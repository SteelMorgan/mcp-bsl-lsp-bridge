&НаСервере
Процедура НоваяНастройкаНаСервере()
	
	Шаблон 			= "%1 - %2: Новая настройка";
	ИмяНастройки	= СтрШаблон(Шаблон, Стратегия, Бар);
		
	СоздатьНастройкуПоШаблону();	
	ЗагрузитьПустыеПараметры();
	Модифицированность = Истина;
	
КонецПроцедуры

