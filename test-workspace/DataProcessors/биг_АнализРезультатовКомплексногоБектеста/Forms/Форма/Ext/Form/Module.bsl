КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаПоПериодам()
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Периоды.НачИнтервала КАК НачалоПериода
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	&Периоды КАК Периоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Операции.ИнструментИД КАК ИнструментИД,
	|	Операции.ПрофитУбыток КАК ПрофитУбыток,
	|	Операции.НачалоСобытияДата КАК НачалоСобытияДата,
	|	Операции.ЗавершениеСобытияДата КАК ЗавершениеСобытияДата,
	|	Операции.Операция КАК Операция
	|ПОМЕСТИТЬ ВТ_Операции
	|ИЗ
	|	&Операции КАК Операции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Операции.ИнструментИД КАК ИнструментИД
	|ПОМЕСТИТЬ ВТ_УникИнструменты
	|ИЗ
	|	ВТ_Операции КАК ВТ_Операции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Периоды.НачалоПериода КАК НачалоПериода,
	|	ВТ_УникИнструменты.ИнструментИД КАК ИнструментИД
	|ПОМЕСТИТЬ ВТ_ПериодыИнструментов
	|ИЗ
	|	ВТ_Периоды КАК ВТ_Периоды
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_УникИнструменты КАК ВТ_УникИнструменты
	|		ПО (ИСТИНА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПериодыИнструментов.НачалоПериода КАК Дата,
	|	ВТ_ПериодыИнструментов.ИнструментИД КАК ИнструментИД,
	|	ВТ_Операции.Операция КАК Операция,
	|	ЕСТЬNULL(ВТ_Операции.ПрофитУбыток, 0) КАК ПрофитУбыток
	|ИЗ
	|	ВТ_ПериодыИнструментов КАК ВТ_ПериодыИнструментов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Операции КАК ВТ_Операции
	|		ПО ВТ_ПериодыИнструментов.ИнструментИД = ВТ_Операции.ИнструментИД
	|			И ВТ_ПериодыИнструментов.НачалоПериода <= ВТ_Операции.ЗавершениеСобытияДата
	|			И ВТ_ПериодыИнструментов.НачалоПериода >= ВТ_Операции.НачалоСобытияДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИнструментИД,
	|	Дата";
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Процедура СформироватьТаблицуИнтерваловОтчета()

	НачалоПериода 	= Дата(3000, 1, 1);
	КонецПериода	= Дата(1, 1, 1);
	Для каждого Строка Из Объект.ОперацииБектестаБезПересечений Цикл
		НачалоПериода = Мин(НачалоПериода, Строка.НачалоСобытияДата);
		КонецПериода	= Макс(КонецПериода, Строка.ЗавершениеСобытияДата);
	КонецЦикла;
	
	ТаблицаИнтервалов 	= биг_ОбщегоНазначения.ПолучитьТаблицуДатЗаПериод(НачалоПериода, КонецПериода, "ДЕНЬ");
	Объект.ТаблицаПериодов.Загрузить(ТаблицаИнтервалов);
	
КонецПроцедуры
  
#КонецОбласти




&НаКлиенте
Процедура ПодобратьОптимальнуюКомбинацию(Команда)
	
	ВремяНачала = ТекущаяДата();
	
	МассивКомбинаций = ПодобратьОптимальнуюКомбинациюНаСервере();
	
	КоличествоКомбинаций = МассивКомбинаций.Количество();
	Счетчик = 0;
	
	// пересчитываем каждый набор комбинаций
	Для Каждого СтруктураКомбинации Из МассивКомбинаций Цикл
		
		Прогресс = Окр(Счетчик / КоличествоКомбинаций * 100, 0);
		Состояние("Пересчет результатов комбинаций", Прогресс); 
		
		Объект.ИсходныеДанные.Очистить();
		
		Для каждого Строка Из СтруктураКомбинации.МассивСтрок Цикл
			НС = Объект.ИсходныеДанные.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Строка);
		КонецЦикла;                              
		
		// пересчитываем сигналы с учетом пересечений
		ПересчитатьДанныеНаСервере();
		
		// собираем результат
		Для каждого Строка Из Объект.ОперацииБектестаБезПересечений Цикл
			СтруктураКомбинации.Результат = СтруктураКомбинации.Результат + Строка.ПрофитУбыток;	
		КонецЦикла;	
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	МаксВариант 	= Неопределено;
	МаксРезультат 	= 0;
	
	Для каждого СтруктураКомбинации Из МассивКомбинаций Цикл
		Если СтруктураКомбинации.Результат > МаксРезультат Тогда
			МаксРезультат = СтруктураКомбинации.Результат;
			МаксВариант	= СтруктураКомбинации.МассивСтрок;
		КонецЕсли;		
	КонецЦикла; 
	
	// перезаполняем форму итоговый раз
	Объект.ИсходныеДанные.Очистить();
	
	Для каждого Строка Из МаксВариант Цикл
		НС = Объект.ИсходныеДанные.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Строка);	
	КонецЦикла;
	
	Пересчитать(Неопределено);

	ВремяЗавершения = ТекущаяДата();
	Длительность = ВремяЗавершения - ВремяНачала;
	Сообщить("Операция заняла " + Окр(Длительность / 60) + " мин");
	
КонецПроцедуры

&НаСервере
Функция ПодобратьОптимальнуюКомбинациюНаСервере()
	
	// Получаем исходные данные из табличной части
    ИсходныеДанные = Объект.ИсходныеДанные.Выгрузить();

    // Создаем массив для хранения уникальных ИнструментИД
    МассивИнструментов = Новый Массив;
    Для Каждого СтрокаИсходныхДанных Из Объект.ИсходныеДанные Цикл
        СтруктураИнструмента = Новый Структура("ИнструментИД, Настройка", СтрокаИсходныхДанных.ИнструментИД, СтрокаИсходныхДанных.Настройка);
        МассивИнструментов.Добавить(СтруктураИнструмента);
    КонецЦикла;

    // Создаем массив для хранения всех комбинаций
    МассивКомбинаций = Новый Массив;

    // Генерируем все комбинации
    СгенерироватьКомбинацииРекурсивно(МассивИнструментов, 0, Новый Массив, МассивКомбинаций);
	
	Возврат МассивКомбинаций;
	   	
КонецФункции

&НаСервере
Процедура СгенерироватьКомбинацииРекурсивно(МассивИнструментов, Индекс, ТекущийМассивСтрок, МассивКомбинаций)
	
	Если Индекс >= МассивИнструментов.Количество() Тогда
        // Создаем копию текущего массива строк
        НовыйМассивСтрок = Новый Массив;
        Для Каждого СтруктураСтроки Из ТекущийМассивСтрок Цикл
            НовыйМассивСтрок.Добавить(Новый Структура("ИнструментИД, Выбор, Настройка", СтруктураСтроки.ИнструментИД, СтруктураСтроки.Выбор, СтруктураСтроки.Настройка));
        КонецЦикла;

        // Создаем структуру для хранения массива строк и результата
        СтруктураВарианта = Новый Структура("МассивСтрок, Результат", НовыйМассивСтрок, 0);
        // Добавляем структуру в массив комбинаций
        МассивКомбинаций.Добавить(СтруктураВарианта);
        Возврат;
    КонецЕсли;

    // Получаем текущий инструмент и его настройку
    СтруктураИнструмента = МассивИнструментов[Индекс];
    Инструмент = СтруктураИнструмента.ИнструментИД;
    Настройка = СтруктураИнструмента.Настройка;

    // Создаем копию текущего массива строк для варианта "Истина"
    МассивИстина = Новый Массив;
    Для Каждого СтруктураСтроки Из ТекущийМассивСтрок Цикл
        МассивИстина.Добавить(Новый Структура("ИнструментИД, Выбор, Настройка", СтруктураСтроки.ИнструментИД, СтруктураСтроки.Выбор, СтруктураСтроки.Настройка));
    КонецЦикла;
    МассивИстина.Добавить(Новый Структура("ИнструментИД, Выбор, Настройка", Инструмент, Истина, Настройка));
    СгенерироватьКомбинацииРекурсивно(МассивИнструментов, Индекс + 1, МассивИстина, МассивКомбинаций);

    // Создаем копию текущего массива строк для варианта "Ложь"
    МассивЛожь = Новый Массив;
    Для Каждого СтруктураСтроки Из ТекущийМассивСтрок Цикл
        МассивЛожь.Добавить(Новый Структура("ИнструментИД, Выбор, Настройка", СтруктураСтроки.ИнструментИД, СтруктураСтроки.Выбор, СтруктураСтроки.Настройка));
    КонецЦикла;
    МассивЛожь.Добавить(Новый Структура("ИнструментИД, Выбор, Настройка", Инструмент, Ложь, Настройка));
    СгенерироватьКомбинацииРекурсивно(МассивИнструментов, Индекс + 1, МассивЛожь, МассивКомбинаций);
	
КонецПроцедуры


