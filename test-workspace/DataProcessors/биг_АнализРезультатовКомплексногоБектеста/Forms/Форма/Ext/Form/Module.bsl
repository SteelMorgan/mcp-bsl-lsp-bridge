#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПересчитатьДанныеНаСервере()
	
	ЗаполнитьИнформациюПоБектесту();	
	ЗаполнитьДанныеБезПересечений();
	
	СформироватьТаблицуИнтерваловОтчета();
	ЗаполнитьДанныеДляДиаграммы();
	ЗаполнитьДанныеДляДиаграммыОбщая();
	
	Если ВыводитьИтого Тогда
		ЗаполнитьНакопленныйРезультат();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДиаграмму()

	ДиаграммаСобытий.Обновление 	= Ложь;
    ДиаграммаСобытий.Очистить();

	СоответствиеСерий 		= Новый Соответствие;
	                  
	// получить минимум из таблицы		
	Для каждого Строка Из Объект.ДанныеДляДиаграммы Цикл
		
		Серия = СоответствиеСерий.Получить(Строка.ИнструментИД);
		Если Серия = Неопределено Тогда
			Серия = ДиаграммаСобытий.Серии.Добавить(Строка.ИнструментИД);
			СоответствиеСерий.Вставить(Строка.ИнструментИД, Серия);
		КонецЕсли;
		
		Точка = ДиаграммаСобытий.УстановитьТочку(Строка.Дата);
		ДиаграммаСобытий.УстановитьЗначение(Точка, Серия, Строка.ПрофитУбыток);			
 
	КонецЦикла;
	
	ДиаграммаСобытий.Обновление 	= Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДиаграммуПоВсем()

	ДиаграммаПоВсем.Обновление 	= Ложь;
    ДиаграммаПоВсем.Очистить();
	
	СоответствиеСерий 		= Новый Соответствие;
	                  		
	Для каждого Строка Из Объект.ДанныеДляДиаграммыОбщая Цикл
		
		Серия = СоответствиеСерий.Получить(Строка.ИнструментИД);
		Если Серия = Неопределено Тогда
			Серия = ДиаграммаПоВсем.Серии.Добавить(Строка.ИнструментИД);
			СоответствиеСерий.Вставить(Строка.ИнструментИД, Серия);
		КонецЕсли;
		
		Точка = ДиаграммаПоВсем.УстановитьТочку(Строка.Дата);
		ДиаграммаПоВсем.УстановитьЗначение(Точка, Серия, Строка.ПрофитУбыток); 
	КонецЦикла;
	
	ДиаграммаПоВсем.Обновление 	= Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНакопленныйРезультат()
	
	НакопленныйРезультат = 0;
	УчтенныеОперации	= Новый Массив();
	
	Для каждого СтрокаПериода Из Объект.ТаблицаПериодов Цикл
		
		Отбор 				= Новый Структура("Дата", СтрокаПериода.НачИнтервала);
		РезультатыВПериоде 	= Объект.ДанныеДляДиаграммы.НайтиСтроки(Отбор);
		
		Для каждого СтрокаРезультата Из РезультатыВПериоде Цикл
			
			Если УчтенныеОперации.Найти(СтрокаРезультата.Операция) = Неопределено Тогда
				НакопленныйРезультат = НакопленныйРезультат + СтрокаРезультата.ПрофитУбыток;
				УчтенныеОперации.Добавить(СтрокаРезультата.Операция);
			КонецЕсли;
		КонецЦикла;
		
		НС = Объект.ДанныеДляДиаграммы.Добавить();
		НС.ИнструментИД = "ИТОГО";
		НС.Дата 		= СтрокаПериода.НачИнтервала;
		НС.ПрофитУбыток = НакопленныйРезультат;
	КонецЦикла;	
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьИнформациюПоБектесту()

	Объект.ОперацииБектеста.Очистить();
	
	ТаблицаФильтр = Новый ТаблицаЗначений;
	ТаблицаФильтр.Колонки.Добавить("ИнструментИД", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаФильтр.Колонки.Добавить("Настройка", Новый ОписаниеТипов("СправочникСсылка.биг_КлючиНастроекСтратегии"));
	
	Для каждого Строка Из Объект.ИсходныеДанные Цикл
		Если Строка.Выбор Тогда
			НС = ТаблицаФильтр.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Строка);
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Фильтр.ИнструментИД КАК ИнструментИД,
	|	Фильтр.Настройка КАК Настройка
	|ПОМЕСТИТЬ ВТ_Фильтр
	|ИЗ
	|	&Фильтр КАК Фильтр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактОперации.Операция.НастройкаСтратегии КАК Настройка,
	|	биг_ДаблИмпактОперации.Операция КАК Операция,
	|	биг_ДаблИмпактОперации.Операция.pnl КАК ПрофитУбыток,
	|	биг_ДаблИмпактОперации.Операция.ТочкаНачалаПадения КАК НачалоСобытияТС,
	|	биг_ДаблИмпактОперации.Операция.cTime КАК ЗавершениеСобытияТС,
	|	биг_ДаблИмпактОперации.Операция.cTimeDateTime КАК ЗАвершениеСобытияДата
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Фильтр КАК ВТ_Фильтр
	|		ПО биг_ДаблИмпактОперации.ИнструментИД = ВТ_Фильтр.ИнструментИД
	|			И биг_ДаблИмпактОперации.Операция.НастройкаСтратегии = ВТ_Фильтр.Настройка
	|ГДЕ
	//|	биг_ДаблИмпактОперации.Операция.Стратегия = &Стратегия
	|	 биг_ДаблИмпактОперации.Операция.Событие = &Событие
	|	И (биг_ДаблИмпактОперации.Операция.Дата МЕЖДУ &НачалоПериода И &ЗавершениеПериода
	|			ИЛИ &БезОтбораПоПериоду)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НачалоСобытияТС";
	
	Запрос.УстановитьПараметр("Фильтр", 	ТаблицаФильтр);
	Запрос.УстановитьПараметр("Стратегия", 	Объект.Стратегия);
	Запрос.УстановитьПараметр("Событие", 	Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс);
	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ЗавершениеПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("БезОтбораПоПериоду", НЕ ЗначениеЗаполнено(Период.ДатаНачала));
	
	Объект.ОперацииБектеста.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Сконвертируем классические даты, если их где то нет
	Для каждого Строка Из Объект.ОперацииБектеста Цикл
		
		Если Строка.НачалоСобытияДата < Дата(1970, 1, 1) Тогда
			Строка.НачалоСобытияДата 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(Строка.НачалоСобытияТС);	
		КонецЕсли;	
		
		Если Строка.ЗавершениеСобытияДата < Дата(1970, 1, 1) Тогда
			Строка.ЗавершениеСобытияДата 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(Строка.ЗавершениеСобытияТС);	
		КонецЕсли;		
	КонецЦикла;		
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБезПересечений()

	// заполнение без пересечений
	Объект.ОперацииБектестаБезПересечений.Очистить();
		
	 // Переменная для хранения последнего добавленного события
    ПоследнееСобытие = Неопределено;

    // Перебираем все события
    Для Каждого Событие Из Объект.ОперацииБектеста Цикл
		
		Если ПоследнееСобытие = Неопределено Тогда
            // Если это первое событие, просто добавляем его
            НоваяСтрока 		= Объект.ОперацииБектестаБезПересечений.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, Событие);
            ПоследнееСобытие 	= НоваяСтрока;
        Иначе
            // Проверяем пересечение с последним добавленным событием
            Если Событие.НачалоСобытияТС > ПоследнееСобытие.ЗавершениеСобытияТС Тогда
				
				// Если пересечения нет, добавляем событие в результирующую таблицу
                НоваяСтрока = Объект.ОперацииБектестаБезПересечений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Событие);							
				
                ПоследнееСобытие = НоваяСтрока;
            КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДляДиаграммы()

	Объект.ДанныеДляДиаграммы.Очистить();
	
	Запрос 				= Новый Запрос;	
	Запрос.Текст 		= ПолучитьТекстЗапросаПоПериодам();	
	Запрос.УстановитьПараметр("Периоды", Объект.ТаблицаПериодов.Выгрузить());
	Запрос.УстановитьПараметр("Операции", Объект.ОперацииБектестаБезПересечений.Выгрузить());
	
	Объект.ДанныеДляДиаграммы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

