&НаСервере
Процедура СтартовоеЗаполнениеФормы()

	Market 		= РегистрыСведений.биг_ПредопределенныеЭлементы.ПолучитьЗначениеПоИмени("OKX");
    instId 		= "BTC-USDT-SWAP";
	Bar			= Справочники.big_BarTypes.H1;
	Account		= РегистрыСведений.биг_ПредопределенныеЭлементы.ПолучитьЗначениеПоИмени("OKXDemoAccount");
	orderType	= Перечисления.big_OKX_OrderTypes.conditional;
	
	НачалоПериодаRSI = Дата("20200101"); 
	ЗавершениеПериодаRSI = КонецМесяца(ТекущаяДата());
	
	ГрузитьДоТочки		= Дата(2023,12,28);
	
	Order		= ПодобратьНеотправленныйОрдер();
    instType	= Перечисления.big_OKX_InstrumentType.SWAP;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьНеотправленныйОрдер()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	big_Order_OKX.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.big_Order_OKX КАК big_Order_OKX
	|ГДЕ
	|	НЕ big_Order_OKX.ПометкаУдаления
	|	И big_Order_OKX.ordId = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	big_Order_OKX.Ссылка УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;	
	
КонецФункции

