	//биг_Индикаторы.ВычислитьПоказательRSISMA(Market, instId, Bar, ТСНачало, ТСЗавершение);
	
	// по новому
	биг_Индикаторы.ВычислитьПоказатель(Market, instId, Bar, Перечисления.биг_ВидыИндикаторов.RSI, 14,,, Перечисления.биг_ИсточникиДанныхТехническихИндикаторов.ЦенаЗакрытия, ТСНачало, ТСЗавершение);
	
