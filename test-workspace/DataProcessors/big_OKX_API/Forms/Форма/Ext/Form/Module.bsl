&НаСервере
Процедура ИсторияАлгоНаСервере()
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ПолучитьИсториюАлгоОрдеров();
	СтруктураОперации.ОрдерТип = orderType;
	СтруктураОперации.ИнструментИД = instId;                             
	
	//биг_МаркетАпи.ПолучитьИсториюАлгоОрдеров(Account, СтруктураОперации);
	
	СтруктураОперации.Состояние = "effective";	
	биг_МаркетАпи.ПолучитьИсториюАлгоОрдеров(Account, СтруктураОперации);
	
	СтруктураОперации.Состояние = "canceled";	
	биг_МаркетАпи.ПолучитьИсториюАлгоОрдеров(Account, СтруктураОперации);
	
	СтруктураОперации.Состояние = "order_failed";	
	биг_МаркетАпи.ПолучитьИсториюАлгоОрдеров(Account, СтруктураОперации);
	
