КонецПроцедуры

&НаКлиенте
Процедура ПодгрузитьИсториюСвечей(Команда)
	
	Лимит 				= 100;
	
	ТС 					= ?(ЗначениеЗаполнено(ГрузитьОтТочки), биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ГрузитьОтТочки), биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло());
	ГрузитьДоТочкиТС 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ГрузитьДоТочки);
	
	ДлительностьБара	= ДлительностьБара(Bar);
	ТребуетсяБар		= Цел((ТС - ГрузитьДоТочкиТС) / ДлительностьБара) + 1;
	ТребуетсяИтераций	= Цел(ТребуетсяБар/Лимит); 
	
	Сч = 0;
	
	Состояние("Начало загрузки", 0);
	
	Пока ТС > ГрузитьДоТочкиТС Цикл
		
		ТССтрока = биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ТС);
		
		СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьИсториюСвечей();
		СтруктураОперации.Биржа            = Market;
		СтруктураОперации.ИнструментИД     = instId;
		СтруктураОперации.Бар              = Bar;
		СтруктураОперации.ТочкаДо          = ТССтрока;
		//СтруктураОперации.ТочкаПосле       = "";
		СтруктураОперации.КоличествоСвечей = Лимит;
		
		ПодгрузитьИсториюСвечейНаСервере(СтруктураОперации);
		
		ТС = ТС - (ДлительностьБара * 100);
		
		Сч = Сч + 1;		
			
		Прогресс = Окр(Сч / ТребуетсяИтераций * 100, 0);
		
		Шаблон 			= "Загрузка свечей %1 / %2 запросов";
		ТекстСостояния 	= СтрШаблон(Шаблон, Сч, ТребуетсяИтераций);
		
		Состояние(ТекстСостояния, Прогресс);	
		
	КонецЦикла;
	
КонецПроцедуры

