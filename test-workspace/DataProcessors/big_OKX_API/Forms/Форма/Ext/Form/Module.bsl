&НаСервере
Процедура ИзменитьАлгоНаСервере()
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ИзменитьАлгоОрдер();
		
	Если ЗначениеЗаполнено(newSlOrdPx) Тогда
		СтруктураОперации.НовыйЦенаСтопЛос = newSlOrdPx;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(newSlTriggerPx) Тогда
		СтруктураОперации.НовыйТриггерСтопЛос = newSlTriggerPx;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(newTpTriggerPx) Тогда
		СтруктураОперации.НовыйТриггерТейкПрофит = newTpTriggerPx;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(newTpOrdPx) Тогда
		СтруктураОперации.НовыйЦенаТейкПрофит = newTpOrdPx;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(newSz) Тогда
		СтруктураОперации.НовыйОбъемТейкПрофит = newSz;
	КонецЕсли;
	
	биг_МаркетАпи.ИзменитьАлгоОрдер(АлгоОрдер, СтруктураОперации);
	
КонецПроцедуры

