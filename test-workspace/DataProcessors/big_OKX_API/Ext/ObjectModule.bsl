Функция АлгоОрдер_СформироватьСтруктуруЗапроса(Order)
	
	JSON 	= АлгоОРдер_ПолучитьСтруктуруДляЗаполненияJSON();	
	Объект 	= Order.ПолучитьОбъект();
	
	Для каждого Элемент Из JSON Цикл
		
		НазваниеРеквизита 	= Элемент.Ключ;
		Реквизит 			= Объект[НазваниеРеквизита];
		ТипРеквизита 		= ТипЗнч(Реквизит);
		
		Если ТипРеквизита = Тип("Строка") Тогда
			
			JSON[НазваниеРеквизита] = Реквизит; 
			
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда 
			
			JSON[НазваниеРеквизита] = Формат(Реквизит, "ЧЦ=30; ЧДЦ=8; ЧРД=.; ЧГ=0");
			
		Иначе
			
			JSON[НазваниеРеквизита] = Строка(Реквизит);	
		КонецЕсли;
	КонецЦикла;
	
	СтрокаUUID 				= Order.УникальныйИдентификатор();
	СтрокаUUID 				= СтрЗаменить(СтрокаUUID, "-", ""); 
	JSON.attachAlgoClOrdId	= СтрокаUUID;
		                  
	биг_ОбщегоНазначенияКлиентСервер.УдалитьНеиспользуемыеКлючи(JSON);
	
	Возврат JSON;
	
КонецФункции  
     
Функция АлгоОРдер_ПолучитьСтруктуруДляЗаполненияJSON()

	Возврат Новый Структура("attachAlgoClOrdId, tpTriggerPx, tpOrdPx, tpOrdKind, tpTriggerPxType, slTriggerPx, slOrdPx, slTriggerPxType, sz, amendPxOnTriggerType, algoId");  
	
КонецФункции

Функция АлгоОрдер_СоздатьДополнитьПоОтвету(Data, Аккаунт)

	algoClOrdId	= Data["algoClOrdId"];
	algoId		= Data["algoId"];
	
	Если ЗначениеЗаполнено(algoClOrdId) И СтрДлина(algoClOrdId) = 32 Тогда		
		UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(Data["algoClOrdId"]);
		Если ЗначениеЗаполнено(UUID) Тогда
			UUID	= Новый УникальныйИдентификатор(UUID);
			Ордер 	= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(UUID);
		Иначе
			Ордер 	= "Объект не найден";
		КонецЕсли;	
			 	
		Если СтрНайти(Ордер, "Объект не найден") <> 0 Тогда
	    	Ордер = Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Если Ордер = Неопределено И ЗначениеЗаполнено(algoId) Тогда
		Ордер	= Документы.big_AlgoOrders_OKX.НайтиПоРеквизиту("algoId", algoId);
		Если НЕ ЗначениеЗаполнено(Ордер) Тогда
			Ордер = Неопределено;	
		КонецЕсли;
	КонецЕсли; 
	
	Если Ордер = Неопределено Тогда
		
		ДокументОбъект 		= Документы.big_AlgoOrders_OKX.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();		
	Иначе 	
		
		ДокументОбъект		= Ордер.ПолучитьОбъект();
	КонецЕсли;
	
	ПоляИсключения		= "attachAlgoOrds";
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ДокументОбъект, Data, ПоляИсключения);
	АлгоОрдер_ЗаполнитьПоляИзОтвета(ДокументОбъект, Data);
	
	ДокументОбъект.Аккаунт 		= Аккаунт; 
	ДокументОбъект.Стратегия 	= биг_СтратегииСервер.ОпределитьСтратегиюАккаунта(Аккаунт);
	Если ЗначениеЗаполнено(ДокументОбъект.Стратегия) Тогда
		ДокументОбъект.НастройкаСтратегии 	= биг_СтратегииСервер.ОпределитьНастройкуОперации(ДокументОбъект.Стратегия, Аккаунт, ДокументОбъект.instId);	
	КонецЕсли;    
	
    УстановитьВремяДокументаПоДаннымБиржи(ДокументОбъект, Data["cTime"]); 
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение 	
		АлгоОрдер_ЗаписатьВРежимеЗаписи(ДокументОбъект);					
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка;
		
КонецФункции 

Процедура АлгоОрдер_ЗаполнитьПоляИзОтвета(ДокументОбъект, Data)
	
	//ДокументОбъект.tpOrdKind        = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_TPOrderKinds", Data["tpOrdKind"]); // потому что веб сокет не отдает это поле, комент как костыль
	ДокументОбъект.tpTriggerPxType  = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_TriggerPxTypes", Data["tpTriggerPxType"]);	
	ДокументОбъект.slTriggerPxType  = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_TriggerPxTypes", Data["slTriggerPxType"]);
	
	ДокументОбъект.tdMode 			= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_tdModes", Data["tdMode"]);
	ДокументОбъект.side 			= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_OrderSides", Data["side"]);
	ДокументОбъект.posSide 			= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_PositionSides", Data["posSide"]);
	ДокументОбъект.ordType 			= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_OrderTypes", Data["ordType"]);
	ДокументОбъект.triggerPxType 	= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_TriggerPxTypes", Data["triggerPxType"]);
		           
КонецПроцедуры

