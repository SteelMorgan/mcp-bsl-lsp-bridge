Процедура АлгоОрдер_ВывестиТекстОтветаБезОбработки(Ответ)

	Сообщить(Ответ["msg"]);
		
	data = Ответ["data"];
	Если data <> Неопределено Тогда
		
		Для каждого Соответствие Из data Цикл
			
			КодОшибки 		= Соответствие["sCode"];
			ТекстОшибки		= Соответствие["sMsg"];
			Идентификатор 	= Соответствие["algoClOrdId"];
			
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				СтрокаUUID		= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(Соответствие["algoClOrdId"]);
				UUID			= Новый УникальныйИдентификатор(СтрокаUUID);
				АлгоОрдер		= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(UUID);
			Иначе
				АлгоОрдер		= "";	
			КонецЕсли;
			  		
			Шаблон 			= "Inner object: %1, error code: %2, error text: %3";
			ТекстОшибки		= СтрШаблон(Шаблон, АлгоОрдер, КодОшибки, ТекстОшибки);
			Сообщить(ТекстОшибки);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьСтруктуруЗапросаПоОписаниюСсылки(Ссылка)

	JSON 	= биг_ОбщегоНазначения.СтруктураРеквизитовПоМетаданным(Ссылка);	
	биг_ОбщегоНазначения.ЗаполнитьСтруктуруПоОбъектуСУчетомТипов(JSON, Ссылка.ПолучитьОбъект());		                  
	биг_ОбщегоНазначенияКлиентСервер.УдалитьНеиспользуемыеКлючи(JSON);
		
	Возврат JSON;
	
КонецФункции

