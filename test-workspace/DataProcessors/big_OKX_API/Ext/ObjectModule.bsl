Функция GET_DownloadInstruments(ПараметрыОперацииБиржи) Экспорт

	Аккаунт = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("OKXDemoAccount");
	Ответ 	= биг_ОКХАпиСервер.GET_Instruments(ПараметрыОперацииБиржи, Аккаунт);
	Market 	= БиржаOKX();
	
	Если Ответ["code"] = "0" Тогда
		
		МассивДанныхОбИнструментах = Ответ["data"];	
		
		Для Каждого Data Из МассивДанныхОбИнструментах Цикл
			
			СоздатьОбновитьИнструмент(Data, Market);				
		КонецЦикла;                                     
		Результат = Истина;
	Иначе
		
		Сообщить(Ответ["msg"]);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

