Процедура ДозаполнитьОрдерПоАлгоордеру(ДокументОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_AlgoOrders_OKX.Ссылка КАК Ссылка,
	|	big_AlgoOrders_OKX.Стратегия КАК Стратегия,
	|	big_AlgoOrders_OKX.НастройкаСтратегии КАК НастройкаСтратегии,
	|	big_AlgoOrders_OKX.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	big_AlgoOrders_OKX.slTriggerPx КАК slTriggerPx,
	|	big_AlgoOrders_OKX.tpTriggerPx КАК tpTriggerPx
	|ИЗ
	|	Документ.big_AlgoOrders_OKX КАК big_AlgoOrders_OKX
	|ГДЕ
	|	big_AlgoOrders_OKX.ordId = &ordId";
	Запрос.УстановитьПараметр("ordId", ДокументОбъект.ordId);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ДокументОбъект.Стратегия 			= Выборка.Стратегия;
		ДокументОбъект.НастройкаСтратегии 	= Выборка.НастройкаСтратегии;
		ДокументОбъект.ТочкаНачалаПадения	= Выборка.ТочкаНачалаПадения;
		
		Если ЗначениеЗаполнено(Выборка.slTriggerPx) Тогда
			ДокументОбъект.Событие = Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

