Процедура АлгоОрдер_Place_ОбработатьПоложительныйОтвет(НаборДанных)
	
	tag 		= НаборДанных["tag"];
	sMsg 		= НаборДанных["sMsg"];
	sCode 		= НаборДанных["sCode"];
	algoId 		= НаборДанных["algoId"];
	algoClOrdId = НаборДанных["algoClOrdId"];
	
	Если ЗначениеЗаполнено(algoClOrdId) Тогда
		UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(algoClOrdId);
		UUID	= Новый УникальныйИдентификатор(UUID);
		АлгоОрдер 	= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(UUID); 
		
		ОрдерОбъект = АлгоОрдер.ПолучитьОбъект();
		ОрдерОбъект.algoId 			= algoId;
		ОрдерОбъект.tag				= tag;
		ОрдерОбъект.Комментарий 	= "sMsg = " + sMsg;
		ОрдерОбъект.Статус			= Перечисления.big_СтатусыТорговыхОбъектов.Активный;
		
		Попытка
			ОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение			
			Ордер_ЗаписатьДокументВРежимеЗаписи(ОрдерОбъект);					
		КонецПопытки;
		
		//ЗафиксироватьОперацию(Стратегия, ОрдерОбъект);
	Иначе
		
		Шаблон = "В ответе не обнаружено значения algoClOrdId";
		//Информация = СтрШаблон(Шаблон, ts, tag, sMsg, sCode, ordId, clOrdId); 
		ЗаписьЖурналаРегистрации("OKX.PlaceAlgoOrder", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.big_AlgoOrders_OKX,, Шаблон);
	КонецЕсли;	
		
КонецПроцедуры


Процедура АРХИВ_АлгоОрдер_СоздатьДополнитьПоОтвету(OrderData)
	
	algoClOrdId	= OrderData["algoClOrdId"];
	algoId	= OrderData["algoId"];
	
	Если ЗначениеЗаполнено(algoClOrdId) И СтрДлина(algoClOrdId) = 32 Тогда		
		UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(OrderData["algoClOrdId"]);
		Если ЗначениеЗаполнено(UUID) Тогда
			UUID	= Новый УникальныйИдентификатор(UUID);
			Ордер 	= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(UUID);
		Иначе
			Ордер 	= "Объект не найден";
		КонецЕсли;	
			 	
		Если СтрНайти(Ордер, "Объект не найден") <> 0 Тогда
	    	Ордер = Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Если Ордер = Неопределено И ЗначениеЗаполнено(algoId) Тогда
		Ордер	= Документы.big_AlgoOrders_OKX.НайтиПоРеквизиту("algoId", algoId);
		Если НЕ ЗначениеЗаполнено(Ордер) Тогда
			Ордер = Неопределено;	
		КонецЕсли;
	КонецЕсли;
	
	Если Ордер = Неопределено Тогда
		
		ДокументОбъект 		= Документы.big_AlgoOrders_OKX.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();		
	Иначе 	
		
		ДокументОбъект		= Ордер.ПолучитьОбъект();
	КонецЕсли;
	
	ПоляИсключения = "";
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ДокументОбъект, OrderData, ПоляИсключения);
	Ордер_ЗаполнитьПоля(ДокументОбъект, OrderData);
	
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение			
		Ордер_ЗаписатьДокументВРежимеЗаписи(ДокументОбъект);					
	КонецПопытки;	
		
