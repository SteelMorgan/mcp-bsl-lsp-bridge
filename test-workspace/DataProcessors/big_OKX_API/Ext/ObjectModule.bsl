	ДокументОбъект.stpMode          = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_SelfTradePreventionModes", OrderData["stpMode"]);
	ДокументОбъект.tdMode           = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_tdModes", OrderData["tdMode"]);
