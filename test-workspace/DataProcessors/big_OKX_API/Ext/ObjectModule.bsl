Функция GET_DownloadCandles(ПараметрыОперацииБиржи) Экспорт
		
	Ответ = биг_ОКХАпиСервер.GET_Candles(ПараметрыОперацииБиржи);
	
	Если Ответ["code"] <> "0" Тогда		
		Сообщить(Ответ["msg"]);
		Результат = Ложь;		
	Иначе 	
		ОбработатьОтветБиржиПоДаннымСвечей(ПараметрыОперацииБиржи, Ответ);
		Результат = Истина;
	КонецЕсли;	
	
	биг_ОбщегоНазначения.Пауза(0.06);
	
	Возврат Результат;
	
КонецФункции

