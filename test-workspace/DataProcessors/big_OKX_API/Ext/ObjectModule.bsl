// Реализация вызова метода API
Функция GET_Tickers(ПараметрыОперацииБиржи) Экспорт
	
	Ответ 	= биг_ОКХАпиСервер.GET_Tickers(ПараметрыОперацииБиржи);
	
	Если Ответ["code"] = "0" Тогда
		
		МассивДанных 	= Ответ["data"];
		
		ТипЧисло 	= ОбщегоНазначения.ОписаниеТипаЧисло(30, 8);
		ТипСтрока	= ОбщегоНазначения.ОписаниеТипаСтрока(100);
		Таблица 	= Новый ТаблицаЗначений;
		
		// Добавление колонок с русскими названиями
		Таблица.Колонки.Добавить("Инструмент", 				Новый ОписаниеТипов("СправочникСсылка.big_Instruments")); // Ссылка на инструмент
		Таблица.Колонки.Добавить("ТипИнструмента", 			ТипСтрока); // instType
		Таблица.Колонки.Добавить("ИнструментИД", 			ТипСтрока); // instId
		Таблица.Колонки.Добавить("ПоследняяЦена", 			ТипЧисло); // last
		Таблица.Колонки.Добавить("РазмерПоследнейСделки", 	ТипЧисло); // lastSz
		Таблица.Колонки.Добавить("ЦенаПредложения", 		ТипЧисло); // askPx
		Таблица.Колонки.Добавить("РазмерПредложения", 		ТипЧисло); // askSz
		Таблица.Колонки.Добавить("ЦенаСпроса", 				ТипЧисло); // bidPx
		Таблица.Колонки.Добавить("РазмерСпроса", 			ТипЧисло); // bidSz
		Таблица.Колонки.Добавить("Открытие24ч", 			ТипЧисло); // open24h
		Таблица.Колонки.Добавить("Максимум24ч", 			ТипЧисло); // high24h
		Таблица.Колонки.Добавить("Минимум24ч", 				ТипЧисло); // low24h
		Таблица.Колонки.Добавить("Объем24ч_ВВалюте", 		ТипЧисло); // volCcy24h
		Таблица.Колонки.Добавить("Объем24ч", 				ТипЧисло); // vol24h
		Таблица.Колонки.Добавить("ОбъемСодUTC0", 			ТипЧисло); // sodUtc0
		Таблица.Колонки.Добавить("ОбъемСодUTC8", 			ТипЧисло); // sodUtc8
		Таблица.Колонки.Добавить("ВремяСервера", 			ТипЧисло); // ts
		
		// Заполнение таблицы данными
		Для Каждого Соответствие Из МассивДанных Цикл
			НоваяСтрока = Таблица.Добавить();
			
			НоваяСтрока.Инструмент 				= Справочники.big_Instruments.НайтиПоРеквизиту("instId", Соответствие["instId"]);
			НоваяСтрока.ТипИнструмента 			= Соответствие["instType"];
			НоваяСтрока.ИнструментИД 			= Соответствие["instId"];
			НоваяСтрока.ПоследняяЦена 			= Число(Соответствие["last"]);
			НоваяСтрока.РазмерПоследнейСделки 	= Число(Соответствие["lastSz"]);
			НоваяСтрока.ЦенаПредложения 		= Число(Соответствие["askPx"]);
			НоваяСтрока.РазмерПредложения 		= Число(Соответствие["askSz"]);
			НоваяСтрока.ЦенаСпроса 				= Число(Соответствие["bidPx"]);
			НоваяСтрока.РазмерСпроса 			= Число(Соответствие["bidSz"]);
			НоваяСтрока.Открытие24ч 			= Число(Соответствие["open24h"]);
			НоваяСтрока.Максимум24ч 			= Число(Соответствие["high24h"]);
			НоваяСтрока.Минимум24ч 				= Число(Соответствие["low24h"]);
			НоваяСтрока.Объем24ч_ВВалюте 		= Число(Соответствие["volCcy24h"]);
			НоваяСтрока.Объем24ч 				= Число(Соответствие["vol24h"]);
			НоваяСтрока.ОбъемСодUTC0 			= Число(Соответствие["sodUtc0"]);
			НоваяСтрока.ОбъемСодUTC8 			= Число(Соответствие["sodUtc8"]);
			НоваяСтрока.ВремяСервера 			= Число(Соответствие["ts"]);
		КонецЦикла;
		
		Результат 		= Таблица;		
	Иначе
		
		Сообщить(Ответ["msg"]);
		Результат = Неопределено;
	КонецЕсли;
	
	биг_ОбщегоНазначения.Пауза(0.11);
	
	Возврат Результат;
	
КонецФункции

