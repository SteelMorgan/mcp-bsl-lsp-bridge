Процедура АлгоОрдер_Изменить_ПрименитьКДокументу(ПараметрыОперацииБиржи, ТаймСтамп = Неопределено) Экспорт
    
	УИДСтрока	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(ПараметрыОперацииБиржи.algoClOrdId);
	УИД 		= Новый УникальныйИдентификатор(УИДСтрока);
	Ссылка 		= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(УИД);
	ОрдерОбъект = Ссылка.ПолучитьОбъект();
	
	Для каждого Элемент Из ПараметрыОперацииБиржи Цикл
		
		Если СтрНачинаетсяС(Элемент.Ключ, "new") Тогда  
			
			ИмяРеквизитаОрдера = НРег(Сред(Элемент.Ключ, 4, 1)) + Сред(Элемент.Ключ, 5);
			ОрдерОбъект[ИмяРеквизитаОрдера] = Элемент.Значение;
		КонецЕсли;			
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТаймСтамп) Тогда
		ОрдерОбъект.uTime = ТаймСтамп;
	Иначе
		ОрдерОбъект.uTime = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло();	
	КонецЕсли;
	ОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

