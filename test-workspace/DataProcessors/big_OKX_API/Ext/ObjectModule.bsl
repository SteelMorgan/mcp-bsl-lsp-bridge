Процедура Позиция_СоздатьДополнитьПоОтвету(PositionData, Аккаунт) Экспорт

	posId	= PositionData["posId"];
	cTime 	= Число(PositionData["cTime"]);
	
	ДокументСсылка 	= Позиция_НайтиПоИдентификаторуИВремени(posId, cTime); //Документы.big_Positions_OKX.НайтиПоРеквизиту("posId", posId);	
	ЭтоНовый 		= Ложь; 
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументОбъект 			= Документы.big_Positions_OKX.СоздатьДокумент();
		ДокументОбъект.posId 	= posId;
		ДокументОбъект.cTime	= cTime;
		ДокументОбъект.Аккаунт	= Аккаунт;		
		
		cTime10					= cTime / 1000;
		ДокументОбъект.Дата		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(cTime10);
		ДокументОбъект.cTime10	= cTime10;
		
		ДокументОбъект.СопоставитьСоСделкой = Истина;
		ЭтоНовый							= Истина;
	Иначе
		ДокументОбъект			= ДокументСсылка.ПолучитьОбъект();	
	КонецЕсли;
	
	ПоляИсключения		= "closeOrderAlgo, uTime";
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ДокументОбъект, PositionData, ПоляИсключения);
	Позиция_ЗаполнитьПоля(ДокументОбъект, PositionData);
	Позиция_ЗаполнитьТЧОрдерАлго(ДокументОбъект, PositionData);	
	Позиция_СопоставлениеСоСделкой(ДокументОбъект, ЭтоНовый);
	
	Если ДокументОбъект.pos > 0 И ДокументОбъект.closeAvgPx = 0 Тогда
		ДокументОбъект.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Активный;
	ИначеЕсли ДокументОбъект.pos = 0 И ДокументОбъект.closeAvgPx > 0 Тогда
		ДокументОбъект.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Исполнен;	
	КонецЕсли;
	
	ДокументОбъект.ПометкаУдаления = Ложь;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		
		Позиция_ЗаписатьДокументВРежимеЗаписи(ДокументОбъект);					
	КонецПопытки;
	
КонецПроцедуры

Процедура Позиция_ЗаполнитьПоля(ДокументОбъект, PositionData)
		
	ДокументОбъект.mgnMode          = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_tdModes", 			PositionData["mgnMode"]);	
	ДокументОбъект.instType 		= биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_InstrumentType", 	PositionData["instType"]);
	ДокументОбъект.posSide          = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_PositionSides", 	PositionData["posSide"]);
	ДокументОбъект.margin           = биг_ОбщегоНазначения.ПолучитьЗначениеПеречисления("big_OKX_tdModes", 			PositionData["mgnMode"]);
	      	
	//Instrument - по режиму и ид
	ДокументОбъект.Instrument		= НайтиИнструмент(ДокументОбъект.instType, ДокументОбъект.instId);
	
	ДокументОбъект.uTime = PositionData["uTime"];
	Если ЗначениеЗаполнено(ДокументОбъект.uTime) Тогда
		ДокументОбъект.uTime10 = Лев(ДокументОбъект.uTime, 10);	
	КонецЕсли;
	
	ДокументОбъект.pTime = PositionData["pTime"];
	Если ЗначениеЗаполнено(ДокументОбъект.pTime) Тогда
		ДокументОбъект.pTime10 = Лев(ДокументОбъект.pTime, 10);	
	КонецЕсли;
	   
КонецПроцедуры 

Процедура Позиция_ЗаполнитьТЧОрдерАлго(ДокументОбъект, PositionData)
	
	closeOrderAlgo = PositionData["closeOrderAlgo"];
	
	Если closeOrderAlgo <> Неопределено Тогда
		
		Для каждого closeOrder Из closeOrderAlgo Цикл
		
			AlgoOrder = Документы.big_AlgoOrders_OKX.СоздатьДополнитьОрдерПоОтвету(closeOrder); 
			НС = ДокументОбъект.closeOrderAlgo.Добавить();
			НС.algoId 		= closeOrder["algoId"];
			НС.AlgoOrder	= AlgoOrder;
			
		КонецЦикла;		
	КонецЕсли	
		
КонецПроцедуры

Процедура Позиция_ЗаписатьДокументВРежимеЗаписи(ДокументОбъект)
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
	Исключение
		Информация = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("OKX.Position", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.big_Positions_OKX, ДокументОбъект.Ссылка, Информация);
	КонецПопытки;
	
КонецПроцедуры

Функция Позиция_НайтиПоИдентификаторуИВремени(posId, cTime)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Positions_OKX.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.big_Positions_OKX КАК big_Positions_OKX
	|ГДЕ
	|	big_Positions_OKX.posId = &posId
	|	И big_Positions_OKX.cTime = &cTime";
	Запрос.УстановитьПараметр("posId", posId);
	Запрос.УстановитьПараметр("cTime", cTime);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли;                     
	
	Возврат Результат;
		
КонецФункции

Процедура Позиция_СопоставлениеСоСделкой(ДокументОбъект, ЭтоНовый)

	Если ДокументОбъект.СопоставитьСоСделкой И НЕ ДокументОбъект.СопоставленаСоСделкой Тогда
		
		// для нового документа
		Если ЭтоНовый Тогда
			
			УИД 			= Новый УникальныйИдентификатор;
			СсылкаНаДок		= Документы.big_Positions_OKX.ПолучитьСсылку(УИД);
			ДокументОбъект.УстановитьСсылкуНового(СсылкаНаДок);			
			СсылкаДокумента = СсылкаНаДок;			
		Иначе
			
			СсылкаДокумента = ДокументОбъект.Ссылка;
		КонецЕсли;                                 
		
		ПараметрыПоиска = Новый Структура();
		ПараметрыПоиска.Вставить("Аккаунт", 		ДокументОбъект.Аккаунт);
		ПараметрыПоиска.Вставить("Инструмент", 		НайтиИнструмент(ДокументОбъект.instId, ДокументОбъект.instType));
		ПараметрыПоиска.Вставить("СторонаПозиции", 	ДокументОбъект.posSide);
		ПараметрыПоиска.Вставить("Плечо", 			ДокументОбъект.lever);
		ПараметрыПоиска.Вставить("РежимМаржи", 		ДокументОбъект.mgnMode);
		ПараметрыПоиска.Вставить("ДатаОткрытия", 	ДокументОбъект.cTime10);
		
		биг_ПортфельноеУправление.ЗаполнитьСделкуДляПозиции(СсылкаДокумента, ДокументОбъект.СопоставитьСоСделкой, ДокументОбъект.СопоставленаСоСделкой, ПараметрыПоиска);
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗафиксироватьИнформациюОПозицииВРегистр(Аккаунт, ИнструментИД, PositionData)
	
	Запись = РегистрыСведений.биг_ДаблИмпактОперации.СоздатьМенеджерЗаписи();
	Запись.Биржа 		= Аккаунт.Владелец;
	Запись.ИнструментИД	= ИнструментИД;
	Запись.Аккаунт		= Аккаунт;
	
	posId				= PositionData["posId"];
	cTime 				= PositionData["cTime"];
	Запись.Операция		= Позиция_НайтиПоИдентификаторуИВремени(posId, cTime);
	Запись.Записать(Истина);
	
КонецПроцедуры


#КонецОбласти //РаботаСПозициями


#Область НСИ

Функция СформироватьМассивСвечей(МассивДанныхОСвечах)
	
	МассивСвечей = Новый Массив();
	
	Для Каждого Data Из МассивДанныхОСвечах Цикл
		
		Свеча = Новый Структура("TimeStamp13, TimeStamp10, TimeStamp, Дата, ЦенаОткрытия, ЦенаМаксимум, ЦенаМинимум, ЦенаЗакрытия, Объем, volCcy, volCcyQuote, confirm");
		Свеча.TimeStamp13 		= Data[0];
		Свеча.TimeStamp10		= Лев(Свеча.TimeStamp13, 10);
		Свеча.TimeStamp			= Число(Свеча.TimeStamp10);
		Свеча.Дата				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(Свеча.TimeStamp10);
		Свеча.ЦенаОткрытия		= Число(Data[1]);
		Свеча.ЦенаМаксимум		= Число(Data[2]);
		Свеча.ЦенаМинимум		= Число(Data[3]);
		Свеча.ЦенаЗакрытия		= Число(Data[4]);
		Свеча.Объем				= Число(Data[5]);
		Свеча.volCcy			= Число(Data[6]);
		Свеча.volCcyQuote		= Число(Data[7]);
		Свеча.confirm			= Число(Data[8]);
		
		МассивСвечей.Добавить(Свеча);
	КонецЦикла;
	
	Возврат МассивСвечей;
	
КонецФункции

Процедура СоздатьОбновитьИнструмент(Data, Market)
	
	instId 			= Data.Get("instId");
	instTypeString 	= Data.Get("instType");
	instType		= Перечисления.big_OKX_InstrumentType[instTypeString];
	
	ИнструментСсылка = НайтиИнструмент(instId, instType);
	
	Если ЗначениеЗаполнено(ИнструментСсылка) Тогда
		Инструмент = ИнструментСсылка.ПолучитьОбъект();
	Иначе
		Инструмент = Справочники.big_Instruments.СоздатьЭлемент();
	КонецЕсли;
	
	Инструмент.Владелец = Market;
	Инструмент.Наименование = "[" + Market + "] " + "[" + instType + "] " + instId;
	
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(Инструмент, Data); 
	
	Инструмент.instType 	= instType;	
	Инструмент.baseCcy 		= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Data["baseCcy"]);
	Инструмент.quoteCcy 	= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Data["quoteCcy"]);
	Инструмент.settleCcy 	= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Data["settleCcy"]);
	Инструмент.ctValCcy 	= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Data["ctValCcy"]);
	
	Инструмент.Записать();
		
КонецПроцедуры

Процедура СоздатьОбновитьМонеты(Data)

	Монета 			= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Data["ccy"]);
	МонетаОбъект 	= Монета.ПолучитьОбъект();
	
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(МонетаОбъект, Data); 
	
	МонетаОбъект.Записать();
	
КонецПроцедуры


Функция НайтиИнструмент(instId, instType)
	
	Market = БиржаOKX();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Instruments.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.big_Instruments КАК big_Instruments
	|ГДЕ
	|	big_Instruments.instId = &instId
	|	И big_Instruments.instType = &instType
	|	И big_Instruments.Владелец = &Market
	|	И НЕ big_Instruments.ПометкаУдаления";
	Запрос.УстановитьПараметр("instId", 	instId);
	Запрос.УстановитьПараметр("instType", 	instType); 
	Запрос.УстановитьПараметр("Market", 	Market);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;	
	
КонецФункции

Процедура ОбработатьОтветБиржиПоДаннымСвечей(ПараметрыОперацииБиржи, Ответ)

	Биржа 				= БиржаOKX();
	МассивДанныхОСвечах = Ответ["data"];
	
	Для Каждого Data Из МассивДанныхОСвечах Цикл
		
		Бар			= ПараметрыОперацииБиржи.bar;
		СоздатьСвечу(Data, Биржа, ПараметрыОперацииБиржи.instId, ПараметрыОперацииБиржи.bar);
	КонецЦикла;		
	
КонецПроцедуры

Процедура СоздатьСвечу(Data, Биржа, instId, bar)
             			
	// https://www.okx.com/docs-v5/en/?shell#order-book-trading-market-data-get-candlesticks
	TimeStamp13 	= Data[0];
	TimeStamp10		= Лев(TimeStamp13, 10);
	TimeStamp		= Число(TimeStamp10);
	Дата			= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(TimeStamp10);
	OpenPrice		= Число(Data[1]);
	HighestPrice	= Число(Data[2]);
	LowestPrice		= Число(Data[3]);
	ClosePrice		= Число(Data[4]);
	TradingVolume	= Число(Data[5]);
	volCcy			= Число(Data[6]);
	volCcyQuote		= Число(Data[7]);
	confirm 		= Число(Data[8]);
	
	Запись = РегистрыСведений.биг_ДанныеСвечей.СоздатьМенеджерЗаписи();
	Запись.Биржа			= Биржа;
	Запись.ИнструментИД 	= instId;
	Запись.Бар				= Справочники.big_BarTypes.НайтиПоНаименованию(bar, Истина);
	Запись.TimeStamp13		= TimeStamp13;
	Запись.TimeStamp10		= TimeStamp10;
	Запись.TimeStamp		= TimeStamp; 
	Запись.ДатаОткрытия		= Дата;
	Запись.ЦенаОткрытия		= OpenPrice;
	Запись.ЦенаМаксимум		= HighestPrice;
	Запись.ЦенаМинимум		= LowestPrice;
	Запись.ЦенаЗакрытия		= ClosePrice;
	Запись.Объем			= TradingVolume;
	Запись.volCcy			= volCcy;
	Запись.volCcyQuote		= volCcyQuote;
	Запись.confirm			= ?(confirm=1, Истина, Ложь);
	Запись.Записать(Истина);
			
КонецПроцедуры

Процедура ЗафиксироватьОбщуюИнформациюОБалансе(data, Аккаунт)

	Для каждого Соответствие Из data Цикл
		
		uTime13 = Соответствие["uTime"];
		uTime10 = Лев(uTime13, 10);
		uTime	= Число(uTime10);
		
		Если ИнформацияОБалансеИзменилась(Аккаунт, uTime10) Тогда
			
			ОбщаяЗаписьБалланса = РегистрыСведений.биг_ОКХ_БаллансАккаунтов.СоздатьМенеджерЗаписи();
			ОбщаяЗаписьБалланса.Account = Аккаунт;
			
			биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ОбщаяЗаписьБалланса, Соответствие);
					
			Период 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(uTime);
			dataId	= Новый УникальныйИдентификатор;
			
			ОбщаяЗаписьБалланса.Период	= Период;
			ОбщаяЗаписьБалланса.dataId	= dataId;
			ОбщаяЗаписьБалланса.uTime	= uTime;
			ОбщаяЗаписьБалланса.uTime10	= uTime10;
			ОбщаяЗаписьБалланса.uTime13	= uTime13;
			
			ОбщаяЗаписьБалланса.Записать(Истина);
			
			ЗафиксироватьДетальнуюИнформациюОБалансе(Соответствие["details"], ОбщаяЗаписьБалланса);
			
		КонецЕсли;		
	КонецЦикла;  
	
КонецПроцедуры

Функция ИнформацияОБалансеИзменилась(Аккаунт, uTime10)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ОКХ_БаллансАккаунтовСрезПоследних.Account КАК Account,
	|	биг_ОКХ_БаллансАккаунтовСрезПоследних.uTime10 КАК uTime10
	|ИЗ
	|	РегистрСведений.биг_ОКХ_БаллансАккаунтов.СрезПоследних(
	|			,
	|			Account = &Аккаунт
	|				И uTime10 = &ТекущаяОтметка) КАК биг_ОКХ_БаллансАккаунтовСрезПоследних";
	
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	Запрос.УстановитьПараметр("ТекущаяОтметка", uTime10);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		// uTime10 последней записи отличается - значит что то поменялось
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;       
		
КонецФункции


Процедура ЗафиксироватьДетальнуюИнформациюОБалансе(МассивДеталейБаланса, ОбщаяЗаписьБалланса)
	
	// установить нулями баланс тех монет, которых больше нет на аккаунте
	ТекущийБалансАккаунта = ПолучитьТекущийДетальныйБаланс(ОбщаяЗаписьБалланса.Account);	
	Для каждого Строка Из ТекущийБалансАккаунта Цикл
		НазваниеМонеты = Строка.ccy.ccy;
		Если МонетаОтсутствуетВНовомБалансе(НазваниеМонеты, МассивДеталейБаланса) Тогда
			ДетальнаяЗаписьБаланса = РегистрыСведений.биг_ОКХ_БаллансАккаунтовДетали.СоздатьМенеджерЗаписи();
			ДетальнаяЗаписьБаланса.Период = ТекущаяДата();
			ДетальнаяЗаписьБаланса.Account	= ОбщаяЗаписьБалланса.Account;
			ДетальнаяЗаписьБаланса.ccy		= Строка.ccy;			
			ДетальнаяЗаписьБаланса.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
	
	// установить баланс монет на аккаунте
	Для каждого Соответствие Из МассивДеталейБаланса Цикл
		
		Монета = Соответствие["ccy"];
		Поиск = Новый Структура("НазваниеМонеты", Монета);
		Результат = ТекущийБалансАккаунта.НайтиСтроки(Поиск);
		
		ДетальнаяЗаписьБаланса = РегистрыСведений.биг_ОКХ_БаллансАккаунтовДетали.СоздатьМенеджерЗаписи();		
		биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ДетальнаяЗаписьБаланса, Соответствие);
				
		uTime13 = Соответствие["uTime"];
		uTime10 = Лев(uTime13, 10);
		uTime	= Число(uTime10);
		Период 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(uTime);
		
		ДетальнаяЗаписьБаланса.dataId	= ОбщаяЗаписьБалланса.dataId;
		ДетальнаяЗаписьБаланса.Период 	= Период;
		ДетальнаяЗаписьБаланса.Account	= ОбщаяЗаписьБалланса.Account;
		ДетальнаяЗаписьБаланса.ccy		= биг_ОбщегоНазначения.НайтиСоздатьВалюту("ccy", Соответствие["ccy"]);
		
		ДетальнаяЗаписьБаланса.uTime 	= uTime;
		ДетальнаяЗаписьБаланса.uTime10 	= uTime10;
		ДетальнаяЗаписьБаланса.uTime13 	= uTime13; 
		
		ДетальнаяЗаписьБаланса.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьДанныеАккаунтаOKX(Данные, Аккаунт)

	Для каждого Соответствие Из Данные Цикл
		
		//uid = Соответствие.Получить("uid");		
		//Аккаунт = НайтиАккаунтПоРеквизитам(uid, demo);
		
		Если ЗначениеЗаполнено(Аккаунт) Тогда
			
			АккаунтОбъект = Аккаунт.ПолучитьОбъект();
			
			биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(АккаунтОбъект, Соответствие);
			
			НаименованиеКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АккаунтОбъект.Контрагент, "Наименование");
			АккаунтОбъект.Наименование =  НаименованиеКонтрагента + " / " + АккаунтОбъект.label;
			АккаунтОбъект.Записать();
			
		Иначе
			
			// реализовать ветку вместе с Мастером создания новых аккаунтов.
			// до тех пор создание вручную и указывать uid
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиАккаунтПоРеквизитам(uid, demo)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_MarketAccounts.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.big_MarketAccounts КАК big_MarketAccounts
	|ГДЕ
	|	big_MarketAccounts.uid = &uid
	|	И big_MarketAccounts.demo = &demo";
	Запрос.УстановитьПараметр("uid", uid);
	Запрос.УстановитьПараметр("demo", demo);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли; 
	
КонецФункции


