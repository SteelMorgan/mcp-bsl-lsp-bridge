Функция Ордер_СформироватьСтруктуруЗапроса(Order)

	//instId,tdMode,ccy,clOrdId,tag,side,posSide,ordType,sz,
	//px,pxUsd,pxVol,reduceOnly,tgtCcy,banAmend,quickMgnType,stpId,stpMode,attachAlgoOrds
	
	JSON 	= Ордер_ПолучитьСтруктуруДляЗаполненияJSON();
	Объект 	= Order.ПолучитьОбъект();
	
	Для каждого Элемент Из JSON Цикл
		
		НазваниеРеквизита 	= Элемент.Ключ;
		Реквизит 			= Объект[НазваниеРеквизита];
		ТипРеквизита 		= ТипЗнч(Реквизит);
		
		Если ТипРеквизита = Тип("Строка") Тогда
			
			JSON[НазваниеРеквизита] = Реквизит; 
			
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда 
			
			JSON[НазваниеРеквизита] = Формат(Реквизит, "ЧЦ=30; ЧДЦ=8; ЧРД=.; ЧГ=0");
			
		Иначе
			
			JSON[НазваниеРеквизита] = Строка(Реквизит);	
		КонецЕсли;
	КонецЦикла;
	   	
	СтрокаUUID 				= Order.УникальныйИдентификатор();
	СтрокаUUID 				= СтрЗаменить(СтрокаUUID, "-", ""); 
	JSON.clOrdId			= СтрокаUUID;
		                  
	биг_ОбщегоНазначенияКлиентСервер.УдалитьНеиспользуемыеКлючи(JSON);
	
	МассивАлгоОрдеров = Новый Массив;
	
	Для каждого Строка Из Order.attachAlgoOrds Цикл
		АлгоОрдер = АлгоОрдер_СформироватьСтруктуруЗапроса(Строка.AlgoOrder);
		МассивАлгоОрдеров.Добавить(АлгоОрдер);
	КонецЦикла;
	
	JSON.Вставить("attachAlgoOrds", МассивАлгоОрдеров);
	
	Возврат JSON;
	
КонецФункции  
     
Функция Ордер_ПолучитьСтруктуруДляЗаполненияJSON()

	Возврат Новый Структура("banAmend, instId,tdMode,ccy,clOrdId,tag,side,posSide,ordType,sz,px,pxUsd,pxVol,reduceOnly,tgtCcy,quickMgnType,stpId,stpMode");  
	
КонецФункции

Процедура Ордер_Отправка_ЗафиксироватьОтвет(OrderData, Аккаунт)

	ts 		= OrderData["ts"];
	tag 	= OrderData["tag"];
	sMsg 	= OrderData["sMsg"];
	sCode 	= OrderData["sCode"];
	ordId 	= OrderData["ordId"];
	clOrdId = OrderData["clOrdId"];
	
	Если ЗначениеЗаполнено(clOrdId) Тогда
		UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(OrderData["clOrdId"]);
		UUID	= Новый УникальныйИдентификатор(UUID);
		Ордер 	= Документы.big_Order_OKX.ПолучитьСсылку(UUID); 
		
		ОрдерОбъект = Ордер.ПолучитьОбъект();
		ОрдерОбъект.ordId 			= ordId;
		ОрдерОбъект.cTime13 		= ts;
		ОрдерОбъект.cTime10			= Лев(ts, 10);
		ОрдерОбъект.cTime			= Число(ОрдерОбъект.cTime10);
		ОрдерОбъект.cTimeDateTime 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ОрдерОбъект.cTime);
		ОрдерОбъект.Комментарий 	= "ts = " + ts + ", sMsg = " + sMsg;
		ОрдерОбъект.Статус			= Перечисления.big_СтатусыТорговыхОбъектов.Активный;
		ОрдерОбъект.Аккаунт			= Аккаунт;
		
		Попытка
			ОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение			
			Ордер_ЗаписатьДокументВРежимеЗаписи(ОрдерОбъект);					
		КонецПопытки;
		
	Иначе
		
		Шаблон = "ts = %1, tag = %2, sMsg = %3, sCode = %4, ordId = %5, clOrdId = %6";
		Информация = СтрШаблон(Шаблон, ts, tag, sMsg, sCode, ordId, clOrdId); 
		ЗаписьЖурналаРегистрации("OKX.PlaceOrder", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.big_Order_OKX,, Информация);
	КонецЕсли;
	     	
КонецПроцедуры

Функция Ордер_СоздатьДополнитьПоОтвету(OrderData, Аккаунт, ЗагрузкаИстории = Ложь) Экспорт

	clOrdId	= OrderData["clOrdId"];
	ordId	= OrderData["ordId"];
	
	Если ЗначениеЗаполнено(clOrdId) И СтрДлина(clOrdId) = 32 Тогда		
		UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(OrderData["clOrdId"]);
		Если ЗначениеЗаполнено(UUID) Тогда
			UUID	= Новый УникальныйИдентификатор(UUID);
			Ордер 	= Документы.big_Order_OKX.ПолучитьСсылку(UUID);
		Иначе
			Ордер 	= "Объект не найден";
		КонецЕсли;	
			 	
		Если СтрНайти(Ордер, "Объект не найден") <> 0 Тогда
	    	Ордер = Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Если Ордер = Неопределено И ЗначениеЗаполнено(ordId) Тогда
		Ордер	= Документы.big_Order_OKX.НайтиПоРеквизиту("ordId", ordId);
		Если НЕ ЗначениеЗаполнено(Ордер) Тогда
			Ордер = Неопределено;	
		КонецЕсли;
	КонецЕсли;
	
	Если Ордер = Неопределено Тогда
		
		ДокументОбъект 		= Документы.big_Order_OKX.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();		
	Иначе 	
		
		ДокументОбъект		= Ордер.ПолучитьОбъект();
	КонецЕсли;
		
	ПоляИсключения		= "algoClOrdId, uTime, attachAlgoOrds, linkedAlgoOrd";
	биг_ОбщегоНазначения.ЗаполнитьОбъектПоСоответствию(ДокументОбъект, OrderData, ПоляИсключения);
	Ордер_ЗаполнитьПоля(ДокументОбъект, OrderData);
	УстановитьВремяДокументаПоДаннымБиржи(ДокументОбъект, OrderData["cTime"]);
	
	ДокументОбъект.Аккаунт 		= Аккаунт; 
	ДокументОбъект.Стратегия 	= биг_СтратегииСервер.ОпределитьСтратегиюАккаунта(Аккаунт);
	Если ЗначениеЗаполнено(ДокументОбъект.Стратегия) Тогда
		ДокументОбъект.НастройкаСтратегии 	= биг_СтратегииСервер.ОпределитьНастройкуОперации(ДокументОбъект.Стратегия, Аккаунт, ДокументОбъект.instId);	
	КонецЕсли; 
	ДозаполнитьОрдерПоАлгоордеру(ДокументОбъект);
	
	
	linkedAlgoOrd = OrderData["linkedAlgoOrd"];
	ДокументОбъект.linkedAlgoOrd.Очистить();
	Для каждого Элемент Из linkedAlgoOrd Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			НС = ДокументОбъект.linkedAlgoOrd.Добавить();
			НС.algoId = Элемент.Значение;
		КонецЕсли;			
	КонецЦикла;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Если ЗагрузкаИстории Тогда                    
			МассивОпераций = Новый Массив();
			МассивОпераций.Добавить(ДокументОбъект.Ссылка);
			биг_СтратегииСервер.ЗафиксироватьОперацию(МассивОпераций);
		КонецЕсли;
	Исключение			
		Ордер_ЗаписатьДокументВРежимеЗаписи(ДокументОбъект);					
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции 

Процедура Ордер_ЗаписатьОтветОРазмещении(OrderData, Order)
	
	ts 		= OrderData["ts"];
	sMsg	= OrderData["sMsg"];
	ordId	= OrderData["ordId"];
	
	ОрдерОбъект = Order.ПолучитьОбъект();
	
	ОрдерОбъект.Комментарий	= sMsg;
	ОрдерОбъект.ordId		= ordId;                      
	
	ОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура Ордер_ЗаполнитьПоля(ДокументОбъект, OrderData)
		
	АпдейтТС						= OrderData["uTime"];
	СоздТС                          = OrderData["cTime"];
	
	ДокументОбъект.cTime13			= СоздТС;
	ДокументОбъект.cTime10			= Лев(СоздТС, 10);
	ДокументОбъект.cTime			= Число(ДокументОбъект.cTime10);
	ДокументОбъект.cTimeDateTime	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДокументОбъект.cTime);
	
	ДокументОбъект.uTime13			= АпдейтТС;
	ДокументОбъект.uTime10			= Лев(АпдейтТС, 10);
