#Область Ордер

Функция POST_PlaceOrder(ПараметрыОперацииБиржи, Аккаунт) Экспорт
		
	// создать JSON по структуре
	//JSON = Ордер_СформироватьСтруктуруЗапроса(Order);	
	
	// отправить документ
	Ответ = биг_ОКХАпиСервер.POST_PlaceOrders(ПараметрыОперацииБиржи, Аккаунт);
	
	Если Ответ["code"] <> "0" Тогда 
		
		Сообщить(Ответ["msg"]);
		
		data = Ответ["data"];
		Если data <> Неопределено Тогда
			
			Для каждого Соответствие Из data Цикл
				
				КодОшибки 		= Соответствие["sCode"];
				ТекстОшибки		= Соответствие["sMsg"];
				Идентификатор 	= Соответствие["clOrdId"];
				
				UUID 			= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(Соответствие["clOrdId"]);
				UUID			= Новый УникальныйИдентификатор(UUID);
				Ордер 			= Документы.big_Order_OKX.ПолучитьСсылку(UUID);
				АлгоОрдер		= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(UUID);
				
				ДокументОшибки	= ?(ЗначениеЗаполнено(Ордер), Ордер, АлгоОрдер);
				
				Шаблон 			= "Inner object: %1, error code: %2, error text: %3";
				ТекстОшибки		= СтрШаблон(Шаблон, ДокументОшибки, КодОшибки, ТекстОшибки);
				Сообщить(ТекстОшибки);
				
			КонецЦикла;
		КонецЕсли;		
		Результат = Ложь;
		
	Иначе
		
		data = Ответ["data"];		
		Для каждого OrderData Из data Цикл
			//после запуска WebSocket не нужно, вызывает конфликт. Инфа об ордере прилетит через вебсокет.
			//Ордер_Отправка_ЗафиксироватьОтвет(OrderData, Аккаунт);
			Ордер_Отправка_АктуализироватьАлгоОрдера(OrderData, Аккаунт);
		КонецЦикла;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

