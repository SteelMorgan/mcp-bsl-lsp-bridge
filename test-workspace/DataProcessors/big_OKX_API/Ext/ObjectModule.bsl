Функция АлгоОрдер_НайтиИдентификаторОсновногоОрдера(АлгоОрдер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Order_OKXattachAlgoOrds.Ссылка.ordId КАК ordId
	|ИЗ
	|	Документ.big_Order_OKX.attachAlgoOrds КАК big_Order_OKXattachAlgoOrds
	|ГДЕ
	|	big_Order_OKXattachAlgoOrds.AlgoOrder = &AlgoOrder";
	Запрос.УстановитьПараметр("AlgoOrder", АлгоОрдер);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ordId;
	       
КонецФункции

Процедура Ордер_Отправка_АктуализироватьАлгоОрдера(OrderData, Аккаунт)

	clOrdId = OrderData["clOrdId"];
	UUID 	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(OrderData["clOrdId"]);
	UUID	= Новый УникальныйИдентификатор(UUID);
