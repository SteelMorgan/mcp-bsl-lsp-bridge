Функция GET_PendingOrders(ПараметрыОперацииБиржи, Аккаунт) Экспорт
	
	Ответ = биг_ОКХАпиСервер.GET_PendingOrders(ПараметрыОперацииБиржи, Аккаунт);

	Если Ответ["code"] <> "0" Тогда 
		
		Сообщить(Ответ["msg"]);
		Результат = Ложь;
	Иначе
		
		data = Ответ["data"];
		
		Для каждого dataSet Из data Цикл
			Ордер_СоздатьДополнитьПоОтвету(dataSet, Аккаунт, Истина);		
		КонецЦикла;      
		
		ЗапуститьВосстановлениеПоследовательностиВФоне();
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция GET_OrdersHistory_7(ПараметрыОперацииБиржи, Аккаунт) Экспорт
						
	Ответ = биг_ОКХАпиСервер.GET_OrdersHistory_7(ПараметрыОперацииБиржи, Аккаунт);
	Количество = 0;
	
	Если Ответ["code"] <> "0" Тогда 
		
		Сообщить(Ответ["msg"]);
		Результат = Ложь;
	Иначе
		
		data = Ответ["data"];
		
		МинДата 	= ТекущаяДатаСеанса();
		МаксДата 	= Дата(1,1,1);
		
		Для каждого OrderData Из data Цикл
			
			ДатаОрдераТС 	= OrderData["cTime"];
			ДатаОрдера		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДатаОрдераТС);
			МинДата			= ?(ДатаОрдера < МинДата, ДатаОрдера, МинДата);
			МаксДата		= ?(ДатаОрдера > МаксДата, ДатаОрдера, МаксДата);
			
			Ордер_СоздатьДополнитьПоОтвету(OrderData, Аккаунт, Истина);
			Количество = Количество + 1;
		КонецЦикла;		
		
		ЗапуститьВосстановлениеПоследовательностиВФоне();
		
		Результат = Истина;
	КонецЕсли;             
	
	СтруктураОтвет = Новый Структура();
	СтруктураОтвет.Вставить("Результат", Результат);
	СтруктураОтвет.Вставить("МинДата", МинДата);
	СтруктураОтвет.Вставить("МаксДата", МаксДата);
	СтруктураОтвет.Вставить("Количество", Количество);
	
	
	Возврат СтруктураОтвет;
	
КонецФункции

