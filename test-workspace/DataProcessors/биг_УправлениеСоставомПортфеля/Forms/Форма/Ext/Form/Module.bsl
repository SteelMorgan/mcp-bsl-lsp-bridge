&НаСервере
Процедура ЗаполнитьПоТОПуМаркетКапыНаСервере(КоличествоПервыхИнструментов)
	
	// 1. Получаем универсальную структуру параметров
	ПараметрыЗапроса = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьТопИнструментов();
	ПараметрыЗапроса.Биржа = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("КоинГеко");
	ПараметрыЗапроса.ВалютаЦены = "usd"; // Получить цены в usd
	ПараметрыЗапроса.Лимит = КоличествоПервыхИнструментов; // Получить ТОП-XX
	ПараметрыЗапроса.Сортировка = "marcet_cap"; // Сортировать по маркет капе
	ПараметрыЗапроса.ПорядокСортировки = "desc"; // По убыванию

	// 2. Вызываем унифицированный метод
	ТаблицаТикеров = биг_МаркетАпи.ЗагрузитьТопИнструментов(ПараметрыЗапроса);

	Если ТаблицаТикеров <> Неопределено Тогда
		ТаблицаТикеров.Сортировать("РыночнаяКапитализация Убыв");
		
		ДополнитьТаблицуПоМаркетКапеИнструментамиБиржи(ТаблицаТикеров);
		
		Объект.Инструменты.Очистить();
		Объект.НастройкаАлгоОрдеров.Очистить();
		
		КоличествоДляПереноса = Мин(КоличествоПервыхИнструментов, ТаблицаТикеров.Количество());
		Сч = 0;
		
		Пока Сч < КоличествоДляПереноса Цикл
			
			Если ЗначениеЗаполнено(ТаблицаТикеров[Сч].Инструмент) Тогда
				НС = Объект.Инструменты.Добавить();
				НС.Инструмент 	= ТаблицаТикеров[Сч].Инструмент;
				НС.ИД			= Новый УникальныйИдентификатор;
				НС.РазмерПлеча	= Объект.РазмерПлеча;
				
				НСНастроек		= Объект.НастройкаАлгоОрдеров.Добавить();
				ЗаполнитьЗначенияСвойств(НСНастроек, НС);			
			КонецЕсли;
			
			Сч = Сч + 1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ДополнитьТаблицуПоМаркетКапеИнструментамиБиржи(ТаблицаТикеров)

	ТаблицаТикеров.Колонки.Добавить("Инструмент");
	МассивСтейблов = биг_ОбщегоНазначенияКлиентСервер.ПолучитьМассивЗначенийПоИмени("Стейблкоин");
	
	Для каждого Строка Из ТаблицаТикеров Цикл
		
		Монета = Справочники.big_Currencys.НайтиПоРеквизиту("ccy", Врег(Строка.Символ));
		Если МассивСтейблов.Найти(Монета) = Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	big_Instruments.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.big_Instruments КАК big_Instruments
			|ГДЕ
			|	(big_Instruments.baseCcy.ccy = &ccy
			|				И big_Instruments.quoteCcy.ccy ПОДОБНО ""USDT%""
			|			ИЛИ big_Instruments.settleCcy.ccy = &ccy
			|				И big_Instruments.ctValCcy.ccy ПОДОБНО ""USDT%"")
			|	И big_Instruments.instType = &instType";
			Запрос.УстановитьПараметр("ccy", 		Врег(Строка.Символ));
			Запрос.УстановитьПараметр("instType", 	Объект.ТипИнструмента);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда 			
				Строка.Инструмент = Выборка.Ссылка;	
			КонецЕсли;			
		КонецЕсли; 	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

