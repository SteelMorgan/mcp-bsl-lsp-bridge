 
 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Портфель", Объект.Портфель);
	Если ЗначениеЗаполнено(Объект.Портфель) Тогда
		ЗаполнитьДанныеИзПортфеля();
		ПроверитьВозможностьИзмененияПортфеля(Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.РежимПозиций) Тогда
		Объект.РежимПозиций = Перечисления.биг_OKX_PostionModes.net_mode;
	КонецЕсли;
	
	Если Объект.РазмерПлеча = 0 Тогда
		Объект.РазмерПлеча = 1;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьПоИнструментам();
	НастроитьВидимостьЭлементовНастройкиУровняМаржи();
	ТипИнструментаПриИзмененииНаСервере();
	УстановитьДоступностьПлеча();
	УстановитьДоступностьИнструментов();
	УстановитьДоступностьТаблицыАккаунты();
	УстановитьДоступностьРежимаПозиций();
	УстановитьВидимостьФлаговОперацийПоАккаунтам(); 
	РассчитатьДоступностьКнопкиСохранения();
	ПроверкаОткрытойСделки();
	НастройкаВидимостиТейковИОчистка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БиржаПриИзменении(Элемент)
	
	УстановитьДоступностьПоИнструментам();
	УстановитьДоступностьТаблицыАккаунты();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПоИнструментам()
	
	Элементы.ТипИнструмента.Доступность = ЗначениеЗаполнено(Объект.Биржа) И ЗначениеЗаполнено(Объект.Портфель);
	
КонецПроцедуры


&НаКлиенте
Процедура ТипИнструментаПриИзменении(Элемент)
	
	Объект.РазмерПлеча = 1;
	
	ОчиститьТаблицуИнструментов();
	ТипИнструментаПриИзмененииНаСервере();
	УстановитьДоступностьИнструментов();
	УстановитьДоступностьПлеча();
	НастроитьВидимостьЭлементовНастройкиУровняМаржи();
	УстановитьДоступностьРежимаПозиций();
	УстановитьВидимостьФлаговОперацийПоАккаунтам();
	РассчитатьДоступностьКнопкиСохранения();
	
	ТипВыбран = ЗначениеЗаполнено(Объект.ТипИнструмента);
	Элементы.Инструменты.Доступность = ТипВыбран;
	Элементы.РежимТорговли.Доступность = ТипВыбран;
	
	НастройкаВидимостиТейковИОчистка();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьФлаговОперацийПоАккаунтам()
	
	Элементы.ГруппаФлагиОперацийПоАккаунту.Видимость = Объект.ТипПортфеля <> ПредопределенноеЗначение("Перечисление.биг_ТипыПортфелей.Консалтинг");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьТаблицыАккаунты()
	
	Доступно = ЗначениеЗаполнено(Объект.Биржа) И ЗначениеЗаполнено(Объект.Портфель);
	Элементы.Аккаунты.Доступность = Доступно;
	
КонецПроцедуры

&НаСервере
Процедура ТипИнструментаПриИзмененииНаСервере()
	
	ДоступныеРежимы = биг_МаркетАпи.ПолучитьДоступныеРежимыТорговли(Объект.ТипИнструмента, Объект.Биржа);
	
	ЗаполнитьСписокВыбораРежимовТорговли(ДоступныеРежимы);
	ЗаполнитьДляВсехИнструментов();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимТорговлиПриИзменении(Элемент)
	
	УстановитьДоступностьПлеча();
	НастроитьВидимостьЭлементовНастройкиУровняМаржи();
	УстановитьДоступностьИнструментов();
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерПлечаПриИзменении(Элемент)
	ЗаполнитьМаржуВСтроках();
КонецПроцедуры

&НаКлиенте
Процедура РазмерПлечаПолзунокПриИзменении(Элемент)
	ЗаполнитьМаржуВСтроках();
КонецПроцедуры

&НаКлиенте
Процедура ИнструментыРазмерПлечаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Инструменты.ТекущиеДанные;
	ВыполнитьПроверкуМаржиВСтроке(ТекДанные); 
	
КонецПроцедуры

&НаКлиенте
Процедура ФлагАктуализацияАккаунтовПриИзменении(Элемент)
	РассчитатьДоступностьКнопкиСохранения();
КонецПроцедуры                             

&НаКлиенте
Процедура ФлагАктуализацииВидаМаржиПриИзменении(Элемент)
	РассчитатьДоступностьКнопкиСохранения();
КонецПроцедуры

&НаКлиенте
Процедура ФлагАктуализацииРежимаПозицийПриИзменении(Элемент)
	РассчитатьДоступностьКнопкиСохранения();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДоступностьКнопкиСохранения()
	
	Если Объект.ТипПортфеля = ПредопределенноеЗначение("Перечисление.биг_ТипыПортфелей.Консалтинг") Тогда
		КнопкаДоступна = Истина;
	Иначе
		КнопкаДоступна = ФлагАктуализацииВидаМаржи И ФлагАктуализацииРежимаПозиций И ФлагАктуализацииТипаИнструмента;	
	КонецЕсли;                                      
	
	Элементы.Сохранить.Доступность = КнопкаДоступна; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Инструменты

&НаКлиенте
Процедура ИнструментыИнструментНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	// показывать только те инструменты, у которых Lever >= Объект.РазмерПлеча
	ТекДанные = Элементы.Инструменты.ТекущиеДанные;	
	
	// пробросить фильтр по уровню Lever в форму выбора Инструмента	
	СтандартнаяОбработка 			= Ложь; 	
	Оповещение 						= Новый ОписаниеОповещения("ИнструментыИнструментЗавершениеВыбора", ЭтаФорма);
	
	НастройкиКомпоновкиДанных 		= Новый НастройкиКомпоновкиДанных;
	
	ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование 	= Истина;
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("lever");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение 	= Объект.РазмерПлеча;
	
	ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование 	= Истина;
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("instType");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= Объект.ТипИнструмента;
	
	ПараметрыОткрытия = Новый Структура("ФиксированныеНастройки", НастройкиКомпоновкиДанных);	
    
	ОткрытьФорму("Справочник.big_Instruments.Форма.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, ЭтаФорма.КлючУникальности,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнструментыИнструментЗавершениеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ТекДанные = Элементы.Инструменты.ТекущиеДанные;
		ТекДанные.Инструмент 	= Результат;
		ИнструментыИнструментПриИзменении(Неопределено);
	КонецЕсли; 
		
КонецПроцедуры

