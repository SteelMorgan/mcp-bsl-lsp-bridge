&НаСервере
Процедура ЗаполнитьТаблицуДетализацияСигнала(ДанныеСигнала)
			
	Если ЗначениеЗаполнено(ДанныеСигнала.ТочкаНачалаПадения) Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ТочкаНачалаПадения"; // точка экстремума
		НС.Значение 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДанныеСигнала.ТочкаНачалаПадения);
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;		
				
	Если ЗначениеЗаполнено(ДанныеСигнала.ТочкаРазворота) И ДанныеСигнала.ТочкаРазворота Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ТочкаРазворота";
		НС.Значение 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДанныеСигнала.ТочкаРазворота);
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ДанныеСигнала.ТочкаВхода1) Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ТочкаВхода1";
		НС.Значение 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДанныеСигнала.ТочкаВхода1);
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ДанныеСигнала.ТочкаВхода2) Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ТочкаВхода2";
		НС.Значение 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДанныеСигнала.ТочкаВхода2);
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДанныеСигнала.ТочкаСигналЗавершен) Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ТочкаСигналЗавершен";
		НС.Значение 		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ДанныеСигнала.ТочкаСигналЗавершен);
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСигнала.ПричинаОтмены) Тогда
		НС 					= ДетализацияСигнала.Добавить();
		НС.Точка 			= "ПричинаОтмены";
		НС.Значение 		= ДанныеСигнала.ПричинаОтмены;
		НС.Сигнал			= ДанныеСигнала.ТочкаНачалаПадения;
	КонецЕсли;		
	
	НС = ДетализацияСигнала.Добавить();
	НС.Точка 	= "СигналЗавершен";
	НС.Значение = ДанныеСигнала.СигналЗавершен;
	НС.Сигнал	= ДанныеСигнала.ТочкаНачалаПадения;
	
	НС = ДетализацияСигнала.Добавить();
	НС.Точка 	= "ЗавершеноПоложительно";
	НС.Значение = ДанныеСигнала.ЗавершеноПоложительно;
	НС.Сигнал	= ДанныеСигнала.ТочкаНачалаПадения;
     		
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоОперациям(ДанныеСигнала)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Аккаунт КАК Аккаунт,
	|	биг_ДаблИмпактОперации.Событие КАК Событие,
	|	биг_ДаблИмпактОперации.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения";
	
	Запрос.УстановитьПараметр("Биржа", 				ДанныеСигнала.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 		ДанныеСигнала.ИнструментИД);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ДанныеСигнала.ТочкаНачалаПадения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;	
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуОпераций(ДанныеСигнала)
	
	СостояниеСтратегии.Очистить();
	
	ВыборкаПоОперациям = ПолучитьДанныеПоОперациям(ДанныеСигнала);
	
	Пока ВыборкаПоОперациям.Следующий() Цикл
		
		НС = СостояниеСтратегии.Добавить();
		ЗаполнитьЗначенияСвойств(НС, ВыборкаПоОперациям);
		
	КонецЦикла;
	
