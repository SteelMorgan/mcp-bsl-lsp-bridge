&НаСервере
Процедура ДоделатьБектестыНаСервере(ТСТочкиЗавершения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактВременныеТочки.Биржа КАК Биржа,
	|	биг_ДаблИмпактВременныеТочки.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактВременныеТочки.Бар КАК Бар,
	|	биг_ДаблИмпактВременныеТочки.НастройкаСтратегии КАК НастройкаСтратегии,
	|	биг_ДаблИмпактВременныеТочки.ТочкаНаЛинииВремени КАК ТочкаОтсчетаТС,
	|	биг_ДаблИмпактВременныеТочки.Бар.SecondsAmount КАК ВеличинаБара,
	|	биг_ДаблИмпактВременныеТочки.ТочкаДатой КАК ТочкаДатой
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактВременныеТочки КАК биг_ДаблИмпактВременныеТочки
	|ГДЕ
	|	биг_ДаблИмпактВременныеТочки.ТочкаНаЛинииВремени < &ДатаЗавершения
	|	И биг_ДаблИмпактВременныеТочки.НастройкаСтратегии.Владелец = &Стратегия";
	
	Запрос.УстановитьПараметр("ДатаЗавершения", ТСТочкиЗавершения);
	Запрос.УстановитьПараметр("Стратегия", Стратегия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаБектестов.Очистить();
	ТекущаяДатаТС  		= ТСТочкиЗавершения;
	
	Пока Выборка.Следующий() Цикл
				
		Разница 			= ТекущаяДатаТС - Выборка.ТочкаОтсчетаТС;
		КоличествоИтераций 	= Цел(Разница / Выборка.ВеличинаБара);
		
		НаименованиеЗадания = "Бектест: " + Стратегия + ", " + Выборка.ИнструментИД + ", " + Выборка.НастройкаСтратегии;
		
		НовоеЗадание = ТаблицаБектестов.Добавить();
		НовоеЗадание.Биржа 						= Биржа;
		НовоеЗадание.ИнструментИД 				= Выборка.ИнструментИД;
		НовоеЗадание.Бар 						= Выборка.Бар;
		НовоеЗадание.КлючНастроек 				= Выборка.НастройкаСтратегии;
		НовоеЗадание.ТочкаОтсчетаТС 			= Выборка.ТочкаОтсчетаТС;
		НовоеЗадание.ТочкаОтсчета				= Выборка.ТочкаДатой;
		НовоеЗадание.КоличествоИтераций 		= КоличествоИтераций;
		НовоеЗадание.НаименованиеЗадания 		= НаименованиеЗадания; 
		
		// коды состояний:
		// 0 - ожидает
		// 1 - запущено
		// 2 - выполнено
		НовоеЗадание.Состояние = 0;
	КонецЦикла;
	
КонецПроцедуры

