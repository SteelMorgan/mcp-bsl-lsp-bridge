#Область Бектест

&НаКлиенте
Процедура ЭмуляцияШагВправоСместитьТочкуИОбработать()

	ТочкаОтсчета 	= ТочкаОтсчета + ВеличинаБара;		
	ТочкаОтсчетаТС	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаОтсчета);
		
	ПараметрыИнструмента = Новый Структура();
	ПараметрыИнструмента.Вставить("Биржа", 			Биржа);
	ПараметрыИнструмента.Вставить("ИнструментИД", 	ИнструментИД);
	ПараметрыИнструмента.Вставить("Бар", 			Бар);
	ПараметрыИнструмента.Вставить("КлючНастроек", 	КлючНастроек);
	
	ЗапускЭмуляцииНаСервере(ПараметрыИнструмента, ТочкаОтсчетаТС);
	
КонецПроцедуры

&наСервереБезКонтекста
Процедура ЗапускЭмуляцииНаСервере(ПараметрыИнструмента, ТочкаОтсчетаТС)
	
	биг_АлгоИмпакт.ПроверитьОперацииПоАктивнымСигналам(ТочкаОтсчетаТС, Истина, ПараметрыИнструмента.КлючНастроек, ПараметрыИнструмента.ИнструментИД, ПараметрыИнструмента.Биржа);
	биг_АлгоИмпакт.ОбработатьИнструмент(ПараметрыИнструмента, ТочкаОтсчетаТС, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗапуститьОчередьЗаданийБектеста(ОтТекущейТочки = Ложь)
	
	ИндикаторПрогрессаБектестаОбщий = 0;
	
	Если ОчередьЗаданийНеОтработана() Тогда
		Сообщить("Еще обрабатывается текущая очередь заданий");
		Возврат;
	КонецЕсли;	                                                                                                          
	ТаблицаБектестов.Очистить();
		
	ДобавитьЗаданияБектестов(ОтТекущейТочки);	
	
	ДатаНачалаБектеста = ТекущаяДата();
	ПодключитьОбработчикиОжиданий();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбработчикиОжиданий()

	// подключим обработку ожидания получения "отклика" на форму
	ПодключитьОбработчикОжидания("ОбработчикОжиданияИндикатор", 55);
	ПодключитьОбработчикОжидания("ОбработчикОжиданияУправлениеОчередьюЗаданий", 60);
	
	// вызовем обработчик сразу вручную, что бы не ожидать запуска первой пачки 60 секунд
	ОбработчикОжиданияУправлениеОчередьюЗаданий();
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьЗаданияБектестов(ОтТекущейТочки  = Ложь)
	
	//Для каждого ЭлементНастройка Из МассТест_СписокКлючей Цикл
	Для каждого ЭлементИнструмента Из МассТест_СписокИнструментИД Цикл
		
		ТекИнструментИД = ЭлементИнструмента.Значение;
		Если НЕ ЗначениеЗаполнено(ТекИнструментИД) Тогда
			Продолжить;
		КонецЕсли;
		
		//ТекКлючНастроек 	= ЭлементНастройка.Значение;			
		//Если НЕ ЗначениеЗаполнено(ТекКлючНастроек) Тогда
		//	Продолжить;
		//КонецЕсли;
		
		//Для каждого ЭлементИнструмента Из МассТест_СписокИнструментИД Цикл
		Для каждого ЭлементНастройка Из МассТест_СписокКлючей Цикл
		
			//ТекИнструментИД = ЭлементИнструмента.Значение;
			//Если НЕ ЗначениеЗаполнено(ТекИнструментИД) Тогда
			//	Продолжить;
			//КонецЕсли; 
			
			ТекКлючНастроек 	= ЭлементНастройка.Значение;			
			Если НЕ ЗначениеЗаполнено(ТекКлючНастроек) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ОтТекущейТочки Тогда
				ТочкаОтсчетаТС = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаОтсчета);
			Иначе
				ТочкаОтсчетаТС = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(Дата(2024,1,1));
			КонецЕсли;
			
			ТекущаяДатаТС  		= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(биг_ОбщегоНазначения.ТекущаяДатаНаСервере());
			
			Разница 			= ТекущаяДатаТС - ТочкаОтсчетаТС;
			КоличествоИтераций 	= Цел(Разница / ВеличинаБара);
			
			НаименованиеЗадания = "Бектест: " + ТекИнструментИД + ", " + ТекКлючНастроек;
			
			НовоеЗадание = ТаблицаБектестов.Добавить();
			НовоеЗадание.Биржа 						= Биржа;
			НовоеЗадание.ИнструментИД 				= ТекИнструментИД;
			НовоеЗадание.Бар 						= Бар;
			НовоеЗадание.КлючНастроек 				= ТекКлючНастроек;
			НовоеЗадание.ТочкаОтсчетаТС 			= ТочкаОтсчетаТС;
			НовоеЗадание.ТочкаОтсчета				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаОтсчетаТС);
			НовоеЗадание.КоличествоИтераций 		= КоличествоИтераций;
			НовоеЗадание.НаименованиеЗадания 		= НаименованиеЗадания; 
			
			// коды состояний:
			// 0 - ожидает
			// 1 - запущено
			// 2 - выполнено
			НовоеЗадание.Состояние = 0;
			
		КонецЦикла;
	КонецЦикла;
	
	Если ИсключаяВыполненныеТесты Тогда
		ОтфильтроватьНастройкиСВыполненнымТестом();	
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ЗапуститьБектестНаСервере(ПараметрыЗапуска, НаименованиеЗадания)
		
	ВыполняемыйМетод 		= "биг_АлгоИмпакт.ПровестиБекТестирование";
	
	ПараметрыВыполнения 	= ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина;
	//ПараметрыВыполнения.Вставить("ИдентификаторФормы", ЭтаФорма.ИдентификаторЗадания); 
	
	СтруктураФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗапуска, ПараметрыВыполнения);
	
	Возврат СтруктураФоновогоЗадания;
	
КонецФункции

&НаКлиенте 
Процедура ОбработчикОжиданияИндикатор() 
	
	ОтборВыполняются = Новый Структура("Состояние", 1);
	АктивныеЗадания = ТаблицаБектестов.НайтиСтроки(ОтборВыполняются);
	
	Для каждого Строка Из АктивныеЗадания Цикл 		
					
		Прогресс = ПрочитатьПрогресс(Строка.ИдентификаторЗадания);
		Если НЕ ТипЗнч(Прогресс) = Тип("Структура") Тогда
			
			Строка.Состояние = 2;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Прогресс) = Тип("Структура") 
			И (Прогресс.Свойство("ЗаданиеЗавершеноСОшибками") ИЛИ Прогресс.Свойство("ЗаданиеОтмененоПользователем")) Тогда
			
			Строка.Состояние = 2;
			Продолжить;
		КонецЕсли;
		
		Если Прогресс.Свойство("ЗаданиеВыполнено") И Прогресс.ЗаданиеВыполнено Тогда
			Строка.Прогресс			= 100;
			Строка.Состояние 		= 2;
		Иначе
			Если Прогресс.Свойство("Процент") Тогда
				Строка.Прогресс		= Прогресс.Процент;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла; 
	
	// средний прогресс
	РассчитатьСреднийПрогресс();
	
	ОтборВыполнено 	= Новый Структура("Состояние", 2);
	СтрокиВыполнено	= ТаблицаБектестов.НайтиСтроки(ОтборВыполнено);
	
	Если СтрокиВыполнено.Количество() = ТаблицаБектестов.Количество() Тогда
		
		// всё выполнено
		ОтключитьОбработчикОжидания("ОбработчикОжиданияИндикатор");
		ОбновитьДанныеМонитора();
	КонецЕсли;

	// оценить время до завершения операции
	ОценитьВремяДоОкончанияБектеста(СтрокиВыполнено);
	  
КонецПроцедуры

&НаКлиенте
Процедура ОценитьВремяДоОкончанияБектеста(СтрокиВыполнено)
	
	ТекТочка = ТекущаяДата();
	ТекДлительность = ТекТочка - ДатаНачалаБектеста;
	
	КоличествоВыполнено = СтрокиВыполнено.Количество();
	Если КоличествоВыполнено > 0 Тогда
		ВремениНаЗадание	= Окр(ТекДлительность / КоличествоВыполнено, 2);
		ОставшеесяВремяСек	= (ТаблицаБектестов.Количество() - КоличествоВыполнено) * ВремениНаЗадание;
		ОставшеесяВремяЧас	= Окр(ОставшеесяВремяСек/3600, 2);
		
		Элементы.НадписьОсталосьВремени.Заголовок = "До завершения операции: " + ОставшеесяВремяЧас + " часов"; 
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработчикОжиданияУправлениеОчередьюЗаданий()
	
	ОтборОжидающие 		= Новый Структура("Состояние", 0);
	ЗаданияВОчереди		= ТаблицаБектестов.НайтиСтроки(ОтборОжидающие);
	
