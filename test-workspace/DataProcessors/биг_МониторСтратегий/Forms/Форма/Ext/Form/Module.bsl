		ОтключитьОбработчикОжидания("ОбработчикОжиданияУправлениеОчередьюЗаданий");
		Возврат;
	КонецЕсли;
	
	
	ОтборВыполняются	= Новый Структура("Состояние", 1);
	ЗаданияВыполняются	= ТаблицаБектестов.НайтиСтроки(ОтборВыполняются);
	
	ЛимитЗаданий 		= 12; // TODO - может заюзать механизм определения количества потоков из модуля ДлительныеОперации?
	МожноЗапустить		= ЛимитЗаданий - ЗаданияВыполняются.Количество();
	КоличествоЗапустить	= Мин(МожноЗапустить, ЗаданияВОчереди.Количество());
	
	Если КоличествоЗапустить > 0 Тогда 
		
		Для ИНД = 0 По КоличествоЗапустить - 1 Цикл
			
			Задание = ЗаданияВОчереди[ИНД];
			
			ПараметрыИнструмента = Новый Структура();
