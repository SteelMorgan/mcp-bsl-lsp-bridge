&НаСервере
Процедура ОпределениеПериодаГрафика()

	// сигнал активен?
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	биг_ДаблИмпактСигналы.СигналЗавершен КАК СигналЗавершен
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	биг_ДаблИмпактСигналы.Биржа = &Биржа
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.Бар = &Бар
	|	И биг_ДаблИмпактСигналы.ТочкаНачалаПадения <= &ТочкаОтсчета
	|	И биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТочкаНачалаПадения УБЫВ";
	
	Если Не ЗначениеЗаполнено(ТочкаОтсчета) Тогда
		ТочкаОтсчета = ТекущаяДатаСеанса() - 10800;	
	КонецЕсли;
	ТочкаОтсчетаТС = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаОтсчета);
	
	Запрос.УстановитьПараметр("Биржа", 			Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 	ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 			Бар);
	Запрос.УстановитьПараметр("ТочкаОтсчета", 	ТочкаОтсчетаТС);
	Запрос.УстановитьПараметр("КлючНастроек", 	КлючНастроек);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		//Сигнал = Выборка.ТочкаНачалаПадения;	
		
		Если ЗначениеЗаполнено(Выборка.ТочкаНачалаПадения) И НЕ Выборка.СигналЗавершен Тогда      
			
			// сигнал активен - от точки сигнала влево 72 свечи, в право до текущего момента			
			ТаймСтампЛеваяСвеча 	= Выборка.ТочкаНачалаПадения - (Бар.SecondsAmount * 72);
			ТаймСтампПраваяСвеча	= ТочкаОтсчетаТС;
			
		Иначе
			
			// сигнал не активен, тогда 73 свечи включая последнюю	
			ТаймСтампПраваяСвеча	= ТочкаОтсчетаТС;
			ТаймСтампЛеваяСвеча		= биг_ОбщегоНазначения.НачалоПериодаПоБару(ТаймСтампПраваяСвеча, Бар) - (Бар.SecondsAmount * 73);
		КонецЕсли;
		
	Иначе
		
		ТаймСтампПраваяСвеча	= ТочкаОтсчетаТС;
		ТаймСтампЛеваяСвеча		= биг_ОбщегоНазначения.НачалоПериодаПоБару(ТаймСтампПраваяСвеча, Бар) - (Бар.SecondsAmount * 73);	
	КонецЕсли;
	      	     
	ТочкаНачала		= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТаймСтампЛеваяСвеча);
	ТочкаЗавершения	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТаймСтампПраваяСвеча);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораСигналов()
	
	Если ЗначениеЗаполнено(ТочкаЗавершения) Тогда
		
		ТаймСтамп = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
		
		// получить детали сигнала                    
		ПараметрыИнструмента = Новый Структура("Биржа, ИнструментИД, Бар, КлючНастроек", Биржа, ИнструментИД, Бар, КлючНастроек); 		
		МассивСигналов = биг_АлгоИмпакт.ПолучитьМассивАктивныхСигналов(ПараметрыИнструмента, ТаймСтамп, ТолькоАктуальные);
		
		СписокВыбора = Элементы.Сигнал.СписокВыбора;
		СписокВыбора.Очистить();
		
		ДетализацияСигнала.Очистить();
		Для каждого АктивныйСигнал Из МассивСигналов Цикл
			
			// это технический сигнал, его проустить
			Если НЕ ЗначениеЗаполнено(АктивныйСигнал.ТочкаНачалаПадения) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если (НЕ АктивныйСигнал.СигналЗавершен) И АктивныйСигнал.ТочкаНачалаПадения <= ТаймСтампПраваяСвеча Тогда
				
				ДобавитьСигналВТаблицу(СписокВыбора, АктивныйСигнал);
			Иначе
				
				Если АктивныйСигнал.ТочкаНачалаПадения <= ТаймСтампПраваяСвеча И АктивныйСигнал.ТочкаСигналЗавершен >= ТаймСтампЛеваяСвеча Тогда
						
					ДобавитьСигналВТаблицу(СписокВыбора, АктивныйСигнал);					
				КонецЕсли;	
			КонецЕсли;						
		КонецЦикла;
		
		// если несколько сигналов, то будет выводиться информация обо всех сразу
		// пока ручками не будет выбран один из сигналов (но потестив, кажется это лютая дрочь)
		ВсегоСигналов = СписокВыбора.Количество();
		
		//Если ВсегоСигналов > 1 Тогда
		//	Сигнал = 0;
		//КонецЕсли;
		
		Если ВсегоСигналов = 1 Тогда
			Сигнал = СписокВыбора[0].Значение;
		КонецЕсли;
			
	КонецЕсли;                           
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСигналВТаблицу(СписокВыбора, АктивныйСигнал)

	СписокВыбора.Добавить(АктивныйСигнал.ТочкаНачалаПадения, биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(АктивныйСигнал.ТочкаНачалаПадения));
	ЗаполнитьТаблицуДетализацияСигнала(АктивныйСигнал);
	
КонецПроцедуры

