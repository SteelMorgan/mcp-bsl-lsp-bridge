&НаСервереБезКонтекста
Функция НайтиКлючСтратегии(Стратегия, ИнструментИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ИнструментыСтратегийСрезПоследних.КлючНастройки КАК КлючНастройки
	|ИЗ
	|	РегистрСведений.биг_ИнструментыСтратегий.СрезПоследних(
	|			,
	|			Стратегия = &Стратегия
	|				И ИнструментИД = &ИнструментИД) КАК биг_ИнструментыСтратегийСрезПоследних";
	Запрос.УстановитьПараметр("Стратегия", Стратегия);
	Запрос.УстановитьПараметр("ИнструментИД", ИнструментИД);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КлючНастройки;
	
КонецФункции

