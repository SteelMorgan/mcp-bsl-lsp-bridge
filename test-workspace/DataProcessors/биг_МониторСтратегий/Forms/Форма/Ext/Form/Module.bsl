	Запрос.УстановитьПараметр("КлючНастроек", 		КлючНастроек);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НС = ТаблицаОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
	КонецЦикла;
	          
