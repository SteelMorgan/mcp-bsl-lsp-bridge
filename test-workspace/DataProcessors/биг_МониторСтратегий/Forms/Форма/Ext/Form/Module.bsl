	Если Результат <> Неопределено Тогда
		ТСТочкиЗавершения = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(Результат);
		ПеределатьБектестыНаСервере(ТСТочкиЗавершения);	
	КонецЕсли;		
	
	ДатаНачалаБектеста = ТекущаяДата();
	ПодключитьОбработчикиОжиданий();
	
КонецПроцедуры

#КонецОбласти //Бектест


#Область РаботаСДиаграммами

&НаСервере
Процедура ОбновитьДанныеДиаграммФормы()
	              
    ГрафикСвечи.Обновление 		= Ложь;
    ГрафикСвечи.Очистить(); 
	
	ГрафикОбъем.Обновление 		= Ложь;
    ГрафикОбъем.Очистить();
	
	ГрафикРСИ.Обновление 		= Ложь;
    ГрафикРСИ.Очистить(); 
	
	ГрафикЧайкина.Обновление	= Ложь;
	ГрафикЧайкина.Очистить();
	
	ГрафикАТР.Обновление		= Ложь;
	ГрафикАТР.Очистить();
	
	ГрафикЦенаЗакрытия.Обновление = Ложь;
	ГрафикЦенаЗакрытия.Очистить();
	    
	КурсМин 	= 9999999999;
	КурсМакс	= 0;
	
	RSIМин		= 0;
	RSIMax 		= 100;
	
	ЧайкинМакс	= 0;
	ЧайкинМин	= 9999999999;
	
	АТРМакс		= 0;
	АТРМин		= 9999999999;

	ЦенаМакс	= 0;
	ЦенаМин		= 9999999999;	
	
	ЗаполнениеТочекДиаграмм(КурсМин, КурсМакс, ЧайкинМакс, ЧайкинМин, АТРМакс, АТРМин, ЦенаМакс, ЦенаМин);	        
	ОбщиеНастройкиОформленияГрафиков(КурсМин, КурсМакс, ЧайкинМакс, ЧайкинМин, АТРМакс, АТРМин, RSIMax, RSIМин, ЦенаМакс, ЦенаМин);
	         	
	ГрафикСвечи.Обновление 			= Истина;
	ГрафикОбъем.Обновление 			= Истина;	
	ГрафикЧайкина.Обновление 		= Истина;
	ГрафикРСИ.Обновление 			= Истина;	
	ГрафикАТР.Обновление 			= Истина;
	ГрафикЦенаЗакрытия.Обновление	= Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТочекДиаграмм(КурсМин, КурсМакс, ЧайкинМакс, ЧайкинМин, АТРМакс, АТРМин, ЦенаМакс, ЦенаМин)
	                     	
    СерияСвечи 				= ГрафикСвечи.Серии.Добавить(ИнструментИД);
	СерияЦена				= ГрафикЦенаЗакрытия.Серии.Добавить("Цена");
	СерияЦенаКороткий		= ГрафикЦенаЗакрытия.Серии.Добавить("ЦенаМА_Короткий");
	СерияЦенаДлинный		= ГрафикЦенаЗакрытия.Серии.Добавить("ЦенаМА_Длинный");
	СерияОбъем 				= ГрафикОбъем.Серии.Добавить("Объем");
	СерияЧайкин             = ГрафикЧайкина.Серии.Добавить("Чайкин");
	СерияЧайкин_СМА         = ГрафикЧайкина.Серии.Добавить("Чайкин_СМА");
	СерияЧайкин_МА   		= ГрафикЧайкина.Серии.Добавить("Чайкин_МА");
	
	СерияЧайкин_ТВМакс 		= ГрафикЧайкина.Серии.Добавить("Чайкин_ТВМакс");
	СерияЧайкин_ТВМин  		= ГрафикЧайкина.Серии.Добавить("Чайкин_ТВМин");
	
	СерияРСИ          		= ГрафикРСИ.Серии.Добавить("РСИ");
	СерияРСИ_СМА            = ГрафикРСИ.Серии.Добавить("РСИ_СМА");
	СерияАТР                = ГрафикАТР.Серии.Добавить("АТР");
		
	ТаблицаСвечей = ПолучитьТаблицуСвечей();
	Если ТаблицаСвечей = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ОбщийОбъемПоГрафику = 0;
	КоличествоСвечей	= 0;
	
	СвечиНачалоПериода 		= Дата(3099, 1, 1);
	СвечиЗавершениеПериода	= Дата(1,1,1);
		
	Для каждого ВыборкаДанныхСвечей Из ТаблицаСвечей Цикл
		 		
		ЭтоКрасная				= биг_ОбщегоНазначения.ЭтоКраснаяСвеча(ВыборкаДанныхСвечей);		     	
		ФорматнаяСтрока 		= ПолучитьФорматнуюСтрокуГрафика(); 
		ДатаСвечи 				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ВыборкаДанныхСвечей.TimeStamp10);
		ИмяСвечи				= Формат(ДатаСвечи, ФорматнаяСтрока);
		
		ОбщийОбъемПоГрафику		= ОбщийОбъемПоГрафику + ВыборкаДанныхСвечей.volCcy;
		КоличествоСвечей		= КоличествоСвечей + 1;
		
		СвечиНачалоПериода		= Мин(СвечиНачалоПериода, ДатаСвечи);
		СвечиЗавершениеПериода	= Макс(СвечиЗавершениеПериода, ДатаСвечи);
				
		ТочкаОткрытия 			= ГрафикСвечи.УстановитьТочку(ИмяСвечи);
		Если ЭтоКрасная Тогда
			ТочкаОткрытия.ПриоритетЦвета	= Истина;
			ТочкаОткрытия.Цвет	= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
		КонецЕсли;
		
		ГрафикСвечи.УстановитьЗначение(ТочкаОткрытия, СерияСвечи, ВыборкаДанныхСвечей.ЦенаОткрытия);
		                                                            		
		ТочкаМакс 				= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_High");		
		ГрафикСвечи.УстановитьЗначение(ТочкаМакс, СерияСвечи, ВыборкаДанныхСвечей.ЦенаМаксимум);
		
		ТочкаМин 				= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_Low");		
		ГрафикСвечи.УстановитьЗначение(ТочкаМин, СерияСвечи, ВыборкаДанныхСвечей.ЦенаМинимум);
		
		ТочкаЗакрытия 			= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_Close");		
		ГрафикСвечи.УстановитьЗначение(ТочкаЗакрытия, СерияСвечи, ВыборкаДанныхСвечей.ЦенаЗакрытия);
				
		КурсМин 				= Мин(КурсМин, ВыборкаДанныхСвечей.ЦенаМинимум);
		КурсМакс				= Макс(КурсМакс, ВыборкаДанныхСвечей.ЦенаМаксимум);
		
		
		// ГРАФИК ЦЕНА
		ТочкаЦены = ГрафикЦенаЗакрытия.УстановитьТочку(ИмяСвечи);
		ГрафикЦенаЗакрытия.УстановитьЗначение(ТочкаЦены, СерияЦена, ВыборкаДанныхСвечей.ЦенаЗакрытия);
		ГрафикЦенаЗакрытия.УстановитьЗначение(ТочкаЦены, СерияЦенаКороткий, ВыборкаДанныхСвечей.Цена_МА_Короткий);
		ГрафикЦенаЗакрытия.УстановитьЗначение(ТочкаЦены, СерияЦенаДлинный, ВыборкаДанныхСвечей.Цена_МА_Длинный);
		ЦенаМакс = Макс(ЦенаМакс, ВыборкаДанныхСвечей.ЦенаЗакрытия, ВыборкаДанныхСвечей.Цена_МА_Короткий, ВыборкаДанныхСвечей.Цена_МА_Длинный);
		ЦенаМин	 = Мин(ЦенаМин, ВыборкаДанныхСвечей.ЦенаЗакрытия, ВыборкаДанныхСвечей.Цена_МА_Короткий, ВыборкаДанныхСвечей.Цена_МА_Длинный);
		
		
		// ГРАФИК ОБЪЕМ
		ТочкаОбъема = ГрафикОбъем.УстановитьТочку(ИмяСвечи);
		ГрафикОбъем.УстановитьЗначение(ТочкаОбъема, СерияОбъем, 	ВыборкаДанныхСвечей.volCcy);
				
		Если ЭтоКрасная Тогда
			ТочкаОбъема.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью(); 
			ТочкаОбъема.ПриоритетЦвета = Истина;
		КонецЕсли;
		
		
		// Чайкин
		ТочкаЧайкин = ГрафикЧайкина.УстановитьТочку(ИмяСвечи);
		ГрафикЧайкина.УстановитьЗначение(ТочкаЧайкин, СерияЧайкин, 			ВыборкаДанныхСвечей.Чайкин);
		ГрафикЧайкина.УстановитьЗначение(ТочкаЧайкин, СерияЧайкин_СМА, 		ВыборкаДанныхСвечей.Чайкин_СМА);
		ГрафикЧайкина.УстановитьЗначение(ТочкаЧайкин, СерияЧайкин_МА, 		ВыборкаДанныхСвечей.Чайкин_МА);		
		ГрафикЧайкина.УстановитьЗначение(ТочкаЧайкин, СерияЧайкин_ТВМакс, 	ВыборкаДанныхСвечей.Чайкин_ТВМакс);
		ГрафикЧайкина.УстановитьЗначение(ТочкаЧайкин, СерияЧайкин_ТВМин, 	ВыборкаДанныхСвечей.Чайкин_ТВМин);
		
		ЧайкинМакс  = Макс(ЧайкинМакс, ВыборкаДанныхСвечей.Чайкин, ВыборкаДанныхСвечей.Чайкин_СМА, ВыборкаДанныхСвечей.Чайкин_МА, ВыборкаДанныхСвечей.Чайкин_ТВМакс); 
		ЧайкинМин	= Мин(ЧайкинМин, ВыборкаДанныхСвечей.Чайкин, ВыборкаДанныхСвечей.Чайкин_СМА, ВыборкаДанныхСвечей.Чайкин_МА, ВыборкаДанныхСвечей.Чайкин_ТВМин); 
				
		// RSI 
		ТочкаРСИ 				= ГрафикРСИ.УстановитьТочку(ИмяСвечи);
		ТочкаРСИ.Цвет 			= биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();
		ТочкаРСИ.ПриоритетЦвета = Истина;
		ГрафикРСИ.УстановитьЗначение(ТочкаРСИ, СерияРСИ, ВыборкаДанныхСвечей.РСИ);
		ГрафикРСИ.УстановитьЗначение(ТочкаРСИ, СерияРСИ_СМА, ВыборкаДанныхСвечей.РСИ_СМА);
		
		
		// АТР
		ТочкаАТР = ГрафикАТР.УстановитьТочку(ИмяСвечи);
		ГрафикАТР.УстановитьЗначение(ТочкаАТР, СерияАТР, ВыборкаДанныхСвечей.АТР); 
		
		АТРМакс = Макс(АТРМакс, ВыборкаДанныхСвечей.АТР);
		АТРМин	= Мин(АТРМин, ВыборкаДанныхСвечей.АТР); 
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуСвечей()
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ПараметрыЗапроса.Биржа 			= Биржа;
	ПараметрыЗапроса.ИнструментИД	= ИнструментИД;
	ПараметрыЗапроса.Бар			= Бар;
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода       = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаНачала);
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
	
	Если НЕ ЗначениеЗаполнено(КлючНастроек) Тогда
		КлючДляИндикаторов = биг_СтратегииСервер.ПолучитьКлючСтратегииПоУмолчанию(Стратегия);
	Иначе
		КлючДляИндикаторов = КлючНастроек;
	КонецЕсли;
	
	ЗадачиРасчета = биг_УправлениеИндикаторамиСервер.ЗадачиРасчетаДляАлгоИмпакт(КлючДляИндикаторов);
	Возврат биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочкеСИндикаторами(ПараметрыЗапроса, ЗадачиРасчета, Истина);	
	
КонецФункции

&НаСервере
Процедура ОбщиеНастройкиОформленияГрафиков(КурсМин, КурсМакс, ЧайкинМакс, ЧайкинМин, АТРМакс, АТРМин, RSIMax, RSIМин, ЦенаМакс, ЦенаМин)
	
	// ГРАФИК СВЕЧИ 
	ШаговГрафика  	= 8;
	ДиапазонЦен		= КурсМакс - КурсМин;
	ЗначениеШага	= ОкруглитьГраницу(ДиапазонЦен / ШаговГрафика);
	
	// рассчитаем верх. планку
	ГраницаВерх = КурсМакс + ЗначениеШага;
	ГраницаНиз	= КурсМин - ЗначениеШага;
	
	Свечи_ОсьY 											= ГрафикСвечи.ОсьЗначений;
	Свечи_ОсьY.МинимальноеЗначение 						= ГраницаНиз;
	Свечи_ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	Свечи_ОсьY.МаксимальноеЗначение 					= ГраницаВерх;
	Свечи_ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
		
	// ГРАФИК ЦЕНА
	ДиапазонЦен											= ЦенаМакс - ЦенаМин;
	ЗначениеШага										= ОкруглитьГраницу(ДиапазонЦен / ШаговГрафика);
	ГраницаВерх 										= ЦенаМакс + ЗначениеШага;
	ГраницаНиз											= ЦенаМин - ЗначениеШага;
	
	Цена_ОсьY 											= ГрафикЦенаЗакрытия.ОсьЗначений;
	Цена_ОсьY.МинимальноеЗначение 						= ГраницаНиз;
	Цена_ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;	
	Цена_ОсьY.МаксимальноеЗначение 						= ГраницаВерх;
	Цена_ОсьY.СпособОпределенияМаксимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;

	Для каждого Серия Из ГрафикЦенаЗакрытия.Серии Цикл
		Если Серия.Текст = "Цена" Тогда 		
			Серия.Цвет 							= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();			
		ИначеЕсли Серия.Текст = "ЦенаМА_Короткий" Тогда		
			Серия.Цвет 							= биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();			
		ИначеЕсли Серия.Текст = "ЦенаМА_Длинный" Тогда			
			Серия.Цвет 							= биг_ОбщегоНазначенияКлиентСервер.ЦветОранжевыйВизуалСтудио();				
		КонецЕсли;
		
		Серия.Маркер						= ТипМаркераДиаграммы.Нет;
		Серия.ТипГрафическогоПредставления	= ТипГрафическогоПредставленияСерииДиаграммы.График;
		Серия.Линия							= Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	КонецЦикла;
		
	
	// ГРАФИК RSI	
	РСИ_ОсьY 											= ГрафикРСИ.ОсьЗначений;
	РСИ_ОсьY.МинимальноеЗначение 						= RSIМин;
	РСИ_ОсьY.СпособОпределенияМинимальногоЗначения 		= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;	
	РСИ_ОсьY.МаксимальноеЗначение 						= RSIMax;
	РСИ_ОсьY.СпособОпределенияМаксимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	
	Для каждого Серия Из ГрафикРСИ.Серии Цикл
		Если Серия.Текст = "РСИ" Тогда
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();			
		ИначеЕсли Серия.Текст = "РСИ_СМА" Тогда			
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();
		КонецЕсли;		
		Серия.Маркер	= ТипМаркераДиаграммы.Нет;
		//Серия.Линия		= Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	КонецЦикла;
	
	
	// ГРАФИК ЧАЙКИНА
	Для каждого Серия Из ГрафикЧайкина.Серии Цикл
		Если Серия.Текст = "Чайкин" Тогда
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();			
		ИначеЕсли Серия.Текст = "Чайкин_СМА" Тогда			
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();
		ИначеЕсли Серия.Текст = "Чайкин_МА" Тогда			
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветОранжевыйВизуалСтудио();			
		ИначеЕсли Серия.Текст = "Чайкин_ТВМакс" Тогда			
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветГолубойВизуалСтудио();
		ИначеЕсли Серия.Текст = "Чайкин_ТВМин" Тогда			
			Серия.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветГолубойВизуалСтудио();	
		КонецЕсли;
		
		Серия.Маркер	= ТипМаркераДиаграммы.Нет;
		//Серия.Линия		= Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	КонецЦикла;
	
	// ГРАФИК АТР
	ДиапазонЦен											= АТРМакс - АТРМин;
	ЗначениеШага										= ОкруглитьГраницу(ДиапазонЦен / ШаговГрафика);
	ГраницаВерх 										= ОкруглитьГраницу(АТРМакс + ЗначениеШага);
	ГраницаНиз											= ОкруглитьГраницу(АТРМин - ЗначениеШага);
	
	АТР_ОсьY 											= ГрафикАТР.ОсьЗначений;
	АТР_ОсьY.МинимальноеЗначение 						= ГраницаНиз;
	АТР_ОсьY.СпособОпределенияМинимальногоЗначения 		= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;	
	АТР_ОсьY.МаксимальноеЗначение 						= ГраницаВерх;
	АТР_ОсьY.СпособОпределенияМаксимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	
	//ГрафикАТР.Серии[0].Линия							= Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	
	// выравнивание левой границы графиков "в линию"
	ГрафикСвечи.ОбластьПостроения.Лево 			= 0.011;
	ГрафикОбъем.ОбластьПостроения.Лево 			= 0.014;
	ГрафикРСИ.ОбластьПостроения.Лево 			= 0.028;	
	ГрафикЧайкина.ОбластьПостроения.Лево		= 0.028;
	ГрафикАТР.ОбластьПостроения.Лево			= 0.028;
	ГрафикЦенаЗакрытия.ОбластьПостроения.Лево	= 0.028;
	
КонецПроцедуры

&НаСервере
Процедура ОформлениеИнтерваловГрафикаRSI()
	
	Если ГрафикРСИ.ИнформационныеИнтервалыЗначений.Количество() = 0 Тогда
		Интервал = ГрафикРСИ.ИнформационныеИнтервалыЗначений.Добавить();
		Интервал.Начало = 40;
		Интервал.Конец 	= 60;
		Интервал.Цвет 	= биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();
		Интервал.ПроцентПолупрозрачности = 90;
		Интервал.ТекстПодписи = "";

		ЛинияГраницы 			= Новый Линия(ТипЛинииДиаграммы.Пунктир, 2);
		Интервал.Граница		= ЛинияГраницы;
		Интервал.ЦветГраницы	= биг_ОбщегоНазначенияКлиентСервер.ЦветБелый();	
	КонецЕсли;

	Если ГрафикРСИ.ИнформационныеЛинииЗначений.Количество() = 0 Тогда
		ЛинияТочки 			= ГрафикРСИ.ИнформационныеЛинииЗначений.Добавить();
		ЛинияТочки.Значение = 50;
		ЛинияТочки.Линия	= Новый Линия(ТипЛинииДиаграммы.Пунктир, 2);	
		ЛинияТочки.Цвет		= биг_ОбщегоНазначенияКлиентСервер.ЦветБелый();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиВспомогательныеПометкиНаДиаграмму()

	ОчиститьКоллекциюИнформационныхЛиний(ГрафикСвечи.ИнформационныеЛинииТочек);
	ОчиститьКоллекциюИнформационныхЛиний(ГрафикСвечи.ИнформационныеЛинииЗначений);
		
	Если ДетализацияСигнала.Количество() > 0 Тогда
				
		Если ЗначениеЗаполнено(Сигнал) Тогда
			
			ВывестиВспомогательныеПометкиНаДиаграммуПоСигналу(Сигнал);
		Иначе
			
			Для каждого Строка Из Элементы.Сигнал.СписокВыбора Цикл
				ВывестиВспомогательныеПометкиНаДиаграммуПоСигналу(Строка.Значение, Ложь);	
			КонецЦикла;
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиВспомогательныеПометкиНаДиаграммуПоСигналу(ВыбранныйСигнал, ВыводитьПозиции = Истина)
	
	КоллекцияЛинийТочек 	= ГрафикСвечи.ИнформационныеЛинииТочек;
	КоллекцияЛинийЗначений	= ГрафикСвечи.ИнформационныеЛинииЗначений;
		
	ФорматнаяСтрока 		= ПолучитьФорматнуюСтрокуГрафика();
	Поиск 					= Новый Структура("Сигнал, Точка", ВыбранныйСигнал, Неопределено);
	ТаблицаДеталей 			= ДетализацияСигнала.Выгрузить();
	
	Точка 					= НайтиЗначениеТочки(ТаблицаДеталей, Поиск, "ТочкаНачалаПадения");
	Если ЗначениеЗаполнено(Точка) И ТочкаВПериодеГрафика(Точка) Тогда           		         
		Значение 			= Формат(Точка, ФорматнаяСтрока);			
		ТекстЛинии			= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ВыбранныйСигнал); //"НАЧАЛО ПАДЕНИЯ";                                          
		ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветОранжевыйВизуалСтудио();
		ТипЛинии 			= ТипЛинииДиаграммы.Пунктир;
		ДобавитьИнформационнуюЛинию(КоллекцияЛинийТочек, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);
	КонецЕсли;
	
	Точка 					= НайтиЗначениеТочки(ТаблицаДеталей, Поиск, "ТочкаРазворота");
	Если ЗначениеЗаполнено(Точка) И ТочкаВПериодеГрафика(Точка) Тогда
		Значение 			= Формат(Точка, ФорматнаяСтрока);         
		ТекстЛинии			= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ВыбранныйСигнал); //"РАЗВОРОТ";                                          
		ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветБелый();
		ТипЛинии 			= ТипЛинииДиаграммы.Пунктир;
		ДобавитьИнформационнуюЛинию(КоллекцияЛинийТочек, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);
	КонецЕсли;
	
	//ДАЛЬШЕ нужно отрисовывать позицию, как это выглядит на бирже (уровень входа, уровни SL & TP)
	Если ВыводитьПозиции Тогда
		ВывестиИнформациюПоСостояниюОрдеровСигнала(КоллекцияЛинийЗначений, Поиск);		
	КонецЕсли;		
	
	ТочкаПричинаОтмены 			= НайтиЗначениеТочки(ТаблицаДеталей, Поиск, "ПричинаОтмены");
	ТочкаЗавершенПоложительно 	= НайтиЗначениеТочки(ТаблицаДеталей, Поиск, "ЗавершеноПоложительно");
	ТочкаЗавершен 				= НайтиЗначениеТочки(ТаблицаДеталей, Поиск, "ТочкаСигналЗавершен");
	
	Если ЗначениеЗаполнено(ТочкаЗавершен) И ТочкаВПериодеГрафика(ТочкаЗавершен) Тогда
		Значение 		= Формат(ТочкаЗавершен, ФорматнаяСтрока);         
		ТекстЛинии		= "ЗАВЕРШЕН " + биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ВыбранныйСигнал);  
		
		Если ТочкаЗавершенПоложительно Тогда
			ЦветЛинии 	= биг_ОбщегоНазначенияКлиентСервер.ЦветЗеленыйТрейдингВью();
			Подсказка	= "";
		Иначе
			ЦветЛинии	= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
			Подсказка	= ТочкаПричинаОтмены; 
		КонецЕсли;
			
		ТипЛинии 		= ТипЛинииДиаграммы.Точечная;
		ДобавитьИнформационнуюЛинию(КоллекцияЛинийТочек, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 2, Подсказка);
	КонецЕсли;
	
	// текущая цена
	// пунктир
	// красный
	ТаймСтамп 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
	Структура 	= Новый Структура("ИнструментИД", ИнструментИД);
	ТекущаяЦена = биг_АлгоИмпакт.ПолучитьЦенуПоИсторическимДанным(Структура, Неопределено, ТаймСтамп);
	
	ТекстЛинии			= "";
	ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
	ТипЛинии 			= ТипЛинииДиаграммы.Пунктир;	
	ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, ТекущаяЦена, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);
	
КонецПроцедуры

&НаСервере
Функция НайтиЗначениеТочки(ТаблицаДеталей, Поиск, НазваниеТочки)
		
	Поиск.Точка = НазваниеТочки;
	МассивСтрок = ТаблицаДеталей.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат МассивСтрок[0].Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВывестиИнформациюПоСостояниюОрдеровСигнала(КоллекцияЛинийЗначений, Поиск)
	
	// точка = уровень цены
	
	// точка входа один и два
	// сумма BTC, Fee
	// зеленый
	ИнформацияОТочкеВходаОдин = ПолучитьИнформациюПоСостояниюОперации(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаОдин, Поиск);
	ВывестиИнформациюОТочкеВхода(КоллекцияЛинийЗначений, ИнформацияОТочкеВходаОдин);
		
	ИнформацияОТочкеВходаДва = ПолучитьИнформациюПоСостояниюОперации(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва, Поиск);
	ВывестиИнформациюОТочкеВхода(КоллекцияЛинийЗначений, ИнформацияОТочкеВходаДва);
	
	// стоп-лосс
	// объем BTC, PnL
	// красный
	ИнформацияОТочкеВыхода = ПолучитьИнформациюПоСостояниюОперации(Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс, Поиск);
	Если ИнформацияОТочкеВыхода <> Неопределено И ИнформацияОТочкеВыхода.Дата <= ТочкаЗавершения Тогда
		ВывестиИнформациюОТочкеВыхода(КоллекцияЛинийЗначений, ИнформацияОТочкеВыхода);
	Иначе
		
		ИнформацияОСтопЛосс = ПолучитьИнформациюПоСостояниюСтопЛоссСигнала(Поиск);
		ВывестиИнформациюОСтопЛосс(КоллекцияЛинийЗначений, ИнформацияОСтопЛосс, ИнформацияОТочкеВходаОдин, ИнформацияОТочкеВходаДва);	
	КонецЕсли;
	          
КонецПроцедуры

&НаСервере
Процедура ВывестиИнформациюОТочкеВхода(КоллекцияЛинийЗначений, ИнформацияОТочкеВхода)
	
	Если ИнформацияОТочкеВхода <> Неопределено И ИнформацияОТочкеВхода.Дата <= ТочкаЗавершения Тогда
	//Если ИнформацияОТочкеВхода <> Неопределено И ТочкаВПериодеГрафика(ИнформацияОТочкеВхода.Дата) Тогда
	
		Инструмент			= Справочники.big_Instruments.НайтиПоРеквизиту("instId", ИнформацияОТочкеВхода.Операция.instId);
		Значение 			= ИнформацияОТочкеВхода.Уровень;         
		
		// | BTC 2.0931 | Fee -67.15 USD |
		ШаблонНадписи		= " | = %1 = | %2 %3 | Fee %4 %5 |";
		ТекстЛинии			= СтрШаблон(ШаблонНадписи, ?(ИнформацияОТочкеВхода.Направление = Перечисления.big_OKX_OrderSides.buy, "LONG", "SHORT"), 
														ИнформацияОТочкеВхода.Монета, 
														ИнформацияОТочкеВхода.Размер * Инструмент.ctVal, 
														Окр(ИнформацияОТочкеВхода.Комиссия, 2), 
														ИнформацияОТочкеВхода.МонетаКомиссии);                                                                            

		ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветЗеленыйТрейдингВью();
		ТипЛинии 			= ТипЛинииДиаграммы.Сплошная;
		
		ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 2);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиИнформациюОТочкеВыхода(КоллекцияЛинийЗначений, ИнформацияОТочкеВыхода)
		
	Значение 			= ИнформацияОТочкеВыхода.Уровень;
	Инструмент			= Справочники.big_Instruments.НайтиПоРеквизиту("instId", ИнформацияОТочкеВыхода.Операция.instId);
	
	// | BTC 2.0931 | Fee -67.15 USD | PnL 2001.31 USD |
	ШаблонНадписи		= " | = SELL = |  %1 %2  |  Fee %3 %4  |  PnL %5 USD  |";
	ТекстЛинии			= СтрШаблон(ШаблонНадписи, ИнформацияОТочкеВыхода.Монета, ИнформацияОТочкеВыхода.Размер * Инструмент.ctVal, Окр(ИнформацияОТочкеВыхода.Комиссия, 2), ИнформацияОТочкеВыхода.МонетаКомиссии, Окр(ИнформацияОТочкеВыхода.ПрофитУбыток, 2));                                          
	ЦветЛинии			= ?(ИнформацияОТочкеВыхода.ПрофитУбыток > 0, биг_ОбщегоНазначенияКлиентСервер.ЦветЗеленыйТрейдингВью(), биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью()); 
	ТипЛинии 			= ТипЛинииДиаграммы.Сплошная;
	
	ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 3);
	
КонецПроцедуры 

&НаСервере
Процедура ВывестиИнформациюОСтопЛосс(КоллекцияЛинийЗначений, ИнформацияОСтопЛосс, ИнформацияОТочкеВходаОдин, ИнформацияОТочкеВходаДва)

	Если ИнформацияОСтопЛосс <> Неопределено И ИнформацияОСтопЛосс.Дата <= ТочкаЗавершения Тогда
	//Если ИнформацияОСтопЛосс <> Неопределено И ТочкаВПериодеГрафика(ИнформацияОСтопЛосс.Дата) Тогда
		
		ОбщийОбъем 			= ИнформацияОТочкеВходаОдин.Размер + ?(ИнформацияОТочкеВходаДва = Неопределено, 0, ИнформацияОТочкеВходаДва.Размер);
		ТекущиеЗатраты 		= биг_ОКХ_Сервер.ВычислитьПрофитУбытокСигналаПоордеруСигнала(ИнформацияОТочкеВходаОдин.Операция, Истина);	
		
		Инструмент			= Справочники.big_Instruments.НайтиПоРеквизиту("instId", ИнформацияОСтопЛосс.Операция.instId);
		СуммаПродажи 		= ОбщийОбъем * ИнформацияОСтопЛосс.Уровень * Инструмент.ctVal;				                             
		КомиссияСПродажи 	= Окр(СуммаПродажи / 100 * 0.005 *-1, 2);
		
		Если ИнформацияОСтопЛосс.posSide = Перечисления.big_OKX_PositionSides.long Тогда
			СуммаПродажи 	= СуммаПродажи *-1;			
		КонецЕсли;
		
		ПрофитУбыток		= Окр(СуммаПродажи + ТекущиеЗатраты + КомиссияСПродажи, 2);
		Значение 			= ИнформацияОСтопЛосс.Уровень;         
			
		// | BTC 2.0931 | Fee -67.15 USD | PnL 2001.31 USD | 
		
		//ШаблонНадписи		= " | = SL = | %1 %2  |  Fee %3 %4  |  PnL %5 USD  |";
		//ТекстЛинии			= СтрШаблон(ШаблонНадписи, ИнформацияОТочкеВходаОдин.Монета, ОбщийОбъем, КомиссияСПродажи, ИнформацияОТочкеВходаОдин.МонетаКомиссии, ПрофитУбыток); 
		
		ШаблонНадписи		= " | SL | %1 %2  |  PnL %3 USD  |";
		ТекстЛинии			= СтрШаблон(ШаблонНадписи, ИнформацияОТочкеВходаОдин.Монета, ОбщийОбъем * Инструмент.ctVal, ПрофитУбыток);
		
		//ЦветЛинии			= ?(ПрофитУбыток > 0, биг_ОбщегоНазначенияКлиентСервер.ЦветЗеленыйТрейдингВью(), биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью());
		ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
		ТипЛинии 			= ТипЛинииДиаграммы.Сплошная;
		
		ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, Значение, ТекстЛинии, ЦветЛинии, ТипЛинии, 2);
	КонецЕсли;
	
КонецПроцедуры
          
&НаСервере
Функция ПолучитьИнформациюПоСостояниюОперации(Событие, Поиск)
	
	// TODO - это тоже нужно делать через модуль "МаркетАпи", что бы было универсально
	// т.е. модуль определяет по запросу какая биржа (по аккаунту) и соответствующий модуль вызывает
	// сама конечная функция должна быть в модуле биржи, т.к. у каждой биржи свои доки и их структура
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Операция КАК Операция,
	|	биг_ДаблИмпактОперации.Операция.fillSz КАК Размер,
	|	биг_ДаблИмпактОперации.Операция.fillPx КАК Уровень,
	|	"""" КАК Монета,
	|	биг_ДаблИмпактОперации.Операция.fee КАК Комиссия,
	|	биг_ДаблИмпактОперации.Операция.feeCcy КАК МонетаКомиссии,
	|	биг_ДаблИмпактОперации.Операция.Дата КАК Дата,
	|	биг_ДаблИмпактОперации.Операция.pnl КАК ПрофитУбыток,
	|	биг_ДаблИмпактОперации.Операция.side КАК Направление
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И биг_ДаблИмпактОперации.Событие = &Событие
	|	И (ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_Order_OKX)) <> ЗНАЧЕНИЕ(Документ.big_Order_OKX.ПустаяСсылка)
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &КлючНастройки";
	
