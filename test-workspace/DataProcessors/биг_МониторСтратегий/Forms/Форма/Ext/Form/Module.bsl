			ПараметрыИнструмента.Вставить("КоличествоИтераций", 		Задание.КоличествоИтераций);
			ПараметрыИнструмента.Вставить("НаименованиеЗадания",		Задание.НаименованиеЗадания);
			ПараметрыИнструмента.Вставить("ФиксироватьДлительность",	Истина);
			
