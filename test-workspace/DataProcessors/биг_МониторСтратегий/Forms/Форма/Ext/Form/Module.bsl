&НаСервере
Процедура ВернутьЭмуляциюКТочкеЗавершениеНаСервере(Результат)

	ТочкаВозвратаДата = Результат;
	ТочкаВозвратаТС 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаВозвратаДата);
	
	// TODO: процедуры перенесены в модуль биг_ДаблИмпакт
	
	//константа "момента времени" по стратегии
	//Константы.биг_ДаблИмпактTimePoint.Установить(ТочкаВозвратаТС);
	ЗаписатьТочкуНаЛинииВремени(ТочкаВозвратаТС);
	
	//удалить сигналы старше даты
	УдалитьСигналыПослеТочки(ТочкаВозвратаТС);
	
	СтеретьЗафиксированныеОперации(ТочкаВозвратаТС);
	             	
	//установить точку в форму
	ТочкаОтсчета = ТочкаВозвратаДата;
	
	//вызвать обновление формы
	ОбновитьДанныеМонитора();
	
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьСигналыПослеТочки(ТочкаВозвратаТС)
	
	Набор	= РегистрыСведений.биг_ДаблИмпактСигналы.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(Биржа);
	Набор.Отбор.ИнструментИД.Установить(ИнструментИД);
	Набор.Отбор.Бар.Установить(Бар);
	Набор.Отбор.КлючНастроек.Установить(КлючНастроек);
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив;
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			МассивУдалить.Добавить(Строка);	
		КонецЕсли;
	КонецЦикла;                            
	
	Для каждого Строка Из МассивУдалить Цикл
		Набор.Удалить(Строка);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры

&НаСервере
Процедура СтеретьЗафиксированныеОперации(ТочкаВозвратаТС)
	
	Набор = РегистрыСведений.биг_ДаблИмпактОперации.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(Биржа);
	Набор.Отбор.ИнструментИД.Установить(ИнструментИД);
	Набор.Отбор.Аккаунт.Установить(Аккаунт); 
	Набор.Отбор.НастройкаСтратегии.Установить(КлючНастроек);
	
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив();
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			
			Операция = Строка.Операция;
			КлючНастройкиОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "НастройкаСтратегии");
			
			Если КлючНастройкиОперации = КлючНастроек Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;				
		КонецЕсли;	
	КонецЦикла;                      
	
	Для каждого СтрокаНабора Из МассивУдалить Цикл
		ДокументОбъект = СтрокаНабора.Операция.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		
		УдалитьИсториюЗначенийДокумента(СтрокаНабора.Операция, ТочкаВозвратаТС);
		
		ДокументОбъект.Удалить();
		
		Набор.Удалить(СтрокаНабора);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры


&НаСервере
Процедура ЗаписатьТочкуНаЛинииВремени(ТочкаОтсчетаТС)
	
	Менеджер = РегистрыСведений.биг_ДаблИмпактВременныеТочки.СоздатьМенеджерЗаписи();
	Менеджер.Биржа 					= Биржа;
	Менеджер.ИнструментИД 			= ИнструментИД;
	Менеджер.Бар					= Бар;
	Менеджер.НастройкаСтратегии     = КлючНастроек;
	
	Менеджер.ТочкаНаЛинииВремени	= ТочкаОтсчетаТС;
	Менеджер.ТочкаДатой				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаОтсчетаТС);
	
	Менеджер.Записать(Истина);
	
КонецПроцедуры

