&наСервереБезКонтекста
Функция ПрочитатьПрогресс(Знач ИдентификаторФоновогоЗадания) Экспорт
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФоновогоЗадания);
	
	Если Задание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// используем БСП
	ПрогрессЗадания = ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторФоновогоЗадания);
	
	Если ПрогрессЗадания = Неопределено
	 Или ТипЗнч(ПрогрессЗадания) <> Тип("Структура") Тогда 
		ПрогрессЗадания = Новый Структура;
	КонецЕсли;
	ПрогрессЗадания.Вставить("ЗаданиеВыполнено", ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторФоновогоЗадания));
	
	Возврат ПрогрессЗадания;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСреднийПрогресс()
	
	СуммаПрогресс = 0;
	
	Для каждого Строка Из ТаблицаБектестов Цикл
		СуммаПрогресс = СуммаПрогресс + ?(Строка.Состояние = 2, 100, Строка.Прогресс);	
	КонецЦикла;                                         
	
	Если ТаблицаБектестов.Количество() > 0 Тогда
		ИндикаторПрогрессаБектестаОбщий = СуммаПрогресс / ТаблицаБектестов.Количество();
	Иначе
		ИндикаторПрогрессаБектестаОбщий = 0;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ОчередьЗаданийНеОтработана()
	
	КоличествоЗаданий = ТаблицаБектестов.Количество();
	ВыполненныеЗадания	= ТаблицаБектестов.НайтиСтроки(Новый Структура("Состояние", 2)); 
	
	Если КоличествоЗаданий = 0 Тогда
		
		// очередь пустая
		Возврат Ложь;
		
	Иначе
		
		Если ВыполненныеЗадания.Количество() < КоличествоЗаданий Тогда
			
			// еще не всё выполнено
			Возврат Истина;	
		Иначе
			
			// все задания выполнены
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли; 
	
КонецФункции

