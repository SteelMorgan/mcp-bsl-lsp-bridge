&НаКлиенте
Процедура УстановитьЗначенияАвтоматическихСтопТейк(СторонаОрдера)
	
	Если ИспользоватьАвтоТейкСтоп Тогда
		
		Если РежимАвтоСтопТейк = ПредопределенноеЗначение("Перечисление.биг_РежимыАвтоСтопТейк.ПерваяОперацияСделки") И (НЕ ЗначениеЗаполнено(Сделка) ИЛИ СделкаЗавершена(Сделка)) Тогда
			
			УстановитьЗначениеТейкСтоп(СторонаОрдера);
		ИначеЕсли РежимАвтоСтопТейк = ПредопределенноеЗначение("Перечисление.биг_РежимыАвтоСтопТейк.КаждуюОперациюСделки") Тогда
			
			УстановитьЗначениеТейкСтоп(СторонаОрдера);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры                           

&НаКлиенте
Процедура УстановитьЗначениеТейкСтоп(СторонаОрдера)
	
	РежимПозицияПортфеля = РежимПозицийПортфеляНаСервере();
	Если РежимПозицияПортфеля = ПредопределенноеЗначение("Перечисление.биг_OKX_PostionModes.long_short_mode") Тогда
		СторонаПозиции = ?(СторонаОрдера = ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.buy"), ПредопределенноеЗначение("Перечисление.big_OKX_PositionSides.long"), ПредопределенноеЗначение("Перечисление.big_OKX_PositionSides.short"));
	Иначе
		СторонаПозиции = ПредопределенноеЗначение("Перечисление.big_OKX_PositionSides.net");	
	КонецЕсли;
	
	Если СторонаПозиции = ПредопределенноеЗначение("Перечисление.big_OKX_PositionSides.short") Тогда
		Множитель = -1;
	Иначе
		Множитель = 1;
	КонецЕсли;
	
	// стопы
	Если ВариантАвтоСтоп = ПредопределенноеЗначение("Перечисление.биг_ВариантыНастройкиПравилСтопТейк.Процентом") Тогда
		
		СЛ_Триггер 	= ПоследняяСвеча_ЗначениеЗакрытия / 100 * (100 - (ПравилоАвтоСтопЛосс * Множитель));
		СЛ_Цена		= Окр(СЛ_Триггер * 0.999, 2);
		
	ИначеЕсли ВариантАвтоСтоп = ПредопределенноеЗначение("Перечисление.биг_ВариантыНастройкиПравилСтопТейк.Суммой") Тогда 
		
		СЛ_Триггер 	= ПоследняяСвеча_ЗначениеЗакрытия - (ПравилоАвтоСтопЛосс * Множитель);
		СЛ_Цена		= Окр(СЛ_Триггер * 0.999, 2);	
	КонецЕсли;
	
	// тейки
	Если ВариантАвтоТейк = ПредопределенноеЗначение("Перечисление.биг_ВариантыНастройкиПравилСтопТейк.Процентом") Тогда
		
		ТП_Триггер 	= ПоследняяСвеча_ЗначениеЗакрытия / 100 * (100 + (ПравилоАвтоТейкПрофит * Множитель));
		ТП_Цена		= Окр(ТП_Триггер * 0.999, 2);
		
	ИначеЕсли ВариантАвтоТейк = ПредопределенноеЗначение("Перечисление.биг_ВариантыНастройкиПравилСтопТейк.Суммой") Тогда 
		
		ТП_Триггер 	= ПоследняяСвеча_ЗначениеЗакрытия - (ПравилоАвтоТейкПрофит * Множитель);
		ТП_Цена		= Окр(ТП_Триггер * 0.999, 2);	
	КонецЕсли;

	// Округлим под ТикСайз
	Тик	= биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(ВыбранныйИнструмент, "tickSz");
	
	Если Тик > 0 Тогда
		СЛ_Триггер = биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(СЛ_Триггер, 	Тик);
		СЛ_Цена    = биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(СЛ_Цена, 		Тик);
		ТП_Триггер = биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(ТП_Триггер, 	Тик);
		ТП_Цена    = биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(ТП_Цена, 		Тик);	
	КонецЕсли; 
	
КонецПроцедуры

