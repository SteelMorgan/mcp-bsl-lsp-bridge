&НаСервере
Функция НайтиЗначениеТочки(ТаблицаДеталей, Поиск, НазваниеТочки)
		
	Поиск.Точка = НазваниеТочки;
	МассивСтрок = ТаблицаДеталей.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат МассивСтрок[0].Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ТочкаВПериодеГрафика(ДатаТочки)
	
	Возврат СвечиНачалоПериода <= ДатаТочки И ДатаТочки <= СвечиЗавершениеПериода;
	
КонецФункции

&НаСервере
Процедура ДобавитьИнформационнуюЛинию(КоллекцияЛиний, ЗначениеТочки, ТекстЛинии, ЦветЛинии, ТипЛинии, ТолщинаЛинии = 5, Подсказка = "")
	
	ЛинияТочки = КоллекцияЛиний.Добавить();
	
	Если ТипЗнч(ЗначениеТочки) = Тип("Строка") Тогда
		ТочкаДиаграммы = ГрафикСвечи.УстановитьТочку(ЗначениеТочки);
		ЛинияТочки.Значение = ТочкаДиаграммы;
		ЛинияТочки.ОбластьПодписи.Ориентация 	= ОриентацияПодписейДиаграммы.Вертикально;
	Иначе
		Если ЗначениеЗаполнено(ЗначениеТочки) Тогда
			ЛинияТочки.Значение = ЗначениеТочки;
			ЛинияТочки.ОбластьПодписи.Ориентация 	= ОриентацияПодписейДиаграммы.Горизонтально;
		КонецЕсли;
			
	КонецЕсли;
	
	//ЛинияТочки = ГрафикСвечи.ИнформационныеЛинииТочек.Добавить();
	  
	ЛинияТочки.Подсказка					= Подсказка;
	ЛинияТочки.ТекстПодписи 				= ТекстЛинии;
	
	ЛинияТочки.Линия						= Новый Линия(ТипЛинии, ТолщинаЛинии);
	
	ЛинияТочки.Цвет							= ЦветЛинии;
	ЛинияТочки.ОбластьПодписи.ЦветТекста 	= ЦветЛинии; 
	
	ЛинияТочки.Положение					= ПоложениеИнформационнойЛинииДиаграммы.ВЗначении;
	ЛинияТочки.ПроцентПолупрозрачности		= 0;
	                                       
