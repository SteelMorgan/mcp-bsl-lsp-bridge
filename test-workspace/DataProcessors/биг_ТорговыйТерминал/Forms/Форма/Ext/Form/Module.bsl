   
   
   

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеФормыПоУмолчанию();
	ПрочитатьСохраненныеНастройки();
	ЗаполнитьФорму();
	             
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// что бы отработали обработчики по полям после загрузки портфеля из сохраненных настроек
	Если ЗначениеЗаполнено(Портфель) Тогда
		
		ТекДанные 		= Элементы.ТаблицаИнструментов.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Инструмент = ТекДанные.Инструмент;
		Иначе
			Инструмент = Неопределено;
		КонецЕсли;
		
		ПортфельПриИзмененииНаСервере(Инструмент);
	    ОбработатьВыборИнструмента();
		УстановитьВидимостьИзмененияПлеча();
		УстановитьВидимостьСделокПозиций();
		ОбновлениеИнформацииОБалансе();
		ПодключитьОбработчикОжидания("КонтрольРезультатаОперации", 1);
		ПодключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях", 1);
		ПодключитьОбработчикОжидания("ОбновлениеИнформацииОбОрдерах", 1);
		ПодключитьОбработчикОжидания("ОбновлениеИнформацииОБалансе", 30);
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбновлениеТекущейЦены", 30);
	ПодключитьОбработчикПоследнейСвечи();
	НастроитьОтображениеЭлементов();
	НастроитьВидимостьКоманд();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СохранитьКлючевыеНастройки();
КонецПроцедуры


#КонецОбласти //ОбработчикиСобытийФормы


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоляДепоПроцентПриИзменении(Элемент)
	
	ОкруглитьЦенуДляТикСайз();
	
	Если ОперацияВыполнимаДляКаждогоАккаунта() Тогда 
		Сторона = ?(ВШорт, ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.sell"), ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.buy"));
		УстановитьЗначенияАвтоматическихСтопТейк(Сторона);		
	КонецЕсли;	 
	
КонецПроцедуры

&НаКлиенте
Процедура ДоляДепоЧисломПриИзменении(Элемент)
	
	ОкруглитьЦенуДляТикСайз();
	
	Если ОперацияВыполнимаДляКаждогоАккаунта() Тогда 
		Сторона = ?(ВШорт, ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.sell"), ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.buy"));
		УстановитьЗначенияАвтоматическихСтопТейк(Сторона);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтообновлениеПриИзменении(Элемент)
	
	Если Автообновление И НаГрафикеНеподтвержденнаяСвеча Тогда
		ОбработчикОбновленияНезавершеннойСвечи();
		ПодключитьОбработчикОжидания("ОбработчикОбновленияНезавершеннойСвечи", 60);
	Иначе
		ОтключитьОбработчикОжидания("ОбработчикОбновленияНезавершеннойСвечи");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БарПриИзменении(Элемент)
	
	ВеличинаБара = ПолучитьВеличинуБараНаСервере(Бар);
	ОбновитьДанныеМонитора();                                 
	ПодключитьОбработчикПоследнейСвечи();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательСЛ_ТППриИзменении(Элемент)
	
	УстановитьОформлениеПолейСтопЛоссТейкПрофит();
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьЗакрытиеСделкиПриИзменении(Элемент)
	
	Элементы.ЗакрытьСделку.Доступность = РазрешитьЗакрытиеСделки;
	
КонецПроцедуры

&НаСервере
Процедура ПортфельПриИзмененииНаСервере(Инструмент)
	
	ЗаполнитьТаблицуИнструментов();	
	ЗаполнитьТаблицуОпераций();	
	ЗаполнитьТаблицуПозиций();
	ЗаполнитьТаблицыУниверсальныхОрдеров();
	
	ПортфельУказан 	= ЗначениеЗаполнено(Портфель);
	Если ПортфельУказан Тогда
		ЗагрузитьТорговыеНастройки(Инструмент);		
	КонецЕсли;
	
	УстановитьДоступностьТорговыхНастроек(ПортфельУказан);	
	НастроитьИспользованиеАлгоОрдеров();
	
КонецПроцедуры

&НаКлиенте
Процедура ПортфельПриИзменении(Элемент)
	
	ОчиститьФорму();
	ТекДанные 		= Элементы.ТаблицаИнструментов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Инструмент = Неопределено;
	Иначе
		Инструмент = ТекДанные.Инструмент;
	КонецЕсли;
	ПортфельПриИзмененииНаСервере(Инструмент);              

	ОбработатьВыборИнструмента();
	УстановитьВидимостьИзмененияПлеча();
	УстановитьВидимостьСделокПозиций();
	
	ПодключитьОбработчикОжидания("КонтрольРезультатаОперации", 1);	
	ПодключитьОбработчикОжидания("ОбновлениеИнформацииОБалансе", 30);
	
КонецПроцедуры

&НаКлиенте
Процедура БиржаПриИзменении(Элемент)
	ЗаполнитьИзбранныеИнструменты();
КонецПроцедуры

&НаКлиенте
Процедура ТипИнструментовПриИзменении(Элемент)
	ЗаполнитьИзбранныеИнструменты();
	НастроитьВидимостьКоманд();
КонецПроцедуры

&НаКлиенте
Процедура ТипОрдераПриИзменении(Элемент)
	
	Если ТипОрдера = ПредопределенноеЗначение("Перечисление.big_OKX_OrderTypes.market") Тогда
		
		Элементы.ЦенаСделки.Видимость 			= Ложь;
		Элементы.ЦенаСделкиНадпись.Видимость 	= Истина;
		ЦенаСделкиНадпись 						= "Разместить по рыночной цене";
		ЦенаСделки								= 0;
		
	Иначе
		
		Элементы.ЦенаСделки.Видимость 			= Истина;
		Элементы.ЦенаСделкиНадпись.Видимость 	= Ложь;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти //ОбработчикиСобытийЭлементовШапкиФормы


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГрафикВлево(Команда)
	ОтключитьОбработчикОжидания("ОбработчикОбновленияНезавершеннойСвечи");
	ГрафикВлевоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ГрафикВправо(Команда)
	ОтключитьОбработчикОжидания("ОбработчикОбновленияНезавершеннойСвечи");
	ГрафикВправоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФокусНаТочку(Команда)
	
	Оповещение 		= Новый ОписаниеОповещения("ФокусНаТочкуЗавершение", ЭтаФорма);
	ТочкаФокуса		= Дата(2024, 1, 1, 0, 0, 0);
	ПоказатьВводДаты(Оповещение, ТочкаФокуса, "Укажите дату фокусировки графика", Частидаты.ДатаВремя);
	
КонецПроцедуры

&НаСервере
Процедура ГрафикВлевоНаСервере()
	
	ТаймСтампЛеваяСвеча		= ТаймСтампЛеваяСвеча - Бар.SecondsAmount;	
	ТаймСтампПраваяСвеча	= ТаймСтампПраваяСвеча - Бар.SecondsAmount;	
	
	ПересчитатьЗависимыеТочкиОбновитьМонитор();
	
КонецПроцедуры

&НаСервере
Процедура ГрафикВправоНаСервере()

	ТаймСтампЛеваяСвеча		= ТаймСтампЛеваяСвеча + Бар.SecondsAmount;	
	ТаймСтампПраваяСвеча	= ТаймСтампПраваяСвеча + Бар.SecondsAmount;	
	
	ПересчитатьЗависимыеТочкиОбновитьМонитор();
	
КонецПроцедуры

&НаКлиенте
Процедура ФокусНаТочкуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ОтключитьОбработчикОжидания("ОбработчикОбновленияНезавершеннойСвечи");
		
		РазмерБара = ПолучитьВеличинуБараНаСервере(Бар);
		ТочкаОтсчета = Результат + (РазмерБара * 40);
		
		ОбновитьДанныеМонитора();
		ПодключитьОбработчикПоследнейСвечи();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Купить(Команда) 
	
	СформироватьОперациюПокупкиПродажи(ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.buy"));		
	
КонецПроцедуры

&НаКлиенте
Процедура Продать(Команда)
	
	СформироватьОперациюПокупкиПродажи(ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.sell"));
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОперациюПокупкиПродажи(СторонаОрдера)
	
	Если ЗначениеЗаполнено(Сделка) И СделкаЗавершена(Сделка) Тогда
		ТаблицаПозиций.Очистить();
		Сделка = Неопределено;
	КонецЕсли;
	
	Если ОперацияВыполнимаДляКаждогоАккаунта() Тогда		
		УстановитьЗначенияАвтоматическихСтопТейк(СторонаОрдера);
		
		Если СформироватьОперациюНаСервере(СторонаОрдера) Тогда
			ПодключитьОбработчикОжидания("КонтрольРезультатаОперации", 1);
			ПодключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях", 1);
			ПодключитьОбработчикОжидания("ОбновлениеИнформацииОбОрдерах", 1);
			ДоляДепоДляОперации = 0;
			ЗаблокироватьКомандыОпераций();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьОперациюНаСервере(СторонаОрдера)
	
	Успешно = Ложь;
	НачатьТранзакцию();
	
	Попытка
		СформироватьОбъектыОперации(СторонаОрдера);
		ЗафиксироватьТранзакцию();
		Успешно = Истина;
	Исключение
		
		Ошибка = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ТорговыйТерминал.ОперацияКупитьПродать", УровеньЖурналаРегистрации.Ошибка,,, Ошибка);
		Сообщить(Ошибка);
		
		Сделка = Неопределено;
	КонецПопытки;
	
	Возврат Успешно;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьСделку(Команда)
	
	Если ЗакрытьСделкуНаСервере() Тогда
		ПодключитьОбработчикОжидания("КонтрольРезультатаОперации", 1);
		ПодключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях", 1);
		ПодключитьОбработчикОжидания("ОбновлениеИнформацииОбОрдерах", 1);
		РазрешитьЗакрытиеСделки = Ложь;
		ЗаблокироватьКомандыОпераций();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗакрытьСделкуНаСервере()

	Успешно = Ложь;
	НачатьТранзакцию();
	
	Попытка
		СформироватьОбъектыЗакрытияСделки();
		ЗафиксироватьТранзакцию();
		Успешно = Истина;
	Исключение
		
		Ошибка = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ТорговыйТерминал.ОперацияЗакрытьСделку", УровеньЖурналаРегистрации.Ошибка,,, Ошибка);
		Сообщить(Ошибка);
	КонецПопытки;
	
	Возврат Успешно;
	
КонецФункции

#КонецОбласти //ОбработчикиКомандФормы


#Область ОбработчикиСобытийТаблицыИнструменты

&НаКлиенте
Процедура СброситьФлагАктивностиИнструмента()
	
	ИдентификаторТС = Элементы.ТаблицаИнструментов.ТекущаяСтрока;
	
	Для каждого Строка Из ТаблицаИнструментов Цикл
		Идентификатор = Строка.ПолучитьИдентификатор();
		
		Если Идентификатор = ИдентификаторТС Тогда
			Строка.Активный = 2;
		Иначе
			Строка.Активный = 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИнструментовИзбранноеНажатиеНаСервере(текИнструмент, текПлечо, текИзбранное)
	
	// Записать изменение в регистр избранных инструментов
	Если текИзбранное Тогда
		РегистрыСведений.биг_ИзбранныеИнструменты.УдалитьИзбранныйИнструмент(текИнструмент, текПлечо);
	Иначе
		РегистрыСведений.биг_ИзбранныеИнструменты.ДобавитьИзбранныйИнструмент(текИнструмент, текПлечо);
	КонецЕсли;	                                                                             
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнструментовИнструментПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаИнструментов.ТекущиеДанные;
	ТекДанные.Активный = 1; // пустая картинка
	ТекДанные.Избранное = ПолучитьСтатусИзбранногоНаСервере(ТекДанные.Инструмент);
	
	Если ЗначениеЗаполнено(Портфель) Тогда
		ЗагрузитьТорговыеНастройки(ТекДанные.Инструмент);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнструментовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле.Имя = "ТаблицаИнструментовИзбранное" Тогда
		ОбработатьКликПоИзбранному(Элемент);
	Иначе
		ОбработатьВыборИнструмента();
	КонецЕсли;
	    
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборИнструмента()
	                
	СброситьФлагАктивностиИнструмента();
	
	ТекДан 				= Элементы.ТаблицаИнструментов.ТекущиеДанные;
	ВыбранныйИнструмент = ТекДан.Инструмент; 
	Плечо				= ТекДан.РазмерПлеча;
	
	ТаблицаИнструментовИнструментОбработкаВыбораНаСервере(ТекДан.Инструмент);
	ОбновлениеИнформацииОБалансе();
	ОбновлениеИнформацииОПозициях();
	ОбновлениеИнформацииОбОрдерах();
	СброситьТриггерыИДолю();
	УстановитьОформлениеПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьТриггерыИДолю()
	
	ДоляДепоДляОперации = 0;
	СЛ_Триггер          = 0;
	СЛ_Цена             = 0;
	ТП_Триггер          = 0;
	ТП_Цена             = 0;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИнструментовИнструментОбработкаВыбораНаСервере(Инструмент)
     
	ИнструментИД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Инструмент, "instId");
		
	ОбновитьДанныеМонитора();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнструментовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Элемент.ТекущиеДанные.Активный = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКликПоИзбранному(Элемент)

	// для тек строки установить обратное значение
	// 2 - в избранном, желтая звезда
	// 0 - пустая звезда ()
	
	текИнструмент 	= Элемент.ТекущиеДанные.Инструмент;
	текИзбранное	= ?(Элемент.ТекущиеДанные.Избранное = 2, Истина, Ложь);
	текПлечо		= Элемент.ТекущиеДанные.РазмерПлеча;
	       
	ТаблицаИнструментовИзбранноеНажатиеНаСервере(текИнструмент, текПлечо, текИзбранное);
	Элемент.ТекущиеДанные.Избранное = ?(Элемент.ТекущиеДанные.Избранное = 2, 0, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнструментовПередУдалением(Элемент, Отказ)
	
	Если ЗначениеЗаполнено(Портфель) Тогда
		Отказ = Истина;
		Сообщить("Выбран портфель. Для изменения состава инструментов (торговых пар) - измените настройки портфеля");
		Возврат;
	КонецЕсли;
	
	текИнструмент 	= Элемент.ТекущиеДанные.Инструмент;
	текИзбранное	= ?(Элемент.ТекущиеДанные.Избранное = 2, Истина, Ложь);
	текПлечо		= Элемент.ТекущиеДанные.РазмерПлеча;
	
	Если текИзбранное Тогда
		ТаблицаИнструментовИзбранноеНажатиеНаСервере(текИнструмент, текПлечо, текИзбранное);	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти //ОбработчикиСобытийТаблицыИнструменты


#Область РаботаСДиаграммами

&НаСервере
Процедура ОбновитьДанныеДиаграммФормы()
	              
    ГрафикСвечи.Обновление 	= Ложь;
    ГрафикСвечи.Очистить(); 
	
	ГрафикОбъем.Обновление 	= Ложь;
    ГрафикОбъем.Очистить();
	
	ГрафикРСИ.Обновление 	= Ложь;
    ГрафикРСИ.Очистить();
	    
	КурсМин 	= 9999999999;
	КурсМакс	= 0;
	RSIМин		= 100;
	RSIMax 		= 0;
	ЗаполнениеТочекДиаграмм(КурсМин, КурсМакс, RSIМин, RSIMax);
	        
	ОбщиеНастройкиОформленияГрафиков(КурсМин, КурсМакс, RSIМин, RSIMax);
	         	
	ГрафикСвечи.Обновление 	= Истина;
	ГрафикОбъем.Обновление 	= Истина;
	ГрафикРСИ.Обновление 	= Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТочекДиаграмм(КурсМин, КурсМакс, RSIМин, RSIMax)
	                     	
    СерияКурс 			= ГрафикСвечи.Серии.Добавить(ИнструментИД);	
	СерияОбъем 			= ГрафикОбъем.Серии.Добавить("Объем");
	СерияОбъемМА		= ГрафикОбъем.Серии.Добавить("ОбъемМА");
	СерияРСИ			= ГрафикРСИ.Серии.Добавить("RSI");
	
	ТаблицаСвечей = ПолучитьТаблицуСвечей();
	Если ТаблицаСвечей = Неопределено Тогда
		
		//TO DO: Реализовать вызов загрузки 100 свечей текущео инструмента
		Возврат;
	КонецЕсли;  
	
	ОбщийОбъемПоГрафику = 0;
	КоличествоСвечей	= 0;
	
	СвечиНачалоПериода 		= Дата(3099, 1, 1);
	СвечиЗавершениеПериода	= Дата(1,1,1);
	
	// КОСТЫЛЬ. Почему то не нет в данных инфы о неподтвержденной свече (текущая свеча)
	//НаГрафикеНеподтвержденнаяСвеча = Ложь;
	НаГрафикеНеподтвержденнаяСвеча = Истина;
	
	Для каждого ВыборкаДанныхСвечей Из ТаблицаСвечей Цикл
		
		Если НЕ ВыборкаДанныхСвечей.Confirm Тогда
			НаГрафикеНеподтвержденнаяСвеча = Истина;			
		КонецЕсли;
		
		ЭтоКрасная				= биг_ОбщегоНазначения.ЭтоКраснаяСвеча(ВыборкаДанныхСвечей);		     	
		ФорматнаяСтрока 		= "ДФ='HH:mm dd/MM'"; 
		ДатаСвечи 				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ВыборкаДанныхСвечей.TimeStamp10);
		ИмяСвечи				= Формат(ДатаСвечи, ФорматнаяСтрока);
		
		ОбщийОбъемПоГрафику		= ОбщийОбъемПоГрафику + ВыборкаДанныхСвечей.volCcy;
		КоличествоСвечей		= КоличествоСвечей + 1;
		КурсМин 				= Мин(КурсМин, ВыборкаДанныхСвечей.ЦенаМинимум);
		КурсМакс				= Макс(КурсМакс, ВыборкаДанныхСвечей.ЦенаМаксимум);
		СвечиНачалоПериода		= Мин(СвечиНачалоПериода, ДатаСвечи);
		СвечиЗавершениеПериода	= Макс(СвечиЗавершениеПериода, ДатаСвечи);
		
		
		ТочкаОткрытия 			= ГрафикСвечи.УстановитьТочку(ИмяСвечи);
		Если ЭтоКрасная Тогда
			ТочкаОткрытия.ПриоритетЦвета	= Истина;
			ТочкаОткрытия.Цвет	= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
		КонецЕсли;
		
		ГрафикСвечи.УстановитьЗначение(ТочкаОткрытия, СерияКурс, ВыборкаДанныхСвечей.ЦенаОткрытия);
		                                                            		
		ТочкаМакс 						= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_High");
		ГрафикСвечи.УстановитьЗначение(ТочкаМакс, СерияКурс, ВыборкаДанныхСвечей.ЦенаМаксимум);
		ПоследняяСвеча_ЗначениеМакс		= ВыборкаДанныхСвечей.ЦенаМаксимум;
		
		ТочкаМин 						= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_Low");
		ГрафикСвечи.УстановитьЗначение(ТочкаМин, СерияКурс, ВыборкаДанныхСвечей.ЦенаМинимум);
		ПоследняяСвеча_ЗначениеМин		= ВыборкаДанныхСвечей.ЦенаМинимум;
		
		ТочкаЗакрытия 					= ГрафикСвечи.УстановитьТочку(ИмяСвечи + "_Close");
		ГрафикСвечи.УстановитьЗначение(ТочкаЗакрытия, СерияКурс, ВыборкаДанныхСвечей.ЦенаЗакрытия);
		ПоследняяСвеча_ЗначениеЗакрытия	= ВыборкаДанныхСвечей.ЦенаЗакрытия;
		
		ПоследняяСвеча_Имя 				= ИмяСвечи;
		
		
		// Объем
		ТочкаОбъема = ГрафикОбъем.УстановитьТочку(ИмяСвечи);
		ГрафикОбъем.УстановитьЗначение(ТочкаОбъема, СерияОбъем, 	ВыборкаДанныхСвечей.volCcy);
		ГрафикОбъем.УстановитьЗначение(ТочкаОбъема, СерияОбъемМА, 	ВыборкаДанныхСвечей.Объем_МА);
		
		// TODO: вставить еще одну серию
		
		Если ЭтоКрасная Тогда
			ТочкаОбъема.Цвет = биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью(); 
			ТочкаОбъема.ПриоритетЦвета = Истина;
		КонецЕсли;
		
		// RSI 
		RSIМин = Мин(RSIМин, ВыборкаДанныхСвечей.РСИ);
		
		ТочкаРСИ 				= ГрафикРСИ.УстановитьТочку(ИмяСвечи);
		ТочкаРСИ.Цвет 			= биг_ОбщегоНазначенияКлиентСервер.ЦветСинийТрейдингВью();
		ТочкаРСИ.ПриоритетЦвета = Истина;
		ГрафикРСИ.УстановитьЗначение(ТочкаРСИ, СерияРСИ, ВыборкаДанныхСвечей.РСИ);
					
	КонецЦикла;	
    	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуСвечей()
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ПараметрыЗапроса.Биржа 			= Биржа;
	ПараметрыЗапроса.ИнструментИД	= ИнструментИД;
	ПараметрыЗапроса.Бар			= Бар;
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода       = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаНачала);
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
	
	ЗадачиРасчета = биг_УправлениеИндикаторамиСервер.ЗадачиРасчетаДляТорговогоТерминала();
	Возврат биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочкеСИндикаторами(ПараметрыЗапроса, ЗадачиРасчета, Истина);
	
КонецФункции

&НаСервере
Процедура ОбщиеНастройкиОформленияГрафиков(КурсМин, КурсМакс, RSIМин, RSIMax)
	
	// ГРАФИК СВЕЧИ 
	ШаговГрафика  	= 8;
	ДиапазонЦен		= КурсМакс - КурсМин;
	ЗначениеШага	= ОкруглитьГраницу(ДиапазонЦен / ШаговГрафика);
	
	// рассчитаем верх. планку
	ГраницаВерх = КурсМакс + ЗначениеШага;
	ГраницаНиз	= КурсМин - ЗначениеШага;
	
	//ГраницаНиз 	= КурсМин - (КурсМин / 100 * ОтсутпЦены);
	//ГраницаВерх	= КурсМакс + (КурсМакс / 100 * ОтступЦены); 
	
	ОсьY 										= ГрафикСвечи.ОсьЗначений;
	ОсьY.МинимальноеЗначение 					= ГраницаНиз;
	ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	ОсьY.МаксимальноеЗначение 					= ГраницаВерх;
	ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	
	// ГРАФИК ОБЪЕМ
	ГрафикОбъем.Серии[1].ТипГрафическогоПредставления 	= ТипГрафическогоПредставленияСерииДиаграммы.График;
	//ГрафикОбъем.Серии[1].Линия.Толщина 					= 2;
	ГрафикОбъем.Серии[1].Цвет							= биг_ОбщегоНазначенияКлиентСервер.ЦветОранжевыйВизуалСтудио();
	ГрафикОбъем.Серии[1].Маркер 						= ТипМаркераДиаграммы.Круг;
	
	
	// ГРАФИК RSI
	Если RSIМин > 20 Тогда
		RSIМин = 20;
	ИначеЕсли RSIМин > 10 Тогда
		RSIМин = 10;
	Иначе
		RSIМин = 0;	
	КонецЕсли;
	
	Если RSIMax > 90 Тогда
		RSIMax = 100;
	ИначеЕсли RSIMax > 80 Тогда
		RSIMax = 90;
	Иначе
		RSIMax = 80;
	КонецЕсли;
	
	ОсьY 										= ГрафикРСИ.ОсьЗначений;
	ОсьY.МинимальноеЗначение 					= RSIМин;
	ОсьY.СпособОпределенияМинимальногоЗначения 	= СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;
	
	ОсьY.МаксимальноеЗначение 					= RSIMax;
	ОсьY.СпособОпределенияМаксимальногоЗначения = СпособОпределенияОграничивающегоЗначенияДиаграммы.ИспользоватьЗначение;

	// выравнивание левой границы графиков "в линию"
	ГрафикСвечи.ОбластьПостроения.Лево 	= 0.011;
	ГрафикОбъем.ОбластьПостроения.Лево 	= 0.014;
	ГрафикРСИ.ОбластьПостроения.Лево 	= 0.028;	
	
КонецПроцедуры

