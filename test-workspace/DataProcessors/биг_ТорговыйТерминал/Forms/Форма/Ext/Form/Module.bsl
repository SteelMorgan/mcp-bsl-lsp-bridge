&НаСервереБезКонтекста
Функция ПолучитьСтатусИзбранногоНаСервере(Инструмент)
	
	ЭтоИзбранное = РегистрыСведений.биг_ИзбранныеИнструменты.ПолучитьСтатусИзбранногоИнструмента(Инструмент);
	Если ЭтоИзбранное Тогда
		Возврат 2;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПрочитатьСохраненныеНастройки()
	
	КлючОбъекта 	= "ФормаТорговогоТерминала";
	КлючНастроек 	= "ОсновныеНастройки";
	ИмяПользователя	= Строка(ПараметрыСеанса.АвторизованныйПользователь);
	
	Настройки = ХранилищеНастроекДанныхФорм.Загрузить(КлючОбъекта, КлючНастроек,, ИмяПользователя);

	Если ЗначениеЗаполнено(Настройки) Тогда
		Биржа				= Настройки.Биржа; 
		ТипИнструментов		= Настройки.ТипИнструментов;
		Бар					= Настройки.Бар;
		ВидМаржи			= Настройки.ВидМаржи;
		Плечо				= Настройки.Плечо;
		ТипОрдера			= Настройки.ТипОрдера;
		ПереключательСЛ_ТП	= Настройки.ПереключательСЛ_ТП; 
		Портфель			= Настройки.Портфель;	
	КонецЕсли;
	    	
КонецПроцедуры

&НаСервере
Процедура СохранитьКлючевыеНастройки()
	
	Настройки = ПолучитьСтруктуруНастроек();
	
	Настройки.Биржа           		= Биржа;
	Настройки.ТипИнструментов 		= ТипИнструментов;
	Настройки.Бар             		= Бар;
	Настройки.ВидМаржи        		= ВидМаржи;
	Настройки.Плечо           		= Плечо;
	Настройки.ТипОрдера       		= ТипОрдера;
	Настройки.ПереключательСЛ_ТП 	= ПереключательСЛ_ТП;
	Настройки.Портфель        		= Портфель;
	
	КлючОбъекта 	= "ФормаТорговогоТерминала";
	КлючНастроек 	= "ОсновныеНастройки";
	ИмяПользователя	= Строка(ПараметрыСеанса.АвторизованныйПользователь);
	
	ХранилищеНастроекДанныхФорм.Сохранить(КлючОбъекта, КлючНастроек, Настройки,, ИмяПользователя); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруНастроек()
	
	Возврат Новый Структура("Биржа, ТипИнструментов, Бар, ВидМаржи, Плечо, ТипОрдера, ПереключательСЛ_ТП, Портфель");
	
КонецФункции

&НаКлиенте
Процедура ПлечоПриИзменении(Элемент)
	УстановитьТекущееПлечоИнструмента();
КонецПроцедуры

&НаКлиенте
Процедура ПлечоПолзунокПриИзменении(Элемент)
	УстановитьТекущееПлечоИнструмента();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущееПлечоИнструмента()
	
	ТекДанные = Элементы.ТаблицаИнструментов.ТекущиеДанные;
	ТекДанные.РазмерПлеча = Плечо;
	
	// странный выверт получился. Что бы сохранить избранное нужно Ложь передать
	// процедура была изначально для другого события
	ТаблицаИнструментовИзбранноеНажатиеНаСервере(ТекДанные.Инструмент, Плечо, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФорму()
	
	Биржа					= Неопределено;
	ТипИнструментов         = Неопределено;	
	ВидМаржи                = Неопределено;
	Плечо                   = Неопределено;
	ТаблицаИнструментов.Очистить();
	ТаблицаОпераций.Очистить();
	ТаблицаПозиций.Очистить();
	ТаблицаОткрытыхАлгоОрдеров.Очистить();
	ТаблицаОткрытыхОрдеров.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИнструментов()
	
	Если ЗначениеЗаполнено(Портфель) Тогда		
		ТаблицаИнструментов.Загрузить(Портфель.Инструменты.Выгрузить());
		
		Для каждого Строка Из ТаблицаИнструментов Цикл
			Строка.Активный = 1;
		КонецЦикла;
		
		УстановитьАктивностьПервогоИнструмента();
	Иначе		
		ЗаполнитьИзбранныеИнструменты();		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьАктивностьПервогоИнструмента()
	
	Если ТаблицаИнструментов.Количество() > 0 Тогда
		Элементы.ТаблицаИнструментов.ТекущаяСтрока = ТаблицаИнструментов[0].ПолучитьИдентификатор();
		
		ВыбранныйИнструмент = ТаблицаИнструментов[0].Инструмент;
		ТаблицаИнструментов[0].Активный = 2;
		
		ТаблицаИнструментовИнструментОбработкаВыбораНаСервере(ТаблицаИнструментов[0].Инструмент);			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОпераций()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ОперацииПортфеля.Портфель КАК Портфель,
	|	биг_ОперацииПортфеля.Сделка КАК Сделка,
	|	биг_ОперацииПортфеля.Операция КАК Операция,
	|	биг_ОперацииПортфеля.Аккаунт КАК Аккаунт,
	|	биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК ИнтеграционныйДокумент,
	|	биг_ОперацииПортфеля.Статус КАК Статус
	|ПОМЕСТИТЬ ВТ_СостояниеПортфеля
	|ИЗ
	|	РегистрСведений.биг_ОперацииПортфеля КАК биг_ОперацииПортфеля
	|ГДЕ
	|	биг_ОперацииПортфеля.Портфель = &Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СостояниеПортфеля.Портфель КАК Портфель,
	|	МАКСИМУМ(ВТ_СостояниеПортфеля.Операция.Дата) КАК ОперацияДата,
	|	МАКСИМУМ(ВТ_СостояниеПортфеля.Сделка.ТаймСтамп10) КАК СделкаТаймСтамп10
	|ПОМЕСТИТЬ ВТ_СрезПоследних
	|ИЗ
	|	ВТ_СостояниеПортфеля КАК ВТ_СостояниеПортфеля
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СостояниеПортфеля.Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СостояниеПортфеля.Портфель КАК Портфель,
	|	ВТ_СостояниеПортфеля.Сделка КАК Сделка,
	|	ВТ_СостояниеПортфеля.Операция КАК Операция,
	|	ВТ_СостояниеПортфеля.Аккаунт КАК Аккаунт,
	|	ВТ_СостояниеПортфеля.ИнтеграционныйДокумент КАК ИнтеграционныйДокумент,
	|	ВТ_СостояниеПортфеля.Статус КАК Статус
	|ИЗ
	|	ВТ_СостояниеПортфеля КАК ВТ_СостояниеПортфеля
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СрезПоследних КАК ВТ_СрезПоследних
	|		ПО ВТ_СостояниеПортфеля.Портфель = ВТ_СрезПоследних.Портфель
	|			И ВТ_СостояниеПортфеля.Операция.Дата = ВТ_СрезПоследних.ОперацияДата
	|			И ВТ_СостояниеПортфеля.Сделка.ТаймСтамп10 = ВТ_СрезПоследних.СделкаТаймСтамп10";
	
	Запрос.УстановитьПараметр("Портфель", Портфель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НС = ТаблицаОпераций.Добавить();
		НС.Аккаунт 		= Выборка.Аккаунт;
		НС.Операция 	= Выборка.Операция;
		НС.Результат 	= Выборка.ИнтеграционныйДокумент;
		НС.Статус 		= Выборка.Статус;
		
		Если НС.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Исполнен Тогда
			НС.Светофор = 2;
		ИначеЕсли НС.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Активный Тогда
			НС.Светофор = 3;
		ИначеЕсли НС.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Отменен Тогда	
			НС.Светофор = 1;
		Иначе
			НС.Светофор = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Сделка = Выборка.Сделка;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПозиций()
	
	ТаблицаПозиций.Очистить();
	
	Если ЗначениеЗаполнено(Сделка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	биг_ПозицииПоСделкам.Аккаунт КАК Аккаунт,
		|	биг_ПозицииПоСделкам.Позиция КАК Позиция,
		|	big_Positions_OKX.pos КАК pos,
		|	big_Positions_OKX.notionalUsd КАК notionalUsd,
		|	big_Positions_OKX.avgPx КАК avgPx,
		|	big_Positions_OKX.liqPx КАК liqPx,
		|	big_Positions_OKX.upl КАК upl,
		|	big_Positions_OKX.realizedPnl КАК realizedPnl,
		|	big_Positions_OKX.fee КАК fee,
		|	big_Positions_OKX.lever КАК lever,
		|	big_Positions_OKX.pnl КАК pnl,
		|	big_Positions_OKX.openAvgPx КАК openAvgPx,
		|	big_Positions_OKX.closeAvgPx КАК closeAvgPx,
		|	big_Positions_OKX.pnlRatio КАК pnlRatio,
		|	big_Positions_OKX.instId КАК instId,
		|	big_Positions_OKX.direction КАК direction
		|ИЗ
		|	РегистрСведений.биг_ПозицииПоСделкам КАК биг_ПозицииПоСделкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.big_Positions_OKX КАК big_Positions_OKX
		|		ПО биг_ПозицииПоСделкам.Позиция = big_Positions_OKX.Ссылка
		|ГДЕ
		|	биг_ПозицииПоСделкам.Сделка = &Сделка";
		Запрос.УстановитьПараметр("Сделка", Сделка);
		ТаблицаПозиций.Загрузить(Запрос.Выполнить().Выгрузить());
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыУниверсальныхОрдеров()
	
	ТаблицаОткрытыхАлгоОрдеров.Очистить();
	КоллекцияОрдеров = 	ПолучитьКоллекциюОрдеровФормы(Портфель); 
	
	Для каждого Элемент Из КоллекцияОрдеров Цикл
		
		Поиск = Новый Структура("АлгоОрдер", Элемент.Операция);
		СуществующиеСтроки = ТаблицаОткрытыхАлгоОрдеров.НайтиСтроки(Поиск);
		
		// TODO: есть проблема. По хорошему элементы ТригерНовый нужно использовать для интеграции
		// а здесь выводить только Текущее значение... ТригерНовый переписывать в Тригер тогда, 
		// когда все интеграционные документы успешно обработаются. Но пока некогда это организовывать
		
		// проблема: если интеграшка не отработала, то мы всё равно видим будто всё уже изменилось.
		Если СуществующиеСтроки.Количество() = 0 Тогда
			НС = ТаблицаОткрытыхАлгоОрдеров.Добавить();
			Если Элемент.ЭтоТП Тогда
				НС.ТригерТП		= ?(Элемент.ТейкПрофит_ТриггерНовый > 0, Элемент.ТейкПрофит_ТриггерНовый, Элемент.ТейкПрофит_Триггер);	
			КонецЕсли;
			Если Элемент.ЭтоСЛ Тогда
				НС.ТригерСЛ     = ?(Элемент.СтопЛосс_ТриггерНовый > 0, Элемент.СтопЛосс_ТриггерНовый, Элемент.СтопЛосс_Триггер);	
			КонецЕсли;		
			НС.АлгоОрдер    	= Элемент.Операция;			
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоллекциюОрдеровФормы(Портфель)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ОперацииПортфеля.Операция КАК Операция,
	|	биг_ОперацииПортфеля.Портфель КАК Портфель,
	|	биг_ОперацииПортфеля.Операция.Дата КАК ОперацияДата,
	|	биг_ОперацииПортфеля.Операция.СтопЛосс_Триггер КАК ОперацияСтопЛосс_Триггер,
	|	биг_ОперацииПортфеля.Операция.СтопЛосс_ТриггерНовый КАК ОперацияСтопЛосс_ТриггерНовый,
	|	биг_ОперацииПортфеля.Операция.ТейкПрофит_Триггер КАК ОперацияТейкПрофит_Триггер,
	|	биг_ОперацииПортфеля.Операция.ТейкПрофит_ТриггерНовый КАК ОперацияТейкПрофит_ТриггерНовый,
	|	биг_ОперацииПортфеля.Операция.Объем КАК ОперацияТейкПрофит_Объем,
	|	биг_ОперацииПортфеля.Операция.РазмерПлеча КАК ОперацияРазмерПлеча,
	|	ВЫБОР
	|		КОГДА биг_ОперацииПортфеля.Операция.СтопЛосс_Триггер > 0
	|				ИЛИ биг_ОперацииПортфеля.Операция.СтопЛосс_ТриггерНовый > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоСЛ,
	|	ВЫБОР
	|		КОГДА биг_ОперацииПортфеля.Операция.ТейкПрофит_Триггер > 0
	|				ИЛИ биг_ОперацииПортфеля.Операция.ТейкПрофит_ТриггерНовый > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоТП
	|ПОМЕСТИТЬ ВТ_ВыборкаПоПортфелю
	|ИЗ
	|	РегистрСведений.биг_ОперацииПортфеля КАК биг_ОперацииПортфеля
	|ГДЕ
	|	((ВЫРАЗИТЬ(биг_ОперацииПортфеля.Операция КАК Документ.биг_ОперацияТейкСтоп)) <> ЗНАЧЕНИЕ(Документ.биг_ОперацияТейкСтоп.ПустаяСсылка)
	|			ИЛИ (ВЫРАЗИТЬ(биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК Документ.big_AlgoOrders_OKX)) <> ЗНАЧЕНИЕ(Документ.big_AlgoOrders_OKX.ПустаяСсылка)
	|				И биг_ОперацииПортфеля.ИнтеграционныйДокумент.state = ""live"")
	|	И биг_ОперацииПортфеля.Портфель = &Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВыборкаПоПортфелю.Портфель КАК Портфель,
	|	МАКСИМУМ(ВТ_ВыборкаПоПортфелю.ОперацияДата) КАК ОперацияДата,
	|	ВТ_ВыборкаПоПортфелю.ЭтоСЛ КАК ЭтоСЛ,
	|	ВТ_ВыборкаПоПортфелю.ЭтоТП КАК ЭтоТП,
	|	ВТ_ВыборкаПоПортфелю.ОперацияСтопЛосс_Триггер КАК ОперацияСтопЛосс_Триггер,
	|	ВТ_ВыборкаПоПортфелю.ОперацияТейкПрофит_Триггер КАК ОперацияТейкПрофит_Триггер
	|ПОМЕСТИТЬ ВТ_ДатаПоследнегоДокумента
	|ИЗ
	|	ВТ_ВыборкаПоПортфелю КАК ВТ_ВыборкаПоПортфелю
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВыборкаПоПортфелю.Портфель,
	|	ВТ_ВыборкаПоПортфелю.ЭтоСЛ,
	|	ВТ_ВыборкаПоПортфелю.ЭтоТП,
	|	ВТ_ВыборкаПоПортфелю.ОперацияТейкПрофит_Триггер,
	|	ВТ_ВыборкаПоПортфелю.ОперацияСтопЛосс_Триггер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВыборкаПоПортфелю.Операция КАК Операция,
	|	ВТ_ВыборкаПоПортфелю.ОперацияСтопЛосс_Триггер КАК СтопЛосс_Триггер,
	|	ВТ_ВыборкаПоПортфелю.ОперацияСтопЛосс_ТриггерНовый КАК СтопЛосс_ТриггерНовый,
	|	ВТ_ВыборкаПоПортфелю.ОперацияТейкПрофит_Триггер КАК ТейкПрофит_Триггер,
	|	ВТ_ВыборкаПоПортфелю.ОперацияТейкПрофит_ТриггерНовый КАК ТейкПрофит_ТриггерНовый,
	|	ВТ_ВыборкаПоПортфелю.ОперацияРазмерПлеча КАК РазмерПлеча,
	|	ВТ_ВыборкаПоПортфелю.ЭтоСЛ КАК ЭтоСЛ,
	|	ВТ_ВыборкаПоПортфелю.ЭтоТП КАК ЭтоТП
	|ПОМЕСТИТЬ ВТ_ПоследняяОперация
	|ИЗ
	|	ВТ_ВыборкаПоПортфелю КАК ВТ_ВыборкаПоПортфелю
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаПоследнегоДокумента КАК ВТ_ДатаПоследнегоДокумента
	|		ПО ВТ_ВыборкаПоПортфелю.Портфель = ВТ_ДатаПоследнегоДокумента.Портфель
	|			И ВТ_ВыборкаПоПортфелю.ОперацияДата = ВТ_ДатаПоследнегоДокумента.ОперацияДата
	|			И ВТ_ВыборкаПоПортфелю.ЭтоСЛ = ВТ_ДатаПоследнегоДокумента.ЭтоСЛ
	|			И ВТ_ВыборкаПоПортфелю.ЭтоТП = ВТ_ДатаПоследнегоДокумента.ЭтоТП
	|			И ВТ_ВыборкаПоПортфелю.ОперацияСтопЛосс_Триггер = ВТ_ДатаПоследнегоДокумента.ОперацияСтопЛосс_Триггер
	|			И ВТ_ВыборкаПоПортфелю.ОперацияТейкПрофит_Триггер = ВТ_ДатаПоследнегоДокумента.ОперацияТейкПрофит_Триггер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ПоследняяОперация.Операция КАК Операция,
	|	ВТ_ПоследняяОперация.СтопЛосс_Триггер КАК СтопЛосс_Триггер,
	|	ВТ_ПоследняяОперация.СтопЛосс_ТриггерНовый КАК СтопЛосс_ТриггерНовый,
	|	ВТ_ПоследняяОперация.ТейкПрофит_Триггер КАК ТейкПрофит_Триггер,
	|	ВТ_ПоследняяОперация.ТейкПрофит_ТриггерНовый КАК ТейкПрофит_ТриггерНовый,
	|	ВТ_ПоследняяОперация.РазмерПлеча КАК РазмерПлеча,
	|	ВТ_ПоследняяОперация.ЭтоСЛ КАК ЭтоСЛ,
	|	ВТ_ПоследняяОперация.ЭтоТП КАК ЭтоТП,
	|	биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК ИнтеграционныйДокумент
	|ИЗ
	|	ВТ_ПоследняяОперация КАК ВТ_ПоследняяОперация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_ОперацииПортфеля КАК биг_ОперацииПортфеля
	|		ПО ВТ_ПоследняяОперация.Операция = биг_ОперацииПортфеля.Операция
	|			И (биг_ОперацииПортфеля.Портфель = ВТ_ПоследняяОперация.Операция.Портфель)
	|			И (биг_ОперацииПортфеля.Сделка = ВТ_ПоследняяОперация.Операция.Сделка)
	|			И ((ВЫРАЗИТЬ(биг_ОперацииПортфеля.Операция КАК Документ.биг_ОперацияТейкСтоп)) <> ЗНАЧЕНИЕ(Документ.биг_ОперацияТейкСтоп.ПустаяСсылка)
	|				ИЛИ (ВЫРАЗИТЬ(биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК Документ.big_AlgoOrders_OKX)) <> ЗНАЧЕНИЕ(Документ.big_AlgoOrders_OKX.ПустаяСсылка))
	|			И (биг_ОперацииПортфеля.ИнтеграционныйДокумент.state = ""live"")";
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоллекцияОрдеров = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Структура = СтруктураКоллекцииОрдеровФормы();
		ЗаполнитьЗначенияСвойств(Структура, Выборка);
		
		КоллекцияОрдеров.Добавить(Структура);
	КонецЦикла;
	
	Возврат КоллекцияОрдеров;
	
КонецФункции

&НаСервереБезКонтекста
Функция СтруктураКоллекцииОрдеровФормы()
	
	Возврат Новый Структура("Операция, СтопЛосс_Триггер, СтопЛосс_ТриггерНовый, ТейкПрофит_Триггер, ТейкПрофит_ТриггерНовый, РазмерПлеча, ЭтоСЛ, ЭтоТП",,0,0,0,0,1,Ложь,Ложь);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьТорговыеНастройки(Инструмент)
	
	РеквизитыПортфеля = Портфель.ПолучитьОбъект();
	
	ТипИнструментов = РеквизитыПортфеля.ТипИнструмента;
	Биржа           = РеквизитыПортфеля.Биржа;
	ВидМаржи        = РеквизитыПортфеля.РежимТорговли;
	
	Если Инструмент = Неопределено Тогда
		
		Если ТаблицаИнструментов.Количество() > 0 Тогда
			Инструмент = ТаблицаИнструментов[0].Инструмент;
		Иначе
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	СтрокаНастроек 	= РеквизитыПортфеля.НастройкаАлгоОрдеров.Найти(Инструмент, "Инструмент");
	
	Если ЗначениеЗаполнено(СтрокаНастроек) Тогда
		ИспользоватьАвтоТейкСтоп    = СтрокаНастроек.ИспользоватьТейкПрофит ИЛИ СтрокаНастроек.ИспользоватьСтопЛосс;
		
		ВариантАвтоТейк        		= СтрокаНастроек.ВариантАвтоТейк;
		ПравилоАвтоТейкПрофит       = СтрокаНастроек.ПравилоАвтоТейкПрофит;
		
		ВариантАвтоСтоп        		= СтрокаНастроек.ВариантАвтоСтоп;
		ПравилоАвтоСтопЛосс        	= СтрокаНастроек.ПравилоАвтоСтопЛосс;
		
		РежимАвтоСтопТейк        	= Перечисления.биг_РежимыАвтоСтопТейк.КаждуюОперациюСделки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьТорговыхНастроек(ПортфельУказан)

	ПортфельУказан = ЗначениеЗаполнено(Портфель);
	Элементы.ТипИнструментов.ТолькоПросмотр 			= ПортфельУказан;
	Элементы.Биржа.ТолькоПросмотр						= ПортфельУказан;
	Элементы.ВидМаржи.Доступность 						= НЕ ПортфельУказан;
	Элементы.ТаблицаИнструментов.ТолькоПросмотр			= ПортфельУказан;

	Элементы.ТаблицаИнструментовДобавить.Доступность 	= НЕ ПортфельУказан;
		
КонецПроцедуры 

&НаСервере
Процедура НастроитьИспользованиеАлгоОрдеров()
	
	//Элементы.ГруппаНастройкиСЛТП.Доступность 	= НЕ ИспользоватьАвтоТейкСтоп;
	Элементы.ПереключательСЛ_ТП.Доступность		= НЕ ИспользоватьАвтоТейкСтоп;
	ПереключательСЛ_ТП 							= ?(ПравилоАвтоСтопЛосс > 0 ИЛИ ПравилоАвтоТейкПрофит > 0, 1, 0);
	
	Элементы.ГруппаСЛ.ТолькоПросмотр			= ИспользоватьАвтоТейкСтоп;
	Элементы.ГруппаТП.ТолькоПросмотр			= ИспользоватьАвтоТейкСтоп И (ТипИнструментов = Перечисления.big_OKX_InstrumentType.SWAP ИЛИ ТипИнструментов = Перечисления.big_OKX_InstrumentType.FUTURES);
КонецПроцедуры

&НаКлиенте
Процедура ВидМаржиПриИзменении(Элемент)
	
	УстановитьВидимостьИзмененияПлеча();		
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьИзмененияПлеча()

	Если ВидМаржи = ПредопределенноеЗначение("Перечисление.big_OKX_tdModes.cash") Тогда
		Элементы.ГруппаПлечо.Видимость = Ложь;
		Плечо = 1;
	Иначе
		Элементы.ГруппаПлечо.Видимость = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнструментовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЗначениеЗаполнено(Портфель) Тогда
		Отказ = Истина;
		Сообщить("Выбран портфель. Для изменения состава инструментов (торговых пар) - измените настройки портфеля");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиТочкуПоНаименованию(ИмяТочки)
	
	Точка = "";
	Для каждого Элемент Из ГрафикСвечи.Точки Цикл
		Если Элемент.Значение = ИмяТочки Тогда
			Точка = Элемент;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Элемент;
	
КонецФункции

&НаКлиенте
