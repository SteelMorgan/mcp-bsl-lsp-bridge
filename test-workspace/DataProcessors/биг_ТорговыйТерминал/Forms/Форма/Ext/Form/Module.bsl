		НовыйАлго.ТейкПрофит_ТриггерНовый	= Результат.ТП_НовыйТриггер;
		НовыйАлго.ОбъемНовый				= Результат.Объем_Новый;
		НовыйАлго.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		Успешно = Истина;
		
		// заполнить таблицы формы
