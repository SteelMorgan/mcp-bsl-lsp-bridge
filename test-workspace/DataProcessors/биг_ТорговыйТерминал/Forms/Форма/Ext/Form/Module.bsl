&НаСервере
Процедура СформироватьОбъектыОперации(СторонаОрдера)

	// если сделка пустая - создать сделку
	Если Не ЗначениеЗаполнено(Сделка) ИЛИ СделкаЗавершена(Сделка) Тогда
		
		Если Портфель.РежимПозиций = Перечисления.биг_OKX_PostionModes.long_short_mode Тогда
			СторонаПозиции = ?(СторонаОрдера = Перечисления.big_OKX_OrderSides.buy, Перечисления.big_OKX_PositionSides.long, Перечисления.big_OKX_PositionSides.short);
		Иначе
			СторонаПозиции = Перечисления.big_OKX_PositionSides.net;	
		КонецЕсли;
		
		//Если ТипИнструментов <> Перечисления.big_OKX_InstrumentType.SPOT Тогда
		//	Сделка = СформироватьНовуюСделку(СторонаПозиции);	
		//КонецЕсли;
		Сделка = СформироватьНовуюСделку(СторонаПозиции);
		
	КонецЕсли;
	
	// создать операцию и провести (встанет в очередь на исполнение)
	Операция = СформироватьОперацию(СторонаОрдера);
	
	// перезаполнить таблицу операций и позиций
	ЗаполнитьТаблицыОперацийИПозиций(Операция);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОбъектыЗакрытияСделки()
	
	Если ЗначениеЗаполнено(Сделка) И НЕ СделкаЗавершена(Сделка) Тогда
		
		Операция = СформироватьОперациюЗакрытияПозиций();
		
		// перезаполнить таблицу операций и позиций
		ЗаполнитьТаблицыОперацийИПозиций(Операция);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция СделкаЗавершена(Сделка)
	
	СделкаЗавершена = Ложь;
	
	Если ТипИнструментов = Перечисления.big_OKX_InstrumentType.SPOT Тогда
		// в споте нет понятия позиция. каждая операция сделка сама в себе и оценить портфель можем по 
		// изменению его стоимости между двумя точками (как раз для этого хранится история балансов)
		СделкаЗавершена = Истина;
	Иначе
		
		СделкаЗавершена = Истина;
		
		Для каждого Строка Из ТаблицаПозиций Цикл
			
			Если СделкаЗавершена И Строка.pos > 0 Тогда
				СделкаЗавершена = Ложь;	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СделкаЗавершена;
	
КонецФункции 

&НаСервере
Функция СформироватьОперацию(СторонаОрдера)
	
	ДокОперации = Документы.биг_ОперацияПокупкаПродажа.СоздатьДокумент();
	ДокОперации.Дата			= ТекущаяДатаСеанса();
	ДокОперации.Портфель 		= Портфель;
	ДокОперации.Сделка			= Сделка;
	ДокОперации.Биржа			= Биржа;
	ДокОперации.ТипОрдера		= ТипОрдера;
	ДокОперации.СторонаОрдера	= СторонаОрдера;
	ДокОперации.Инструмент		= ВыбранныйИнструмент;
	ДокОперации.ДоляОтДепозита	= ДоляДепоДляОперации;
	ДокОперации.ЦенаОрдера		= ЦенаСделки;
	ДокОперации.РазмерПлеча		= Плечо;
	ДокОперации.РежимТорговли	= ВидМаржи;	
	
	ЭтоНаборПозиции = Ложь;
	Если (ТипИнструментов = Перечисления.big_OKX_InstrumentType.SPOT И СторонаОрдера = Перечисления.big_OKX_OrderSides.buy)
			И (ЗначениеЗаполнено(ТП_Триггер) ИЛИ ЗначениеЗаполнено(СЛ_Триггер)) Тогда
			
		ЭтоНаборПозиции = Истина;
	ИначеЕсли ТипИнструментов = Перечисления.big_OKX_InstrumentType.SWAP 
				И (Сделка.СторонаСделки = Перечисления.big_OKX_PositionSides.long И СторонаОрдера = Перечисления.big_OKX_OrderSides.buy) Тогда
		
		ЭтоНаборПозиции = Истина;
	ИначеЕсли ТипИнструментов = Перечисления.big_OKX_InstrumentType.SWAP 
				И (Сделка.СторонаСделки = Перечисления.big_OKX_PositionSides.short И СторонаОрдера = Перечисления.big_OKX_OrderSides.sell) Тогда
				
		ЭтоНаборПозиции = Истина;				
	КонецЕсли;
	
	Если ЭтоНаборПозиции Тогда
		
		Док = Документы.биг_ОперацияТейкСтоп.СоздатьДокумент();
		
		Док.Дата				= ТекущаяДатаСеанса();
		Док.Портфель			= Портфель;
		Док.Сделка				= Сделка;
		Док.Биржа				= Биржа;
		Док.ТипОрдера			= ТипОрдера;
		Док.Инструмент			= ВыбранныйИнструмент;
		
		Док.ТейкПрофит_Триггер 	= ТП_Триггер;
		Док.ТейкПрофит_Цена		= -1; // исполнение по рынку
		Док.ТейкПрофит_Доля		= ДоляДепоДляОперации;
		
		Док.СтопЛосс_Триггер	= СЛ_Триггер;
		Док.СтопЛосс_Цена		= -1; // исполнение по рынку;
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		СтрокаТейк = ДокОперации.СтопТейк.Добавить();
		СтрокаТейк.ТейкСтоп = Док.Ссылка;
		// TO DO: дописать обновление тейка 
		
		ТП_Триггер 	= 0;
		ТП_Цена		= 0;
	КонецЕсли;
	
	Если ТаблицаПозиций.Количество() > 0 Тогда
		Позиция = ТаблицаПозиций[0];
		Если ВРЕГ(Позиция.direction) = "SHORT" И СторонаОрдера = Перечисления.big_OKX_OrderSides.buy Тогда
			//ДокОперации.ОперацияПротивПозиции = Истина;
		ИначеЕсли ВРЕГ(Позиция.direction) = "LONG" И СторонаОрдера = Перечисления.big_OKX_OrderSides.sell Тогда
			//ДокОперации.ОперацияПротивПозиции = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	ДокОперации.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокОперации.Ссылка;
	
КонецФункции

&НаСервере
Функция СформироватьОперациюЗакрытияПозиций()
	
	ДокОперации = Документы.биг_ОперацияЗакрытьПозицию.СоздатьДокумент();
	ДокОперации.Дата			= ТекущаяДатаСеанса();
	ДокОперации.Портфель 		= Портфель;
	ДокОперации.Сделка			= Сделка;
	ДокОперации.Биржа			= Биржа;
	
	Для каждого Строка Из ТаблицаПозиций Цикл
		НС = ДокОперации.Позиции.Добавить();
		НС.Позиция 	= Строка.Позиция;
		НС.Аккаунт	= Строка.Аккаунт;
	КонецЦикла;
	
	ДокОперации.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокОперации.Ссылка;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицыОперацийИПозиций(Операция)
	
	ТаблицаОпераций.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ОперацииПортфеля.Портфель КАК Портфель,
	|	биг_ОперацииПортфеля.Сделка КАК Сделка,
	|	биг_ОперацииПортфеля.Операция КАК Операция,
	|	биг_ОперацииПортфеля.Аккаунт КАК Аккаунт,
	|	биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК ИнтеграционныйДокумент,
	|	биг_ОперацииПортфеля.Статус КАК Статус,
	|	0 КАК Светофор
	|ИЗ
	|	РегистрСведений.биг_ОперацииПортфеля КАК биг_ОперацииПортфеля
	|ГДЕ
	|	биг_ОперацииПортфеля.Портфель = &Портфель
	|	И биг_ОперацииПортфеля.Сделка = &Сделка
	|	И биг_ОперацииПортфеля.Операция = &Операция";
	
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("Операция", Операция);
	
	ТаблицаОпераций.Загрузить(Запрос.Выполнить().Выгрузить());
	Для каждого Строка Из ТаблицаОпераций Цикл
		Если Строка.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Исполнен Тогда
			Строка.Светофор = 2;
		ИначеЕсли Строка.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Активный Тогда
			Строка.Светофор = 3;
		ИначеЕсли Строка.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Отменен Тогда	
			Строка.Светофор = 1;
		Иначе
			Строка.Светофор = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиЗаполнитьСтрокиОпераций(ДанныеОпераций)
	
	Для каждого Строка Из ДанныеОпераций Цикл
		
		Поиск = Новый Структура("Операция, Аккаунт");
		ЗаполнитьЗначенияСвойств(Поиск, Строка);
		
		СтрокиТаблицы = ТаблицаОпераций.НайтиСтроки(Поиск);
		Если СтрокиТаблицы.Количество() = 1 Тогда
			ЦелеваяСтрока = СтрокиТаблицы[0];
			ЦелеваяСтрока.Результат = Строка.ИнтеграционныйДокумент;
			ЦелеваяСтрока.Статус	= Строка.Статус;
			
			Если ЦелеваяСтрока.Статус = ПредопределенноеЗначение("Перечисление.big_СтатусыТорговыхОбъектов.Исполнен") Тогда
				ЦелеваяСтрока.Светофор = 2;
			ИначеЕсли ЦелеваяСтрока.Статус = ПредопределенноеЗначение("Перечисление.big_СтатусыТорговыхОбъектов.Активный") Тогда
				ЦелеваяСтрока.Светофор = 3;
			ИначеЕсли ЦелеваяСтрока.Статус = ПредопределенноеЗначение("Перечисление.big_СтатусыТорговыхОбъектов.Отменен") Тогда	
				ЦелеваяСтрока.Светофор = 1;
			Иначе
				ЦелеваяСтрока.Светофор = 0;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// --- 3. Определение итогового значения "Светофор" для всей группы ---
	// Инициализируем флаги и предполагаемый итог
	ЕстьОтмененные = Ложь;
	ЕстьАктивные = Ложь;
	ВсеВыполнены = Истина; // Предполагаем, что все Выполнены, пока не докажем обратное
	
	// Проходим по всем строкам таблицы для определения итогового статуса
	Для каждого СтрокаТаблицы Из ТаблицаОпераций Цикл
		СветофорСтроки = СтрокаТаблицы.Светофор;
		
		Если СветофорСтроки = 1 Тогда
			ЕстьОтмененные = Истина;
		ИначеЕсли СветофорСтроки = 3 Тогда
			ЕстьАктивные = Истина;
		КонецЕсли;
		
		// Если строка не "Выполнена" (Светофор <> 2), то не все выполнены
		Если СветофорСтроки <> 2 Тогда
			ВсеВыполнены = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// --- 4. Установка итогового значения "Светофор" по приоритетам ---
	// Приоритет: 1 (Отменен) > 3 (Активный) > 2 (Выполнен) > 0 (Другое)
	Если ЕстьОтмененные Тогда
		ИтоговыйСветофор = 1; // Высший приоритет
	ИначеЕсли ЕстьАктивные Тогда
		ИтоговыйСветофор = 3; // Средний приоритет
	ИначеЕсли ВсеВыполнены Тогда
		ИтоговыйСветофор = 2; // Низший приоритет среди значимых статусов
	Иначе
		ИтоговыйСветофор = 0; // Ни один из вышеперечисленных
	КонецЕсли;
	
	// --- 5. Запись итогового значения в переменную формы или реквизит ---
	// Предполагается, что в форме есть переменная ИтоговыйСветофор
	// или какой-то реквизит для хранения этого значения.
	// В данном примере просто присваиваем переменной формы.
	// Вы можете заменить это на запись в нужный реквизит.
	ТекущаяОперацияСтатус = ИтоговыйСветофор;
	
	Если ДанныеОпераций.Количество() > 0 Тогда
		ТекущаяОперация = ДанныеОпераций[0].Операция;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеПолейСтопЛоссТейкПрофит()
	
	ИспользоватьСЛТП = ПереключательСЛ_ТП = 1;
	
	Если НЕ ИспользоватьСЛТП Тогда
		СЛ_Триггер 	= 0;
		СЛ_Цена		= 0;
		ТП_Триггер 	= 0;
		ТП_Цена		= 0;
	КонецЕсли;
	
	Элементы.ГруппаНастройкиСЛТП.Видимость 	= ИспользоватьСЛТП;
	
КонецПроцедуры

&НаСервере
Функция СформироватьНовуюСделку(СторонаПозиции)
	
	СделкаОбъект = Справочники.биг_Сделки.СоздатьЭлемент();
	СделкаОбъект.ТаймСтамп10 		= биг_ОбщегоНазначенияКлиентСервер.ТекущаяДатаВМиллисекундахЭпохаUnixGMT0() / 1000;
	СделкаОбъект.ДатаНачалаСделки 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(СделкаОбъект.ТаймСтамп10);
	СделкаОбъект.Инструмент			= ВыбранныйИнструмент;	
	СделкаОбъект.Плечо				= Плечо;
    СделкаОбъект.РежимМаржи			= ВидМаржи;
	СделкаОбъект.Наименование		= Формат(СделкаОбъект.ТаймСтамп10, "ЧЦ=13; ЧГ=0") + "_" + ИнструментИД; 

	Если Портфель.РежимПозиций = Перечисления.биг_OKX_PostionModes.long_short_mode Тогда
		СделкаОбъект.СторонаСделки		= СторонаПозиции;
	Иначе
		СделкаОбъект.СторонаСделки		= Перечисления.big_OKX_PositionSides.net;
	КонецЕсли;                                                                   
	
	СделкаОбъект.Записать();
	
	Возврат СделкаОбъект.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОформлениеПолей()
	
	Тикер = ПолучитьТикерИнструмента(ВыбранныйИнструмент);
	
	// формат для поля СЛ_Цена
	Шаблон = "ЧФ='Ч %1'";
	СтрокаФормата = СтрШаблон(Шаблон, ?(ЗначениеЗаполнено(Тикер.quoteCcy), Тикер.quoteCcy, Тикер.settleCcy));
	
	Элементы.СЛ_Цена.ФорматРедактирования = СтрокаФормата;
	Элементы.СЛ_Триггер.ФорматРедактирования = СтрокаФормата;
	
	// формат для поля ТП_Цена
	Элементы.ТП_Цена.ФорматРедактирования	= СтрокаФормата;
	Элементы.ТП_Триггер.ФорматРедактирования	= СтрокаФормата;
	
	// формат для поля ЦенаСделки
	Элементы.ЦенаСделки.ФорматРедактирования = СтрокаФормата;
	
	// TO DO: по сути сейчас подписи для SWAP режима сделаны. для спота нужно выводить: [Купить/Продать] [Тикер]
	
	// кнопки продать и купить           
	ТикерДляКнопок = ?(ЗначениеЗаполнено(Тикер.baseCcy), Тикер.baseCcy, Тикер.ctValCcy); 
	
	Если ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SWAP") ИЛИ ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.FUTURES") Тогда
		ТекстКнопкиКупить = "LONG";
	Иначе
		ТекстКнопкиКупить = "КУПИТЬ";
	КонецЕсли;
	
	Если ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SWAP") ИЛИ ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.FUTURES") Тогда
		ТекстКнопкиПродать = "SHORT";
	Иначе
		ТекстКнопкиПродать = "ПРОДАТЬ";
	КонецЕсли;
	
	Элементы.Купить.Заголовок = ТекстКнопкиКупить + "
								|" + ТикерДляКнопок;
	
	Элементы.Продать.Заголовок = ТекстКнопкиПродать + "
								|" + ТикерДляКнопок;
	
	Элементы.ЗакрытьСделку.Заголовок = "ЗАКРЫТЬ
										|" + ТикерДляКнопок;
	
	Элементы.ПеревернутьПозицию.Заголовок = "ПЕРЕВЕРНУТЬ
										|" + ТикерДляКнопок;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТикерИнструмента(Инструмент)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Инструмент, "baseCcy, quoteCcy, settleCcy, ctValCcy"); 
	
	Возврат Реквизиты;
	
КонецФункции

&НаКлиенте
Процедура НастроитьОтображениеЭлементов()

	УстановитьОформлениеПолейСтопЛоссТейкПрофит();
	УстановитьОформлениеПолей();

	ТипОрдераПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКоманд()
	
	ЭтоСпот = ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SPOT");
	Элементы.ГруппаПеревернуть.Видимость	= НЕ ЭтоСпот;
	Элементы.ГруппаЗакрытьСделку.Видимость	= НЕ ЭтоСпот;
	
	ЭтоФьючи = (ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.FUTURES")
				ИЛИ ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SWAP"));
	Элементы.ВШорт.Видимость 				= ЭтоФьючи;
	Элементы.ИзменитьАлго.Видимость			= ТаблицаОткрытыхАлгоОрдеров.Количество() > 0;
	
КонецПроцедуры

