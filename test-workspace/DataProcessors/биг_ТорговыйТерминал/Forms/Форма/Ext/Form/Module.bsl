&НаКлиенте
Процедура ОбновлениеТекущейЦены() Экспорт
	
	СостояниеОбновлениеЦены = 2;
	
	Свеча = ПолучитьОперативнуюЦенуИнструмента(Биржа, ВыбранныйИнструмент, Бар);
	ПоследняяСвеча_ЗначениеОткрытия = Свеча.ЦенаОткрытия;
	ПоследняяСвеча_ЗначениеМин      = Свеча.ЦенаМинимум;
	ПоследняяСвеча_ЗначениеМакс     = Свеча.ЦенаМаксимум;
	ПоследняяСвеча_ЗначениеЗакрытия = Свеча.ЦенаЗакрытия;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОбновленияНезавершеннойСвечи() Экспорт
	
	СостояниеОбновлениеСвечи = 2;
	
	СерияКурс				= "";
	Для каждого Элемент Из ГрафикСвечи.Серии Цикл
		Если Элемент.Текст = ИнструментИД Тогда
			СерияКурс = Элемент;	
		КонецЕсли;	
	КонецЦикла;
	
	//ОбновлениеТекущейЦены();
	
	ГрафикСвечи.Обновление 	= Ложь;
	
	ТочкаОткр = НайтиТочкуПоНаименованию(ПоследняяСвеча_Имя);
	ГрафикСвечи.УстановитьЗначение(ТочкаОткр, СерияКурс, ПоследняяСвеча_ЗначениеОткрытия);
	
	ТочкаМин = НайтиТочкуПоНаименованию(ПоследняяСвеча_Имя + "_Low");
	ГрафикСвечи.УстановитьЗначение(ТочкаМин, СерияКурс, ПоследняяСвеча_ЗначениеМин);
		
    ТочкаМакс = НайтиТочкуПоНаименованию(ПоследняяСвеча_Имя + "_High");
	ГрафикСвечи.УстановитьЗначение(ТочкаМакс, СерияКурс, ПоследняяСвеча_ЗначениеМакс);
	
	ТочкаЗакрытия = НайтиТочкуПоНаименованию(ПоследняяСвеча_Имя + "_Close");
	ГрафикСвечи.УстановитьЗначение(ТочкаЗакрытия, СерияКурс, ПоследняяСвеча_ЗначениеЗакрытия);
    
	// немножко копипаст, но исходный код написан НаСервере - долго переделывать. см. ВывестиВспомогательныеПометкиНаДиаграммуПоСигналу() из формы обработки биг_МониторСтратегии_ДаблИмпакт
	ПодсказкаТекЦены 	= "Уровень текущей цены";
	ЛинияТекЦена 		= Неопределено;
	
	Для каждого Линия Из ГрафикСвечи.ИнформационныеЛинииЗначений Цикл
		Если Линия.Подсказка = ПодсказкаТекЦены Тогда
			ГрафикСвечи.ИнформационныеЛинииЗначений(Линия);	
		КонецЕсли;	
	КонецЦикла;
	
	КоллекцияЛинийЗначений	= ГрафикСвечи.ИнформационныеЛинииЗначений;
	ТекстЛинии				= "Текущая цена";
	ЦветЛинии				= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
	ТипЛинии 				= ТипЛинииДиаграммы.Пунктир;	
	ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, ПоследняяСвеча_ТекЦена, ТекстЛинии, ЦветЛинии, ТипЛинии, 1, ПодсказкаТекЦены);
	
	ГрафикСвечи.Обновление = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольРезультатаОперации() Экспорт
	
	СостояниеКонтрольРезультата = 2;
	
	// собираем в массив строки, где нет интеграционного документа
	МассивОжидания = Новый Массив;
	Для каждого Строка Из ТаблицаОпераций Цикл
		Если ЗначениеЗаполнено(Строка.Операция) И НЕ (Строка.Статус = ПредопределенноеЗначение("Перечисление.big_СтатусыТорговыхОбъектов.Исполнен") ИЛИ Строка.Статус = ПредопределенноеЗначение("Перечисление.big_СтатусыТорговыхОбъектов.Отменен")) Тогда
			
			СтруктураОжидания = Новый Структура("Портфель, Сделка, Операция, Аккаунт", Портфель, Сделка, Строка.Операция, Строка.Аккаунт);
			МассивОжидания.Добавить(СтруктураОжидания);	
		КонецЕсли;
	КонецЦикла;
	
	// если таких строк нет - отключить обработчик ожидания
	Если МассивОжидания.Количество() = 0 Тогда
		
		РазблокироватьКомандыОпераций();
		СостояниеКонтрольРезультата = 1;
		ОтключитьОбработчикОжидания("КонтрольРезультатаОперации");
	Иначе
		
		// иначе обращаемся к РС биг_ОперацииПортфеля и по найденным записям дополняем таблицу
		ДанныеОпераций = ПолучитьДанныеОпераций(МассивОжидания);
		НайтиЗаполнитьСтрокиОпераций(ДанныеОпераций);
	КонецЕсли;
			
КонецПроцедуры

