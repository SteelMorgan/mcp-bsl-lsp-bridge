&НаКлиенте
Процедура ОбновлениеИнформацииОБалансе()
	
	СостояниеОбновлениеБаланса = 2;
	Объект.ТаблицаБалансы.Очистить();
	
	Если ЗначениеЗаполнено(Портфель) Тогда
		ДанныеБаланса = ПолучитьБалансыУчастниковПортфеля(Портфель, ВыбранныйИнструмент);
		
		Для каждого Строка Из ДанныеБаланса Цикл
			НС = Объект.ТаблицаБалансы.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Строка);
		КонецЦикла;
	Иначе
		СостояниеОбновлениеБаланса = 1;
		ОтключитьОбработчикОжидания("ОбновлениеИнформацииОБалансе");
	КонецЕсли;	
	
КонецПроцедуры                                                

&НаСервереБезКонтекста
Функция ПолучитьБалансыУчастниковПортфеля(Портфель, Инструмент)
	
	Тикер = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Инструмент, "baseCcy, ctValCcy, quoteCcy, settleCcy");
	Монеты = Новый Массив; 
	
	ТикерМонетыПокупки 	= ?(ЗначениеЗаполнено(Тикер.baseCcy), Тикер.baseCcy, Тикер.ctValCcy);
	ТикерМонетыОплаты 	= ?(ЗначениеЗаполнено(Тикер.quoteCcy), Тикер.quoteCcy, Тикер.settleCcy);
	
	Монеты.Добавить(Справочники.big_Currencys.НайтиПоНаименованию(ТикерМонетыПокупки, Истина));
	Монеты.Добавить(Справочники.big_Currencys.НайтиПоНаименованию(ТикерМонетыОплаты, Истина));
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ОКХ_БаллансАккаунтовСрезПоследних.Account КАК Account,
	|	ЕСТЬNULL(биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.ccy, ЗНАЧЕНИЕ(Справочник.big_Currencys.ПустаяСсылка)) КАК ccy,
	|	ЕСТЬNULL(биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.availBal, 0) КАК availBal,
	|	ЕСТЬNULL(биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.eqUsd, 0) КАК eqUsd,
	|	ЕСТЬNULL(биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.frozenBal, 0) КАК frozenBal
	|ИЗ
	|	РегистрСведений.биг_УчастникиПортфелей.СрезПоследних(
	|			,
	|			Портфель = &Портфель
	|				И Участник = ИСТИНА) КАК биг_УчастникиПортфелейСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.биг_ОКХ_БаллансАккаунтов.СрезПоследних КАК биг_ОКХ_БаллансАккаунтовСрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.биг_ОКХ_БаллансАккаунтовДетали.СрезПоследних(, ccy В (&Монеты)) КАК биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних
	|			ПО биг_ОКХ_БаллансАккаунтовСрезПоследних.Account = биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.Account
	|		ПО биг_УчастникиПортфелейСрезПоследних.Аккаунт = биг_ОКХ_БаллансАккаунтовСрезПоследних.Account";
	
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("Монеты", Монеты);
	
	ТаблицаБалансов = Запрос.Выполнить().Выгрузить();
	ДанныеОстатков	= ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаБалансов);
	
	Возврат ДанныеОстатков;
	
КонецФункции


&НаКлиенте
Процедура ОбновлениеИнформацииОПозициях()
	
	СостояниеОбновлениеПозиций = 2;
	
	Если ЗначениеЗаполнено(Сделка) Тогда 
				
		МассивАккаунтов = Новый Массив;
		Для каждого Строка Из ТаблицаОпераций Цикл
			МассивАккаунтов.Добавить(Строка.Аккаунт);
		КонецЦикла;	                                 
		
		Если МассивАккаунтов.Количество() > 0 Тогда
			
			// TO DO: нужно бы проверять, а изменились ли данные ? что бы не обновлять просто так каждый раз
			// так меньше будет "дергаться" экран
			
			ДанныеПозиций = ПолучитьДанныеОПозицияхФормы(Сделка, МассивАккаунтов);		
			ПродолжитьОжидание = Ложь;
			
			ТаблицаПозиций.Очистить();
			
			Если ДанныеПозиций.Количество() = 0 Тогда
				ПродолжитьОжидание = Истина;
				
			Иначе
				
				Для каждого Строка Из ДанныеПозиций Цикл
					НС = ТаблицаПозиций.Добавить();
					ЗаполнитьЗначенияСвойств(НС, Строка);
					
					Если НЕ ПродолжитьОжидание И Строка.pos > 0 Тогда
						ПродолжитьОжидание = Истина;	
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;		
			
			Если НЕ ПродолжитьОжидание Тогда
				СостояниеОбновлениеПозиций = 1;
				ОтключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях");
			КонецЕсли;			
		Иначе
			СостояниеОбновлениеПозиций = 1;
			ОтключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях");	
		КонецЕсли;
	Иначе
		СостояниеОбновлениеПозиций = 1;
		ОтключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях");
	КонецЕсли;		
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОПозицияхФормы(Сделка, МассивАккаунтов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ПозицииПоСделкам.Позиция.Ссылка КАК Позиция,
	|	биг_ПозицииПоСделкам.Позиция.pos КАК pos,
	|	биг_ПозицииПоСделкам.Позиция.notionalUsd КАК notionalUsd,
	|	биг_ПозицииПоСделкам.Позиция.avgPx КАК avgPx,
	|	биг_ПозицииПоСделкам.Позиция.liqPx КАК liqPx,
	|	биг_ПозицииПоСделкам.Позиция.upl КАК upl,
	|	биг_ПозицииПоСделкам.Позиция.realizedPnl КАК realizedPnl,
	|	биг_ПозицииПоСделкам.Позиция.fee КАК fee,
	|	биг_ПозицииПоСделкам.Позиция.lever КАК lever,
	|	биг_ПозицииПоСделкам.Позиция.pnl КАК pnl,
	|	биг_ПозицииПоСделкам.Позиция.openAvgPx КАК openAvgPx,
	|	биг_ПозицииПоСделкам.Позиция.closeAvgPx КАК closeAvgPx,
	|	биг_ПозицииПоСделкам.Позиция.pnlRatio КАК pnlRatio,
	|	биг_ПозицииПоСделкам.Аккаунт КАК Аккаунт,
	|	биг_ПозицииПоСделкам.Позиция.instId КАК instId,
	|	биг_ПозицииПоСделкам.Позиция.direction КАК direction
	|ИЗ
	|	РегистрСведений.биг_ПозицииПоСделкам КАК биг_ПозицииПоСделкам
	|ГДЕ
	|	биг_ПозицииПоСделкам.Сделка = &Сделка
	|	И биг_ПозицииПоСделкам.Аккаунт В(&МассивАккаунтов)";
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("МассивАккаунтов", МассивАккаунтов);
	ТаблицаПозиций = Запрос.Выполнить().Выгрузить();
	
	ДанныеОПозициях = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаПозиций);
	Возврат ДанныеОПозициях;
	
КонецФункции

