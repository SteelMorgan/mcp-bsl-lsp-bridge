Процедура ОкруглитьЦенуДляТикСайз()
	
	// для маркет ордеров биржа сама выставит текущую цену
	// только если это спот, все остальное работает "лотами"
	Если ТипОрдера = ПредопределенноеЗначение("Перечисление.big_OKX_OrderTypes.limit")
			И ТипИнструментов = ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SPOT") Тогда
			
		ЦенаСделки = Цел(ЦенаСделки / биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(ВыбранныйИнструмент, "tickSz"));			
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Функция ОперацияВыполнимаДляКаждогоАккаунта()
	
	РеквизитыИнструмента 	= биг_ОбщегоНазначенияКлиентСервер.ЗначенияРеквизитовОбъекта(ВыбранныйИнструмент, "quoteCcy, settleCcy");
	МонетаПроверки 			= ?(ЗначениеЗаполнено(РеквизитыИнструмента.quoteCcy), РеквизитыИнструмента.quoteCcy, РеквизитыИнструмента.settleCcy);
	ИнструментСпот 			= ПредопределенноеЗначение("Перечисление.big_OKX_InstrumentType.SPOT");
	
	МассивАккаунтов 		= ПолучитьМассивАккаунтовВБаллансе();
	
	// если это спот тогда проверить, что депозит > 0 (цена есть, количество будет получено исходя из Доли от депозита)
	Отказ = Ложь;
	Если ТипИнструментов = ИнструментСпот Тогда
		ПроверкаДляКаждогоАккаунтаПортфеляЕстьДепозитВЦелевойВалюте(Отказ, МонетаПроверки, МассивАккаунтов);		
	КонецЕсли;	
	
	// для остальных рассчитываем потенциальный размер покупки и проверяем что он Больше минимального размера лота
	Если Не Отказ И ТипИнструментов <> ИнструментСпот Тогда
		//ПроверкаДостаточностиДепозитовДляОперации(Отказ, МонетаПроверки, МассивАккаунтов);	
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьМассивАккаунтовВБаллансе()
	
	МассивАккаунтов 		= Новый Массив();
	Для каждого Строка Из Объект.ТаблицаБалансы Цикл
		Если МассивАккаунтов.Найти(Строка.Account) = Неопределено Тогда
			МассивАккаунтов.Добавить(Строка.Account);	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивАккаунтов;
	
КонецФункции


&НаКлиенте
Процедура ПроверкаДляКаждогоАккаунтаПортфеляЕстьДепозитВЦелевойВалюте(Отказ, МонетаПроверки, МассивАккаунтов)
		
	Для каждого Аккаунт Из МассивАккаунтов Цикл
		
		Поиск 	= Новый Структура("ccy, Account", МонетаПроверки, Аккаунт);
		Строки 	= Объект.ТаблицаБалансы.НайтиСтроки(Поиск);
		Если Строки.Количество() = 0 Тогда
			
			Отказ = Истина;
			Шаблон 	= "Для аккаунта %1 отсутствует балланс по монете %2. Операция не возможна";
			Текст 	= СтрШаблон(Шаблон, Аккаунт, МонетаПроверки);
			Сообщить(Текст);
			
		ИначеЕсли Строки.Количество() = 1 Тогда 
			
			Если Строки[0].availBal = 0 Тогда
				Отказ = Истина;
				Шаблон 	= "Для аккаунта %1 отсутствует балланс по монете %2. Операция не возможна";
				Текст 	= СтрШаблон(Шаблон, Аккаунт, МонетаПроверки);
				Сообщить(Текст);	
			КонецЕсли;
		Иначе
			
			Сообщить("ПроверкаДляКаждогоАккаунтаПортфеляЕстьДепозитВЦелевойВалюте. Получено больше одной строки - Ошибка программы");			
		КонецЕсли;
	КонецЦикла;			
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаДостаточностиДепозитовДляОперации(Отказ, МонетаПроверки, МассивАккаунтов)

	Для каждого Аккаунт Из МассивАккаунтов Цикл
		
		Поиск 	= Новый Структура("ccy, Account", МонетаПроверки, Аккаунт);
		Строки 	= Объект.ТаблицаБалансы.НайтиСтроки(Поиск);
		
		Для каждого Строка Из Строки Цикл
			
			ОжидаемаяСуммаОперации 	= Строка.availBal / 100 * ДоляДепоДляОперации;
			ОжидаемыйРазмерОперации	= ОжидаемаяСуммаОперации / ПоследняяСвеча_ЗначениеЗакрытия;
			
			Если биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(ВыбранныйИнструмент, "minSz") > ОжидаемыйРазмерОперации Тогда
				
				Отказ = Истина;
				Шаблон 	= "Для аккаунта %1 отсутствует балланс по монете %2. Операция не возможна";
				Текст 	= СтрШаблон(Шаблон, Аккаунт, МонетаПроверки);
				Сообщить(Текст);				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

