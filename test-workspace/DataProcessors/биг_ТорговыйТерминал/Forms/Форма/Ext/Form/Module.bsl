			СформироватьОперациюПокупкиПродажи(ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.sell"));
			
		ИначеЕсли СторонаПозиции = ПредопределенноеЗначение("Перечисление.big_OKX_PositionSides.short") Тогда	
			
			// покупаем
			ДоляДепоДляОперации = 200;
			СформироватьОперациюПокупкиПродажи(ПредопределенноеЗначение("Перечисление.big_OKX_OrderSides.buy"));			
		КонецЕсли;
