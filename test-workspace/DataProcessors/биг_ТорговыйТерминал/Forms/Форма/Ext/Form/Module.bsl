&НаСервере
Процедура ВывестиИнформациюПоТекущемуИнструменту()
	
	КоллекцияЛинийЗначений = ГрафикСвечи.ИнформационныеЛинииЗначений;
	ОчиститьКоллекциюИнформационныхЛиний(КоллекцияЛинийЗначений);	
			
	ТаймСтамп 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
	СтруктураОперации 				= биг_МаркетАпиКлиентСервер.СтруктураОперации_ПолучитьЦену();
	СтруктураОперации.Биржа			= Биржа;
	СтруктураОперации.ИнструментТип	= ТипИнструментов;
	СтруктураОперации.ИнструментИД	= ИнструментИД;
		
	// текущая цена, пунктир, красный
	ТекстЛинии			= "";
	ЦветЛинии			= биг_ОбщегоНазначенияКлиентСервер.ЦветОранжевыйВизуалСтудио();
	ТипЛинии 			= ТипЛинииДиаграммы.Пунктир;	
	ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, ПоследняяСвеча_ЗначениеЗакрытия, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);
	
	Для каждого Строка Из ТаблицаОткрытыхАлгоОрдеров Цикл
		
		Если Строка.ТригерСЛ > 0 Тогда
			ТекстЛинии 	= "  | SL | " + Строка.ТригерСЛ;
			ЦветЛинии	= биг_ОбщегоНазначенияКлиентСервер.ЦветКрасныйТрейдингВью();
			ТипЛинии	= ТипЛинииДиаграммы.Сплошная;
			ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, Строка.ТригерСЛ, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);
		КонецЕсли;
		
		Если Строка.ТригерТП > 0 Тогда
			ТекстЛинии 	= "  | TP | " + Строка.ТригерТП;
			ЦветЛинии	= биг_ОбщегоНазначенияКлиентСервер.ЦветЗеленыйТрейдингВью();
			ТипЛинии	= ТипЛинииДиаграммы.Сплошная;
			ДобавитьИнформационнуюЛинию(КоллекцияЛинийЗначений, Строка.ТригерТП, ТекстЛинии, ЦветЛинии, ТипЛинии, 1);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура УдалитьИсториюЗначенийДокумента(Операция, ТочкаВозвратаТС)
	
	ТочкаПроверки = биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаВозвратаТС);
	Если ТипЗнч(Операция) = Тип("ДокументСсылка.big_AlgoOrders_OKX") Тогда
		
		Набор = РегистрыСведений.биг_ОКХ_ИсторияАлгоОрдеров.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(Операция);
		Набор.Прочитать();
		
		МассивУдалить = Новый Массив;
		
		Для каждого Строка Из Набор Цикл
			Если Строка.Период > ТочкаПроверки Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;
		КонецЦикла;                            
		
		Для каждого Строка Из МассивУдалить Цикл
			Набор.Удалить(Строка);
		КонецЦикла;
		
		Набор.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОкруглитьГраницу(Значение)
		
	ПредставлениеЗначения = Формат(Значение, "ЧРД=.; ЧГ=0");
	Подстроки = СтрРазделить(ПредставлениеЗначения, ".");
		
	Если Подстроки.Количество() = 2 Тогда
		ЕстьДробнаяЧасть = Истина;
	Иначе		
		ЕстьДробнаяЧасть = Ложь;	
	КонецЕсли;

	ДлинаЦелого 	= СтрДлина(Подстроки[0]);
	ДлинаДробной 	= ?(ЕстьДробнаяЧасть, СтрДлина(Подстроки[1]), 0);
	
	Если Значение < 1 Тогда
		
		Шаг = Окр(Значение, ДлинаДробной - 1);	
	Иначе
		
		Шаг = Окр(Значение, -1 * (ДлинаЦелого - 1));	
	КонецЕсли;
	
	Возврат Шаг;
	
КонецФункции

&НаСервере
Процедура ОпределениеПериодаГрафика()

	ТочкаЗавершения	= ТекущаяДатаСеанса();
	ТочкаНачала		= ТочкаЗавершения - (Бар.SecondsAmount * 73);
	 
КонецПроцедуры

