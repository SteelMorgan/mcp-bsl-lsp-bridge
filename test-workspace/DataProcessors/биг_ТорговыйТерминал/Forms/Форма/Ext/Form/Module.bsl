&НаКлиенте
Процедура ОтменитьАлгоОрдер(Команда)
	
	ТекСтрокаАлго = Элементы.ТаблицаОткрытыхАлгоОрдеров.ТекущиеДанные;
	Если ТекСтрокаАлго <> Неопределено Тогда
		ОтменитьАлгоОрдерНаСервере(ТекСтрокаАлго.АлгоОрдер);
	Иначе
		Сообщить("Выберите Алго-ордер для Отмены");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИзменитьАлгоНаСервере(Результат)
	
	Успешно = Ложь;
	НачатьТранзакцию();
	
	Попытка
		//ДокОбъект = Результат.АлгоОрдер.ПолучитьОбъект();
		//ДокОбъект.СтопЛосс_ТриггерНовый 	= Результат.СЛ_НовыйТриггер;
		//ДокОбъект.ТейкПрофит_ТриггерНовый 	= Результат.ТП_НовыйТриггер;
		//ДокОбъект.ОбъемНовый 				= Результат.Объем_Новый;
		//
		//ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//
		//ПоставитьАлгоОрдерВОчередьОпераций(ДокОбъект.Портфель, ДокОбъект.Сделка, Результат.АлгоОрдер);
		
		СтарыйАлго 	= Результат.АлгоОрдер.ПолучитьОбъект();
		НовыйАлго 	= Документы.биг_ОперацияТейкСтоп.СоздатьДокумент();
		КопируемыеРеквизиты = "Портфель, Сделка, Биржа, Стратегия, КлючНастроек, Сигнал, Событие, ТипОрдера, Инструмент, СтопЛосс_Цена, ТейкПрофит_Цена, РазмерПлеча, СтопЛосс_Триггер, ТейкПрофит_Триггер, Объем";
		ЗаполнитьЗначенияСвойств(НовыйАлго, СтарыйАлго, КопируемыеРеквизиты);
		
		НовыйАлго.Дата 						= ТекущаяДатаСеанса();
		НовыйАлго.ОперацияОснование 		= Результат.АлгоОрдер;
