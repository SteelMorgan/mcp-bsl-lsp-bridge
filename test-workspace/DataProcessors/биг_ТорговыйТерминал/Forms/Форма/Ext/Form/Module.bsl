&НаСервереБезКонтекста
Функция ПолучитьДанныеОпераций(МассивОжидания)
	
	ТаблицаФильтр = Новый ТаблицаЗначений();
	ТаблицаФильтр.Колонки.Добавить("Портфель", 	Новый ОписаниеТипов("СправочникСсылка.биг_Портфели"));
	ТаблицаФильтр.Колонки.Добавить("Сделка", 	Новый ОписаниеТипов("СправочникСсылка.биг_Сделки"));
	ТаблицаФильтр.Колонки.Добавить("Операция", 	Метаданные.ОпределяемыеТипы.биг_ОперацияСПортфелем.Тип);
	ТаблицаФильтр.Колонки.Добавить("Аккаунт", 	Новый ОписаниеТипов("СправочникСсылка.big_MarketAccounts"));
	
	Для каждого Строка Из МассивОжидания Цикл
		НС = ТаблицаФильтр.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Строка);
	КонецЦикла;                              
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_Фильтр.Портфель КАК Портфель,
	|	ВТ_Фильтр.Сделка КАК Сделка,
	|	ВТ_Фильтр.Операция КАК Операция,
	|	ВТ_Фильтр.Аккаунт КАК Аккаунт
	|ПОМЕСТИТЬ ВТ_Фильтр
	|ИЗ
	|	&ВТ_Фильтр КАК ВТ_Фильтр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	биг_ОперацииПортфеля.Портфель КАК Портфель,
	|	биг_ОперацииПортфеля.Сделка КАК Сделка,
	|	биг_ОперацииПортфеля.Операция КАК Операция,
	|	биг_ОперацииПортфеля.Аккаунт КАК Аккаунт,
	|	биг_ОперацииПортфеля.ИнтеграционныйДокумент КАК ИнтеграционныйДокумент,
	|	биг_ОперацииПортфеля.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.биг_ОперацииПортфеля КАК биг_ОперацииПортфеля
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Фильтр КАК ВТ_Фильтр
	|		ПО биг_ОперацииПортфеля.Портфель = ВТ_Фильтр.Портфель
	|			И биг_ОперацииПортфеля.Сделка = ВТ_Фильтр.Сделка
	|			И биг_ОперацииПортфеля.Операция = ВТ_Фильтр.Операция
	|			И биг_ОперацииПортфеля.Аккаунт = ВТ_Фильтр.Аккаунт
	|ГДЕ
	|	биг_ОперацииПортфеля.Статус <> ЗНАЧЕНИЕ(Перечисление.big_СтатусыТорговыхОбъектов.Новый)";
	
	ПустойИдентификатор  = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Запрос.УстановитьПараметр("ПустойИдентификатор", ПустойИдентификатор);
	Запрос.УстановитьПараметр("ВТ_Фильтр", ТаблицаФильтр);
	
	ДеталиОпераций 			= Запрос.Выполнить().Выгрузить();
	МассивСтруктурТаблицы 	= ОбщегоНазначения.ТаблицаЗначенийВМассив(ДеталиОпераций);	

	Возврат МассивСтруктурТаблицы;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОперативнуюЦенуИнструмента(Биржа, Инструмент, Бар)
	
	РеквизитыИнструмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Инструмент, "instType, instId");
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьСвечи();
	СтруктураОперации.Биржа            	= Биржа;
	СтруктураОперации.ИнструментИД		= РеквизитыИнструмента.instId;
	СтруктураОперации.Бар              	= Бар;
	СтруктураОперации.КоличествоСвечей 	= 1;
	
	Свеча = Неопределено;
	МассивСвечей = биг_МаркетАпи.ПолучитьПоследнююСвечу(СтруктураОперации);
	Если МассивСвечей <> Неопределено И МассивСвечей.Количество() > 0 Тогда
		Свеча = МассивСвечей[0];
	КонецЕсли;
	
	Возврат Свеча;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвечиГрафикаНаБирже(Биржа, Инструмент, Бар, ТочкаНачала, ТочкаЗавершения)
	
	ТС 						= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаЗавершения);
	ГрузитьДоТочкиТС 		= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(ТочкаНачала);
		
	ТССтрока 				= биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ТС);
	ГрузитьДоТочкиТССтрока	= биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ГрузитьДоТочкиТС);
	
	РеквизитыИнструмента 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Инструмент, "instType, instId");
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьИсториюСвечей();
	СтруктураОперации.Биржа            = Биржа;
	СтруктураОперации.ИнструментИД     = РеквизитыИнструмента.instId;
	СтруктураОперации.Бар              = Бар;
	СтруктураОперации.ТочкаДо          = ТССтрока;
	СтруктураОперации.ТочкаПосле       = ГрузитьДоТочкиТССтрока;
	СтруктураОперации.КоличествоСвечей = 100;	

	МассивСвечей = биг_МаркетАпи.ПолучитьИсториюСвечей(СтруктураОперации);
	ДополнитьМассивСвечейДаннымиОбИндикаторах(МассивСвечей);
	Возврат МассивСвечей;
	
КонецФункции 

&НаСервереБезКонтекста
