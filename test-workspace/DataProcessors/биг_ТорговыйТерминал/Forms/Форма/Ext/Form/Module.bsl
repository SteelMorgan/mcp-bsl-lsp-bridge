		Сообщить(Ошибка);
	КонецПопытки;
	
	Возврат Успешно;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьАлго(Команда)
	
	ТекСтрокаАлго = Элементы.ТаблицаОткрытыхАлгоОрдеров.ТекущиеДанные;
	Если ТекСтрокаАлго <> Неопределено Тогда
		ПараметрыОткрытия 	= Новый Структура("АлгоОрдер, Сделка, ТекущаяЦена", ТекСтрокаАлго.АлгоОрдер, Сделка, ПоследняяСвеча_ЗначениеЗакрытия);
		Оповещение			= Новый ОписаниеОповещения("ВводУровнейАлгоОрдераЗавершение", ЭтаФорма);
		ОткрытьФорму("Обработка.биг_ТорговыйТерминал.Форма.ФормаВыбораУровняАлгоОрдера", ПараметрыОткрытия, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Сообщить("Выберите Алго-ордер для Отмены");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВводУровнейАлгоОрдераЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда                      
		Если ИзменитьАлгоНаСервере(Результат) Тогда
			ПодключитьОбработчикОжидания("КонтрольРезультатаОперации", 1);
			ПодключитьОбработчикОжидания("ОбновлениеИнформацииОПозициях", 1);
			ПодключитьОбработчикОжидания("ОбновлениеИнформацииОбОрдерах", 3);
			ДоляДепоДляОперации = 0;
			ЗаблокироватьКомандыОпераций();			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоставитьАлгоОрдерВОчередьОпераций(Портфель, Сделка, Операция)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.биг_ОперацииПортфеля");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Портфель", 	Портфель);
	ЭлементБлокировки.УстановитьЗначение("Сделка", 		Сделка);
	ЭлементБлокировки.УстановитьЗначение("Операция", 	Операция);
	Блокировка.Заблокировать(); 
	
	ОчередьОпераций = РегистрыСведений.биг_ОперацииПортфеля.СоздатьНаборЗаписей();
	ОчередьОпераций.Отбор.Портфель.Установить(Портфель);
	ОчередьОпераций.Отбор.Сделка.Установить(Сделка);
	ОчередьОпераций.Отбор.Операция.Установить(Операция);
	ОчередьОпераций.Прочитать();
	
	// получается мы храним только последнюю "интеграцию" по каждой операции
	// возможно в будущем нужно будет добавить в регистр измерение с идентификатором действия
	// и тогда не нужно будет очищать, и будет храниться вся история
	ОчередьОпераций.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_УчастникиПортфелейСрезПоследних.Аккаунт КАК Аккаунт
	|ИЗ
	|	РегистрСведений.биг_УчастникиПортфелей.СрезПоследних(
	|			&ДатаДокумента,
	|			Портфель = &Портфель
	|				И Участник = ИСТИНА) КАК биг_УчастникиПортфелейСрезПоследних";
	
	Запрос.УстановитьПараметр("Портфель", 		Портфель);
	Запрос.УстановитьПараметр("ДатаДокумента", 	ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НС = ОчередьОпераций.Добавить();
		НС.Портфель = Портфель;
		НС.Сделка	= Сделка;
		НС.Операция	= Операция;
		НС.Аккаунт	= Выборка.Аккаунт;						
		НС.Статус	= Перечисления.big_СтатусыТорговыхОбъектов.Новый;			
	КонецЦикла;
	
	ОчередьОпераций.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти //СлужебныеПроцедурыИФункции   





 









































  






