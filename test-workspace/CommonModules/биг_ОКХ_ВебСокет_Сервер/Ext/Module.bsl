Процедура ПроверитьСоздатьСоединениеВебСокет(Слушатель, Клиент, ВыполнитьАвторизацию = Ложь) Экспорт
	
	СостояниеСоединения = Клиент.ПолучитьСостояниеСоединения();
	Если СостояниеСоединения = СостояниеWebSocketСоединения.Открыто ИЛИ СостояниеСоединения = СостояниеWebSocketСоединения.Открывается Тогда
		Соединение = Клиент.ПолучитьТекущееСоединение();
	Иначе
		Соединение = Клиент.Подключить();
		РегистрыСведений.биг_СоединенияВебСокет.ЗафиксироватьКлючСлушателя(Слушатель, Клиент.URLСервера, Клиент.Ключ, Соединение.Ключ, ВыполнитьАвторизацию);
		
		Если ВыполнитьАвторизацию Тогда
			Авторизация(Соединение, Слушатель);
		Иначе
			ПодписатьсяНаОнлайнКаналы(Соединение, Слушатель);
		КонецЕсли;		 
	КонецЕсли;               
	
КонецПроцедуры

Функция ЗакрытьСессиюСлушателя_Паблик(Слушатель) Экспорт
	
	ПубличныйСокет	= АдресВебСокет_Паблик();
	КлючСоединения 	= РегистрыСведений.биг_СоединенияВебСокет.ПолучитьКлючСоединенияСлушателя(Слушатель, ПубличныйСокет.Адрес);
	Если КлючСоединения <> Неопределено И КлючСоединения <> "" Тогда
		Соединение = WebSocketКлиентСоединения.ПолучитьСоединение(КлючСоединения);
		Если Соединение <> Неопределено И Соединение.ПолучитьСостояние() = СостояниеWebSocketСоединения.Открыто Тогда
			Соединение.Закрыть();	
		КонецЕсли;		
	КонецЕсли;	
	
КонецФункции

Функция ЗакрытьСессиюСлушателя_Приват(Слушатель) Экспорт
	
	ЭтоДемо			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Слушатель, "demo");
	ПриватныйСокет	= АдресаВебСокетОКХ_Приват();	
	АдресПоиска 	= ?(ЭтоДемо, ПриватныйСокет.АдресДемо, ПриватныйСокет.Адрес);
	
