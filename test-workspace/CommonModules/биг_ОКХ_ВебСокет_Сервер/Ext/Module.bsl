	ПриватАдреса 	= АдресаВебСокетОКХ_Приват();
	Если Адрес = ПриватАдреса.Адрес ИЛИ Адрес = ПриватАдреса.АдресДемо Тогда
		
		ПараметрыОперацииБиржи = ПараметрыПодпискиНаОбновлениеОрдеров();
		МассивПакетов.Добавить(ПараметрыОперацииБиржи);
		
		ПараметрыОперацииБиржи = ПараметрыПодпискиНаОбновлениеПозиций();
		МассивПакетов.Добавить(ПараметрыОперацииБиржи);
	КонецЕсли;
	
	// Для паблик данных пока что не требуется постоянно поддерживать какие то подписки,
	// но если потребуется это должно жить здесь
	
