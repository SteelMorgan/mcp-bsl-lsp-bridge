#Область СлужебныеПроцедурыФункции

Функция НайтиСоздатьКлиентВебСокет(Слушатель, ДанныеСокета, Демо)
		
	АдресПоиска 	= ?(Демо, ДанныеСокета.АдресДемо, ДанныеСокета.Адрес);
	
	КлючКлиента 	= ПолучитьКлючКлиентаВебСокета(Слушатель, АдресПоиска);
	Если КлючКлиента = "" Тогда
		КлючКлиента = Строка(Новый УникальныйИдентификатор());		
	КонецЕсли; 
	
	Возврат ПолучитьКлиентаВебСокет(АдресПоиска, КлючКлиента);
		
КонецФункции

Функция ПолучитьКлючКлиентаВебСокета(Слушатель, АдресПоиска)
	
	Возврат РегистрыСведений.биг_СоединенияВебСокет.КлючКлиентаАдресаПоСлушателю(Слушатель, АдресПоиска);
		
КонецФункции

Функция ПолучитьКлиентаВебСокет(Адрес, Ключ)
	
	Клиент = WebSocketКлиенты.НайтиПоКлючу(Ключ);
	
	Если Клиент = Неопределено Тогда
		Клиент = WebSocketКлиенты.СоздатьКлиента(Метаданные.WebSocketКлиенты.биг_ВебСокет_ОКХ, Ключ);
		Клиент.URLСервера = Адрес;
		Клиент.Записать();		
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Процедура Авторизация(Соединение, Аккаунт)
	
	СтруктураОперации = биг_ОКХ_ВебСокет_КлиентСервер.СП_Логин();
	
	method 								= "GET";
	requestPath 						= "/users/self/verify";
	timestamp							= Формат(Цел(биг_ОбщегоНазначенияКлиентСервер.ТекущаяДатаВМиллисекундахЭпохаUnixGMT0() / 1000), "ЧГ=0");
	ПараметрыАккаунта 					= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Аккаунт, "APIKey, passphrase, SecretKey");
	
	СтруктураОперации.args[0].apiKey 		= ПараметрыАккаунта.APIKey;
	СтруктураОперации.args[0].passphrase 	= ПараметрыАккаунта.passphrase;
	СтруктураОперации.args[0].timestamp		= timestamp;	
	
	prehashString 						= timestamp + method + requestPath; 
	secretKey 							= ПараметрыАккаунта.SecretKey;	
	secretKeyDoubleData					= ПолучитьДвоичныеДанныеИзСтроки(secretKey);
	sign 								= РаботаВМоделиСервисаБТС.Подпись(secretKeyDoubleData, prehashString);
	
	СтруктураОперации.args[0].sign		= sign;
	
	СтрокаJson 							= биг_КоннекторHTTP.ОбъектВJson(СтруктураОперации);
	
	Параметры = биг_ОКХ_ВебСокет_КлиентСервер.ПараметрыСоединения(Соединение);
	Параметры.Вставить("Сообщение", СтрокаJson);
	биг_ВебСокет_Сервер.ЗаписатьВЛог("ОтправкаСообщения", Соединение.Ключ, Параметры);
	
	Соединение.ОтправитьСообщение(СтрокаJson);
			
КонецПроцедуры

Процедура ПодписатьсяНаОнлайнКаналы(Соединение, Слушатель)
	
	Адрес 								= Соединение.URLСервера;
	МассивПараметровОперацийПодписки 	= СформироватьНеобходимыеПакеты(Адрес);
	
	Для каждого ПараметрыОперацииБиржи Из МассивПараметровОперацийПодписки Цикл
		ПодписатьсяНаКанал(ПараметрыОперацииБиржи, Слушатель);	
	КонецЦикла;
	
КонецПроцедуры 

Процедура ПодписатьсяНаКанал(ПараметрыОперацииБиржи, Слушатель, Соединение = Неопределено)
	
	Если ПараметрыОперацииБиржи.args.Количество() = 0 Тогда
		Сообщить("Не заполнен массив аругментов");
		Возврат;
	КонецЕсли;
	
	Аргумент 		= ПараметрыОперацииБиржи.args[0];
	КаналПодписки 	= Аргумент.channel;
	Демо			= Ложь;
	
	Если ТипЗнч(Слушатель) = Тип("СправочникСсылка.big_MarketAccounts") Тогда
		Демо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Слушатель, "demo");		
	КонецЕсли;
		
	Если Соединение = Неопределено Тогда
		// получить текущее соединение
		URLАдресСоединения 	= биг_ОКХ_ВебСокет_КлиентСервер.ПолучитьУРЛпоНазваниюКаналаПодписки(КаналПодписки, Демо);
		Ключ 				= биг_ВебСокет_Сервер.ПолучитьКлючСоединения(Слушатель, URLАдресСоединения);
		Соединение 			= WebSocketКлиентСоединения.ПолучитьСоединение(Ключ);	
	КонецЕсли;
	
	Состояние 	= Соединение.ПолучитьСостояние();
	
	// проверить состояние соединения
	Если НЕ (Состояние = СостояниеWebSocketСоединения.Открыто ИЛИ Состояние = СостояниеWebSocketСоединения.Открывается) Тогда
		
		Сообщить("Соединение вебсокета отсутствует, хотя должно быть. Подписка на канал не выполнена");
		Возврат;
	КонецЕсли;	

	СтрокаJson 		= биг_КоннекторHTTP.ОбъектВJson(ПараметрыОперацииБиржи);
	
	Параметры = биг_ОКХ_ВебСокет_КлиентСервер.ПараметрыСоединения(Соединение);
	Параметры.Вставить("Сообщение", СтрокаJson);
	биг_ВебСокет_Сервер.ЗаписатьВЛог("ОтправкаСообщения", Ключ, Параметры);
	
	Соединение.ОтправитьСообщение(СтрокаJson);
	
КонецПроцедуры                                      

Процедура ПодобратьКлючИПроверитьСоединение(Слушатель, Клиент, ВыполнитьАвторизацию = Ложь)

	КлючСоединения = РегистрыСведений.биг_СоединенияВебСокет.ПолучитьКлючСоединенияСлушателя(Слушатель, Клиент.URLСервера);
	Если КлючСоединения = Неопределено ИЛИ КлючСоединения = "" Тогда
		
		ПроверитьСоздатьСоединениеВебСокет(Слушатель, Клиент, ВыполнитьАвторизацию);
	Иначе
		
		// проверить, что Соединение живое
		Соединение = WebSocketКлиентСоединения.ПолучитьСоединение(КлючСоединения);
		Если Соединение = Неопределено Тогда
			ПроверитьСоздатьСоединениеВебСокет(Слушатель, Клиент, ВыполнитьАвторизацию);
		Иначе
			Состояние 	= Соединение.ПолучитьСостояние();
			Если Состояние = СостояниеWebSocketСоединения.Закрыто ИЛИ Состояние = СостояниеWebSocketСоединения.Закрывается Тогда
				ПроверитьСоздатьСоединениеВебСокет(Слушатель, Клиент, ВыполнитьАвторизацию);	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция АдресаВебСокетОКХ_Приват()
	
	Структура = Новый Структура();
	Структура.Вставить("Адрес", 	"wss://ws.okx.com:8443/ws/v5/private");
	Структура.Вставить("АдресДемо", "wss://wspap.okx.com:8443/ws/v5/private");
	
	Возврат Структура;
		
КонецФункции

Функция АдресВебСокет_Паблик()
	
	Структура = Новый Структура();
	Структура.Вставить("Адрес", 	"wss://ws.okx.com:8443/ws/v5/public");
	Структура.Вставить("АдресДемо", "wss://wspap.okx.com:8443/ws/v5/public");
	
	Возврат Структура;
		
КонецФункции

#КонецОбласти //СлужебныеПроцедурыФункции  


