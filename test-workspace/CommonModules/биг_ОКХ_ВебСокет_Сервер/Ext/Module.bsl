	Если КлючСоединения <> Неопределено И КлючСоединения <> "" Тогда
		Соединение = WebSocketКлиентСоединения.ПолучитьСоединение(КлючСоединения);
		Если Соединение <> Неопределено И Соединение.ПолучитьСостояние() = СостояниеWebSocketСоединения.Открыто Тогда
			Соединение.Закрыть();	
		КонецЕсли;		
	КонецЕсли;	
	
КонецФункции

Процедура Подпис_МаркетЦены(СтруктураОбщегоФормата) Экспорт	
		
	ПараметрыОперации = биг_ОКХ_ВебСокет_КлиентСервер.Мап_МаркетЦены(СтруктураОбщегоФормата);
	биг_ОбщегоНазначенияКлиентСервер.УдалитьНеЗаполненныеПараметры(ПараметрыОперации);
	
