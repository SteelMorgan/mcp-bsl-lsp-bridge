	//Если Адрес = ПабликАдреса.Адрес ИЛИ Адрес = ПабликАдреса.АдресДемо Тогда
	//	
	//КонецЕсли;
	
	Возврат МассивПакетов;
	
КонецФункции

Функция ПараметрыПодпискиНаОбновлениеОрдеров()
		
	Параметры = биг_ОКХ_ВебСокет_КлиентСервер.СП_Подписка_ИзмененияОрдеров();
	Параметры.op = "subscribe"; 
	
	МассивАргументов = Новый Массив();
	Аргумент = биг_ВебСокет_КлиентСервер.Опис_ИзмененияОрдеров_Аргументы();
	Аргумент.ИнструментТип = "SPOT";
