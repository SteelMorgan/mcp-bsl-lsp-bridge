	ЗаполнениеOKX 	= Обработки.big_OKX_API.Создать();
	Для каждого СтруктураДанных Из Данные Цикл
		ДокументОперации = ЗаполнениеOKX.Ордер_СоздатьДополнитьПоОтвету(СтруктураДанных, Слушатель);
		
		Если ЗначениеЗаполнено(СтруктураДанных.clOrdId) И ЗначениеЗаполнено(СтруктураДанных.fillSz) Тогда
			
			МассивОпераций = биг_ОКХ_Сервер.ПолучитьМассивСвязанныхОпераций(ДокументОперации);
			биг_СтратегииСервер.ЗафиксироватьОперацию(МассивОпераций);			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаОтветов_КаналПозиций(Соединение, Сообщение, Данные, Канал)

	Слушатель 		= РегистрыСведений.биг_СоединенияВебСокет.СлушательПоКлючуСоединения(Соединение.Ключ);
