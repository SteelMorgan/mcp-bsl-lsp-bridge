    Возврат биг_ОКХ_КлиентСервер.ПараметрыОперацииБиржи_ЗагрузитьТикеры(ПараметрыОперации);
	
КонецФункции

#КонецОбласти //ПереадресацияСтруктурПараметров
						  
						  
#Область Служебные

Функция ИнициализироватьМодуль()
	
	Модуль = Обработки.big_OKX_API.Создать();
	Возврат Модуль;
		
КонецФункции

Процедура УдалитьНеЗаполненныеПараметры(ОбъектПроверки)
	
	Если ТипЗнч(ОбъектПроверки) = Тип("Структура") ИЛИ ТипЗнч(ОбъектПроверки) = Тип("Соответствие") Тогда
		МассивКоллекцийКлючЗначение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектПроверки);
	ИначеЕсли ТипЗнч(ОбъектПроверки) = Тип("Массив") Тогда
		МассивКоллекцийКлючЗначение = ОбъектПроверки;
	Иначе
		ВызватьИсключение "Не верный тип данных для проверки пустых параметров";
	КонецЕсли;
	
	Для каждого КоллекцияПараметров Из МассивКоллекцийКлючЗначение Цикл 
		
		МассивУдалить = Новый Массив;
		
		Для каждого Элемент Из КоллекцияПараметров Цикл
			
			ТипЗначения = ТипЗнч(Элемент.Значение);
			Если ТипЗначения = Тип("Строка") Тогда
				
				Если НЕ ЗначениеЗаполнено(Элемент.Значение) ИЛИ Элемент.Значение = "0" Тогда
					МассивУдалить.Добавить(Элемент.Ключ);
				КонецЕсли; 
				
			ИначеЕсли ТипЗначения = Тип("Массив") Тогда 
				
				УдалитьНеЗаполненныеПараметры(Элемент.Значение);	
			КонецЕсли;	
		КонецЦикла;
		
		Для каждого Ключ Из МассивУдалить Цикл
			КоллекцияПараметров.Удалить(Ключ);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры  

Процедура Бектест_АлгоОрдер_УстановитьСтатусОтменен(ПараметрыОперацииБиржи)
	
	Для каждого СтруктураПараметров Из ПараметрыОперацииБиржи Цикл
		
		АлгоОрдер = Документы.big_AlgoOrders_OKX.НайтиПоРеквизиту("algoId", СтруктураПараметров.algoId);
		ОрдерОбъект = АлгоОрдер.ПолучитьОбъект();
		ОрдерОбъект.state = "canceled";
		ОрдерОбъект.Статус = Перечисления.big_СтатусыТорговыхОбъектов.Отменен;
		ОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
		
КонецПроцедуры

Процедура ПолучитьДанныеБиржиОбОрдере(ПараметрыОперацииБиржи, Аккаунт)
	
	ПараметрыАктуализироватьОрдер = биг_ОКХ_КлиентСервер.СтруктураЗапроса_АктуализироватьОрдер();
	ПараметрыАктуализироватьОрдер.clOrdId 	= ПараметрыОперацииБиржи.clOrdId;
	ПараметрыАктуализироватьОрдер.instId 	= ПараметрыОперацииБиржи.instId;
	
	АктуализироватьОрдер(ПараметрыАктуализироватьОрдер, Аккаунт);
	
	Для каждого Структура Из ПараметрыОперацииБиржи.attachAlgoOrds Цикл
		
		ПараметрыАктуализироватьАлгоОрдер = биг_ОКХ_КлиентСервер.СтруктураЗапроса_АктуализироватьАлгоОрдер();
		ПараметрыАктуализироватьАлгоОрдер.algoClOrdId = Структура.attachAlgoClOrdId;
		
		АктуализироватьАлгоОрдер(ПараметрыАктуализироватьАлгоОрдер, Аккаунт);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначенияСвечиПоТочкеСПодборомФрейма(ИнструментИД, ТаймСтамп, Бар) Экспорт
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ПараметрыЗапроса.Биржа          = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("OKX");
	ПараметрыЗапроса.ИнструментИД   = ИнструментИД;
	ПараметрыЗапроса.Бар 			= Бар;
	
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= ТаймСтамп;
	ПараметрыЗапроса.СортировкаПоУбыванию				= Истина;
	ПараметрыЗапроса.КоличествоСвечей					= 1;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	
	ЦенаЗакрытия = ПолучитьЦенуЗакрытияРекурсивно(ПараметрыЗапроса);
	
	Возврат ЦенаЗакрытия;
	
КонецФункции

Функция ПолучитьЦенуЗакрытияРекурсивно(ПараметрыЗапроса)
	
	ДанныеСвечей = биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);
	
	Если ДанныеСвечей.Количество() = 0 Тогда
		
		СтаршийБар = биг_ОбщегоНазначения.НайтиСтаршийФрейм(ПараметрыЗапроса.Бар);
		Если СтаршийБар = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			ПараметрыЗапроса.Бар = СтаршийБар;
			Возврат ПолучитьЦенуЗакрытияРекурсивно(ПараметрыЗапроса)
		КонецЕсли;
		
	Иначе
		Возврат ДанныеСвечей[0].ЦенаЗакрытия;	
	КонецЕсли;	
	
КонецФункции

Процедура ЗаписатьДанныеАлгоордераВИсторию(ПараметрыОперацииБиржи)
	
	Если ПараметрыОперацииБиржи.Свойство("algoClOrdId") Тогда
		УидБезРазделителей = ПараметрыОперацииБиржи.algoClOrdId;
	Иначе
		УидБезРазделителей = ПараметрыОперацииБиржи.КлиентАлгоОрдерИД;	
	КонецЕсли;
	
	УИДСтрока	= биг_ОбщегоНазначенияКлиентСервер.ДополнитьUUIDразделителями(УидБезРазделителей);
	УИД 		= Новый УникальныйИдентификатор(УИДСтрока);
	Ссылка 		= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(УИД);
	
	РеквизитыДокумента = "tpTriggerPx, tpOrdPx, sz, slTriggerPx, slOrdPx, uTime, cTime";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, РеквизитыДокумента);
	
	Запись 				= РегистрыСведений.биг_ОКХ_ИсторияАлгоОрдеров.СоздатьМенеджерЗаписи();
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.uTime) Тогда		
		Строка13		= Формат(ЗначенияРеквизитов.uTime, "ЧГ=0");		
	Иначе		
		Строка13		= Формат(ЗначенияРеквизитов.cTime, "ЧГ=0");	
	КонецЕсли;

	Если ЗначениеЗаполнено(Строка13) Тогда
		Запись.Период 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(Лев(Строка13, 10));
	Иначе
		Запись.Период 	= ТекущаяДатаСеанса();	
	КонецЕсли;
	
	Запись.Документ		= Ссылка;
	Запись.tpTriggerPx	= ЗначенияРеквизитов.tpTriggerPx;
	Запись.tpOrdPx		= ЗначенияРеквизитов.tpOrdPx;
	Запись.sz			= ЗначенияРеквизитов.sz;
	Запись.slTriggerPx	= ЗначенияРеквизитов.slTriggerPx;
	Запись.slOrdPx		= ЗначенияРеквизитов.slOrdPx;
	
	Запись.Записать(Истина);
	
КонецПроцедуры

Функция ПересчитатьВКонтракты(РазмерОрдера, Инструмент) Экспорт

	РазмерКонтракта 	= биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(Инструмент, "ctVal");
	МножительКонтракта 	= биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(Инструмент, "ctMult");
	
	Если ЗначениеЗаполнено(РазмерКонтракта) И РазмерКонтракта > 0 Тогда
		РазмерОрдера = РазмерОрдера / РазмерКонтракта / МножительКонтракта;
	КонецЕсли;
	
	Возврат РазмерОрдера;
КонецФункции

#КонецОбласти //Служебные


#Область Данные

Функция ПолучитьКлючевыеДанныеОперации(ДокументОперации) Экспорт
	
	СтруктураОтвета 	= биг_МаркетАпиКлиентСервер.СтруктураОсновныхДанныхОперации();
	
	СтрокаРеквизитов 	= "Аккаунт, instId, sz, fillSz, px, fillPx, fee, pnl";
	ЗначенияОперации 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОперации, СтрокаРеквизитов);
	
	СтруктураОтвета.Биржа			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияОперации.Аккаунт, "Владелец");
	СтруктураОтвета.Аккаунт			= ЗначенияОперации.Аккаунт;
	СтруктураОтвета.ИнструментИД	= ЗначенияОперации.instId;
	СтруктураОтвета.Размер			= ЗначенияОперации.sz;
	СтруктураОтвета.РазмерЗаполнено	= ЗначенияОперации.fillSz;
	СтруктураОтвета.Цена			= ЗначенияОперации.px;
	СтруктураОтвета.ЦенаЗаполнено	= ЗначенияОперации.fillPx;
	СтруктураОтвета.Сумма			= ?(СтруктураОтвета.РазмерЗаполнено > 0, СтруктураОтвета.РазмерЗаполнено, СтруктураОтвета.Размер) * ?(СтруктураОтвета.ЦенаЗаполнено > 0, СтруктураОтвета.ЦенаЗаполнено, СтруктураОтвета.Цена);
	СтруктураОтвета.Комиссия		= ЗначенияОперации.fee;
	СтруктураОтвета.ПрофитУбыток	= ЗначенияОперации.pnl;
	
	Возврат СтруктураОтвета;
	
КонецФункции

