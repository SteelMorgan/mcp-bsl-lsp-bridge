#Область Бектест

Процедура СоздатьДокумент_Ордер_Бектест(ПараметрыОперации, Ордер, ТаймСтамп)
	
	Если ЗначениеЗаполнено(ТаймСтамп) Тогда
		Ордер.Дата 	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТаймСтамп);
		Ордер.cTime	= ТаймСтамп;
	КонецЕсли;
	
	// т.к. ордер реально на биржу отправляться не будет, то делаем вид, будто он успешно выполнен
	Ордер.state 	= "filled";
	Ордер.fillTime	= ТаймСтамп * 1000;
	
	Ордер.fillSz 	= ПараметрыОперации.РазмерОрдера;
	
	Если ПараметрыОперации.ОрдерТип = Перечисления.big_OKX_OrderTypes.market Тогда
		
		// цена маркет-ордера должна определяться биржей в момент обработки, поэтому в рамках бектеста берем
		// цену закрытия предыдущей свечи (ну или можно грузить регулярные                           
		Бар				= Справочники.big_BarTypes.H1;
		Ордер.fillPx 	= ПолучитьЗначенияСвечиПоТочкеСПодборомФрейма(ПараметрыОперации.ИнструментИД, ТаймСтамп, Бар);
		//Ордер.fillPx	= Окр(Ордер.fillPx * 0.9999, 2);
	Иначе
		Ордер.fillPx	= ПараметрыОперации.ЦенаОрдера;	
	КонецЕсли;

	Ордер.px = Ордер.fillPx;
	Ордер.sz = Ордер.fillSz;
	
	Если ПараметрыОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN Тогда
		
		Ордер_Бектест_Маржинальный(Ордер, ПараметрыОперации);
		
	ИначеЕсли ПараметрыОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SWAP Тогда	
		
		Ордер_Бектест_Своп(Ордер, ПараметрыОперации); // в интерактиве почему то это Фьючерс
		
	ИначеЕсли ПараметрыОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT Тогда	
		
		Ордер_Бектест_Спот(Ордер, ПараметрыОперации);
	КонецЕсли;
	    	
КонецПроцедуры  

