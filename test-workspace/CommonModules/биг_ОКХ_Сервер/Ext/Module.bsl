Процедура Ордер_Бектест_ВычислитьPnL(ДокументОперации) Экспорт
	
	// получить:
	// - среднюю цену покупки сигнала (себес)
	// - размер комиссий закупки
	// - размер комиссий продажи
	// ПрофитУбыток = Сумма продажи - Цена закупа - Комисси
	
	Инструмент			= Справочники.big_Instruments.НайтиПоРеквизиту("instId", ДокументОперации.instId);       	
	ОбъектДокумента 	= ДокументОперации.ПолучитьОбъект();
	
	ОбъемПродажи 		= ОбъектДокумента.fillSz * Инструмент.ctVal;
	ЦенаПродажи 		= ОбъектДокумента.fillPx;
	Комиссия			= ОбъектДокумента.fee;
	ТекущийПрофитУбыток = ВычислитьПрофитУбытокСигналаПоОрдеруСигнала(ДокументОперации, Истина); 
		
	Если ОбъектДокумента.Событие = Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс 
		И ОбъектДокумента.side = Перечисления.big_OKX_OrderSides.sell Тогда
		
		ПрофитУбыток 		= (ОбъемПродажи * ЦенаПродажи) + Комиссия + ТекущийПрофитУбыток;
	ИначеЕсли ОбъектДокумента.Событие = Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс 
		И ОбъектДокумента.side = Перечисления.big_OKX_OrderSides.buy Тогда
		
		ПрофитУбыток 		= (ОбъемПродажи * ЦенаПродажи * -1) + Комиссия + ТекущийПрофитУбыток;
	КонецЕсли;
		
	ОбъектДокумента.pnl = ПрофитУбыток;
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
		
КонецПроцедуры 

Функция ВычислитьПрофитУбытокСигналаПоордеруСигнала(Операция, ИсключаяСтопЛосс = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Операция.fillPx КАК px,
	|	биг_ДаблИмпактОперации.Операция.fillSz КАК sz,
	|	ВЫБОР
	|		КОГДА биг_ДаблИмпактОперации.Операция.side = ЗНАЧЕНИЕ(Перечисление.big_OKX_OrderSides.sell)
	|			ТОГДА биг_ДаблИмпактОперации.Операция.fillSz * биг_ДаблИмпактОперации.Операция.fillPx * big_Instruments.ctVal
	|		ИНАЧЕ биг_ДаблИмпактОперации.Операция.fillSz * биг_ДаблИмпактОперации.Операция.fillPx * big_Instruments.ctVal * -1
	|	КОНЕЦ КАК sum,
	|	биг_ДаблИмпактОперации.Операция.fee КАК fee
	|ПОМЕСТИТЬ ВТ_ОперацииСигнала
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.big_Instruments КАК big_Instruments
	|		ПО биг_ДаблИмпактОперации.ИнструментИД = big_Instruments.instId
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И биг_ДаблИмпактОперации.Событие В(&СобытияПокупки)
	|	И (ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_Order_OKX)) <> ЗНАЧЕНИЕ(Документ.big_Order_OKX.ПустаяСсылка)
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Операция.fillPx,
	|	биг_ДаблИмпактОперации.Операция.fillSz,
	|	ВЫБОР
	|		КОГДА биг_ДаблИмпактОперации.Операция.side = ЗНАЧЕНИЕ(Перечисление.big_OKX_OrderSides.sell)
	|			ТОГДА биг_ДаблИмпактОперации.Операция.fillSz * биг_ДаблИмпактОперации.Операция.fillPx * big_Instruments.ctVal * -1
	|		ИНАЧЕ биг_ДаблИмпактОперации.Операция.fillSz * биг_ДаблИмпактОперации.Операция.fillPx * big_Instruments.ctVal
	|	КОНЕЦ,
	|	биг_ДаблИмпактОперации.Операция.fee
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.big_Instruments КАК big_Instruments
	|		ПО биг_ДаблИмпактОперации.НастройкаСтратегии = big_Instruments.instId
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И биг_ДаблИмпактОперации.Событие = &СобытиеПродажи
	|	И (ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_Order_OKX)) <> ЗНАЧЕНИЕ(Документ.big_Order_OKX.ПустаяСсылка)
	|	И НЕ &ИсключаяСтопЛосс
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_ОперацииСигнала.sum) КАК sum,
	|	СУММА(ВТ_ОперацииСигнала.fee) КАК fee
	|ПОМЕСТИТЬ ВТ_Групп
	|ИЗ
	|	ВТ_ОперацииСигнала КАК ВТ_ОперацииСигнала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Групп.sum КАК sum,
	|	ВТ_Групп.fee КАК fee,
	|	ВТ_Групп.sum + ВТ_Групп.fee КАК pnl
	|ИЗ
	|	ВТ_Групп КАК ВТ_Групп";

	СписокРеквизитов = "Аккаунт, instId, ТочкаНачалаПадения, НастройкаСтратегии";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, СписокРеквизитов);
	
	Запрос.УстановитьПараметр("Биржа", 				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитов.Аккаунт, "Владелец"));
	Запрос.УстановитьПараметр("ИнструментИД", 		ЗначенияРеквизитов.instId);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ЗначенияРеквизитов.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("Аккаунт", 			ЗначенияРеквизитов.Аккаунт);
	Запрос.УстановитьПараметр("НастройкаСтратегии", ЗначенияРеквизитов.НастройкаСтратегии);
	Запрос.УстановитьПараметр("СобытиеПродажи", 	Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс);
	Запрос.УстановитьПараметр("ИсключаяСтопЛосс", 	ИсключаяСтопЛосс);
	
	СобытияПокупки = Новый Массив();
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаОдин);
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва);
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеРазворотаТренда);
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеУвеличенияПозиции);
	Запрос.УстановитьПараметр("СобытияПокупки", СобытияПокупки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.pnl;
	
КонецФункции

