Функция СоздатьАлгоОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест = Ложь) Экспорт
    
	УдалитьНеЗаполненныеПараметры(ПараметрыОперацииБиржи);
	
	Модуль = ИнициализироватьМодуль();
	
	Если Бектест Тогда                
		
		ЗаписатьДанныеАлгоордераВИсторию(ПараметрыОперацииБиржи);
		Возврат Истина; // документ уже создан, а отправлять на биржу не нужно
	Иначе
		
		Результат = Модуль.POST_PlaceAlgoOrder(ПараметрыОперацииБиржи, Аккаунт);
		
		// !!! TODO: по хорошему для таких вызовов нужно формировать очередь и обрабатывать отдельно
		Если Результат Тогда
			ПараметрыЗапроса = биг_ОКХ_КлиентСервер.СтруктураЗапроса_АктуализироватьАлгоОрдер();
			ПараметрыЗапроса.algoClOrdId = ПараметрыОперацииБиржи.algoClOrdId;
			АктуализироватьАлгоОрдер(ПараметрыОперацииБиржи, Аккаунт);
			ЗаписатьДанныеАлгоордераВИсторию(ПараметрыОперацииБиржи);
		КонецЕсли;
		
		Возврат Результат; 	
	КонецЕсли;
	
КонецФункции

Функция ИзменитьАлгоОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест = Ложь, ТаймСтамп = Неопределено) Экспорт
    
	УдалитьНеЗаполненныеПараметры(ПараметрыОперацииБиржи);
	
	Модуль = ИнициализироватьМодуль();
	
	Если Бектест Тогда
		
		Модуль.АлгоОрдер_Изменить_ПрименитьКДокументу(ПараметрыОперацииБиржи, ТаймСтамп);
		ЗаписатьДанныеАлгоордераВИсторию(ПараметрыОперацииБиржи);
		Возврат Истина;
	Иначе
		
		ЗаписатьДанныеАлгоордераВИсторию(ПараметрыОперацииБиржи); 
		
		Возврат Модуль.POST_AmendAlgoOrder(ПараметрыОперацииБиржи, Аккаунт);	
	КонецЕсли;	
	
КонецФункции

Функция ОтменитьАлгоОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест = Ложь) Экспорт
	
	Для каждого Структура Из ПараметрыОперацииБиржи Цикл
		УдалитьНеЗаполненныеПараметры(Структура);	
	КонецЦикла;  
	
	Модуль = ИнициализироватьМодуль();
	
	Если Бектест Тогда
		Бектест_АлгоОрдер_УстановитьСтатусОтменен(ПараметрыОперацииБиржи);
		Возврат Истина;
	Иначе
		Возврат Модуль.POST_CancelAlgoOrder(ПараметрыОперацииБиржи, Аккаунт);	
	КонецЕсли;
	  
КонецФункции

