Функция СоздатьОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест = Ложь) Экспорт
	
	УдалитьНеЗаполненныеПараметры(ПараметрыОперацииБиржи);
	
	Модуль = ИнициализироватьМодуль();
	
	Если Бектест Тогда
		Возврат Истина; // документ уже создан, а отправлять на биржу не будем
	Иначе
		Результат = Модуль.POST_PlaceOrder(ПараметрыОперацииБиржи, Аккаунт);
		
		// !!! TODO: по хорошему для таких вызовов нужно формировать очередь и обрабатывать отдельно
		Если Результат Тогда
			// раньше сразу запрашивал детали ордера. После запуска WebSocket-клиента не актуально
			//ПолучитьДанныеБиржиОбОрдере(ПараметрыОперацииБиржи, Аккаунт);	
		КонецЕсли;
		
		Возврат Результат;	
	КонецЕсли;	
	
КонецФункции

