Функция ПолучитьДоступныеРежимыТорговли(ТипИнструмента) Экспорт

	МассивДопустимыхРежимов = Новый Массив();
	
	Если ТипИнструмента = Перечисления.big_OKX_InstrumentType.FUTURES Тогда
		
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.isolated);
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.cross);
		
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.MARGIN Тогда
		
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.isolated);
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.cross);
		
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.OPTION Тогда
		
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.cash);
		
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.SPOT Тогда
		
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.cash);
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.spot_isolated);
		
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.SWAP Тогда
		
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.isolated);
		МассивДопустимыхРежимов.Добавить(Перечисления.big_OKX_tdModes.cross);	
		
	Иначе
		
		Сообщить("Для переданного Типа инструмента не задано соответствие в модуле биг_ОКХ_Сервер.ПолучитьДоступныеРежимыТорговли()");
	КонецЕсли;
	
	Возврат МассивДопустимыхРежимов;
	
КонецФункции

