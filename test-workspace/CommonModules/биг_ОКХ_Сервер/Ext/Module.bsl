#Область РаботаСДокументами

Функция СоздатьДокумент_Ордер(ПараметрыОперации, Бектест = Ложь, ТаймСтамп = Неопределено) Экспорт
	
	УИД 			= Новый УникальныйИдентификатор();
	СсылкаНаОрдер 	= Документы.big_Order_OKX.ПолучитьСсылку(УИД);		
	Ордер			= НайтиСоздатьОрдер(ПараметрыОперации, СсылкаНаОрдер);
	
	ПараметрыОперации.КлиентОрдерИД = биг_ОКХ_КлиентСервер.КлиентскийИдентификатор(СсылкаНаОрдер);
	
	// сперва нужно создать алгоордера, если они есть
	Если ПараметрыОперации.МассивСвязанныхАлгоОрдеров.Количество() > 0 Тогда
		Для каждого СтруктураАлгоОрдера Из ПараметрыОперации.МассивСвязанныхАлгоОрдеров Цикл
						
			УИДАлго 			= Новый УникальныйИдентификатор;
			СсылкаНаАлгоОрдер	= Документы.big_AlgoOrders_OKX.ПолучитьСсылку(УИДАлго);			
			АлгоОрдер 			= НайтиСоздатьАлгоОрдер(СтруктураАлгоОрдера, СсылкаНаАлгоОрдер);			
			
			СтруктураАлгоОрдера.КлиентАлгоОрдерИД = биг_ОКХ_КлиентСервер.КлиентскийИдентификатор(СсылкаНаАлгоОрдер); 
			
			СтруктураАлгоОрдера.Ордер = СсылкаНаОрдер;
			АлгоОрдер.Заполнить(СтруктураАлгоОрдера);
			
			Если Бектест Тогда
				СоздатьДокумент_АлгоОрдер_Бектест(СтруктураАлгоОрдера, АлгоОрдер, ТаймСтамп);
				АлгоОрдер.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				// в "рабочем" режиме документ будет проведен после загрузки деталей операции с биржи
				// т.е. после подтверждения, что ордер размещен
				АлгоОрдер.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			ЗаписатьДанныеАлгоордераВИсторию(СтруктураАлгоОрдера);
			
			НС = Ордер.attachAlgoOrds.Добавить();
			НС.АлгоОрдер = АлгоОрдер.Ссылка; 
		КонецЦикла;	
	КонецЕсли;
	     
	Ордер.Заполнить(ПараметрыОперации);
	 	
	Если Бектест Тогда   		
		СоздатьДокумент_Ордер_Бектест(ПараметрыОперации, Ордер, ТаймСтамп);
 		Ордер.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		// в "рабочем" режиме документ будет проведен после загрузки деталей операции с биржи
		// т.е. после подтверждения, что ордер размещен
		Ордер.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
		
	Возврат Ордер.Ссылка;
	
КонецФункции

Функция СоздатьДокумент_АлгоОрдер(ПараметрыОперации, Бектест = Ложь, ТаймСтамп = Неопределено) Экспорт

	АлгоОрдер = Документы.big_AlgoOrders_OKX.СоздатьДокумент();
	АлгоОрдер.Заполнить(ПараметрыОперации);
	
	Если Бектест Тогда
		СоздатьДокумент_АлгоОрдер_Бектест(ПараметрыОперации, АлгоОрдер, ТаймСтамп);
	КонецЕсли; 
		
	АлгоОрдер.Записать(РежимЗаписиДокумента.Запись);
		
	Возврат АлгоОрдер.Ссылка;
	
КонецФункции

Функция ПолучитьМассивСвязанныхОпераций(Операция) Экспорт
	
	ТипЗначения 	= ТипЗнч(Операция);
	МассивОпераций 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Операция);
	
	Если ТипЗначения = Тип("ДокументСсылка.big_Order_OKX") Тогда
		Для каждого Строка Из Операция.attachAlgoOrds Цикл
			МассивОпераций.Добавить(Строка.АлгоОрдер);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат МассивОпераций;
	
КонецФункции

Функция НайтиСоздатьОрдер(ПараметрыОперации, СсылкаНаОрдер)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Order_OKX.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.big_Order_OKX КАК big_Order_OKX
	|ГДЕ
	|	big_Order_OKX.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И big_Order_OKX.НастройкаСтратегии = &КлючНастроек
	|	И big_Order_OKX.Аккаунт = &Аккаунт
	|	И big_Order_OKX.instId = &ИнструментИД
	|	И big_Order_OKX.Событие = &Событие";
	
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ПараметрыОперации.Сигнал);
	Запрос.УстановитьПараметр("КлючНастроек", 		ПараметрыОперации.КлючНастроек);
	Запрос.УстановитьПараметр("Аккаунт", 			ПараметрыОперации.Аккаунт);
	Запрос.УстановитьПараметр("Событие", 			ПараметрыОперации.Событие);
	Запрос.УстановитьПараметр("ИнструментИД", 		ПараметрыОперации.ИнструментИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОрдерОбъект = Документы.big_Order_OKX.СоздатьДокумент();
		ОрдерОбъект.УстановитьСсылкуНового(СсылкаНаОрдер);
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОрдерОбъект 	= Выборка.Ссылка.ПолучитьОбъект();
		
		// очистка документа
		ОрдерОбъект.attachAlgoOrds.Очистить();
		ОрдерОбъект.uTime = 0;
		ОрдерОбъект.cTime = 0;
		ОрдерОбъект.state = "";
		
		СсылкаНаОрдер 	= Выборка.Ссылка;
	КонецЕсли;                                        
	
	Возврат ОрдерОбъект;	
	
КонецФункции

Функция НайтиСоздатьАлгоОрдер(ПараметрыОперации, СсылкаНаАлгоОрдер)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_AlgoOrders_OKX.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.big_AlgoOrders_OKX КАК big_AlgoOrders_OKX
	|ГДЕ
	|	big_AlgoOrders_OKX.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И big_AlgoOrders_OKX.НастройкаСтратегии = &КлючНастроек
	|	И big_AlgoOrders_OKX.Аккаунт = &Аккаунт
	|	И big_AlgoOrders_OKX.instId = &ИнструментИД
	|	И big_AlgoOrders_OKX.Событие = &Событие";
	
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ПараметрыОперации.Сигнал);
	Запрос.УстановитьПараметр("КлючНастроек", 		ПараметрыОперации.КлючНастроек);
	Запрос.УстановитьПараметр("Аккаунт", 			ПараметрыОперации.Аккаунт);
	Запрос.УстановитьПараметр("Событие", 			ПараметрыОперации.Событие);
	Запрос.УстановитьПараметр("ИнструментИД", 		ПараметрыОперации.ИнструментИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОрдерОбъект = Документы.big_AlgoOrders_OKX.СоздатьДокумент();
		ОрдерОбъект.УстановитьСсылкуНового(СсылкаНаАлгоОрдер);
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОрдерОбъект 		= Выборка.Ссылка.ПолучитьОбъект();
		
		// стираем состояние, которое могло быть установлено в предыдущих итерациях
		// очистка документа
		ОрдерОбъект.uTime 		= 0;
		ОрдерОбъект.cTime 		= 0;
		ОрдерОбъект.state 		= "";
		ОрдерОбъект.tpTriggerPx	= 0;
		ОрдерОбъект.tpOrdPx     = 0;
		ОрдерОбъект.slTriggerPx = 0;
		ОрдерОбъект.slOrdPx     = 0;
		ОрдерОбъект.sz          = 0;
		
		СсылкаНаАлгоОрдер 	= Выборка.Ссылка;
	КонецЕсли;                                        
	
	Возврат ОрдерОбъект;
	
КонецФункции

