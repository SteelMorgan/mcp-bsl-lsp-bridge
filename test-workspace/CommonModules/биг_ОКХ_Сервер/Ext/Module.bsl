#Область ПрограммныйИнтерфейс

Процедура МенеджерОбновленияАктивныхОрдеров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Order_OKX.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.big_Order_OKX КАК big_Order_OKX
	|ГДЕ
	|	(big_Order_OKX.Статус = ЗНАЧЕНИЕ(Перечисление.big_СтатусыТорговыхОбъектов.Новый)
	|			ИЛИ big_Order_OKX.Статус = ЗНАЧЕНИЕ(Перечисление.big_СтатусыТорговыхОбъектов.Активный))
	|	И big_Order_OKX.ordId <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВыполняемыйМетод 		= "биг_ОКХ_Сервер.ОбновлениеИнформацииОбОрдере";
		
		ПараметрыЗапуска		= Новый Структура("Ордер", Выборка.Ссылка);
		
		ПараметрыВыполнения 	= ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = ВыполняемыйМетод;
		ПараметрыВыполнения.ЗапуститьВФоне 				= Истина; 
		
		СтруктураФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗапуска, ПараметрыВыполнения);		
	КонецЦикла;             	
	
КонецПроцедуры

Процедура ОбновлениеИнформацииОбОрдере(Параметры, АдресХранилищаРезультата) Экспорт
	
	биг_МаркетАпи.АктуализироватьОрдер(Параметры.Ордер);
	
КонецПроцедуры

Процедура МенеджерОбновленияОткрытыхПозицийИОрдеров() Экспорт
	
	// сейчас здесь только АлгоОрдера, потому что Ордера и Позиции уехали в веб-сокет
	Биржа = Биржа();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	big_AlgoOrders_OKX.Аккаунт КАК Аккаунт,
	               |	big_AlgoOrders_OKX.algoId КАК ОрдерИД
	               |ИЗ
	               |	Документ.big_AlgoOrders_OKX КАК big_AlgoOrders_OKX
	               |ГДЕ
	               |	(big_AlgoOrders_OKX.Статус = ЗНАЧЕНИЕ(Перечисление.big_СтатусыТорговыхОбъектов.Активный)
	               |			ИЛИ big_AlgoOrders_OKX.Статус = ЗНАЧЕНИЕ(Перечисление.big_СтатусыТорговыхОбъектов.Новый))
	               |	И big_AlgoOrders_OKX.algoId <> """"
	               |	И big_AlgoOrders_OKX.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл	
		
		// АЛГО ОРДЕРА
		АлгоОрдерДетали	= биг_МаркетАпиКлиентСервер.СтруктураОперации_АктуализироватьАлгоОрдер();
		АлгоОрдерДетали.Биржа         	= Биржа;
		АлгоОрдерДетали.Аккаунт       	= Выборка.Аккаунт;
		АлгоОрдерДетали.АлгоОрдерИД		= Выборка.ОрдерИД;
		
		биг_МаркетАпи.АктуализироватьАлгоОрдер(, АлгоОрдерДетали);
        						
	КонецЦикла;
	         	
КонецПроцедуры                                       

Процедура МенеджерОбновленияИсторииОрдеровПозиций(НачалоПериода = Неопределено) Экспорт
		
	Биржа = Биржа();
	
	// TODO: собирать аккаунты не срезом последних, а все кто был активен в периоде
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	big_MarketAccounts.Ссылка КАК Аккаунт,
	               |	big_Instruments.instType КАК ИнструментТип,
	               |	биг_ИнструментыСтратегийСрезПоследних.ИнструментИД КАК ИнструментИД
	               |ИЗ
	               |	Справочник.big_MarketAccounts КАК big_MarketAccounts
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_УчастникиСтратегий.СрезПоследних(, Участник = ИСТИНА) КАК биг_УчастникиСтратегийСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_ИнструментыСтратегий.СрезПоследних(, Участие = ИСТИНА) КАК биг_ИнструментыСтратегийСрезПоследних
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.big_Instruments КАК big_Instruments
	               |				ПО биг_ИнструментыСтратегийСрезПоследних.ИнструментИД = big_Instruments.instId
	               |			ПО биг_УчастникиСтратегийСрезПоследних.Participiant.Владелец = биг_ИнструментыСтратегийСрезПоследних.Биржа
	               |		ПО big_MarketAccounts.Ссылка = биг_УчастникиСтратегийСрезПоследних.Participiant
	               |ГДЕ
	               |	big_MarketAccounts.Владелец = &Биржа
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	big_MarketAccounts.Ссылка,
	               |	биг_ПортфелиИнструменты.Инструмент.instType,
	               |	биг_ПортфелиИнструменты.Инструмент.instId
	               |ИЗ
	               |	Справочник.big_MarketAccounts КАК big_MarketAccounts
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_УчастникиПортфелей.СрезПоследних(, Участник = ИСТИНА) КАК биг_УчастникиПортфелейСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.биг_Портфели.Инструменты КАК биг_ПортфелиИнструменты
	               |			ПО биг_УчастникиПортфелейСрезПоследних.Портфель = биг_ПортфелиИнструменты.Ссылка
	               |		ПО big_MarketAccounts.Ссылка = биг_УчастникиПортфелейСрезПоследних.Аккаунт
	               |ГДЕ
	               |	big_MarketAccounts.Владелец = &Биржа";
	
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		    			
		ПараметрыЗапроса = биг_МаркетАпиКлиентСервер.СтруктураОперации_ПолучитьИсториюОрдеров();
		ПараметрыЗапроса.Биржа = Биржа;
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Выборка);
		
		Ответ = биг_МаркетАпи.ПолучитьИсториюОрдеров(Выборка.Аккаунт, ПараметрыЗапроса);			
	КонецЦикла;
	
КонецПроцедуры

