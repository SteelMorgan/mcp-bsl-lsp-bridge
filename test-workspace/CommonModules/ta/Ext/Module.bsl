

// Функция - rma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается RMA
//  length - Период для расчета RMA
// 
// Возвращаемое значение:
//  Массив значений RMA
//
Функция rma(data, length, source = Неопределено) Экспорт
	
	Если length <= 0 Тогда
        Возврат 0;
	КонецЕсли;
	
	Если source = Неопределено Тогда
		Возврат rma_old(data, length);
	Иначе
		
		Коэффициент = 1 / length;
	    ЗначенияRMA = Новый Массив;
	    ЗначенияRMA.Добавить(data[0]);

	    Для Индекс = 1 По data.Количество() - 1 Цикл
			ТекЭлемент 	= data[Индекс][source]; 
			Значение 	= Окр((ТекЭлемент * Коэффициент) + (ЗначенияRMA[Индекс - 1] * (1 - Коэффициент)),8);
	        ЗначенияRMA.Добавить(Значение);
	    КонецЦикла;

	    Возврат ЗначенияRMA;
	КонецЕсли;
	
КонецФункции

// Функция для расчета среднего значения
Функция sma(data, length, source = Неопределено) Экспорт
	
	Если source = Неопределено Тогда
		Возврат sma_old(data, length);
	Иначе
		
		// Создаем массив для хранения значений SMA
	    SMA_Значения = Новый Массив;

	    // Если данных меньше, чем период, заполняем массив значениями Неопределено
	    Если data.Количество() < length Тогда
	        Для Индекс = 0 По data.Количество() - 1 Цикл
	            SMA_Значения.Добавить(Неопределено);
	        КонецЦикла;
	        Возврат SMA_Значения;
	    КонецЕсли;

	    // Заполняем первые (Период - 1) элементов значениями Неопределено
	    Для Индекс = 0 По length - 2 Цикл
	        SMA_Значения.Добавить(Неопределено);
	    КонецЦикла;

	    // Расчет SMA для каждого бара, начиная с (Период - 1)
	    Для Индекс = length - 1 По data.Количество() - 1 Цикл
	        Сумма = 0;
	        Для ВнутреннийИндекс = Индекс - length + 1 По Индекс Цикл
	            Если data[ВнутреннийИндекс] <> Неопределено Тогда
					ТекЭлемент 	= data[ВнутреннийИндекс][source];
					Если ЗначениеЗаполнено(ТекЭлемент) Тогда
						Сумма = Сумма + ТекЭлемент;	
					КонецЕсли;					
	            Иначе
	                // Обработка случая, когда элемент не является числом
	                // Например, можно пропустить элемент или задать значение по умолчанию
	                Сумма = Сумма + 0; // если пропускаем элемент
	            КонецЕсли;
	        КонецЦикла;
	        SMA = Окр(Сумма / length, 8);
	        SMA_Значения.Добавить(SMA);
	    КонецЦикла;

	    Возврат SMA_Значения;		
	КонецЕсли; 
	
КонецФункции

// Функция - ema
//
// Параметры:
//  source - Массив значений, для которых рассчитывается EMA
//  length - Период для расчета EMA
// 
// Возвращаемое значение:
//  Массив значений EMA
//
Функция ema(data, length, source = Неопределено) Экспорт
	
	Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;
	
	Если source = Неопределено Тогда
		Возврат ema_old(data, length);
	Иначе
		
	    Коэффициент = 2 / (length + 1);
	    EMA = Новый Массив;
	    EMA.Добавить(data[0]);

	    Для Индекс = 1 По data.Количество() - 1 Цикл
			ТекЭлемент 	= data[Индекс][source];
			Значение 	= Окр((ТекЭлемент * Коэффициент) + (EMA[Индекс - 1] * (1 - Коэффициент)), 8);
	        EMA.Добавить(Значение);
	    КонецЦикла;

	    Возврат EMA;		
	КонецЕсли;	

КонецФункции

// Функция - wma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается WMA
//  length - Период для расчета WMA
// 
// Возвращаемое значение:
//  Массив значений WMA
//
Функция wma(data, length, source = Неопределено) Экспорт
	
	Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;
	
	Если source = Неопределено Тогда
		Возврат wma_old(data, length);
	КонецЕсли;
	
    WMA = Новый Массив;
    Для Индекс = 0 По data.Количество() - 1 Цикл
        Если Индекс < length - 1 Тогда
            WMA.Добавить(Неопределено);
        Иначе
            Сумма = 0;
            Вес = 0;
            Для ПодИндекс = 0 По length - 1 Цикл
				ТекЭлемент 	= data[Индекс - ПодИндекс][source]; 
				Сумма 		= Сумма + ТекЭлемент * (length - ПодИндекс);
                Вес 		= Вес + (length - ПодИндекс);
            КонецЦикла;
			Значение = Окр(Сумма / Вес, 8); 
			WMA.Добавить(Значение);
        КонецЕсли;
    КонецЦикла;

    Возврат WMA;
КонецФункции

// Функция - vwma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается VWMA
//  volume - Массив значений объема
//  length - Период для расчета VWMA
// 
// Возвращаемое значение:
//  Массив значений VWMA
//
Функция vwma(data, length, source = Неопределено) Экспорт
	
	Если length <= 0 Тогда
        Возврат 0;
	КонецЕсли;
	
    VWMA = Новый Массив;
    Для Индекс = 0 По data.Количество() - 1 Цикл
        Если Индекс < length - 1 Тогда
            VWMA.Добавить(Неопределено);
        Иначе
            Сумма = 0;
            СуммаОбъема = 0;
            Для ПодИндекс = 0 По length - 1 Цикл
				ТекЭлемент 	= data[Индекс - ПодИндекс][source];
				Сумма 		= Сумма + ТекЭлемент * data[Индекс - ПодИндекс].volCcy;
                СуммаОбъема = СуммаОбъема + data[Индекс - ПодИндекс].volCcy;
            КонецЦикла;
			Значение = Окр(Сумма / СуммаОбъема, 8);
			VWMA.Добавить(Значение);
        КонецЕсли;
    КонецЦикла;

    Возврат VWMA;
КонецФункции

// Функция - rsi
//
// Параметры:
//  rsiSourceInput - Массив значений цен закрытия
//  rsiLengthInput - Период для расчета RSI
// 
// Возвращаемое значение:
//  Массив значений RSI
//
Функция rsi(data, length, source = Неопределено) Экспорт
	
	// Проверка входных данных
    Если length <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Если data.Количество() < length Тогда
        Возврат Новый Массив;
    КонецЕсли;
	
	Если source = Неопределено Тогда
		Возврат rsi_old(data, length);	
	КонецЕсли;
	
    // Вычисление изменений
	Изменения 	= math.change(data, source);	    

    // Вычисление приростов и убытков
    Приросты 	= Новый Массив;
    Убытки 		= Новый Массив;

    Для Каждого Изменение Из Изменения Цикл
        Приросты.Добавить(max(Изменение, 0));
        Убытки.Добавить(-min(Изменение, 0));
    КонецЦикла;

    // Вычисление RMA для приростов и убытков
    up 			= ta.rma(Приросты, length);
    down 		= ta.rma(Убытки, length);

    // Вычисление RSI
    RSI = Новый Массив;
    Для Индекс = 0 По data.Количество() - 1 Цикл
		Если Индекс < length - 1 Тогда
			RSI.Добавить(Неопределено);
        Иначе 
			Если down[Индекс-1] = 0 Тогда
                RSI.Добавить(100);
            ИначеЕсли up[Индекс-1] = 0 Тогда
                RSI.Добавить(0);
            Иначе
                RS = up[Индекс-1] / down[Индекс-1];
                RSI.Добавить(Окр(100 - (100 / (1 + RS)), 2));
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Возврат RSI;
	
КонецФункции 

// Функция - ma (median averrage)
//
// Параметры:
//  source - Массив значений цен закрытия
//  length - Период для расчета median
// 
// Возвращаемое значение:
//  Массив значений median
//
Функция ma(data, length, source = Неопределено) Экспорт
	
	Если source = Неопределено Тогда
		Возврат ma_old(data, length);	
	КонецЕсли;
	
    // Создаем массив для хранения медианных значений
    Средние = Новый Массив;

    // Проходим по всему массиву Источник
    Для i = 0 По data.Количество() - 1 Цикл
        // Определяем начало подмассива для текущей точки
        Начало = Макс(0, i - length + 1);

        // Извлекаем подмассив последних Длина значений
        Подмассив = Новый Массив;
        Для j = Начало По i Цикл
			ТекЭлемент = data[j][source];  
			Подмассив.Добавить(ТекЭлемент);
        КонецЦикла;
		
		Среднее = Окр(math.sum(Подмассив, Подмассив.Количество()) / Подмассив.Количество(), 8); 
		
        // Добавляем медиану в массив медианных значений
        Средние.Добавить(Среднее);
    КонецЦикла;

    Возврат Средние;
	
КонецФункции 

// Функция - max
//
// Параметры:
//   data         - Массив объектов или чисел (свечи или индикаторы)
//   length       - Период для расчета максимума
//   source       - Источник данных (например, "close", "open", "high", "low")
//
// Возвращаемое значение:
//   Массив значений, где каждый элемент — это максимальное значение за последние 'length' баров
//
Функция ta_max(data, length, source) Экспорт
    
    Если length <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Результат = Новый Массив;

    // Проходим по всем барам
    Для Индекс = 0 По data.Количество() - 1 Цикл

        // Определяем начало подмассива (не меньше 0)
        НачалоПодмассива = ?(Индекс < length - 1, 0, Индекс - length + 1);

        // Извлекаем значения за последние 'length' баров
        ПодмассивЧисел = Новый Массив;

        Для j = НачалоПодмассива По Индекс Цикл
            // Получаем значение из data[j] по source
            ЗначениеИзДанных = data[j][source];
            Если ЗначениеЗаполнено(ЗначениеИзДанных) Тогда
                ПодмассивЧисел.Добавить(ЗначениеИзДанных);
            КонецЕсли;
        КонецЦикла;

        // Вычисляем максимум
        Максимум = Неопределено;
        Для Каждого Число Из ПодмассивЧисел Цикл
            Если НЕ ЗначениеЗаполнено(Максимум) Тогда
                Максимум = Число;
            Иначе
                Максимум = ?(Число > Максимум, Число, Максимум);
            КонецЕсли;
        КонецЦикла;

        // Добавляем результат в результирующий массив
        Результат.Добавить(Максимум);

    КонецЦикла;

    Возврат Результат;

КонецФункции

// Функция - ta_min
//
// Параметры:
//   data         - Массив объектов или чисел (свечи или индикаторы)
//   length       - Период для расчета максимума
//   source       - Источник данных (например, "close", "open", "high", "low")
//
// Возвращаемое значение:
//   Массив значений, где каждый элемент — это максимальное значение за последние 'length' баров
//
Функция ta_min(data, length, source) Экспорт
    
    Если length <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Результат = Новый Массив;

    // Проходим по всем барам
    Для Индекс = 0 По data.Количество() - 1 Цикл

        // Определяем начало подмассива (не меньше 0)
        НачалоПодмассива = ?(Индекс < length - 1, 0, Индекс - length + 1);

        // Извлекаем значения за последние 'length' баров
        ПодмассивЧисел = Новый Массив;

        Для j = НачалоПодмассива По Индекс Цикл
            // Получаем значение из data[j] по source
            ЗначениеИзДанных = data[j][source];
            Если ЗначениеЗаполнено(ЗначениеИзДанных) Тогда
                ПодмассивЧисел.Добавить(ЗначениеИзДанных);
            КонецЕсли;
        КонецЦикла;

        // Вычисляем Минимум
        Минимум = Неопределено;
        Для Каждого Число Из ПодмассивЧисел Цикл
            Если НЕ ЗначениеЗаполнено(Минимум) Тогда
                Минимум = Число;
            Иначе
                Минимум = ?(Число < Минимум, Число, Минимум);
            КонецЕсли;
        КонецЦикла;

        // Добавляем результат в результирующий массив
        Результат.Добавить(Минимум);

    КонецЦикла;

    Возврат Результат;

КонецФункции

// Функция - tvmax (Threshold Value Max)
//
// Параметры:
//   data     - Массив структур (свечей), из которых берутся значения по ключу source
//   length   - Период для расчета максимума
//   hight    - Коэффициент умножения найденного максимума
//   source   - Имя поля (например "close", "high"), из которого брать данные
//
// Возвращаемое значение:
//   Массив значений TVM — каждый элемент равен max(source, length) * hight
//
Функция tvmax(data, length, hight, source) Экспорт

    Если length <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Результат = Новый Массив;

    // Вызываем уже реализованную функцию ta.max(), которая возвращает массив максимумов
    maxValues = ta.ta_max(data, length, source);

    // Для каждого значения max умножаем на hight и добавляем в результат
    Для Каждого maxVal Из maxValues Цикл
        Если Не ЗначениеЗаполнено(maxVal) Тогда
            Результат.Добавить(Неопределено);
        Иначе
            Результат.Добавить(Окр(maxVal * hight, 8));
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Функция - tvmax (Threshold Value Max)
//
// Параметры:
//   data     - Массив структур (свечей), из которых берутся значения по ключу source
//   length   - Период для расчета максимума
//   hight    - Коэффициент умножения найденного максимума
//   source   - Имя поля (например "close", "high"), из которого брать данные
//
// Возвращаемое значение:
//   Массив значений TVM — каждый элемент равен max(source, length) * hight
//
Функция tvmin(data, length, hight, source) Экспорт

    Если length <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Результат = Новый Массив;

    // Вызываем уже реализованную функцию ta.max(), которая возвращает массив максимумов
    minValues = ta.ta_min(data, length, source);

    // Для каждого значения max умножаем на hight и добавляем в результат
    Для Каждого minVal Из minValues Цикл
        Если Не ЗначениеЗаполнено(minVal) Тогда
            Результат.Добавить(Неопределено);
        Иначе
            Результат.Добавить(Окр(minVal * hight, 8));
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Функция для расчета Accumulation/Distribution Line (AD)
Функция ad(data) Экспорт
    Результат = Новый Массив;
    Предыдущее = 0;

    Для Каждого Строка Из data Цикл
        MFV = ((Строка.ЦенаЗакрытия - Строка.ЦенаМинимум) - (Строка.ЦенаМаксимум - Строка.ЦенаЗакрытия)) / (Строка.ЦенаМаксимум - Строка.ЦенаМинимум);
              
        MFV = MFV * Строка.volCcy; // Используем volCcy из API OKX
        
        Текущее = Окр(Предыдущее + MFV, 8);
        Результат.Добавить(Текущее);
        Предыдущее = Текущее;
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Функция для расчета Chaikin Oscillator (ChOscil)
Функция chOscil(data, КороткийEMAPeriod = 3, ДлинныйEMAPeriod = 10) Экспорт
	
	adValues = ad(data);
	
	КороткийEMA = ema(adValues, КороткийEMAPeriod);
    ДлинныйEMA = ema(adValues, ДлинныйEMAPeriod);

    Результат = Новый Массив;
    Для i = 0 По КороткийEMA.Количество() - 1 Цикл
        Если КороткийEMA[i] <> Неопределено И ДлинныйEMA[i] <> Неопределено Тогда
            Результат.Добавить(КороткийEMA[i] - ДлинныйEMA[i]);
        ИначеЕсли i >= КороткийEMAPeriod И i >= ДлинныйEMAPeriod Тогда
            Результат.Добавить(0); // Если данные есть, но значения не рассчитаны
        Иначе
            Результат.Добавить(Неопределено);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Функция для расчета Average True Range (ATR)
Функция atr(data, length) Экспорт
    TrueRange = Новый Массив;

    Для i = 1 По data.Количество() - 1 Цикл
        TR = Макс(
            data[i].ЦенаМаксимум - data[i].ЦенаМинимум,
            биг_Алг.Абс(data[i].ЦенаМаксимум - data[i - 1].ЦенаЗакрытия),
            биг_Алг.Абс(data[i].ЦенаМинимум - data[i - 1].ЦенаЗакрытия)
        );
        TrueRange.Добавить(TR);
    КонецЦикла;

    // Добавляем начальное значение
    TrueRange.Вставить(0, data[0].ЦенаМаксимум - data[0].ЦенаМинимум);

    // Вычисляем EMA для TrueRange
    Результат = ema(TrueRange, length);
    Возврат Результат;
КонецФункции

// Функция для расчета Average Directional Index (ADX)
Функция adx(data, length) Экспорт
	
	// Вычисляем TrueRange
    TrueRange = Новый Массив;
    PositiveDM = Новый Массив;
    NegativeDM = Новый Массив;

    Для i = 1 По data.Количество() - 1 Цикл
        UpMove = data[i].ЦенаМаксимум - data[i - 1].ЦенаМаксимум;
        DownMove = data[i - 1].ЦенаМинимум - data[i].ЦенаМинимум;

        PositiveDM.Добавить(?(UpMove > DownMove И UpMove > 0, UpMove, 0));
        NegativeDM.Добавить(?(DownMove > UpMove И DownMove > 0, DownMove, 0));

        TR = Макс(
            data[i].ЦенаМаксимум - data[i].ЦенаМинимум,
            биг_Алг.Абс(data[i].ЦенаМаксимум - data[i - 1].ЦенаЗакрытия),
            биг_Алг.Абс(data[i].ЦенаМинимум - data[i - 1].ЦенаЗакрытия)
        );
        TrueRange.Добавить(TR);
    КонецЦикла;

    // Добавляем начальные значения
    TrueRange.Вставить(0, data[0].ЦенаМаксимум - data[0].ЦенаМинимум);
    PositiveDM.Вставить(0, 0);
    NegativeDM.Вставить(0, 0);

    // Вычисляем +DI и -DI
    PlusDI = ema(PositiveDM, length);
    MinusDI = ema(NegativeDM, length);

    DX = Новый Массив;
    Для i = 0 По PlusDI.Количество() - 1 Цикл
        Если MinusDI[i] + PlusDI[i] <> 0 Тогда
            DX.Добавить(Окр(100 * биг_Алг.Абс(PlusDI[i] - MinusDI[i]) / (PlusDI[i] + MinusDI[i]), 2));
        Иначе
            DX.Добавить(Неопределено);
        КонецЕсли;
    КонецЦикла;

    // Вычисляем ADX как скользящее среднее DX
    Результат = ema(DX, length);
    Возврат Результат;
КонецФункции

// Функция - change
//
// Параметры:
//  source - Массив значений, для которых рассчитываются изменения
// 
// Возвращаемое значение:
//  Массив изменений
//
Функция change(source) Экспорт
    Изменения = Новый Массив;

    Для Индекс = 1 По source.Количество() - 1 Цикл
        Изменение = source[Индекс] - source[Индекс - 1];
        Изменения.Добавить(Изменение);
    КонецЦикла;

    Возврат Изменения;
КонецФункции

#Область СтарыеМетоды

// Функция - rma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается RMA
//  length - Период для расчета RMA
// 
// Возвращаемое значение:
//  Массив значений RMA
//
Функция rma_old(source, length)
    Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;

    Коэффициент = 1 / length;
    ЗначенияRMA = Новый Массив;
    ЗначенияRMA.Добавить(source[0]);

    Для Индекс = 1 По source.Количество() - 1 Цикл
        Значение = Окр((source[Индекс] * Коэффициент) + (ЗначенияRMA[Индекс - 1] * (1 - Коэффициент)),8);
        ЗначенияRMA.Добавить(Значение);
    КонецЦикла;

    Возврат ЗначенияRMA;
КонецФункции

// Функция для расчета среднего значения
Функция sma_old(source, length)
	
	// Создаем массив для хранения значений SMA
    SMA_Значения = Новый Массив;

    // Если данных меньше, чем период, заполняем массив значениями Неопределено
    Если source.Количество() < length Тогда
        Для Индекс = 0 По source.Количество() - 1 Цикл
            SMA_Значения.Добавить(Неопределено);
        КонецЦикла;
        Возврат SMA_Значения;
    КонецЕсли;

    // Заполняем первые (Период - 1) элементов значениями Неопределено
    Для Индекс = 0 По length - 2 Цикл
        SMA_Значения.Добавить(Неопределено);
    КонецЦикла;

    // Расчет SMA для каждого бара, начиная с (Период - 1)
    Для Индекс = length - 1 По source.Количество() - 1 Цикл
        Сумма = 0;
        Для ВнутреннийИндекс = Индекс - length + 1 По Индекс Цикл
            Если source[ВнутреннийИндекс] <> Неопределено Тогда
                Сумма = Сумма + source[ВнутреннийИндекс];
            Иначе
                // Обработка случая, когда элемент не является числом
                // Например, можно пропустить элемент или задать значение по умолчанию
                Сумма = Сумма + 0; // если пропускаем элемент
            КонецЕсли;
        КонецЦикла;
        SMA = Окр(Сумма / length, 2);
        SMA_Значения.Добавить(SMA);
    КонецЦикла;

    Возврат SMA_Значения;
	
КонецФункции

// Функция - ema
//
// Параметры:
//  source - Массив значений, для которых рассчитывается EMA
//  length - Период для расчета EMA
// 
// Возвращаемое значение:
//  Массив значений EMA
//
Функция ema_old(source, length)
    Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;

    Коэффициент = 2 / (length + 1);
    EMA = Новый Массив;
    EMA.Добавить(source[0]);

    Для Индекс = 1 По source.Количество() - 1 Цикл
        Значение = Окр((source[Индекс] * Коэффициент) + (EMA[Индекс - 1] * (1 - Коэффициент)),8);
        EMA.Добавить(Значение);
    КонецЦикла;

    Возврат EMA;
КонецФункции

// Функция - wma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается WMA
//  length - Период для расчета WMA
// 
// Возвращаемое значение:
//  Массив значений WMA
//
Функция wma_old(source, length)
    Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;

    WMA = Новый Массив;
    Для Индекс = 0 По source.Количество() - 1 Цикл
        Если Индекс < length - 1 Тогда
            WMA.Добавить(Неопределено);
        Иначе
            Сумма = 0;
            Вес = 0;
            Для ПодИндекс = 0 По length - 1 Цикл
                Сумма = Сумма + source[Индекс - ПодИндекс] * (length - ПодИндекс);
                Вес = Вес + (length - ПодИндекс);
            КонецЦикла;
            WMA.Добавить(Сумма / Вес);
        КонецЕсли;
    КонецЦикла;

    Возврат WMA;
КонецФункции

// Функция - vwma
//
// Параметры:
//  source - Массив значений, для которых рассчитывается VWMA
//  volume - Массив значений объема
//  length - Период для расчета VWMA
// 
// Возвращаемое значение:
//  Массив значений VWMA
//
Функция vwma_old(source, volume, length)
    Если length <= 0 Тогда
        Возврат 0;
    КонецЕсли;

    VWMA = Новый Массив;
    Для Индекс = 0 По source.Количество() - 1 Цикл
        Если Индекс < length - 1 Тогда
            VWMA.Добавить(Неопределено);
        Иначе
            Сумма = 0;
            СуммаОбъема = 0;
            Для ПодИндекс = 0 По length - 1 Цикл
                Сумма = Сумма + source[Индекс - ПодИндекс] * volume[Индекс - ПодИндекс];
                СуммаОбъема = СуммаОбъема + volume[Индекс - ПодИндекс];
            КонецЦикла;
            VWMA.Добавить(Сумма / СуммаОбъема);
        КонецЕсли;
    КонецЦикла;

    Возврат VWMA;
КонецФункции

// Функция - rsi
//
// Параметры:
//  rsiSourceInput - Массив значений цен закрытия
//  rsiLengthInput - Период для расчета RSI
// 
// Возвращаемое значение:
//  Массив значений RSI
//
Функция rsi_old(rsiSourceInput, rsiLengthInput)
	
	// Проверка входных данных
    Если rsiLengthInput <= 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Если rsiSourceInput.Количество() < rsiLengthInput Тогда
        Возврат Новый Массив;
    КонецЕсли;

    // Вычисление изменений
    Изменения 	= ta.change(rsiSourceInput);

    // Вычисление приростов и убытков
    Приросты 	= Новый Массив;
    Убытки 		= Новый Массив;

    Для Каждого Изменение Из Изменения Цикл
        Приросты.Добавить(max(Изменение, 0));
        Убытки.Добавить(-min(Изменение, 0));
    КонецЦикла;

    // Вычисление RMA для приростов и убытков
    up 			= ta.rma(Приросты, rsiLengthInput);
    down 		= ta.rma(Убытки, rsiLengthInput);

    // Вычисление RSI
    RSI = Новый Массив;
    Для Индекс = 0 По rsiSourceInput.Количество() - 1 Цикл
		Если Индекс < rsiLengthInput - 1 Тогда
			RSI.Добавить(Неопределено);
        Иначе 
			Если down[Индекс-1] = 0 Тогда
                RSI.Добавить(100);
            ИначеЕсли up[Индекс-1] = 0 Тогда
                RSI.Добавить(0);
            Иначе
                RS = up[Индекс-1] / down[Индекс-1];
                RSI.Добавить(Окр(100 - (100 / (1 + RS)), 2));
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Возврат RSI;
	
КонецФункции 

