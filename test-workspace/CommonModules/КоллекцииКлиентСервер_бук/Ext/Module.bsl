#Область Структура

// Формирование текстового представления значений реквизитов структуры/соответствия
// 
//
// Параметры:
//  
//  пСтруктура - Структура,Соответствие,ФиксированнаяСтруктура,ФиксированноеСоответствие - структура, которую необходимо обработать
//  пРазделитель - Строка - Строка, которая будет разделителем пар ключ/значение
//  пРазделительПары - Строка - Строка, которая будет разделителем ключа и значения
//
// Возвращаемое значение:
//   Строка - Представления ключей и значения
//
Функция ПредставлениеСтруктуры(пСтруктура, пРазделитель = Неопределено, пРазделительПары = ": ") Экспорт
	
	РазделительЭлементов = ?(пРазделитель = Неопределено, Символы.ПС, пРазделитель);
	
	ЧастиСтроки = Новый Массив;
	Для Каждого Элем Из пСтруктура Цикл
		ЧастиСтроки.Добавить(Элем.Ключ);
		ЧастиСтроки.Добавить(пРазделительПары);
		ЧастиСтроки.Добавить(Элем.Значение);
		ЧастиСтроки.Добавить(РазделительЭлементов);
	КонецЦикла;
	
	МаксИндекс = ЧастиСтроки.ВГраница();
	ЧастиСтроки.Удалить(МаксИндекс); //удаляем закрывающий разделитель элементов
	
	Результат = МассивВСтрокуСРазделителями(ЧастиСтроки, "");
	
	Возврат Результат;

КонецФункции

// Создание/Дополнение структуры или соответствия по массиву
// Это полиморфная функция чей результат зависит от типа параметра
//
// Параметры:
//  
//  пМассив - Строка,Массив,СписокЗначений,Структура,Соответствие - Ключи структуры
//                 Для коллекций типа Структура и Соответствие предполагается хранение имени реквизита в ключе
//  пЗначениеПоУмолчанию - Произвольный - Значение которое будет вставлено во все новые пары Ключ/Значение
//  пКонтейнер - Строка,Тип,Структура,Соответствие - описание универсальной коллекции
//                 Если передана строка, то предполагается, что это имя универсальной коллекции "Структура"
//                 или "Соответствие", а в результате будет создан и заполнен новый объект указанного типа
//                 Если передан тип, то будет создана новая коллекция указанного типа 
//                 В остальных случаях функция вернёт переданный объект после дозаполнения 
//
// Возвращаемое значение:
//   Структура,Соответствие - Универсальная структура, новая или переданная
//
Функция СтруктураПоМассиву(пМассив, пЗначениеПоУмолчанию = Неопределено, пКонтейнер = "Структура") Экспорт
	
	Результат = УниверсальнаяКоллекция(пКонтейнер);
	КлючиСтруктуры = ПреобразоватьВМассив(пМассив, Ложь);
	
	Для Каждого ИмяКлюча Из КлючиСтруктуры Цикл
		Результат.Вставить(ИмяКлюча, пЗначениеПоУмолчанию);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

