#Область ПрограммныйИнтерфейс


#Область Управление

Процедура ИсполнениеСтратегииDoubleImpact() Экспорт
	
	// пропустим цикл, если предыдущее задание не завершилось
	Если биг_ОбщегоНазначения.ФоновоеЗаданиеАктивно_ПоКлючу("big_ВыполнитьСтратегиюДаблИмпакт") Тогда
		Возврат;
	КонецЕсли;	
	
	ТаймСтамп 	= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло();
	Бектест		= Ложь;
	
	ВыборкаИнструментовСтратегии = ПолучитьВыборкуИнструментовСтратегии();	
	Пока ВыборкаИнструментовСтратегии.Следующий() Цикл
		
		ОбработатьИнструмент(ВыборкаИнструментовСтратегии, ТаймСтамп, Бектест);		
	КонецЦикла;
	
КонецПроцедуры       

Процедура ОбработатьИнструмент(ПараметрыИнструмента, ТаймСтамп, Бектест) Экспорт
	
	КлючНастроек = ПараметрыИнструмента.КлючНастроек;
	
	//получить текущие активные точки и их статус	
	МассивСигналов = ПолучитьМассивАктивныхСигналов(ПараметрыИнструмента, ТаймСтамп);
	
	Если НЕ ТребуетсяОбработкаСигнала(ПараметрыИнструмента, КлючНастроек, ТаймСтамп) Тогда
		Возврат;	
	КонецЕсли;
		
	Для каждого Сигнал Из МассивСигналов Цикл
		
		Сигнал.Бектест 	= Бектест;
		ШагВыполнен		= Ложь;
		ВыполнениеСигнала(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);
		
		Если ШагВыполнен Тогда
			ЗафиксироватьТочкуТекущегоШага(ПараметрыИнструмента, КлючНастроек, ТаймСтамп);	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПроверитьОперацииПоАктивнымСигналам(ТаймСтамп = Неопределено, Бектест = Ложь, КлючНастройки = Неопределено, ИнструментИД, Биржа) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактСигналы.Биржа КАК Биржа,
	|	биг_ДаблИмпактСигналы.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактСигналы.Бар КАК Бар,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	биг_ДаблИмпактСигналы.КлючНастроек КАК КлючНастроек
	|ПОМЕСТИТЬ ВТ_АктивныеСигналы
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	НЕ биг_ДаблИмпактСигналы.СигналЗавершен
	|	И (биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек
	|			ИЛИ &БезФильтраПоНастройке)
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.Биржа = &Биржа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Биржа КАК Биржа,
	|	биг_ДаблИмпактОперации.Аккаунт КАК Аккаунт,
	|	биг_ДаблИмпактОперации.НастройкаСтратегии КАК НастройкаСтратегии,
	|	биг_ДаблИмпактОперации.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактОперации.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	биг_ДаблИмпактОперации.Операция КАК Операция,
	|	ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).slOrdPx КАК slOrdPx,
	|	ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).tpOrdPx КАК tpOrdPx,
	|	ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).state КАК state,
	|	биг_ДаблИмпактОперации.Операция.Дата КАК Дата,
	|	биг_ДаблИмпактОперации.Бар КАК Бар,
	|	биг_ДаблИмпактОперации.Операция.Событие КАК Событие,
	|	биг_ДаблИмпактОперации.Операция.slTriggerPx КАК slTriggerPx,
	|	биг_ДаблИмпактОперации.Операция.tpTriggerPx КАК tpTriggerPx,
	|	биг_ДаблИмпактОперации.Операция.sz КАК sz,
	|	ЕСТЬNULL(биг_ДаблИмпактОперации.Операция.Ордер.fillSz, 0) КАК fillSz,
	|	биг_ДаблИмпактОперации.Операция.НастройкаСтратегии КАК КлючНастроек,
	|	ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).algoId КАК algoId
	|ИЗ
	|	ВТ_АктивныеСигналы КАК ВТ_АктивныеСигналы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|		ПО ВТ_АктивныеСигналы.Биржа = биг_ДаблИмпактОперации.Биржа
	|			И ВТ_АктивныеСигналы.ИнструментИД = биг_ДаблИмпактОперации.ИнструментИД
	|			И ВТ_АктивныеСигналы.ТочкаНачалаПадения = биг_ДаблИмпактОперации.ТочкаНачалаПадения
	|			И ВТ_АктивныеСигналы.КлючНастроек = биг_ДаблИмпактОперации.НастройкаСтратегии
	|ГДЕ
	|	(ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX)) <> ЗНАЧЕНИЕ(Документ.big_AlgoOrders_OKX.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("КлючНастроек", 			КлючНастройки);
	Запрос.УстановитьПараметр("БезФильтраПоНастройке", 	КлючНастройки = Неопределено);
	Запрос.УстановитьПараметр("ИнструментИД", 			ИнструментИД);
	Запрос.УстановитьПараметр("Биржа", 					Биржа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Бектест = Ложь Тогда // актуализация ордеров в настоящем времени
			
			биг_МаркетАпи.АктуализироватьАлгоОрдер(Выборка.Операция);	
		Иначе // имитируем работу с биржей
			
			ИскуственноПроверитьВыполнениеОрдера(Выборка, ТаймСтамп);	
		КонецЕсли;
		// получить актуальный статус
		
		ПроверитьАктуальностьСигнала(Выборка, ТаймСтамп);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти //Управление


