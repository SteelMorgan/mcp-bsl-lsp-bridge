#Область Бектест

Процедура ПровестиБекТестирование(ПараметрыИнструмента, АдресРезультата = Неопределено) Экспорт
		
	Если НЕ ПараметрыИнструмента.Свойство("ФиксироватьДлительность") Тогда
		ПараметрыИнструмента.Вставить("ПараметрыИнструмента", Ложь);	
	КонецЕсли;
	
	Если ПараметрыИнструмента.ФиксироватьДлительность Тогда
		ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();	
	КонецЕсли;	
	
	ТочкаОтсчетаТС 		= ПараметрыИнструмента.ТочкаОтсчетаТС;
	КоличествоИтераций 	= ПараметрыИнструмента.КоличествоИтераций;
	
	// откатываем состояние инструмента
	
	ЗаписатьТочкуНаЛинииВремени(ПараметрыИнструмента.Биржа, ПараметрыИнструмента.ИнструментИД, ПараметрыИнструмента.Бар, ПараметрыИнструмента.КлючНастроек, ТочкаОтсчетаТС);
	УдалитьСигналыПослеТочки(ПараметрыИнструмента, ТочкаОтсчетаТС);	
	СтеретьЗафиксированныеОперации(ПараметрыИнструмента, ТочкаОтсчетаТС);
	
	ШагПрогресса 		= Цел(КоличествоИтераций / 100);
	СчетчикПрогресса 	= 0;
	Прогресс			= 0;
	
	Для Сч = 1 По КоличествоИтераций Цикл
		
		ПроверитьОперацииПоАктивнымСигналам(ТочкаОтсчетаТС, Истина, ПараметрыИнструмента.КлючНастроек, ПараметрыИнструмента.ИнструментИД, ПараметрыИнструмента.Биржа);
		ОбработатьИнструмент(ПараметрыИнструмента, ТочкаОтсчетаТС, Истина);
		
		ТочкаОтсчетаТС 	= ТочкаОтсчетаТС + ПараметрыИнструмента.Бар.SecondsAmount;		
		СчетчикПрогресса = СчетчикПрогресса + 1;
		Если СчетчикПрогресса = ШагПрогресса Тогда
			Прогресс 			= Прогресс + 1;
			СчетчикПрогресса 	= 0;
			
			ДлительныеОперации.СообщитьПрогресс(Прогресс);
		КонецЕсли;
	КонецЦикла;                                                                                                                
		
	Если ПараметрыИнструмента.ФиксироватьДлительность Тогда 		
		КоличествоСигналов = ПолучитьКоличествоСигналовИнструмента(ПараметрыИнструмента);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(ПараметрыИнструмента.НаименованиеЗадания, ВремяНачала, КоличествоСигналов);					
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	
	ЗаписьРезультата = РегистрыСведений.биг_РезультатыБектестов.СоздатьМенеджерЗаписи();
	ЗаписьРезультата.Биржа			= ПараметрыИнструмента.Биржа;
	ЗаписьРезультата.ИнструментИД	= ПараметрыИнструмента.ИнструментИД;
	ЗаписьРезультата.Бар			= ПараметрыИнструмента.Бар;
	ЗаписьРезультата.КлючНастроек	= ПараметрыИнструмента.КлючНастроек; 
	ЗаписьРезультата.Выполнен		= Истина;
	ЗаписьРезультата.Записать(Истина);
	
КонецПроцедуры

Процедура УдалитьСигналыПослеТочки(ПараметрыИнструмента, ТочкаВозвратаТС)
	
	Набор	= РегистрыСведений.биг_ДаблИмпактСигналы.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(ПараметрыИнструмента.Биржа);
	Набор.Отбор.ИнструментИД.Установить(ПараметрыИнструмента.ИнструментИД);
	Набор.Отбор.Бар.Установить(ПараметрыИнструмента.Бар);
	Набор.Отбор.КлючНастроек.Установить(ПараметрыИнструмента.КлючНастроек);
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив;
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			МассивУдалить.Добавить(Строка);	
		КонецЕсли;
	КонецЦикла;                            
	
	Для каждого Строка Из МассивУдалить Цикл
		Набор.Удалить(Строка);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры

Процедура СтеретьЗафиксированныеОперации(ПараметрыИнструмента, ТочкаВозвратаТС)
	
	Набор = РегистрыСведений.биг_ДаблИмпактОперации.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(ПараметрыИнструмента.Биржа);
	Набор.Отбор.ИнструментИД.Установить(ПараметрыИнструмента.ИнструментИД);
	Набор.Отбор.НастройкаСтратегии.Установить(ПараметрыИнструмента.КлючНастроек);
	
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив();
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			
			Операция = Строка.Операция;
			КлючНастройкиОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "НастройкаСтратегии");
			
			Если КлючНастройкиОперации = ПараметрыИнструмента.КлючНастроек Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;				
		КонецЕсли;	
	КонецЦикла;                      
	
	Для каждого СтрокаНабора Из МассивУдалить Цикл
		ДокументОбъект = СтрокаНабора.Операция.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		
		УдалитьИсториюЗначенийДокумента(СтрокаНабора.Операция, ТочкаВозвратаТС);
		
		ДокументОбъект.Удалить();
		
		Набор.Удалить(СтрокаНабора);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры 

Процедура УдалитьИсториюЗначенийДокумента(Операция, ТочкаВозвратаТС)
	
	ТочкаПроверки = биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаВозвратаТС);
	Если ТипЗнч(Операция) = Тип("ДокументСсылка.big_AlgoOrders_OKX") Тогда
		
		Набор = РегистрыСведений.биг_ОКХ_ИсторияАлгоОрдеров.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(Операция);
		Набор.Прочитать();
		
		МассивУдалить = Новый Массив;
		
		Для каждого Строка Из Набор Цикл
			Если Строка.Период > ТочкаПроверки Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;
		КонецЦикла;                            
		
		Для каждого Строка Из МассивУдалить Цикл
			Набор.Удалить(Строка);
		КонецЦикла;
		
		Набор.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти //Бектест 


#Область АнализСигнала


#Область КлючевыеШаги

Процедура ВыполнениеСигнала(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);
    	  	
	// если точки нет, тогда поиск точки начала падения
	Если Сигнал.ТекущееСобытие = Неопределено Тогда
		
		ПоискТочкиНачалаПадения(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);
		
	ИначеЕсли Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.ПоискТочкиЗавершенияПадения Тогда
	
		ПоискТочкиЗавершенияПадения(Сигнал, ТаймСтамп, ШагВыполнен);
		
	ИначеЕсли Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.ПоискТочкиРазворота Тогда
		
		ПоискТочкиРазворота(Сигнал, ТаймСтамп, ШагВыполнен);
		
	ИначеЕсли Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаОдин Тогда
		
		ПоискТочкиВходаОдин(Сигнал, ТаймСтамп, ШагВыполнен);
			
	ИначеЕсли Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва Тогда		
		
		ПоискТочкиВходаДва(Сигнал, ТаймСтамп, ШагВыполнен); // (пробой вверх)
		
	ИначеЕсли Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.МониторингУровняСтопЛосс Тогда
		
		МониторингКоррекцияУровняСтопЛосс(Сигнал, ТаймСтамп, ШагВыполнен);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПоискТочкиНачалаПадения(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен)
	
	ПериодАнализа		= ПолучитьЗначениеПараметраСтратегии("ДИ_1_ТочкаНачалаПадения_ПериодАнализа", КлючНастроек);
	ЦелевоеОтклонение	= ПолучитьЗначениеПараметраСтратегии("ДИ_1_ТочкаНачалаПадения_ЦелевоеОтклонение", КлючНастроек);
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= ТаймСтамп;
	ПараметрыЗапроса.КоличествоСвечей					= ПериодАнализа;
	ПараметрыЗапроса.СортировкаПоУбыванию				= Истина;	
		
	ДанныеСвечей 		= ПолучитьДанныеСвечейПоТочке_ДаблИмпакт(ПараметрыЗапроса);
	Если ДанныеСвечей.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли; 
	
	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ТочкаНачалаПадения 	= НайтиТочкуСЦелевымОтклонением(ДанныеСвечей, ЦелевоеОтклонение);
	
	Если ЗначениеЗаполнено(ТочкаНачалаПадения) Тогда
		ЗафиксироватьТочкуНачалаПадения(Сигнал, ТочкаНачалаПадения, КлючНастроек);	
	КонецЕсли;        

	ШагВыполнен = Истина;
	
КонецПроцедуры

Процедура ПоискТочкиЗавершенияПадения(Сигнал, ТаймСтамп, ШагВыполнен)
	
	ПериодАнализа		= ПолучитьЗначениеПараметраСтратегии("ДИ_2_ЗавершениеПадения_ПериодАнализа", Сигнал.КлючНастроек);
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= Сигнал.ТочкаНачалаСобытия;
	ПараметрыЗапроса.КоличествоСвечей					= ПериодАнализа;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	
	ДанныеСвечей 		= ПолучитьДанныеСвечейПоТочке_ДаблИмпакт(ПараметрыЗапроса);
	
	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ПараметрыПроверки 	= ПолучитьСтруктуруПроверкиТочкиЗавершенияПадения();	
	
	ТочкаЗавершенияПадения_ПроверкаТриКрасных(ДанныеСвечей, ПараметрыПроверки, Сигнал);	
	Если ПараметрыПроверки.ПроверкаШаблон И ПараметрыПроверки.ПроверкаДоп Тогда
		
		ЗафиксироватьТочкуЗавершенияПадения(Сигнал, ДанныеСвечей, Перечисления.биг_ДаблИмпактPatterns.ТриКрасных);
		Возврат;
	КонецЕсли;
			
	ТочкаЗавершенияПадения_СемьИзВосьми(ДанныеСвечей, ПараметрыПроверки, Сигнал);	
	Если ПараметрыПроверки.ПроверкаШаблон И ПараметрыПроверки.ПроверкаДоп Тогда 
	
		ЗафиксироватьТочкуЗавершенияПадения(Сигнал, ДанныеСвечей, Перечисления.биг_ДаблИмпактPatterns.СемьИзВосьми);
		Возврат;
	КонецЕсли;
		  	 			
	Если ПараметрыПроверки.ПрерватьСигнал Тогда
		
		ПрерватьОбработкуТекущегоСигнала(Сигнал, ПараметрыПроверки.ПричинаОтмены, ПараметрыПроверки.ТочкаОтмены);
	КонецЕсли;
	
	ШагВыполнен = Истина;
	
КонецПроцедуры

Процедура ПоискТочкиРазворота(Сигнал, ТаймСтамп, ШагВыполнен)
	
	ПериодАнализа		= ПолучитьЗначениеПараметраСтратегии("ДИ_3_ПоискТочкиРазворота_ПериодАнализа", Сигнал.КлючНастроек); 
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= Сигнал.ТочкаНачалаСобытия;
	ПараметрыЗапроса.КоличествоСвечей					= ПериодАнализа;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	ПараметрыЗапроса.ИсключаяПереданнуюТочку 			= Истина;
	
	ДанныеСвечей 		= ПолучитьДанныеСвечейПоТочке_ДаблИмпакт(ПараметрыЗапроса);
	
	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ТочкаНайдена		= Ложь;
	
	Для каждого Свеча Из ДанныеСвечей Цикл
		
		Если биг_ОбщегоНазначения.ЭтоЗеленаяСвеча(Свеча) Тогда
			
			КоэффициентОбъема = Свеча.volCcy / Свеча.volCcyMA20;
			Если КоэффициентОбъема >= 1 Тогда
				ЗафиксироватьТочкуРазворота(Сигнал, Свеча);
				ТочкаНайдена = Истина;
			КонецЕсли; 
			
		КонецЕсли;		
	КонецЦикла;                                                                         
	
	// если получены все 30 свечей (т.е. мы уже 30 свечей ждем разворот)
	// но он так и не обнаружен - отменяем сигнал
	Если НЕ ТочкаНайдена И ДанныеСвечей.Количество() >= ПериодАнализа Тогда
		ЗавершитьСигналОтрицательно(Сигнал, "Не обнаружена точка разворота", ТаймСтамп);	
	КонецЕсли;
	
	ШагВыполнен = Истина;
	
КонецПроцедуры

Процедура ПоискТочкиВходаОдин(Сигнал, ТаймСтамп, ШагВыполнен)
	
	ПериодАнализа		= ПолучитьЗначениеПараметраСтратегии("ДИ_4_ПоискТочкиВходаОдин_ПериодАнализа", Сигнал.КлючНастроек);	      
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= Сигнал.ТочкаНачалаСобытия;
	ПараметрыЗапроса.КоличествоСвечей					= ПериодАнализа;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	
	ДанныеСвечей 		= биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);	         	
	
	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ПараметрыПроверки 	= ПолучитьСтруктуруПроверкиТочкиЗавершенияПадения();
		
	ТочкаВходаОдин_ДвеИзТрехЗеленых(Сигнал, ДанныеСвечей, ПараметрыПроверки);	
	Если ПараметрыПроверки.ПроверкаШаблон И ПараметрыПроверки.ПроверкаДоп Тогда
		ЗафиксироватьТочкуВходаОдин(Сигнал, ДанныеСвечей, ТаймСтамп);
		Возврат;
	КонецЕсли;
	     		
	ТочкаВходаОдин_ТриИзШестиЗеленых(Сигнал, ДанныеСвечей, ПараметрыПроверки);
	Если ПараметрыПроверки.ПроверкаШаблон И ПараметрыПроверки.ПроверкаДоп Тогда
	
		ЗафиксироватьТочкуВходаОдин(Сигнал, ДанныеСвечей, ТаймСтамп);
		Возврат;
	КонецЕсли;
	         	
	Если ПараметрыПроверки.ПрерватьСигнал Тогда
		
		ПрерватьОбработкуТекущегоСигнала(Сигнал, ПараметрыПроверки.ПричинаОтмены, ПараметрыПроверки.ТочкаОтмены); 
	КонецЕсли;

	ШагВыполнен = Истина;
	
КонецПроцедуры

Процедура ПоискТочкиВходаДва(Сигнал, ТаймСтамп, ШагВыполнен)

	ПериодАнализа		= ПолучитьЗначениеПараметраСтратегии("ДИ_5_ПоискТочкиВходаДва_ПериодАнализа", Сигнал.КлючНастроек);
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= Сигнал.ТочкаНачалаСобытия;
	ПараметрыЗапроса.КоличествоСвечей					= ПериодАнализа;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	
	ДанныеСвечей 		= ПолучитьДанныеСвечейПоТочке_ДаблИмпакт(ПараметрыЗапроса);

	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ОбъемВыше 						= Ложь;
	ЗеленаяСвеча 					= Ложь;
	ЦенаЗакрытияВышеСопротивления 	= Ложь;
	
	// на хх% выше среднего объема
	КоэффициентМинимальногоПревышенияОбъема = ПолучитьЗначениеПараметраСтратегии("ДИ_5_ПоискТочкиВходаДва_КоэффициентОбъемаСигналаПробития", Сигнал.КлючНастроек);
	УровеньСопротивления					= Сигнал.УровеньСопротивления;
	              
	Для каждого Свеча Из ДанныеСвечей Цикл
		
		КоэффициентПревышения 			= Свеча.volCcy / Свеча.volCcyMA20;
		
		ОбъемВыше						= КоэффициентПревышения > КоэффициентМинимальногоПревышенияОбъема; 
		ЗеленаяСвеча 					= биг_ОбщегоНазначения.ЭтоЗеленаяСвеча(Свеча);
		ЦенаЗакрытияВышеСопротивления 	= Свеча.ЦенаЗакрытия > УровеньСопротивления;
		
		Если ОбъемВыше И ЗеленаяСвеча И ЦенаЗакрытияВышеСопротивления Тогда
			
			ЗафиксироватьТочкуВходаДва(Сигнал, ДанныеСвечей, ТаймСтамп);			
		КонецЕсли;		
	КонецЦикла;
	
	ШагВыполнен = Истина;
	
КонецПроцедуры

Процедура МониторингКоррекцияУровняСтопЛосс(Сигнал, ТаймСтамп, ШагВыполнен)

	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.СортировкаПоУбыванию		 		= Истина;
	ПараметрыЗапроса.КоличествоСвечей					= 1;        
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода   = ТаймСтамп;
	ПараметрыЗапроса.ОграничениеПериода                 = ТаймСтамп;
	
	ДанныеСвечей 		= биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);
	Если ДанныеСвечей.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось получить информацию о свечах";
	КонецЕсли;                                                    

	Если НЕ Сигнал.Бектест Тогда
        Если НЕ ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, ПараметрыЗапроса.СортировкаПоУбыванию, Сигнал.Бар, ТаймСтамп) Тогда
			
			// бывает, что обработка данных начата раньше, чем свежая свеча пришла
			ШагВыполнен = Ложь;
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ПоследняяСвеча 				= ДанныеСвечей[0];
	
	// собираем все аккаунты, подключенные к этому инструменту текущей биржи
	ТаблицаУчастников 			= СобратьАккаунтыДляРеакцииНаСигнал(Сигнал);
	                                                                                                                     
	Для каждого Запись Из ТаблицаУчастников Цикл
		
		Аккаунт 				= Запись.Участник;
		СтопЛос 				= НайтиСтопЛос(Сигнал, Аккаунт);
		
		// КОСТЫЛЬ!!! 
		Если СтопЛос <> Неопределено Тогда  
			
			// в начале сигнала нужно мерить уровень изменения относительно цены второго входа
			// и поднимаем СЛ, когда цена там изменится. А вот когда Триггер СЛ > Цены входа, тогда меряем от него
			ВторойВход				= НайтиОперациюПоСобытиюСигнала(Сигнал, Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва, Запись.Участник);
			ДанныеВторогоВхода		= биг_МаркетАпи.ПолучитьКлючевыеДанныеОперации(ВторойВход);
			ТриггерСЛ 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтопЛос, "slTriggerPx");
			
			УровеньСнизу			= Макс(ДанныеВторогоВхода.ЦенаЗаполнено, ТриггерСЛ);
			УровеньСверху			= ПоследняяСвеча.ЦенаЗакрытия;
			
			НовыйТриггерСЛ			= РассчитатьНовыйУровеньСтопЛосс(Сигнал, УровеньСверху, УровеньСнизу);
			
			Если НовыйТриггерСЛ > ТриггерСЛ Тогда
					
				НовыйУровеньСтопЛосс	= -1;			
				ИзменитьСтопЛосс(Аккаунт, СтопЛос, НовыйТриггерСЛ, НовыйУровеньСтопЛосс, Сигнал, ТаймСтамп);
			КонецЕсли;	
			
		ИначеЕсли Сигнал.Бектест Тогда
			
			// при размещении ордера происходит ошибка, документ не создается. причину пока не выяснил 
			// ОТКАТИМ СИГНАЛ  
			ТочкаСбросаТС = Сигнал.ТочкаНачалаПадения - Сигнал.Бар.SecondsAmount;
			СброситьСигнал(Сигнал, ТочкаСбросаТС);			 
		КонецЕсли;		
			
	КонецЦикла;	 
	
	ШагВыполнен = Истина;
	
КонецПроцедуры


Процедура ПрерватьОбработкуТекущегоСигнала(Сигнал, ПричинаОтмены, ТочкаОтмены)
		
	Запись = ПолучитьЗаписьСобытийСигнала(Сигнал);
	 
	Запись.ТочкаСигналЗавершен	= ТочкаОтмены;
	Запись.СигналЗавершен 		= Истина;
	Запись.ПричинаОтмены		= ПричинаОтмены;
	Запись.Записать(Истина);		
	
	биг_ПодсистемаОповещений.ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись);
	
