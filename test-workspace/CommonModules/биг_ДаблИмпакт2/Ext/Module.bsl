#Область СлужебныйИнтерфейс

// to do: перенести в ОМ МаркетАпи
Процедура ЗагрузитьИнформациюОСвечах() Экспорт
	
	// пропустим цикл, если предыдущее задание не завершилось
	Если биг_ОбщегоНазначения.ФоновоеЗаданиеАктивно_ПоКлючу("big_ЗагрузкаИнформацииОСвечах") Тогда
		Возврат;
	КонецЕсли;  
	
	ТекТаймСтамп			= биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(); 
	
	ИнструментыСтратегии 	= ПолучитьВыборкуИнструментовСтратегии(Ложь);
		
	Пока ИнструментыСтратегии.Следующий() Цикл                                                          
		
		// здесь должен быть вызов модуля Маркет АПИ, что бы в зависимости от биржи пошел вызов на конкретный модуль интеграции
		//ОбработкаИнтеграции = ИнструментыСтратегии.Биржа.ИнтеграционныйМодуль;   
		//МодульИнтеграции 	= ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ОбработкаИнтеграции);
		
		ТаймСтамп				= ТекТаймСтамп;
		
		// получить данные о последней свече
		ПоследняяСвеча 		= НайтиПоследнююСвечуИнструмента(ИнструментыСтратегии, ТаймСтамп);
		ТCПоследнейСвечи	= ?(ПоследняяСвеча <> Неопределено, ПоследняяСвеча.TimeStamp10, биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(Дата(2020, 01, 01)));
		КоличествоСвечей	= 100;
		
		// вычесть её точку из текущего времени, поделить на размер бара
		ТребуетсяБар		= Цел((ТаймСтамп - ТCПоследнейСвечи) / ИнструментыСтратегии.Бар.SecondsAmount) + 1;
		ТребуетсяИтераций	= Цел(ТребуетсяБар/КоличествоСвечей);
		Если ТребуетсяИтераций > 40 Тогда
			ТребуетсяИтераций = 40;
		ИначеЕсли ТребуетсяИтераций = 0 Тогда
			ТребуетсяИтераций = 1;
		КонецЕсли;		
		
		Для Счетчик = 1 По ТребуетсяИтераций Цикл
			
			ТССтрока = биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ТаймСтамп);
			
			СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьИсториюСвечей(); 			
			СтруктураОперации.Биржа 			= ИнструментыСтратегии.Биржа;
			СтруктураОперации.ИнструментИД		= ИнструментыСтратегии.ИнструментИД;
			СтруктураОперации.Бар				= ИнструментыСтратегии.Бар;
			СтруктураОперации.КоличествоСвечей	= КоличествоСвечей;
			СтруктураОперации.ТочкаДо			= ТаймСтамп * 1000; //у ОКХ формат ТС 13 символов			
			
			биг_МаркетАпи.ЗагрузитьИсториюСвечей(СтруктураОперации);
			
			ТаймСтамп = ТаймСтамп - (ИнструментыСтратегии.Бар.SecondsAmount * КоличествоСвечей);
			
		КонецЦикла;
		
		ПараметрRSI 	= 14;
        ТаймСтампRSI 	= ТаймСтамп - (ИнструментыСтратегии.Бар.SecondsAmount * ПараметрRSI); 
		
		биг_Индикаторы.ВычислитьПоказатель(ИнструментыСтратегии.Биржа, ИнструментыСтратегии.ИнструментИД, ИнструментыСтратегии.Бар,
												Перечисления.биг_ВидыИндикаторов.RSI, ПараметрRSI,,, 
												Перечисления.биг_ИсточникиДанныхТехническихИндикаторов.ЦенаЗакрытия, ТаймСтампRSI, ТекТаймСтамп);
												
												
		ПараметрМА		= 20;
		ТаймСтампМА		= ТаймСтамп - (ИнструментыСтратегии.Бар.SecondsAmount * ПараметрМА);
		биг_Индикаторы.ВычислитьПоказатель(ИнструментыСтратегии.Биржа, ИнструментыСтратегии.ИнструментИД, ИнструментыСтратегии.Бар,
												Перечисления.биг_ВидыИндикаторов.MA, ПараметрМА,,, 
												Перечисления.биг_ИсточникиДанныхТехническихИндикаторов.volCcy, ТаймСтампМА, ТекТаймСтамп); 
													
													
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивАктивныхСигналов(ПараметрыИнструмента, ТаймСтамп, ТолькоАктуальные = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактСигналы.Биржа КАК Биржа,
	|	биг_ДаблИмпактСигналы.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактСигналы.Бар КАК Бар,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	биг_ДаблИмпактСигналы.СреднийОбъем КАК СреднийОбъем,
	|	биг_ДаблИмпактСигналы.УровеньСопротивления КАК УровеньСопротивления,
	|	биг_ДаблИмпактСигналы.ТочкаЗавершенияПадения КАК ТочкаЗавершенияПадения,
	|	биг_ДаблИмпактСигналы.ТочкаРазворота КАК ТочкаРазворота,
	|	биг_ДаблИмпактСигналы.ТочкаВхода1 КАК ТочкаВхода1,
	|	биг_ДаблИмпактСигналы.ТочкаВхода2 КАК ТочкаВхода2,
	|	биг_ДаблИмпактСигналы.ТочкаВыхода1 КАК ТочкаВыхода1,
	|	биг_ДаблИмпактСигналы.ТочкаВыхода2 КАК ТочкаВыхода2,
	|	биг_ДаблИмпактСигналы.ТекущееСобытие КАК ТекущееСобытие,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаСобытия КАК ТочкаНачалаСобытия,
	|	биг_ДаблИмпактСигналы.СигналЗавершен КАК СигналЗавершен,
	|	биг_ДаблИмпактСигналы.ЗавершеноПоложительно КАК ЗавершеноПоложительно,
	|	биг_ДаблИмпактСигналы.ПричинаОтмены КАК ПричинаОтмены,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПаденияДатой КАК ТочкаНачалаПаденияДатой,
	|	биг_ДаблИмпактСигналы.ТочкаСигналЗавершен КАК ТочкаСигналЗавершен,
	|	биг_ДаблИмпактСигналы.ПаттернСигнала КАК ПаттернСигнала,
	|	биг_ДаблИмпактСигналы.КлючНастроек КАК КлючНастроек
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	биг_ДаблИмпактСигналы.Биржа = &Биржа
	|	И НЕ биг_ДаблИмпактСигналы.СигналЗавершен
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.Бар = &Бар
	|	И биг_ДаблИмпактСигналы.ТочкаНачалаПадения <= &ТаймСтамп
	|	И биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек
	|	И НЕ биг_ДаблИмпактСигналы.СигналЗавершен
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТочкаНачалаПадения";
	
	Запрос.УстановитьПараметр("Биржа", 		ПараметрыИнструмента.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", ПараметрыИнструмента.ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 		ПараметрыИнструмента.Бар);
	Запрос.УстановитьПараметр("КлючНастроек", 		ПараметрыИнструмента.КлючНастроек);
	Запрос.УстановитьПараметр("ТаймСтамп", 	ТаймСтамп);

	Если НЕ ТолькоАктуальные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ биг_ДаблИмпактСигналы.СигналЗавершен", "");
	КонецЕсли;
	
	МассивСигналов = Новый Массив();
	
	// добавляем в массив сигналов "пустой сигнал", что бы тек. точка могла быть новым сигналом
	Сигнал = ПолучитьСтруктуруСигнала();
	ЗаполнитьЗначенияСвойств(Сигнал, ПараметрыИнструмента);
	МассивСигналов.Добавить(Сигнал);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Сигнал = ПолучитьСтруктуруСигнала();
			ЗаполнитьЗначенияСвойств(Сигнал, Выборка);
			МассивСигналов.Добавить(Сигнал);
		КонецЦикла;		
	КонецЕсли;
	
	Возврат МассивСигналов;	
		
КонецФункции

Функция ПолучитьДетальнуюИнформациюПоСигналу(Биржа, ИнструментИД, Бар, КлючНастроек, ТочкаНачалаПадения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактСигналы.Биржа КАК Биржа,
	|	биг_ДаблИмпактСигналы.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактСигналы.Бар КАК Бар,
	|	биг_ДаблИмпактСигналы.КлючНастроек КАК КлючНастроек,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПадения КАК ТочкаНачалаПадения,
	|	биг_ДаблИмпактСигналы.СреднийОбъем КАК СреднийОбъем,
	|	биг_ДаблИмпактСигналы.УровеньСопротивления КАК УровеньСопротивления,
	|	биг_ДаблИмпактСигналы.ТочкаЗавершенияПадения КАК ТочкаЗавершенияПадения,
	|	биг_ДаблИмпактСигналы.ПаттернСигнала КАК ПаттернСигнала,
	|	биг_ДаблИмпактСигналы.ТочкаРазворота КАК ТочкаРазворота,
	|	биг_ДаблИмпактСигналы.ТочкаВхода1 КАК ТочкаВхода1,
	|	биг_ДаблИмпактСигналы.ТочкаВхода2 КАК ТочкаВхода2,
	|	биг_ДаблИмпактСигналы.ТочкаВыхода1 КАК ТочкаВыхода1,
	|	биг_ДаблИмпактСигналы.ТочкаВыхода2 КАК ТочкаВыхода2,
	|	биг_ДаблИмпактСигналы.ТекущееСобытие КАК ТекущееСобытие,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаСобытия КАК ТочкаНачалаСобытия,
	|	биг_ДаблИмпактСигналы.ТочкаСигналЗавершен КАК ТочкаСигналЗавершен,
	|	биг_ДаблИмпактСигналы.СигналЗавершен КАК СигналЗавершен,
	|	биг_ДаблИмпактСигналы.ЗавершеноПоложительно КАК ЗавершеноПоложительно,
	|	биг_ДаблИмпактСигналы.ПричинаОтмены КАК ПричинаОтмены,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПаденияДатой КАК ТочкаНачалаПаденияДатой
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	биг_ДаблИмпактСигналы.Биржа = &Биржа
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.Бар = &Бар
	|	И биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек
	|	И биг_ДаблИмпактСигналы.ТочкаНачалаПадения = &ТочкаНачалаПадения";
	
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", ИнструментИД);
	Запрос.УстановитьПараметр("Бар", Бар);
	Запрос.УстановитьПараметр("КлючНастроек", КлючНастроек);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ТочкаНачалаПадения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Сигнал = ПолучитьСтруктуруСигнала();
	ЗаполнитьЗначенияСвойств(Сигнал, Выборка);
	
	Возврат Сигнал;
	
