Функция ПолучитьНастройкуСтратегии(Биржа, ИнструментИД) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактИнструментыСрезПоследних.КлючНастройки КАК КлючНастройки
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактИнструменты.СрезПоследних КАК биг_ДаблИмпактИнструментыСрезПоследних
	|ГДЕ
	|	биг_ДаблИмпактИнструментыСрезПоследних.Биржа = &Биржа
	|	И биг_ДаблИмпактИнструментыСрезПоследних.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактИнструментыСрезПоследних.Участие";
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", ИнструментИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КлючНастройки;	
	
КонецФункции

#КонецОбласти //Интеграция 


