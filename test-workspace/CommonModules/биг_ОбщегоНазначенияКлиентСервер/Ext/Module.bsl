

#Область ВычисленияНадМассивами

Функция ВычислитьRSI(ЦеныЗакрытия, Период = 14) Экспорт 

	// ЦеныЗакрытия - массив цен закрытия
    // Период - период для расчета RSI (обычно 14)

    Если ЦеныЗакрытия.Количество() < Период Тогда
        Возврат Неопределено; // Недостаточно данных для расчета
    КонецЕсли;

    // Массивы для хранения изменений цен
    Изменения = Новый Массив;
    ПоложительныеИзменения = Новый Массив;
    ОтрицательныеИзменения = Новый Массив;

    // Вычисляем изменения цен
    Для i = 1 По ЦеныЗакрытия.Количество() - 1 Цикл
        Изменение = ЦеныЗакрытия[i] - ЦеныЗакрытия[i - 1];
        Изменения.Добавить(Изменение);
        Если Изменение > 0 Тогда
            ПоложительныеИзменения.Добавить(Изменение);
            ОтрицательныеИзменения.Добавить(0);
        Иначе
            ПоложительныеИзменения.Добавить(0);
            ОтрицательныеИзменения.Добавить(-Изменение);
        КонецЕсли;
    КонецЦикла;

    // Рассчитываем средние значения
    СреднееПоложительноеИзменение = СуммаЧиселВМассиве(ПоложительныеИзменения) / Период;
    СреднееОтрицательноеИзменение = СуммаЧиселВМассиве(ОтрицательныеИзменения) / Период;

    // Рассчитываем RS
    RS = СреднееПоложительноеИзменение / СреднееОтрицательноеИзменение;

    // Рассчитываем RSI
    RSI = 100 - (100 / (1 + RS));

    Возврат RSI;
	
КонецФункции

Функция СуммаЧиселВМассиве(Массив) Экспорт
	
	Сумма = 0;
	
	Для каждого Число Из Массив Цикл
		Сумма = Сумма + Число;	
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

Функция СреднееЗначениеВМассиве(Массив) Экспорт
	
	Среднее = Неопределено; 
	
	Если Массив.Количество() <> 0 Тогда 
		
		Сумма = СуммаЧиселВМассиве(Массив);
		Среднее = Сумма / Массив.Количество();	
		
	КонецЕсли; 
	
	Возврат Среднее;
	
КонецФункции

