КонецФункции 

Функция ДатуВTimestampСтрока(пДата = Неопределено) Экспорт
	
	Возврат Формат(Число(?(ТипЗнч(пДата) = Тип("Дата"), пДата, биг_ОбщегоНазначения.ТекущаяДатаНаСервере()) - Дата("19700101")),"ЧН=0; ЧГ=0");
	
КонецФункции

Функция TimeStampЧислоВСтроку(TimeStampЧисло, КоличествоСимволов = 13) Экспорт

	ТСИтог 		= "";
	
	ТССтрока 	= Формат(TimeStampЧисло,"ЧН=0; ЧГ=0");
	ДлинаТС 	= СтрДлина(ТССтрока);
	
	Если ДлинаТС < КоличествоСимволов Тогда
		
		//добавить нули
		Разница = КоличествоСимволов - ДлинаТС;
		Для Сч=1 По Разница Цикл
			ТССтрока = ТССтрока + "0";
		КонецЦикла;
		
		ТСИтог = ТССтрока;
		
	ИначеЕсли ДлинаТС > КоличествоСимволов Тогда
		
		// обрезать
		ТСИтог = Лев(ТССтрока, КоличествоСимволов);
	Иначе
		
		ТСИтог = ТССтрока;
	КонецЕсли;
	
	Возврат ТСИтог;
	
КонецФункции
     
Функция TimestampВДату(Timestamp) Экспорт
	
	Возврат Дата("19700101") + Timestamp;  
	
КонецФункции

Функция ТекущаяДатаВМиллисекундахЭпохаUnixGMT0() Экспорт

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - (Дата(1970, 1, 1) - Дата(1,1,1)) * 1000;
	
КонецФункции


Функция СтрокаДатыСМиллисекундами(ТСВМиллисекундах = Неопределено) Экспорт
	
	// УниверсальноеВремя(ТекущаяДатаСеанса(), ЧасовойПоясСеанса())
	
	Если ТСВМиллисекундах = Неопределено Тогда
		ТСВМиллисекундах = ТекущаяДатаВМиллисекундахЭпохаUnixGMT0();		
	КонецЕсли;
	
	Миллисекунды 	= ВыделитьМиллисекунды(ТСВМиллисекундах);
	МилисекСтрока 	= Формат(Миллисекунды, "ЧЦ=3; ЧВН=");
	
	ТС13Строка		= Формат(ТСВМиллисекундах, "ЧГ=0");
	ТС10Число	 	= Число(Лев(ТС13Строка, 10));
	
	ДатаВремя 		= TimestampВДату(ТС10Число); 
	СтрокаДаты 		= Формат(ДатаВремя, "ДФ=yyyy-MM-ddTHH:mm:ss.") + МилисекСтрока + "Z";
	
	Возврат СтрокаДаты;
	
КонецФункции

Функция ВыделитьМиллисекунды(ТекущаяДатаВМиллисекундах) Экспорт
	
	// Преобразуем значение текущей даты в миллисекундах в объект типа Дата
    ДатаВремя = Дата(1970, 1, 1) + ТекущаяДатаВМиллисекундах / 1000;
    
    // Выделяем миллисекунды
    Миллисекунды = ТекущаяДатаВМиллисекундах % 1000;
    
    Возврат Миллисекунды;
	
КонецФункции

