#Область РаботаСТекстом

Функция ЭкранироватьСпецсимволыДляMarkdownV2(ИсходныйТекст) Экспорт
	
	Текст = ИсходныйТекст;
	
    // Список специальных символов, которые нужно экранировать
    Спецсимволы = Новый Массив;
	Спецсимволы.Добавить("\\"); // Экранируем сам обратный слэш
    Спецсимволы.Добавить("#");
    Спецсимволы.Добавить("[");
    Спецсимволы.Добавить("]");
    Спецсимволы.Добавить("(");
    Спецсимволы.Добавить(")");
    Спецсимволы.Добавить("_");
    Спецсимволы.Добавить("*");
    Спецсимволы.Добавить("`");
    Спецсимволы.Добавить("~");
    Спецсимволы.Добавить(">");
    Спецсимволы.Добавить("<");
    Спецсимволы.Добавить("-");
    Спецсимволы.Добавить("+");
    Спецсимволы.Добавить("=");
    Спецсимволы.Добавить("|");
    Спецсимволы.Добавить("{");
    Спецсимволы.Добавить("}");
    Спецсимволы.Добавить(".");
    Спецсимволы.Добавить("!");
	
	// Экранирование каждого специального символа
    Для Каждого Символ Из Спецсимволы Цикл
        Текст = СтрЗаменить(Текст, Символ, "\" + Символ);
	КонецЦикла;
	
	Текст = СтрЗаменить(Текст, Символы.НПП, "");

    Возврат Текст;

КонецФункции

