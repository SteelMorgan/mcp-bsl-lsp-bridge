Процедура УдалитьНеиспользуемыеКлючи(СтруктураJSON) Экспорт
	
	Массив = Новый Массив;
	
	Для каждого Элемент Из СтруктураJSON Цикл
		Если НЕ ЗначениеЗаполнено(Элемент.Значение) Тогда
			Массив.Добавить(Элемент.Ключ);	
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого Ключ Из Массив Цикл
		СтруктураJSON.Удалить(Ключ);	
	КонецЦикла;
		
КонецПроцедуры

// Функция для рекурсивной замены Соответствий на Структуры в объекте JSON
Функция ЗаменитьСоответствияНаСтруктуры(ОбъектJSON) Экспорт
	
	// Определяем тип текущего объекта
    ТипОбъекта = ТипЗнч(ОбъектJSON);
    
    // Если это Соответствие - преобразуем в Структуру
    Если ТипОбъекта = Тип("Соответствие") Тогда
        
        // Создаем новую структуру
        НоваяСтруктура = Новый Структура;
        
        // Перебираем все элементы соответствия
        Для Каждого Элемент Из ОбъектJSON Цикл
            // Рекурсивно обрабатываем значение элемента
            ОбработанноеЗначение = ЗаменитьСоответствияНаСтруктуры(Элемент.Значение);
            // Добавляем в новую структуру
            НоваяСтруктура.Вставить(Элемент.Ключ, ОбработанноеЗначение);
        КонецЦикла;
        
        // Возвращаем преобразованную структуру
        Возврат НоваяСтруктура;
        
    // Если это Массив - обрабатываем каждый элемент массива
    ИначеЕсли ТипОбъекта = Тип("Массив") Тогда
        
        // Создаем новый массив для результатов
        НовыйМассив = Новый Массив;
        
        // Перебираем все элементы массива
        Для Каждого Элемент Из ОбъектJSON Цикл
            // Рекурсивно обрабатываем каждый элемент
            ОбработанныйЭлемент = ЗаменитьСоответствияНаСтруктуры(Элемент);
            // Добавляем в новый массив
            НовыйМассив.Добавить(ОбработанныйЭлемент);
        КонецЦикла;
        
        // Возвращаем преобразованный массив
        Возврат НовыйМассив;
        
    // Если это Структура - обрабатываем ее значения
    ИначеЕсли ТипОбъекта = Тип("Структура") Тогда
        
        // Создаем новую структуру для результатов
        НоваяСтруктура = Новый Структура;
        
        // Перебираем все элементы структуры
        Для Каждого Элемент Из ОбъектJSON Цикл
            // Рекурсивно обрабатываем значение элемента
            ОбработанноеЗначение = ЗаменитьСоответствияНаСтруктуры(Элемент.Значение);
            // Добавляем в новую структуру
            НоваяСтруктура.Вставить(Элемент.Ключ, ОбработанноеЗначение);
        КонецЦикла;
        
        // Возвращаем преобразованную структуру
        Возврат НоваяСтруктура;
        
    // Для всех остальных типов (простые значения: строка, число, дата, булево и т.д.) - возвращаем как есть
    Иначе
        Возврат ОбъектJSON;
    КонецЕсли;
		
КонецФункции

