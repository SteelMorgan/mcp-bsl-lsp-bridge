#Область МэппингПараметровМетодовИнтеграционныхМодулей

// Конвертирует универсальные параметры в специфичные для CoinGecko под метод "ЗагрузитьТопИнструментов"
Функция ПараметрыОперацииБиржи_ЗагрузитьТопИнструментов(ПараметрыОперации) Экспорт
    СтруктураОперации = КонвертироватьПараметрыОперации_ЗагрузитьТопИнструментов(ПараметрыОперации);
    // CoinGecko API ожидает параметры в URL, преобразование в строку не требуется
    // биг_МаркетАпиКлиентСервер.ПреобразоватьВСтрокуПараметрыОперации(СтруктураОперации); // Не нужно для GET-запросов с параметрами
    Возврат СтруктураОперации;
КонецФункции

// Реализация конвертации универсальных параметров в специфичные для CoinGecko
Функция КонвертироватьПараметрыОперации_ЗагрузитьТопИнструментов(ПараметрыОперации)
    СтруктураЗапроса = СтруктураЗапроса_ЗагрузитьТопИнструментов();
    
    // vs_currency — валюта цен
    Если ЗначениеЗаполнено(ПараметрыОперации.ВалютаЦены) Тогда
        СтруктураЗапроса.vs_currency = ПараметрыОперации.ВалютаЦены;
    КонецЕсли;

    // per_page — количество результатов на странице
    Если ЗначениеЗаполнено(ПараметрыОперации.Лимит) Тогда
        СтруктураЗапроса.per_page = ПараметрыОперации.Лимит;
    КонецЕсли;
    
    // page — номер страницы
    Если ЗначениеЗаполнено(ПараметрыОперации.Страница) Тогда
        СтруктураЗапроса.page = ПараметрыОперации.Страница;
    КонецЕсли;
    
    // order — порядок сортировки
    Если ЗначениеЗаполнено(ПараметрыОперации.Сортировка) И ЗначениеЗаполнено(ПараметрыОперации.ПорядокСортировки) Тогда
        СтруктураЗапроса.order = ПараметрыОперации.Сортировка + "_" + ПараметрыОперации.ПорядокСортировки;
    ИначеЕсли ЗначениеЗаполнено(ПараметрыОперации.Сортировка) Тогда
        // Если порядок не задан, используем по умолчанию desc
        СтруктураЗапроса.order = ПараметрыОперации.Сортировка + "_desc";
    КонецЕсли;
    
    // Добавьте маппинг других параметров при необходимости

    Возврат СтруктураЗапроса;
КонецФункции

// Структура запроса, соответствующая API CoinGecko (/coins/markets)
Функция СтруктураЗапроса_ЗагрузитьТопИнструментов()
    СтруктураЗапроса = Новый Структура();
    СтруктураЗапроса.Вставить("vs_currency", "usd"); // по умолчанию
    СтруктураЗапроса.Вставить("per_page", 100); // по умолчанию
    СтруктураЗапроса.Вставить("page", 1); // по умолчанию
    СтруктураЗапроса.Вставить("order", "market_cap_desc"); // по умолчанию
    // Добавьте другие параметры по необходимости (например, "sparkline", "price_change_percentage")
    Возврат СтруктураЗапроса;
КонецФункции

#КонецОбласти //МэппингПараметровМетодовИнтеграционныхМодулей