Процедура ЗаполнитьСделкуДляПозиции(Позиция, СопоставитьСоСделкой, СопоставленаСоСделкой, ПараметрыПоиска) Экспорт

	// выполняем поиск
	Сделка = ПодобратьСделкуПоПозиции(ПараметрыПоиска);	
	
	Если ЗначениеЗаполнено(Сделка) Тогда
		
		// если нашли ставим в документ флаг ПозицияОбъект.СопоставитьСоСделкой = Ложь, ПозицияОбъект.СопоставленаСоСделкой = Истина
		СопоставитьСоСделкой = Ложь;
		СопоставленаСоСделкой = Истина;
		
		// заполняем запись в регистр
		Набор = РегистрыСведений.биг_ПозицииПоСделкам.СоздатьНаборЗаписей();
		Набор.Отбор.Сделка.Установить(Сделка);
		Набор.Отбор.Аккаунт.Установить(ПараметрыПоиска.Аккаунт);
		
		Запись = Набор.Добавить();
		Запись.Сделка 	= Сделка;
		Запись.Аккаунт	= ПараметрыПоиска.Аккаунт;
		Запись.Позиция	= Позиция;
		
		Набор.Записать(Истина);
	Иначе
		
		// иначе ПозицияОбъект.СопоставитьСоСделкой = Ложь (что бы больше не искать сделку при каждом обновлении позиции)
		СопоставитьСоСделкой = Ложь;
	КонецЕсли;
	  
КонецПроцедуры

Функция ПодобратьСделкуПоПозиции(ПараметрыПоиска)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	биг_Сделки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.биг_Сделки КАК биг_Сделки
	|ГДЕ
	|	биг_Сделки.ТаймСтамп10 МЕЖДУ &ОтступОтПозиции И &ДатаПозиции
	|	И биг_Сделки.Инструмент = &Инструмент
	|	И биг_Сделки.СторонаСделки = &СторонаСделки
	|	И биг_Сделки.Плечо = &Плечо
	|	И биг_Сделки.РежимМаржи = &РежимМаржи
	|	И НЕ биг_Сделки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	биг_Сделки.ТаймСтамп10 УБЫВ";
	
	Запрос.УстановитьПараметр("ОтступОтПозиции", 	ПараметрыПоиска.ДатаОткрытия - 120);
	Запрос.УстановитьПараметр("ДатаПозиции", 		ПараметрыПоиска.ДатаОткрытия);
	Запрос.УстановитьПараметр("Инструмент", 		ПараметрыПоиска.Инструмент);
	Запрос.УстановитьПараметр("СторонаСделки", 		ПараметрыПоиска.СторонаПозиции);
	Запрос.УстановитьПараметр("Плечо", 				ПараметрыПоиска.Плечо);
	Запрос.УстановитьПараметр("РежимМаржи", 		ПараметрыПоиска.РежимМаржи);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Сделка = Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Сделка = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Сделка;
	
КонецФункции

Функция НайтиИнструментБиржиПоДвумМонетам(Биржа, База, Квота) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	big_Instruments.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.big_Instruments КАК big_Instruments
	|ГДЕ
	|	big_Instruments.Владелец = &Владелец
	|	И big_Instruments.baseCcy = &baseCcy
	|	И big_Instruments.quoteCcy = &quoteCcy
	|	И big_Instruments.instType = Значение(Перечисление.big_OKX_InstrumentType.SPOT)";
	
	Запрос.УстановитьПараметр("Владелец", Биржа);
	Запрос.УстановитьПараметр("baseCcy", База);
	Запрос.УстановитьПараметр("quoteCcy", Квота);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	
КонецФункции


