#Область ОписаниеПараметров

Функция СП_Логин() Экспорт
	
	Структура = Новый Структура();
	Структура.Вставить("op", "login");
	
	Аргументы = Новый Структура(); 
	Аргументы.Вставить("apiKey", "");
	Аргументы.Вставить("passphrase", "");
	Аргументы.Вставить("timestamp", "");
	Аргументы.Вставить("sign", "");
	Массив = Новый Массив;
	Массив.Добавить(Аргументы);
	
	Структура.Вставить("args", Массив);
	
	Возврат Структура;
	
КонецФункции

Функция СП_Подписка_МаркетЦены()
	
	Структура = Новый Структура();
	Структура.Вставить("id", 			""); // Unique identifier of the message. Provided by client.
	Структура.Вставить("op", 			""); // Operation
	Структура.Вставить("args", 			""); // List of subscribed channels
	
	Возврат Структура;
	
КонецФункции

Функция СП_Аргументы_МаркетПрайс(МассивАргументов)
	
	Массив = Новый Массив();
	
	Для каждого Элемент Из МассивАргументов Цикл
		Структура = Новый Структура();
		ДобавитьКанал(Структура, "mark-price");
		ДобавитьИнструментИД(Структура, Элемент.ИнструментИД);
		
		Массив.Добавить(Структура);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция СП_Подписка_ИзмененияОрдеров() Экспорт
	
	Структура = Новый Структура();
	Структура.Вставить("id", 			""); // Unique identifier of the message. Provided by client.
	Структура.Вставить("op", 			""); // Operation
	Структура.Вставить("args", 			""); // List of subscribed channels
	
	Возврат Структура;
	
КонецФункции

Функция СП_Аргументы_ИзмененияОрдеров(МассивАргументов) Экспорт
	
	Массив = Новый Массив();
	
	Для каждого Элемент Из МассивАргументов Цикл
		Структура = Новый Структура();
		ДобавитьКанал(Структура, "orders");
		ДобавитьИнструментИД(Структура, 		Элемент.ИнструментИД);
		ДобавитьИнструментТип(Структура, 		Элемент.ИнструментТип);
		ДобавитьИнструментСемейство(Структура, 	Элемент.ИнструментСемейство);
		
		Массив.Добавить(Структура);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция СП_Подписка_БалансыИПозиции() Экспорт

	Параметры = Новый Структура();
	Параметры.Вставить("op", "subscribe");
	
	МассивАргументов = Новый Массив;
	Аргумент = Новый Структура("channel", "balance_and_position");
	МассивАргументов.Добавить(Аргумент);
	
	Параметры.Вставить("args", МассивАргументов);
	
	Возврат Параметры;	
КонецФункции

Функция СП_Подписка_Позиции() Экспорт

	Параметры = Новый Структура();
	Параметры.Вставить("op", 	"subscribe");
	Параметры.Вставить("args", 	"");
	
	Возврат Параметры;	
КонецФункции

Функция СП_Подписка_Позиции_Аргумент() Экспорт
	
	Структура = Новый Структура();
	Структура.Вставить("channel", "positions");
	Структура.Вставить("instType", "");
	
	Возврат Структура;
	
КонецФункции


Процедура ДобавитьКанал(Структура, ИмяКанала)	
	Структура.Вставить("channel", ИмяКанала); // Channel name		
КонецПроцедуры

Процедура ДобавитьИнструментИД(Структура, ИнструментИД)	
	Структура.Вставить("instId", ИнструментИД); // Instrument ID filter		
КонецПроцедуры

Процедура ДобавитьИнструментТип(Структура, ИнструментТип)	
	Структура.Вставить("instType", ИнструментТип); // Instrument ID filter		
КонецПроцедуры

Процедура ДобавитьИнструментСемейство(Структура, ИнструментСемейство)	
	Структура.Вставить("instFamily", ИнструментСемейство); // Instrument ID filter		
КонецПроцедуры

