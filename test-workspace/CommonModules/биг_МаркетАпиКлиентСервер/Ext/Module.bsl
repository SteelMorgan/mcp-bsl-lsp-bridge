Функция СтруктураОперации_ЗагрузитьТопИнструментов() Экспорт
	
    СтруктураОперации = Новый Структура();
    СтруктураОперации.Вставить("Биржа", ""); // Используется для выбора интеграции, например "CoinGecko"
