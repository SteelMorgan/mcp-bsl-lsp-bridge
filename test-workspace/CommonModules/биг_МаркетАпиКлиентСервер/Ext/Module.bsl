    Возврат СтруктураОперации;
КонецФункции

#КонецОбласти //СтруктураПараметровУнифицированныхМетодов 


#Область Вспомогательные

Процедура ПреобразоватьВСтрокуПараметрыОперации(СтруктураОперации) Экспорт

	Для каждого Элемент Из СтруктураОперации Цикл
		
		ТипЗначения = ТипЗнч(Элемент.Значение); 
		Если ТипЗначения <> Тип("Массив") Тогда 
			
			Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево")  Тогда
				СтруктураОперации.Вставить(Элемент.Ключ, XMLСтрока(Элемент.Значение));
			ИначеЕсли ТипЗначения = Тип("Строка") Тогда
			Иначе
				СтруктураОперации.Вставить(Элемент.Ключ, Строка(Элемент.Значение));	
			КонецЕсли;			
		Иначе    
			
			Для каждого Структура Из Элемент.Значение Цикл
				ПреобразоватьВСтрокуПараметрыОперации(Структура);	
			КонецЦикла;
			
		КонецЕсли;			
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти //Вспомогательные



