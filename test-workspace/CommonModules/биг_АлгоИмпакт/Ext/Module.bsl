Функция ПолучитьПоследнююСвечуСИндикаторами(Сигнал, КлючНастроек, ТаймСтамп)
	                           
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	РазмерБара = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сигнал.Бар, "SecondsAmount");
	
	ПараметрыЗапроса.СортировкаПоУбыванию				= Истина;
	ПараметрыЗапроса.КоличествоСвечей					= 1;
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= биг_ОбщегоНазначения.НачалоПериодаПоБару(ТаймСтамп, Сигнал.Бар) - РазмерБара;
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода; //ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода - (РазмерБара * ПараметрыЗапроса.КоличествоСвечей) + 1;
	ПараметрыЗапроса.ОграничениеПериода			       	= ТаймСтамп;
		
	ЗадачиРасчета 		= биг_УправлениеИндикаторамиСервер.ЗадачиРасчетаДляАлгоИмпакт(КлючНастроек);
	МассивСОднойСвечой  = биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочкеСИндикаторами(ПараметрыЗапроса, ЗадачиРасчета);
	
	Если МассивСОднойСвечой.Количество() > 0 Тогда
		Свеча = МассивСОднойСвечой[0];
	Иначе
		Свеча = Неопределено;
	КонецЕсли;
	
	Возврат Свеча;
	
КонецФункции

Функция ОпределитьУровеньСтопЛосс(Сигнал, ТекСвеча, Запись, ТаймСтамп)
	
	МассивСтопов		= НайтиСтопЛос(Сигнал, Запись.Участник);
		
	Если Сигнал.Бектест Тогда
		ТекущаяЦена		= ПолучитьЦенуПоИсторическимДанным(Сигнал, Запись, ТаймСтамп);		
	Иначе
		ТекущаяЦена		= ПолучитьТекущуюЦену(Сигнал, Запись);	
	КонецЕсли;
	
	КоличествоАТРдляСЛ	= ПолучитьЗначениеПараметраСтратегии("АИ_2_КоличествоАТРнаСтопЛосс", Сигнал.КлючНастроек);
	РискНаСделку		= ПолучитьЗначениеПараметраСтратегии("АИ_2_Риск", Сигнал.КлючНастроек);
	
	УровеньСтопЛоссАТР 	= ТекущаяЦена + (ТекСвеча.АТР * КоличествоАТРдляСЛ) * ?(Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий, 1, -1);		
	УровеньПоРиску		= ТекущаяЦена + (ТекущаяЦена / 100 * РискНаСделку) * ?(Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий, 1, -1);
	
	Если Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Восходящий Тогда		
		
		УровеньСтопЛосс = Макс(УровеньСтопЛоссАТР, УровеньПоРиску);
		Если МассивСтопов.Количество() > 0 Тогда
			УровеньСтопЛосс = Макс(УровеньСтопЛоссАТР, МассивСтопов[0].slTriggerPx);	
		КонецЕсли;
		
	ИначеЕсли Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий Тогда
		
		УровеньСтопЛосс = Мин(УровеньСтопЛоссАТР, УровеньПоРиску);
		Если МассивСтопов.Количество() Тогда
			УровеньСтопЛосс = Мин(УровеньСтопЛоссАТР, МассивСтопов[0].slTriggerPx);	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УровеньСтопЛосс;
	
КонецФункции                                                                    

Процедура АктуализироватьНастройкиИнструментаНаАккаунте(ИнструментИД, Аккаунт, КлючНастроек, ШагВыполнен)
	
	ЗначениеПлеча		= ПолучитьЗначениеПараметраСтратегии("ДИ_2_Плечо", КлючНастроек);
	ЗначениеПлеча		= ?(ЗначениеЗаполнено(ЗначениеПлеча), ЗначениеПлеча, 1);
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_УстановитьМаржу();

	СтруктураОперации.Вставить("ИнструментИД", ИнструментИД);
	СтруктураОперации.Вставить("УровеньМаржи", ЗначениеПлеча);
	СтруктураОперации.Вставить("РежимТорговли", Перечисления.big_OKX_tdModes.isolated);

	ШагВыполнен = биг_МаркетАпи.УстановитьМаржу(Аккаунт, СтруктураОперации);
	
КонецПроцедуры        

Функция ТребуетсяОбработкаСигнала(Сигнал, КлючНастроек, ТаймСтамп)
	
	ТочкаПоследнегоШага = ПолучитьТекущуюТочкуНаЛинииВремени(Сигнал.Биржа, Сигнал.ИнструментИД, Сигнал.Бар, КлючНастроек);
	СледующийШаг 		= ТочкаПоследнегоШага + Сигнал.Бар.SecondsAmount;
	Возврат ТаймСтамп >= СледующийШаг;
	
КонецФункции

Функция ПолучитьТекущуюТочкуНаЛинииВремени(Биржа, ИнструментИД, Бар, КлючНастроек)
	
	Менеджер = РегистрыСведений.биг_ДаблИмпактВременныеТочки.СоздатьМенеджерЗаписи();
	Менеджер.Биржа 					= Биржа;
	Менеджер.ИнструментИД 			= ИнструментИД;
	Менеджер.Бар					= Бар;
	Менеджер.НастройкаСтратегии		= КлючНастроек;
	Менеджер.Прочитать();
	
	Возврат Менеджер.ТочкаНаЛинииВремени;	
	
КонецФункции

Процедура ЗаписатьТочкуНаЛинииВремени(Биржа, ИнструментИД, Бар, КлючНастроек, ТочкаОтсчетаТС)
	
	Менеджер = РегистрыСведений.биг_ДаблИмпактВременныеТочки.СоздатьМенеджерЗаписи();
	Менеджер.Биржа 					= Биржа;
	Менеджер.ИнструментИД 			= ИнструментИД;
	Менеджер.Бар					= Бар;
	Менеджер.НастройкаСтратегии		= КлючНастроек;
	
	Менеджер.ТочкаНаЛинииВремени	= ТочкаОтсчетаТС;
	Менеджер.ТочкаДатой				= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаОтсчетаТС);
	
	Менеджер.Записать(Истина);
	
КонецПроцедуры

Процедура ЗафиксироватьТочкуТекущегоШага(Инструмент, КлючНастроек, ТаймСтамп)
	
	ЗаписатьТочкуНаЛинииВремени(Инструмент.Биржа, Инструмент.ИнструментИД, Инструмент.Бар, КлючНастроек, биг_ОбщегоНазначения.НачалоПериодаПоБару(ТаймСтамп, Инструмент.Бар));			
		
КонецПроцедуры

Функция НайтиПоследнююСвечуИнструмента(Сигнал, ТаймСтамп)
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ВыбратьПервые			= 1;
	ПараметрыЗапроса.СортировкаПоУбыванию	= Истина;
	
	ДанныеСвечей = биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);
	
	Если ДанныеСвечей.Количество() = 0 Тогда
		ПоследняяСвеча = Неопределено;
	Иначе
		ПоследняяСвеча = ДанныеСвечей[0];	
	КонецЕсли;
	
	Возврат ПоследняяСвеча;
	
КонецФункции

Функция НайтиМинимальныйУровеньВСигнале(Сигнал)
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= Сигнал.ТочкаНачалаПадения;
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода   = Сигнал.ТочкаЗавершенияПадения;
	
	ДанныеСвечей 		= биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);
	
	Минимум = 999999999999;
	Для каждого Свеча Из ДанныеСвечей Цикл
		Минимум = Мин(Свеча.ЦенаМинимум, Минимум);
		//Минимум = Мин(Свеча.ЦенаЗакрытия, Минимум);
	КонецЦикла;
	
	Возврат Минимум;
		
КонецФункции

Функция СобратьАккаунтыДляРеакцииНаСигнал(Сигнал)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_УчастникиСтратегийСрезПоследних.Participiant КАК Участник,
	|	биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.ccy КАК Монета,
	|	биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.availBal КАК ДоступныйБаланс,
	|	биг_УчастникиСтратегийСрезПоследних.СуммаДепозита КАК СуммаДепозита
	|ИЗ
	|	РегистрСведений.биг_УчастникиСтратегий.СрезПоследних(, ) КАК биг_УчастникиСтратегийСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.биг_ОКХ_БаллансАккаунтовДетали.СрезПоследних КАК биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних
	|		ПО биг_УчастникиСтратегийСрезПоследних.Participiant = биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.Account
	|			И (биг_ОКХ_БаллансАккаунтовДеталиСрезПоследних.ccy = &USDT)
	|ГДЕ
	|	биг_УчастникиСтратегийСрезПоследних.Участник
	|	И биг_УчастникиСтратегийСрезПоследних.Strategy = &Strategy
	|	И биг_УчастникиСтратегийСрезПоследних.Participiant.Владелец = &Биржа";
	
	Запрос.УстановитьПараметр("Strategy", 	ЭтаСтратегия());
	Запрос.УстановитьПараметр("USDT", 		РегистрыСведений.биг_ПредопределенныеЭлементы.ПолучитьЗначениеПоИмени("USDT"));
	Запрос.УстановитьПараметр("Биржа",		Сигнал.Биржа);

	ТабличаУчастников = Запрос.Выполнить().Выгрузить();
	
	Возврат	ТабличаУчастников;	
		
КонецФункции

Функция НайтиСтопЛос(Сигнал, Аккаунт)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).slTriggerPx > 0
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии";
	
	Запрос.УстановитьПараметр("Биржа", 				Сигнал.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 		Сигнал.ИнструментИД);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", Сигнал.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("Аккаунт", 			Аккаунт);
	Запрос.УстановитьПараметр("НастройкаСтратегии", Сигнал.КлючНастроек);
	                       
	Выборка = Запрос.Выполнить().Выбрать();
		
	МассивСтопов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивСтопов.Добавить(Выборка.Операция);		
	КонецЦикла;
	
	Возврат МассивСтопов;	
	
КонецФункции

Функция ТекущийИнструментИмеетОткрытыеОрдера(Сигнал)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДаблИмпактСигналы.Биржа КАК Биржа,
	|	биг_ДаблИмпактСигналы.ИнструментИД КАК ИнструментИД,
	|	биг_ДаблИмпактСигналы.КлючНастроек КАК КлючНастроек,
	|	биг_ДаблИмпактСигналы.ТочкаНачалаПадения КАК ТочкаНачалаПадения
	|ПОМЕСТИТЬ ВТ_АктивныеСигналы
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	НЕ биг_ДаблИмпактСигналы.СигналЗавершен
	|	И биг_ДаблИмпактСигналы.ТочкаНачалаПадения <> &ТекущаяТочкаНачалаПадения
	|	И биг_ДаблИмпактСигналы.Биржа = &Биржа
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	биг_ДаблИмпактОперации.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АктивныеСигналы КАК ВТ_АктивныеСигналы
	|		ПО биг_ДаблИмпактОперации.Биржа = ВТ_АктивныеСигналы.Биржа
	|			И биг_ДаблИмпактОперации.ИнструментИД = ВТ_АктивныеСигналы.ИнструментИД
	|			И биг_ДаблИмпактОперации.НастройкаСтратегии = ВТ_АктивныеСигналы.КлючНастроек
	|			И биг_ДаблИмпактОперации.Операция.ТочкаНачалаПадения = ВТ_АктивныеСигналы.ТочкаНачалаПадения";
	
	Запрос.УстановитьПараметр("ТекущаяТочкаНачалаПадения", 	Сигнал.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("Биржа", 						Сигнал.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 				Сигнал.ИнструментИД);
	Запрос.УстановитьПараметр("КлючНастроек", 				Сигнал.КлючНастроек);
	                 
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе 
		Возврат Истина;		
	КонецЕсли;
		
КонецФункции

Функция ВычислитьУровеньСопротивленияСигналаНаСтаршемФрейме(Сигнал)
	
	// определение "более старшего" фрейма
	Бар = биг_ОбщегоНазначения.НайтиСтаршийФрейм(Сигнал.Бар);
	
	// Получаем данные о 72 свечах 
	// из базы
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал); 
	
	ПараметрыЗапроса.КоличествоСвечей		= 72;
	ПараметрыЗапроса.ОграничениеПериода     = Сигнал.ТочкаНачалаПадения;
	ПараметрыЗапроса.СортировкаПоУбыванию	= Истина;
	
	ДанныеСвечей = биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);
	Если ДанныеСвечей.Количество() < ПараметрыЗапроса.КоличествоСвечей Тогда
		
		// если меньше, то запрос к бирже
		ПараметрыЗапроса = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьИсториюСвечей();
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Сигнал);
		
		// !!! TODO: ОКХ ведет учет в 13-ти значном формате.. не гибко, но пока так
		ПараметрыЗапроса.ТочкаДо 			= Сигнал.ТочкаНачалаПадения * 1000; 
		ПараметрыЗапроса.КоличествоСвечей 	= ПараметрыЗапроса.КоличествоСвечей;
	КонецЕсли;
		
		
	// ищем последнюю красную свечу (влево)
	ПредыдущаяСвеча = ДанныеСвечей[0];
	
	Для каждого Строка Из ДанныеСвечей Цикл
		Если биг_ОбщегоНазначения.ЭтоКраснаяСвеча(Строка) Тогда
			
			ПредыдущаяСвеча = Строка;
		Иначе         
			
			// попалась зеленая свеча - предыдущая и была последней красной
			Прервать; 
		КонецЕсли;	
	КонецЦикла;
	
	// ЦенаВыхода = ЦенаОткрытияПоследнейКрасной - 0.1%
	ЦенаВыхода = ПредыдущаяСвеча.ЦенаОткрытия - (ПредыдущаяСвеча.ЦенаОткрытия / 100 * 0.1);
	Возврат ЦенаВыхода;	
		
КонецФункции

Процедура ПроверитьАктуальностьСигнала(Выборка, ТаймСтамп)
	
	Если Выборка.slTriggerPx > 0 Тогда
		
		// это Стоп Лосс
		
		СтатусыСработал = Новый Массив;
		СтатусыСработал.Добавить("EFFECTIVE");
		СтатусыСработал.Добавить("PARTIALLY_EFFECTIVE");
		
		СтатусДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Операция, "state");
		Если СтатусыСработал.Найти(ВРег(СтатусДокумента)) <> Неопределено Тогда
			
			// сработал стоп, сигнал нуно завершить
			
			ПрофитУбытокСигнала = НайтиПрофитУбытокСигнала(Выборка);
			Если ПрофитУбытокСигнала <= 0 Тогда
				ЗавершитьСигналОтрицательно(Выборка, "Сработал Стоп-лосс", ТаймСтамп);
			Иначе
				ЗавершитьСигналУспешно(Выборка, ТаймСтамп);
			КонецЕсли;
			
			биг_ПодсистемаОповещений.ВнутреннееОповещениеОСрабатыванииСтопЛосса(Выборка, ПрофитУбытокСигнала);
			
			//ПрофитУбытокВПроцентах = ВычислитьФинРезВПроцентах(Выборка, ПрофитУбытокСигнала);
			//биг_ПодсистемаОповещений.ПубличноеОповещениеОСрабатыванииСтопЛосса(Выборка, ПрофитУбытокВПроцентах);
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИскуственноПроверитьВыполнениеОрдера(Выборка, ТаймСтамп)
	
	// начало - дата создания ордера
	// конец - таймстамп
	// получить данные свечей за период
	
	ПараметрыЗапроса 	= биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам(); 
	ПараметрыЗапроса.Биржа 								= Выборка.Биржа;
	ПараметрыЗапроса.ИнструментИД 						= Выборка.ИнструментИД;      
	
	// TODO: в теории тут может быть любой фрейм, поэтому надо получать точку на минутную свечу, а есл нет на более старший фрейм
	// такая процедура есть.. где то.. 
	ПараметрыЗапроса.Бар								= Справочники.big_BarTypes.H1;
	
	Если ЗначениеЗаполнено(Выборка.Операция.uTime) Тогда
		НачалоПериода = Число(Лев(Формат(Выборка.Операция.uTime, "ЧГ=0"), 10));	
	ИначеЕсли ЗначениеЗаполнено(Выборка.Операция.cTime) Тогда
		НачалоПериода = Число(Лев(Формат(Выборка.Операция.cTime, "ЧГ=0"), 10));
	Иначе
		НачалоПериода = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло(Выборка.Дата);	
	КонецЕсли;
	ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода 		= НачалоПериода + 1;
	ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода   = ТаймСтамп;        
	
	ДанныеСвечей 		= биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочкеСИндикаторами(ПараметрыЗапроса);
	
	Если Выборка.slTriggerPx > 0 Тогда
		
		// проверить есть ли Цена Минимум ниже, чем триггер стоп-лосс
		Для каждого Строка Из ДанныеСвечей Цикл
			
			Если (Выборка.side = Перечисления.big_OKX_OrderSides.sell И Строка.ЦенаМинимум <= Выборка.slTriggerPx) ИЛИ
				(Выборка.side = Перечисления.big_OKX_OrderSides.buy И Строка.ЦенаМаксимум >= Выборка.slTriggerPx) Тогда
				
				Если Выборка.slOrdPx = -1 Тогда
					
					// маркет ордер - считаем, что исполнился
					// установить state = effective
					УстановитьСтатусАлгоОрдера(Выборка.Операция, "effective", Перечисления.big_СтатусыТорговыхОбъектов.Исполнен);
					Бектест_СоздатьОрдер(Выборка, ТаймСтамп);
					Прервать;
				Иначе
					
					// лимитный ордер - проверяем опустилась ли цена ниже
					Если Строка.ЦенаМинимум <= Выборка.slOrdPx Тогда
						
						// установить state = effective
						УстановитьСтатусАлгоОрдера(Выборка.Операция, "effective", Перечисления.big_СтатусыТорговыхОбъектов.Исполнен);
						Бектест_СоздатьОрдер(Выборка, ТаймСтамп);
						Прервать;
					КонецЕсли;					
				КонецЕсли;				
			КонецЕсли;			
		КонецЦикла;	
	КонецЕсли;
	   		
	Если Выборка.tpTriggerPx > 0 Тогда
		
		Сообщить("Тейк профиты не доделаны. ОМ биг_АлгоИмпакт.ИскуственноПроверитьВыполнениеОрдера()");
		
		// проверить есть ли Цена Выше, чем триггер тейк-профит
		Для каждого Строка Из ДанныеСвечей Цикл
			
			Если Строка.ЦенаМаксимум >= Выборка.tpTriggerPx Тогда
				
				Если Выборка.tpOrdPx = -1 Тогда
					
					// маркет ордер - считаем, что исполнился
					// установить state = effective
					УстановитьСтатусАлгоОрдера(Выборка.Операция, "effective", Перечисления.big_СтатусыТорговыхОбъектов.Исполнен);
					Бектест_СоздатьОрдер(Выборка, ТаймСтамп);
					Прервать;
				Иначе
					
					// лимитный ордер - проверяем опустилась ли цена ниже
					Если Строка.ЦенаМинимум >= Выборка.tpOrdPx Тогда
						
						// установить state = effective
						УстановитьСтатусАлгоОрдера(Выборка.Операция, "effective", Перечисления.big_СтатусыТорговыхОбъектов.Исполнен);
						Бектест_СоздатьОрдер(Выборка, ТаймСтамп);
						Прервать;
					КонецЕсли;					
				КонецЕсли;				
			КонецЕсли;			
		КонецЦикла;		
	КонецЕсли; 
	
КонецПроцедуры

Процедура УстановитьСтатусАлгоОрдера(Операция, СтатусОКХ, СтатусВнутренний)
	
	ДокОбъект = Операция.ПолучитьОбъект();
	ДокОбъект.state 	= СтатусОКХ;
	ДокОбъект.Статус 	= СтатусВнутренний;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры 

Процедура Бектест_СоздатьОрдер(Выборка, ТаймСтамп)

	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_СоздатьОрдер();
	СтруктураОперации.Биржа 				= Выборка.Биржа;
	СтруктураОперации.Аккаунт 				= Выборка.Аккаунт;
	СтруктураОперации.Стратегия				= ЭтаСтратегия();
	СтруктураОперации.КлючНастроек			= Выборка.НастройкаСтратегии;
	СтруктураОперации.Сигнал				= Выборка.ТочкаНачалаПадения;
	СтруктураОперации.Событие				= Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс;
	СтруктураОперации.ОрдерСторона			= Выборка.side;
	СтруктураОперации.ИнструментТип			= Перечисления.big_OKX_InstrumentType.SWAP; //DI_HARD - стратегия всегда на фьючах или могут быть варинаты ?
	СтруктураОперации.ИнструментИД			= Выборка.ИнструментИД;
	СтруктураОперации.БектестВычислитьPnL	= Истина;
	
	// на текущий момент ТейкПрофиты по стратегии не используются. Но закладываю для универсальности	
	Если Выборка.slOrdPx > 0 ИЛИ Выборка.tpOrdPx > 0 Тогда
		СтруктураОперации.ОрдерТип		= Перечисления.big_OKX_OrderTypes.limit;
		СтруктураОперации.ЦенаОрдера	= ?(ЗначениеЗаполнено(Выборка.slOrdPx), Выборка.slOrdPx, Выборка.tpOrdPx);
	Иначе
		// ОТЛАДКА 
		// Тут должен быть маркет-ордер, но с определением цены пока не придумал.. поэтому делаем лимитный
		//СтруктураОперации.ОрдерТип	= Перечисления.big_OKX_OrderTypes.market;
		СтруктураОперации.ОрдерТип		= Перечисления.big_OKX_OrderTypes.limit;		
		СтруктураОперации.ЦенаОрдера 	= Выборка.slTriggerPx;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.tpOrdPx) Тогда
		СтруктураОперации.РазмерОрдера  = Выборка.sz;
	Иначе
		СтруктураОперации.РазмерОрдера	= ОпределитьОбъемПокупокВСигналеПоОрдеру(Выборка.Операция);			
	КонецЕсли;
	
	биг_МаркетАпи.СоздатьОрдер(Неопределено, СтруктураОперации, Истина, ТаймСтамп);
	
КонецПроцедуры

Функция РассчитатьОриентировочнуюСуммуОперацииВВалютеОперации(Сигнал, Запись, ПроцентДепозитаНаВход, ТаймСтамп)
		
	Если Сигнал.Бектест Тогда
		// TODO: обращение к маркет апи по Запись.Участник (аккаунт) и признаком бектест
		// маркетапи перенаправляет в модуль нужной биржи (по аккаунту)
		// там для бектеста смотрим текущий накопелнный результат и вычисляем балланс как Депо + (ПрофитЛосс - Комиссия), если он отрицательный
		ДоступныйБаланс = Запись.СуммаДепозита; //а пока что мы в минус "не уходим". Это завышает прибыли, но пока сойдет
	Иначе
		ДоступныйБаланс = Запись.ДоступныйБаланс;
	КонецЕсли;
	
	СуммаПоДепозиту		= Окр(Запись.СуммаДепозита / 100 * ПроцентДепозитаНаВход , 2);
	ДолларовДоступно	= Мин(Запись.ДоступныйБаланс, СуммаПоДепозиту);
	
	ЗначениеПлеча		= ПолучитьЗначениеПараметраСтратегии("ДИ_2_Плечо", Сигнал.КлючНастроек);
	ЗначениеПлеча		= ?(ЗначениеЗаполнено(ЗначениеПлеча), ЗначениеПлеча, 1);
	ДолларовНаОперацию	= ДолларовДоступно * ЗначениеПлеча;
	
	// нельзя брать количество "в притык", иначе ордер не сработает, если за время его создания цена увеличиться
	// поэтому искуственно "завысим" цену в расчетах, что бы был запас 
	Если Сигнал.Бектест Тогда
		ТекущаяЦена		= ПолучитьЦенуПоИсторическимДанным(Сигнал, Запись, ТаймСтамп);		
	Иначе
		ТекущаяЦена		= ПолучитьТекущуюЦену(Сигнал, Запись);	
	КонецЕсли;
	
	ЦенаРасчета			= ТекущаяЦена;	
	РазмерОрдера		= Окр(ДолларовНаОперацию / ЦенаРасчета, 8);
	
	Возврат РазмерОрдера;
	
КонецФункции

Функция ПолучитьТекущуюЦену(Сигнал, Запись)
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ПолучитьЦену();
	СтруктураОперации.Биржа			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Участник, "Владелец");
	СтруктураОперации.ИнструментТип	= Перечисления.big_OKX_InstrumentType.SWAP; //DI_HARD - пока так. по хорошему нужно это в сигнале фиксировать
	СтруктураОперации.ИнструментИД	= Сигнал.ИнструментИД;
	
	Цена = биг_МаркетАпи.ПолучитьЦенуТикета(СтруктураОперации);
	Возврат Цена;
		
КонецФункции                             

Процедура ПроверитьВходныеПараметры(ТаймСтамп, НастройкаСтратегии)

	Если НастройкаСтратегии = Неопределено Тогда
		Стратегия 			= ЭтаСтратегия();
		НастройкаСтратегии 	= Стратегия.ОсновнаяНастройка;
	КонецЕсли;
	
	Если ТаймСтамп = Неопределено Тогда
		ТаймСтамп = биг_ОбщегоНазначенияКлиентСервер.ДатуВTimestampЧисло();	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуНастроек(НастройкаСтратегии)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ЗначенияКонтрольныхУровней.КонтрольныйУровень КАК Параметр,
	|	биг_ЗначенияКонтрольныхУровней.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.биг_ЗначенияКонтрольныхУровней КАК биг_ЗначенияКонтрольныхУровней
	|ГДЕ
	|	биг_ЗначенияКонтрольныхУровней.НастройкаСтратегии = &НастройкаСтратегии";
	Запрос.УстановитьПараметр("НастройкаСтратегии", НастройкаСтратегии);
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаНастроек;
		
КонецФункции

Функция ПолучитьЗначениеПараметраСтратегии(ИмяПараметра, КлючНастроек)

	Возврат РегистрыСведений.биг_ЗначенияКонтрольныхУровней.ЗначениеУровняПоИмени(ИмяПараметра, КлючНастроек);
	
КонецФункции

Функция ОпределитьОбъемПокупокВСигналеПоОрдеру(Операция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(биг_ДаблИмпактОперации.Операция.fillSz) КАК fillSz
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И биг_ДаблИмпактОперации.Операция.side = &Сторона
	|	И (ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_Order_OKX)) <> ЗНАЧЕНИЕ(Документ.big_Order_OKX.ПустаяСсылка)
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии
	|	И биг_ДаблИмпактОперации.Операция.Событие В(&СобытиЯПокупки)";
	
	СтрокаРеквизитов 	= "instId, ТочкаНачалаПадения, Аккаунт, НастройкаСтратегии";
	ЗначенияРеквизитов 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, СтрокаРеквизитов);
	
	Запрос.УстановитьПараметр("Биржа", 				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитов.Аккаунт, "Владелец"));
	Запрос.УстановитьПараметр("ИнструментИД", 		ЗначенияРеквизитов.instId);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ЗначенияРеквизитов.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("Аккаунт", 			ЗначенияРеквизитов.Аккаунт);
	
	Если Операция.side = Перечисления.big_OKX_OrderSides.buy Тогда
		Запрос.УстановитьПараметр("Сторона", 		Перечисления.big_OKX_OrderSides.sell);
	Иначе
		Запрос.УстановитьПараметр("Сторона", 		Перечисления.big_OKX_OrderSides.buy);
	КонецЕсли;
	Запрос.УстановитьПараметр("НастройкаСтратегии", ЗначенияРеквизитов.НастройкаСтратегии);
	
	СобытияПокупки = Новый Массив;
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаОдин);
	СобытияПокупки.Добавить(Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва);	
	Запрос.УстановитьПараметр("СобытиЯПокупки", 	СобытияПокупки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.fillSz;
	КонецЕсли;
	
КонецФункции

Функция НайтиПрофитУбытокСигнала(ВыборкаПоОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(биг_ДаблИмпактОперации.Операция.pnl) КАК ПрофитУбыток,
	|	биг_ДаблИмпактОперации.Операция.fillSz КАК ОперацияfillSz
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И биг_ДаблИмпактОперации.Аккаунт = &Аккаунт
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии
	|	И биг_ДаблИмпактОперации.Событие = &Событие
	|
	|СГРУППИРОВАТЬ ПО
	|	биг_ДаблИмпактОперации.Операция.fillSz";
	
	Запрос.УстановитьПараметр("Аккаунт", 			ВыборкаПоОперации.Аккаунт);
	Запрос.УстановитьПараметр("Биржа", 				ВыборкаПоОперации.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 		ВыборкаПоОперации.ИнструментИД);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", ВыборкаПоОперации.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("НастройкаСтратегии", ВыборкаПоОперации.НастройкаСтратегии);	
	Запрос.УстановитьПараметр("Событие", 			Перечисления.биг_ДаблИмпактEvents.ВыполнениеСтопЛосс);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ПрофитУбыток;
		
КонецФункции

Функция ПолучитьКоличествоСигналовИнструмента(ПараметрыИнструмента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(биг_ДаблИмпактСигналы.ТочкаНачалаПадения, 0)) КАК КоличествоСигналов
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактСигналы КАК биг_ДаблИмпактСигналы
	|ГДЕ
	|	биг_ДаблИмпактСигналы.Биржа = &Биржа
	|	И биг_ДаблИмпактСигналы.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактСигналы.Бар = &Бар
	|	И биг_ДаблИмпактСигналы.КлючНастроек = &КлючНастроек";
	
	Запрос.УстановитьПараметр("Биржа", 			ПараметрыИнструмента.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 	ПараметрыИнструмента.ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 			ПараметрыИнструмента.Бар);
	Запрос.УстановитьПараметр("КлючНастроек", 	ПараметрыИнструмента.КлючНастроек);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КоличествоСигналов;
		
КонецФункции

Функция ВычислитьФинРезВПроцентах(Выборка, ФинРез)
	
	Если Выборка.fillSz = 0 Тогда
		Возврат 0;
	Иначе
		ФинРезВПроцентах = Окр(ФинРез / Выборка.fillSz * 100, 2);
		Возврат ФинРезВПроцентах;
	КонецЕсли;   
	
КонецФункции

Функция ПроверитьНаличиеАктуальнойСвечи(ДанныеСвечей, СортировкаПоУбыванию, Бар, ТаймСтамп)
	
	КоличествоСвечей = ДанныеСвечей.Количество(); 
	Если КоличествоСвечей > 0 Тогда
		
		Свеча = ?(СортировкаПоУбыванию, ДанныеСвечей[0], ДанныеСвечей[КоличествоСвечей-1]); 
		ЦелеваяДатаТС = биг_ОбщегоНазначения.НачалоПериодаПоБару(ТаймСтамп, Бар) - Бар.SecondsAmount;
		
		Если Свеча.TimeStamp < ЦелеваяДатаТС Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли; 
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция Модуль(Число)

	Возврат ?(Число > 0, Число, -Число);
	
КонецФункции

