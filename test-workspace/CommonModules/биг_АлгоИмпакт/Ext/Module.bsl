#КонецОбласти //СлужебныйИнтерфейс


#Область Бектест

Процедура ПровестиБекТестирование(ПараметрыИнструмента, АдресРезультата = Неопределено) Экспорт
		
	Если НЕ ПараметрыИнструмента.Свойство("ФиксироватьДлительность") Тогда
		ПараметрыИнструмента.Вставить("ПараметрыИнструмента", Ложь);	
	КонецЕсли;
	
	Если ПараметрыИнструмента.ФиксироватьДлительность Тогда
		ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();	
	КонецЕсли;	
	
	ТочкаОтсчетаТС 		= ПараметрыИнструмента.ТочкаОтсчетаТС;
	КоличествоИтераций 	= ПараметрыИнструмента.КоличествоИтераций;
	
	// откатываем состояние инструмента
	
	ЗаписатьТочкуНаЛинииВремени(ПараметрыИнструмента.Биржа, ПараметрыИнструмента.ИнструментИД, ПараметрыИнструмента.Бар, ПараметрыИнструмента.КлючНастроек, ТочкаОтсчетаТС);
	УдалитьСигналыПослеТочки(ПараметрыИнструмента, ТочкаОтсчетаТС);	
	СтеретьЗафиксированныеОперации(ПараметрыИнструмента, ТочкаОтсчетаТС);
	
	ШагПрогресса 		= Цел(КоличествоИтераций / 100);
	СчетчикПрогресса 	= 0;
	Прогресс			= 0;
	
	Для Сч = 1 По КоличествоИтераций Цикл
		
		//ПроверитьОперацииПоАктивнымСигналам(ТочкаОтсчетаТС, Истина, ПараметрыИнструмента.КлючНастроек, ПараметрыИнструмента.ИнструментИД, ПараметрыИнструмента.Биржа);
		ОбработатьИнструмент(ПараметрыИнструмента, ТочкаОтсчетаТС, Истина);
		
		ТочкаОтсчетаТС 	= ТочкаОтсчетаТС + ПараметрыИнструмента.Бар.SecondsAmount;		
		СчетчикПрогресса = СчетчикПрогресса + 1;
		Если СчетчикПрогресса = ШагПрогресса Тогда
			Прогресс 			= Прогресс + 1;
			СчетчикПрогресса 	= 0;
			
			ДлительныеОперации.СообщитьПрогресс(Прогресс);
		КонецЕсли;
	КонецЦикла;                                                                                                                
		
	Если ПараметрыИнструмента.ФиксироватьДлительность Тогда 		
		КоличествоСигналов = ПолучитьКоличествоСигналовИнструмента(ПараметрыИнструмента);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(ПараметрыИнструмента.НаименованиеЗадания, ВремяНачала, КоличествоСигналов);					
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	
	ЗаписьРезультата = РегистрыСведений.биг_РезультатыБектестов.СоздатьМенеджерЗаписи();
	ЗаписьРезультата.Биржа			= ПараметрыИнструмента.Биржа;
	ЗаписьРезультата.ИнструментИД	= ПараметрыИнструмента.ИнструментИД;
	ЗаписьРезультата.Бар			= ПараметрыИнструмента.Бар;
	ЗаписьРезультата.КлючНастроек	= ПараметрыИнструмента.КлючНастроек; 
	ЗаписьРезультата.Выполнен		= Истина;
	ЗаписьРезультата.Записать(Истина);
	
КонецПроцедуры

Процедура УдалитьСигналыПослеТочки(ПараметрыИнструмента, ТочкаВозвратаТС)
	
	Набор	= РегистрыСведений.биг_ДаблИмпактСигналы.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(ПараметрыИнструмента.Биржа);
	Набор.Отбор.ИнструментИД.Установить(ПараметрыИнструмента.ИнструментИД);
	Набор.Отбор.Бар.Установить(ПараметрыИнструмента.Бар);
	Набор.Отбор.КлючНастроек.Установить(ПараметрыИнструмента.КлючНастроек);
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив;
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			МассивУдалить.Добавить(Строка);	
		КонецЕсли;
	КонецЦикла;                            
	
	Для каждого Строка Из МассивУдалить Цикл
		Набор.Удалить(Строка);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры

Процедура СтеретьЗафиксированныеОперации(ПараметрыИнструмента, ТочкаВозвратаТС)
	
	Набор = РегистрыСведений.биг_ДаблИмпактОперации.СоздатьНаборЗаписей();
	Набор.Отбор.Биржа.Установить(ПараметрыИнструмента.Биржа);
	Набор.Отбор.ИнструментИД.Установить(ПараметрыИнструмента.ИнструментИД);
	Набор.Отбор.НастройкаСтратегии.Установить(ПараметрыИнструмента.КлючНастроек);
	
	Набор.Прочитать();
	
	МассивУдалить = Новый Массив();
	
	Для каждого Строка Из Набор Цикл
		Если Строка.ТочкаНачалаПадения > ТочкаВозвратаТС Тогда
			
			Операция = Строка.Операция;
			КлючНастройкиОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "НастройкаСтратегии");
			
			Если КлючНастройкиОперации = ПараметрыИнструмента.КлючНастроек Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;				
		КонецЕсли;	
	КонецЦикла;                      
	
	Для каждого СтрокаНабора Из МассивУдалить Цикл
		ДокументОбъект = СтрокаНабора.Операция.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		
		УдалитьИсториюЗначенийДокумента(СтрокаНабора.Операция, ТочкаВозвратаТС);
		
		ДокументОбъект.Удалить();
		
		Набор.Удалить(СтрокаНабора);
	КонецЦикла;
	
	Набор.Записать(Истина);
	
КонецПроцедуры 

Процедура УдалитьИсториюЗначенийДокумента(Операция, ТочкаВозвратаТС)
	
	ТочкаПроверки = биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаВозвратаТС);
	Если ТипЗнч(Операция) = Тип("ДокументСсылка.big_AlgoOrders_OKX") Тогда
		
		Набор = РегистрыСведений.биг_ОКХ_ИсторияАлгоОрдеров.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(Операция);
		Набор.Прочитать();
		
		МассивУдалить = Новый Массив;
		
		Для каждого Строка Из Набор Цикл
			Если Строка.Период > ТочкаПроверки Тогда
				МассивУдалить.Добавить(Строка);	
			КонецЕсли;
		КонецЦикла;                            
		
		Для каждого Строка Из МассивУдалить Цикл
			Набор.Удалить(Строка);
		КонецЦикла;
		
		Набор.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти //Бектест 


#Область АнализСигнала


#Область КлючевыеШаги

Процедура ВыполнениеСигнала(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);
		
	Если Сигнал.ТекущееСобытие = Неопределено Тогда		
		ВыявитьЭкстремум(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);		
	Иначе		
		ПровестиАнализПозиции(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);		
	КонецЕсли;
	  
	Если Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеРазворотаТренда Тогда		
		ОпределитьРазворот(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);		 
	КонецЕсли;	
	 
	Если Сигнал.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеУвеличенияПозиции Тогда		
		ОпределитьПереходОбласти(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен);		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыявитьЭкстремум(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен) 
		
	ТекСвеча = ПолучитьПоследнююСвечуСИндикаторами(Сигнал, КлючНастроек, ТаймСтамп);
	Если ТекСвеча = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСвеча.Чайкин_МА = 0 Тогда
		// если медиана нулевая, то лучше пропустить свечу	
		Возврат;
	КонецЕсли;  
	
	ВыявленЭкстремум = Ложь;
	
	Если ТекСвеча.Чайкин > 0 Тогда
		ВыявленЭкстремум = ТекСвеча.Чайкин > ТекСвеча.Чайкин_ТВМакс;
	Иначе
		ВыявленЭкстремум = ТекСвеча.Чайкин < ТекСвеча.Чайкин_ТВМин;
	КонецЕсли;
	    
	Если ВыявленЭкстремум Тогда
		Сигнал.Тренд = ?(ТекСвеча.Чайкин > 0, Перечисления.биг_ВидыТрендов.Нисходящий, Перечисления.биг_ВидыТрендов.Восходящий); //фиксируем не текущий тренд, а ожидаемый
		ЗафиксироватьТочкуЭкстремума(Сигнал, ТаймСтамп, КлючНастроек);		
	КонецЕсли;
			
	ШагВыполнен = Истина;	
	
КонецПроцедуры

Процедура ПровестиАнализПозиции(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен)
	
	Если ЗначениеЗаполнено(Сигнал.ТочкаВхода1) Тогда
		
		// Позиция есть, Рассчитать уровень стоп-лосс по текущим данным	
		ТекСвеча = ПолучитьПоследнююСвечуСИндикаторами(Сигнал, КлючНастроек, ТаймСтамп);
		Если ТекСвеча = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОбновитьУровеньСтопЛосс(Сигнал, КлючНастроек, ТаймСтамп, ТекСвеча, ШагВыполнен);		
	КонецЕсли;

КонецПроцедуры

Процедура ОпределитьРазворот(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен)
	
	ТекСвеча = ПолучитьПоследнююСвечуСИндикаторами(Сигнал, КлючНастроек, ТаймСтамп);
	Если ТекСвеча = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПорогRSIВерх 	= 55;
	ПорогRSIНиз		= 45;
	
	Если Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий Тогда
		
		//ТекСвеча.ЦенаЗакрытия < ТекСвеча.Цена_МА_Короткий
		Если ТекСвеча.Чайкин < ТекСвеча.Чайкин_СМА И ТекСвеча.РСИ >= ПорогRSIВерх Тогда
			
			// Есть условия, где мы ждем разворот
			ЗафиксироватьТочкуВходаОдин(Сигнал, ТаймСтамп, ТекСвеча, ШагВыполнен);
			
		ИначеЕсли ТекСвеча.Чайкин < ТекСвеча.Чайкин_СМА И ТекСвеча.РСИ < ПорогRSIВерх Тогда
			
			// Есть условия, где пора прервать сигнал
			ПричинаОтказа = "Ожидаемый тренд = " + Сигнал.Тренд + ". Чайкин развернулся, но ";
			ПричинаОтказа = ПричинаОтказа + ?(ТекСвеча.РСИ < ПорогRSIВерх, "значение RSI < " + ПорогRSIВерх + ". RSI = " + ТекСвеча.РСИ + " ", "");
			
			ПрерватьОбработкуТекущегоСигнала(Сигнал, ПричинаОтказа, ТаймСтамп);
		КонецЕсли;
		
	ИначеЕсли Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Восходящий Тогда
		
		//ТекСвеча.ЦенаЗакрытия > ТекСвеча.Цена_МА_Короткий
		Если ТекСвеча.Чайкин > ТекСвеча.Чайкин_СМА И ТекСвеча.РСИ <= ПорогRSIНиз Тогда
			
			// Есть условия, где мы ждем разворот
			ЗафиксироватьТочкуВходаОдин(Сигнал, ТаймСтамп, ТекСвеча, ШагВыполнен);	
			
		ИначеЕсли ТекСвеча.Чайкин > ТекСвеча.Чайкин_СМА И ТекСвеча.РСИ > ПорогRSIНиз Тогда
			
			// Есть условия, где пора прервать сигнал
			ПричинаОтказа = "Ожидаемый тренд = " + Сигнал.Тренд + ". Чайкин развернулся, но ";
			ПричинаОтказа = ПричинаОтказа + ?(ТекСвеча.РСИ > ПорогRSIНиз, "значение RSI > " + ПорогRSIНиз + ". RSI = " + ТекСвеча.РСИ + " ", "");
			
			ПрерватьОбработкуТекущегоСигнала(Сигнал, ПричинаОтказа, ТаймСтамп);
		КонецЕсли;
	КонецЕсли;          
		
	ШагВыполнен = Истина;

КонецПроцедуры

Процедура ОпределитьПереходОбласти(Сигнал, КлючНастроек, ТаймСтамп, ШагВыполнен)

	ТекСвеча = ПолучитьПоследнююСвечуСИндикаторами(Сигнал, КлючНастроек, ТаймСтамп);
	Если ТекСвеча = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Восходящий И ТекСвеча.Чайкин > 0 Тогда
		
		УвеличитьПозицию(Сигнал, ТекСвеча, ТаймСтамп, КлючНастроек, ШагВыполнен);
		Если ШагВыполнен Тогда
			ПерейтиКМониторингуПозиции(Сигнал, КлючНастроек, ТаймСтамп);	
		КонецЕсли;		
	ИначеЕсли Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий И ТекСвеча.Чайкин < 0 Тогда
		
		УвеличитьПозицию(Сигнал, ТекСвеча, ТаймСтамп, КлючНастроек, ШагВыполнен);
		Если ШагВыполнен Тогда
			ПерейтиКМониторингуПозиции(Сигнал, КлючНастроек, ТаймСтамп);	
		КонецЕсли;		
	КонецЕсли;
	
	ШагВыполнен = Истина;
	
КонецПроцедуры

#КонецОбласти //КлючевыеШаги


#Область РаботаССигналом

Процедура ЗафиксироватьТочкуЭкстремума(Сигнал, ТочкаНачалаПадения, КлючНастроек)

	Запись = РегистрыСведений.биг_ДаблИмпактСигналы.СоздатьМенеджерЗаписи();
	Запись.Биржа 					= Сигнал.Биржа;
	Запись.ИнструментИД				= Сигнал.ИнструментИД;
	Запись.Бар						= Сигнал.Бар;
	Запись.КлючНастроек				= КлючНастроек;
	Запись.ТочкаНачалаПадения 		= ТочкаНачалаПадения;
	Запись.ТочкаНачалаПаденияДатой	= биг_ОбщегоНазначенияКлиентСервер.TimestampВДату(ТочкаНачалаПадения);
	Запись.ТекущееСобытие			= Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеРазворотаТренда; 
	Запись.ТочкаНачалаСобытия		= ТочкаНачалаПадения;
	Запись.Тренд					= Сигнал.Тренд;
	Запись.Записать(Истина);
	
	биг_ПодсистемаОповещений.ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись);
		
КонецПроцедуры

Процедура ЗафиксироватьТочкуВходаОдин(Сигнал, Таймстамп, ТекСвеча, ШагВыполнен)
	
	// проверка есть ли открытые ордера (позиции?) у текущего инструмента
	//		если есть - то прервать текущий сигнал
	//		если нет - фиксируем точку входа, размещаем ордера
	Если ТекущийИнструментИмеетОткрытыеОрдера(Сигнал) Тогда
		
		ПричинаОтмены = "По данному инструменту уже есть открытая позиция";
		ПрерватьОбработкуТекущегоСигнала(Сигнал, ПричинаОтмены, Таймстамп);		
	Иначе
		
		РазместитьОрдераДляТочкиВходаОдин(Сигнал, ТекСвеча, Таймстамп, ШагВыполнен);
		
		Если ШагВыполнен Тогда		
			Запись = ПолучитьЗаписьСобытийСигнала(Сигнал);
			Запись.ТочкаВхода1			= Таймстамп;
			Запись.ТекущееСобытие		= Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеУвеличенияПозиции; 
			Запись.ТочкаНачалаСобытия	= Таймстамп + 1;
			Запись.Записать(Истина);
			
			биг_ПодсистемаОповещений.ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись);
			биг_ПодсистемаОповещений.ПубличноеОповещениеПоЗаписиСигнала(Сигнал, Запись);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПерейтиКМониторингуПозиции(Сигнал, КлючНастроек, ТаймСтамп)
	
	Запись = ПолучитьЗаписьСобытийСигнала(Сигнал);
	Запись.ТекущееСобытие		= Перечисления.биг_ДаблИмпактEvents.АИ_МониторингПозиции; 
	Запись.ТочкаНачалаСобытия	= Таймстамп + 1;
	Запись.Записать(Истина);	
	
	биг_ПодсистемаОповещений.ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись);
	биг_ПодсистемаОповещений.ПубличноеОповещениеПоЗаписиСигнала(Сигнал, Запись);
КонецПроцедуры

Процедура ПрерватьОбработкуТекущегоСигнала(Сигнал, ПричинаОтмены, ТочкаОтмены)
		
	Запись = ПолучитьЗаписьСобытийСигнала(Сигнал);
	 
	Запись.ТочкаСигналЗавершен	= ТочкаОтмены;
	Запись.СигналЗавершен 		= Истина;
	Запись.ПричинаОтмены		= ПричинаОтмены;
	Запись.Записать(Истина);		
	
	биг_ПодсистемаОповещений.ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись);
	
КонецПроцедуры

