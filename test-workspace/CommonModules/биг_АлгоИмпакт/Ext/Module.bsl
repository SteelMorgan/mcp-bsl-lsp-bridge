Функция ПолучитьНастройкуСтратегии(Биржа, ИнструментИД) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ИнструментыСтратегийСрезПоследних.КлючНастройки КАК КлючНастройки
	|ИЗ
	|	РегистрСведений.биг_ИнструментыСтратегий.СрезПоследних(, ) КАК биг_ИнструментыСтратегийСрезПоследних
	|ГДЕ
	|	биг_ИнструментыСтратегийСрезПоследних.Биржа = &Биржа
	|	И биг_ИнструментыСтратегийСрезПоследних.ИнструментИД = &ИнструментИД
	|	И биг_ИнструментыСтратегийСрезПоследних.Участие";
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", ИнструментИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КлючНастройки;	
	
КонецФункции

