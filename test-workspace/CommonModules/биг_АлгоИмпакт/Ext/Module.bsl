#Область УправлениеОперациями

Процедура РазместитьОрдераДляТочкиВходаОдин(Сигнал, ТекСвеча, ТаймСтамп, ШагВыполнен)
	
	// расчет цен и контрольных уровней 
	ПроцентДепозитаНаВход 	= ПолучитьЗначениеПараметраСтратегии("АИ_2_ВходОдин_ПроцентДепозита", Сигнал.КлючНастроек);
			
	Инструмент				= Справочники.big_Instruments.НайтиПоРеквизиту("instId", Сигнал.ИнструментИД,, Сигнал.Биржа);
	Кратность 				= биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(Инструмент, "lotSz");
	
	// собираем все аккаунты, подключенные к этому инструменту текущей биржи
	ТаблицаУчастников 		= СобратьАккаунтыДляРеакцииНаСигнал(Сигнал);
	
	Для каждого Запись Из ТаблицаУчастников Цикл
		
		ТриггерСтопЛос	= ОпределитьУровеньСтопЛосс(Сигнал, ТекСвеча, Запись, ТаймСтамп);
		Аккаунт 		= Запись.Участник;
		
		// для каждого аккаунта определяем сумму операции		
		РазмерОрдера	= РассчитатьОриентировочнуюСуммуОперацииВВалютеОперации(Сигнал, Запись, ПроцентДепозитаНаВход, ТаймСтамп);				 
		РазмерОрдера	= биг_ОКХ_Сервер.ПересчитатьВКонтракты(РазмерОрдера, Инструмент);		
		РазмерОрдера 	= биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(РазмерОрдера, Кратность);
		
		Если ШагВыполнен Тогда
			АктуализироватьНастройкиИнструментаНаАккаунте(Сигнал.ИнструментИД, Аккаунт, Сигнал.КлючНастроек, ШагВыполнен);	
		КонецЕсли;
		
		Если ШагВыполнен Тогда
			ТочкаВхода_РазместитьМаркетОрдер(Сигнал, Аккаунт, РазмерОрдера, Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаОдин, ТриггерСтопЛос, ТаймСтамп, ШагВыполнен);	
		КонецЕсли;			
	КонецЦикла;
	
КонецПроцедуры

Процедура УвеличитьПозицию(Сигнал, ТекСвеча, ТаймСтамп, КлючНастроек, ШагВыполнен)

	// расчет цен и контрольных уровней 
	ПроцентДепозитаНаВход 	= ПолучитьЗначениеПараметраСтратегии("АИ_3_ВходаДва_ПроцентДепозита", КлючНастроек);
	
	Инструмент				= Справочники.big_Instruments.НайтиПоРеквизиту("instId", Сигнал.ИнструментИД,, Сигнал.Биржа);
	Кратность 				= биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(Инструмент, "lotSz");
	
	// собираем все аккаунты, подключенные к этому инструменту текущей биржи
	ТаблицаУчастников = СобратьАккаунтыДляРеакцииНаСигнал(Сигнал);
	
	Для каждого Запись Из ТаблицаУчастников Цикл
		
		Аккаунт 		= Запись.Участник;
		ТриггерСтопЛос	= ОпределитьУровеньСтопЛосс(Сигнал, ТекСвеча, Запись, ТаймСтамп);
			
		// для каждого аккаунта определяем сумму операции
		РазмерОрдера	= РассчитатьОриентировочнуюСуммуОперацииВВалютеОперации(Сигнал, Запись, ПроцентДепозитаНаВход, ТаймСтамп);		
		РазмерОрдера	= биг_ОКХ_Сервер.ПересчитатьВКонтракты(РазмерОрдера, Инструмент);		
		РазмерОрдера 	= биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(РазмерОрдера, Кратность);
		
		АктуализироватьНастройкиИнструментаНаАккаунте(Сигнал.ИнструментИД, Запись.Участник, КлючНастроек, ШагВыполнен);
		ТочкаВхода_РазместитьМаркетОрдер(Сигнал, Аккаунт, РазмерОрдера, Перечисления.биг_ДаблИмпактEvents.ПоискТочкиВходаДва, ТриггерСтопЛос, ТаймСтамп, ШагВыполнен);
	КонецЦикла;                                                                                                          		
	
КонецПроцедуры

Процедура ТочкаВхода_РазместитьМаркетОрдер(Сигнал, Аккаунт, РазмерОрдера, Событие, ТриггерСтопЛос = Неопределено, ТаймСтамп, ШагВыполнен) 

	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_СоздатьОрдер();
	СтруктураОперации.Биржа 			= Сигнал.Биржа;
	СтруктураОперации.Аккаунт 			= Аккаунт;
	СтруктураОперации.Стратегия			= ЭтаСтратегия();
	СтруктураОперации.КлючНастроек		= Сигнал.КлючНастроек;
	СтруктураОперации.Событие			= Событие;
	СтруктураОперации.ИнструментИД		= Сигнал.ИнструментИД;
	СтруктураОперации.РазмерОрдера  	= РазмерОрдера; 
	СтруктураОперации.Сигнал			= Сигнал.ТочкаНачалаПадения;
	
	Если Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Восходящий Тогда
		СтруктураОперации.ОрдерСторона 	= Перечисления.big_OKX_OrderSides.buy;
		
	ИначеЕсли Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий Тогда
		СтруктураОперации.ОрдерСторона 	= Перечисления.big_OKX_OrderSides.sell;	
	КонецЕсли;
	
	СтруктураОперации.ОрдерТип			= Перечисления.big_OKX_OrderTypes.market;	
	СтруктураОперации.ИнструментТип		= Перечисления.big_OKX_InstrumentType.SWAP;
	
	Если ТриггерСтопЛос <> Неопределено Тогда
		
		УровеньСтопЛосс		= -1; // ордер будет продан по текущей рыночной цене "market"		
		СтруктураАлгоОрдера = биг_МаркетАпиКлиентСервер.СтруктураОперации_СоздатьАлгоОрдер();
		
		ЗаполнитьЗначенияСвойств(СтруктураАлгоОрдера, СтруктураОперации); //биржа, аккаунт, стратегия, событие, ИнструментИД
		СтруктураАлгоОрдера.ТриггерСтопЛос 	= ТриггерСтопЛос;
		СтруктураАлгоОрдера.ЦенаСтопЛос 	= УровеньСтопЛосс;
		
		Если Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Нисходящий Тогда
			// ШОРТ
			СтруктураАлгоОрдера.НаправлениеДействия = Перечисления.big_OKX_OrderSides.buy;
			СтруктураАлгоОрдера.СторонаПозиции		= Перечисления.big_OKX_PositionSides.long;
		ИначеЕсли Сигнал.Тренд = Перечисления.биг_ВидыТрендов.Восходящий Тогда
			// ЛОНГ
			СтруктураАлгоОрдера.НаправлениеДействия = Перечисления.big_OKX_OrderSides.sell;
			СтруктураАлгоОрдера.СторонаПозиции		= Перечисления.big_OKX_PositionSides.short;
		КонецЕсли;
		
		СтруктураОперации.МассивСвязанныхАлгоОрдеров.Добавить(СтруктураАлгоОрдера);
	КонецЕсли;                                                                                                                                                                                                                                                                                         
	
	Попытка
		ШагВыполнен = биг_МаркетАпи.СоздатьОрдер(Неопределено, СтруктураОперации, Сигнал.Бектест, ТаймСтамп);	
	Исключение
	    ШагВыполнен = Ложь;
	КонецПопытки;
		
	Если НЕ ШагВыполнен Тогда                                                        
		ТекстСообщения = "!!! При размещении ордера произошла ошибка (см. логи интеграции). Время: " + ТекущаяДатаСеанса();
		биг_ПодсистемаОповещений.ВнутреннееОповещение_Произвольное(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьУровеньСтопЛосс(Сигнал, КлючНастроек, ТаймСтамп, ТекСвеча, ШагВыполнен)
	
	ТаблицаУчастников = СобратьАккаунтыДляРеакцииНаСигнал(Сигнал);
	
	Для каждого Запись Из ТаблицаУчастников Цикл
		
		ТриггерСтопЛос		= ОпределитьУровеньСтопЛосс(Сигнал, ТекСвеча, Запись, ТаймСтамп);
		Аккаунт 			= Запись.Участник;
		МассивАлгоОрдеров	= НайтиСтопЛос(Сигнал, Аккаунт);
		
		Для каждого Алгоордер Из МассивАлгоОрдеров Цикл
			Если АлгоОрдер.slTriggerPx <> ТриггерСтопЛос Тогда
				ИзменитьСтопЛосс(Аккаунт, АлгоОрдер, ТриггерСтопЛос, Сигнал, ТаймСтамп, ШагВыполнен);	
			КонецЕсли;			
		КонецЦикла;		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьСтопЛосс(Аккаунт, АлгоОрдер, НовыйТриггер, Сигнал, ТаймСтамп, ШагВыполнен)
		
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ИзменитьАлгоОрдер();                
	СтруктураОперации.Аккаунт 				= Аккаунт;
	СтруктураОперации.ИнструментИД          = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АлгоОрдер, "instId");
	СтруктураОперации.КлиентАлгоОрдерИД 	= биг_ОКХ_КлиентСервер.КлиентскийИдентификатор(АлгоОрдер);
	СтруктураОперации.НовыйТриггерСтопЛос	= НовыйТриггер;
	СтруктураОперации.НовыйЦенаСтопЛос		= -1;
	
	Попытка
		ШагВыполнен = биг_МаркетАпи.ИзменитьАлгоОрдер(СтруктураОперации, Сигнал.Бектест, ТаймСтамп);	
	Исключение
	    ШагВыполнен = Ложь;
	КонецПопытки;
	
	Если ШагВыполнен Тогда
		биг_ПодсистемаОповещений.ВнутреннееОповещениеИзменениеУровняСтопЛосс(Сигнал, СтруктураОперации);
		биг_ПодсистемаОповещений.ПубличноеОповещениеИзменениеУровняСтопЛосс(Сигнал, СтруктураОперации);
	Иначе
		ТекстСообщения = "!!! При размещении ордера произошла ошибка (см. логи интеграции). Время: " + ТекущаяДатаСеанса();
		биг_ПодсистемаОповещений.ВнутреннееОповещение_Произвольное(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВыборкуИнструментовСтратегии(Участие = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ИнструментыСтратегийСрезПоследних.Биржа КАК Биржа,
	|	биг_ИнструментыСтратегийСрезПоследних.ИнструментИД КАК ИнструментИД,
	|	биг_ИнструментыСтратегийСрезПоследних.Бар КАК Бар,
	|	биг_ИнструментыСтратегийСрезПоследних.КлючНастройки КАК КлючНастроек
	|ИЗ
	|	РегистрСведений.биг_ИнструментыСтратегий.СрезПоследних(, Стратегия = &Стратегия) КАК биг_ИнструментыСтратегийСрезПоследних
	|ГДЕ
	|	(биг_ИнструментыСтратегийСрезПоследних.Участие = &Участие
	|			ИЛИ &НеИспользоватьФильтр)";
	
	Запрос.УстановитьПараметр("Участие", 				Участие);
	Запрос.УстановитьПараметр("Стратегия", 				ЭтаСтратегия());
	Запрос.УстановитьПараметр("НеИспользоватьФильтр", 	НЕ Участие);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
		
КонецФункции

