	КонецЕсли;
	        
КонецПроцедуры   

Функция СформироватьПубличноеСообщениеПоЗаписиСигнала(Запись)
	
	Шаблон = "Сигнал #K_%1_%2 
			|Стратегия: #%3, Бар = %4
			|
			|%5";
	
	СтопЛосс = НайтиСтопЛос(Запись);
	Если Запись.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.АИ_ОжиданиеУвеличенияПозиции Тогда
		Информация = "Команда GBIG приняла #решение_войти в позицию. Вход на 20% от депозита, выделенного на работу со стратегией.";
		Информация = Информация + " Обязательно ставим стоп-лосы: Триггер цена = " + СтопЛосс.slTriggerPx + " (в случае срабатывания будет продано по тек. Market Price)";
	ИначеЕсли Запись.ТекущееСобытие = Перечисления.биг_ДаблИмпактEvents.АИ_МониторингПозиции Тогда
		Информация = "Позиция подрастает успешно - команда GBIG #продолжает_вход в позицию. Вход на оставшиеся 80% от депозита, выделенного на работу со стратегией";
	КонецЕсли;
	ТекстСообщения = СтрШаблон(Шаблон, Запись.ТочкаНачалаПадения, Запись.ИнструментИД, Запись.КлючНастроек.Владелец, Запись.Бар,  Информация);
								
	Возврат ТекстСообщения;

КонецФункции

