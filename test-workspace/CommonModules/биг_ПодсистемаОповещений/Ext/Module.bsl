
#Область ОповещенияОСигналах_DI

Процедура ВнутреннееОповещение_Произвольное(ТекстСообщения) Экспорт

	Бот 				= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_Бот_ГБИГ_Уведомления");
	Чат					= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("ТГ_Группа_ДИСигналсТеч");
	
	Справочники.биг_Боты.ОтправитьСообщение(Бот, Чат, ТекстСообщения);
	
КонецПроцедуры


Процедура ВнутреннееОповещениеПоЗаписиСигнала(Сигнал, Запись) Экспорт

	Если НЕ Сигнал.Бектест Тогда
		
		ВыполнятьОповещение = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_СигналыДИ_КаждыйСигнал",, Ложь);
		Если ВыполнятьОповещение Тогда

			Бот 				= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_Бот_ГБИГ_Уведомления");
			Чат					= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("ТГ_Группа_ДИСигналсТеч");
			
			ТекстСообщения 		= СформироватьСообщениеПоЗаписиСигнала(Запись);
			
			Справочники.биг_Боты.ОтправитьСообщение(Бот, Чат, ТекстСообщения);			
		КонецЕсли;	
	КонецЕсли;
	        
КонецПроцедуры

Функция СформироватьСообщениеПоЗаписиСигнала(Запись)
	
	Шаблон = "#K_%1_%2 
			|Точка начала падения, UTC = %3. Бар = %4
			|Стратегия: #%5
			|
			|Тек. состояние = %6
			|Сигнал завершен = %7
			|Результат = %8
			|
			|Ключ = %9";
			
	//ТекстСообщения = СтрШаблон(Шаблон, СтратегияДаблИмпакт());		
	ТекстСообщения = СтрШаблон(Шаблон, Запись.ТочкаНачалаПадения, Запись.ИнструментИД, 
								Запись.ТочкаНачалаПаденияДатой, Запись.Бар,
								Запись.КлючНастроек.Владелец,
								Запись.ТекущееСобытие, 
								?(Запись.СигналЗавершен, "Да", "Нет"), 
								?(Запись.ЗавершеноПоложительно, "Завершен успешно, смотри операции в 1С", Запись.ПричинаОтмены), 
								Запись.КлючНастроек);
								
	Возврат ТекстСообщения;

КонецФункции

Процедура ВнутреннееОповещениеИзменениеУровняСтопЛосс(Сигнал, СтруктураОперации) Экспорт

	Если НЕ Сигнал.Бектест Тогда
		
		ВыполнятьОповещение = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_СигналыДИ_КаждыйСигнал",, Ложь);
		Если ВыполнятьОповещение Тогда

			Бот 				= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_Бот_ГБИГ_Уведомления");
			Чат					= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("ТГ_Группа_ДИСигналсТеч");
			
			ТекстСообщения 		= СформироватьСообщениеОбИзмененииУровняСтопЛосс(Сигнал, СтруктураОперации);
			
			Справочники.биг_Боты.ОтправитьСообщение(Бот, Чат, ТекстСообщения);			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьСообщениеОбИзмененииУровняСтопЛосс(Сигнал, СтруктураОперации)
	
	Шаблон = "#K_%1_%2
			|Стратегия: #%3
			|
			|Создан / изменен стоп-ордер
			|Новый Триггер = %4
			|Новая Цена = %5";
	
	ТекстСообщения = СтрШаблон(Шаблон, Сигнал.ТочкаНачалаПадения, Сигнал.ИнструментИД,
								Сигнал.КлючНастроек.Владелец,
								СтруктураОперации.НовыйТриггерСтопЛос, СтруктураОперации.НовыйЦенаСтопЛос);
								
	Возврат ТекстСообщения;

КонецФункции

Процедура ВнутреннееОповещениеОСрабатыванииСтопЛосса(Выборка, ПрофитУбытокСигнала) Экспорт
	
	// algoId заполнено только у тех ордеров, что были отправлены на биржу. При бектестах ордера создаются, но на биржу не отправляются
	Если ЗначениеЗаполнено(Выборка.algoId) Тогда
		
		ВыполнятьОповещение = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_СигналыДИ_КаждыйСигнал",, Ложь);
		Если ВыполнятьОповещение Тогда

			Бот 				= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_Бот_ГБИГ_Уведомления");
			Чат					= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("ТГ_Группа_ДИСигналсТеч");
			
			ТекстСообщения 		= СформироватьСообщениеОСрабатыванииАлгоОрдера(Выборка, ПрофитУбытокСигнала);
			
			Справочники.биг_Боты.ОтправитьСообщение(Бот, Чат, ТекстСообщения);			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьСообщениеОСрабатыванииАлгоОрдера(Выборка, ПрофитУбытокСигнала)
	
	Шаблон = "#K_%1_%2			
			|Стратегия: #%3 
			|
			|Сработал стоп-лосс!
			|
			|Фин.результат сигнала = %4";
	
	ТекстСообщения = СтрШаблон(Шаблон, Выборка.ТочкаНачалаПадения, Выборка.ИнструментИД, Выборка.КлючНастроек.Владелец, ПрофитУбытокСигнала);								
	Возврат ТекстСообщения;

КонецФункции



