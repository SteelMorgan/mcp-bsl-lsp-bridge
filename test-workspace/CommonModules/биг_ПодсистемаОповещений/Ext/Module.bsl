Процедура ПубличноеОповещениеОСрабатыванииСтопЛосса(Объект, ФинРезВПроцентах) Экспорт

	// algoId заполнено только у тех ордеров, что были отправлены на биржу. При бектестах ордера создаются, но на биржу не отправляются
	Если ЗначениеЗаполнено(Объект.posId) Тогда
		
		ВыполнятьОповещение = биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_СигналыДИ_ПубличныеОповещения",, Ложь);
		Если ВыполнятьОповещение Тогда

			Бот 				= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("Оповещения_ТГ_Бот_ГБИГ_Уведомления");
			Чат					= биг_ОбщегоНазначенияКлиентСервер.ПолучитьЗначениеПоИмени("ТГ_Группа_ГБИГ_ОнЭйр");
			
			ТекстСообщения 		= СформироватьПубличноеСообщениеОСрабатыванииСтопЛосс(Объект, ФинРезВПроцентах);
			
			Справочники.биг_Боты.ОтправитьСообщение(Бот, Чат, ТекстСообщения);			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПубличноеСообщениеОСрабатыванииСтопЛосс(Выборка, ФинРезВПроцентах)
	
	Шаблон = "Сигнал #K_%1_%2 
			|Стратегия: #%3 
			|
			|Сработал стоп-лосс, #сигнал_завершен!
			|Фин.результат сигнала = %4";
	
	Если ФинРезВПроцентах > 0 Тогда
		Шаблон = Шаблон + "
		   	|
			|P.S. Поделитесь ответом на это сообщение, а сколько процентов на этом сигнале удалось заработать вам ? (за вычетом комиссий)";
	КонецЕсли;			
	
	ТекстСообщения = СтрШаблон(Шаблон, Выборка.ТочкаНачалаПадения, Выборка.ИнструментИД,  Выборка.КлючНастроек.Владелец, ФинРезВПроцентах);
	ТекстСообщения = ТекстСообщения + "%";
	Возврат ТекстСообщения;

КонецФункции

    
#КонецОбласти //ОповещенияОСигналах_DI 

#Область СлужебныеПроцедурыФункции

Функция НайтиСтопЛос(Сигнал) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	биг_ДаблИмпактОперации.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.биг_ДаблИмпактОперации КАК биг_ДаблИмпактОперации
	|ГДЕ
	|	биг_ДаблИмпактОперации.Биржа = &Биржа
	|	И биг_ДаблИмпактОперации.ИнструментИД = &ИнструментИД
	|	И биг_ДаблИмпактОперации.ТочкаНачалаПадения = &ТочкаНачалаПадения
	|	И ВЫРАЗИТЬ(биг_ДаблИмпактОперации.Операция КАК Документ.big_AlgoOrders_OKX).slTriggerPx > 0
	|	И биг_ДаблИмпактОперации.НастройкаСтратегии = &НастройкаСтратегии";
	
	Запрос.УстановитьПараметр("Биржа", 				Сигнал.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 		Сигнал.ИнструментИД);
	Запрос.УстановитьПараметр("ТочкаНачалаПадения", Сигнал.ТочкаНачалаПадения);
	Запрос.УстановитьПараметр("НастройкаСтратегии", Сигнал.КлючНастроек);
	                       
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Операция;	
	
КонецФункции

#КонецОбласти //СлужебныеПроцедурыФункции