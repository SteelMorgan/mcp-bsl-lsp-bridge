	Проверка = Ложь;
	
	Попытка
		А = Объект[Элемент.Ключ];
		Проверка = Истина;
	Исключение
		
		ТекстПредупреждения = "Для объекта " + Строка(Объект) + " отсутствует поле " + Элемент.Ключ + ", что бы сохранить значение " + Элемент.Значение;
		//ЗаписьЖурналаРегистрации("Интеграция.ЗаполнитьОбъектПоСоответствию", УровеньЖурналаРегистрации.Ошибка,,, ТекстПредупреждения);
	КонецПопытки;
	
	Возврат Проверка;
	
КонецФункции


Функция НайтиСоздатьВалюту(ИмяРеквизитаДляПоиска, ЗначениеРееквизитаПоиска) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗначениеРееквизитаПоиска) Тогда
		Возврат Справочники.big_Currencys.ПустаяСсылка();
	КонецЕсли;                                           
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизитаДляПоиска) Тогда
		Возврат Справочники.big_Currencys.ПустаяСсылка();
	КонецЕсли;
	
	Валюта = Справочники.big_Currencys.НайтиПоРеквизиту(ИмяРеквизитаДляПоиска, ЗначениеРееквизитаПоиска);
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Currencys = Справочники.big_Currencys.СоздатьЭлемент();
		Currencys[ИмяРеквизитаДляПоиска] 	= ЗначениеРееквизитаПоиска;
		Currencys.Наименование				= ЗначениеРееквизитаПоиска;
		
		Currencys.Записать();
		
		Валюта = Currencys.Ссылка;
	КонецЕсли;                    
	
	Возврат Валюта;
	
КонецФункции

