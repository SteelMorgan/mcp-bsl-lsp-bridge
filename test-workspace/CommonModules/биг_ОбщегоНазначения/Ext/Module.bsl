Процедура ЗаполнитьСтруктуруПоСсылке(СтруктураОперации, ДокументОперации) Экспорт
	
	СтруктураРеквизитов = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураОперации);
	ОставитьВСтруктуреТолькоСтроки(СтруктураРеквизитов);
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОперации, СтруктураРеквизитов);
	
	Для каждого Элемент Из ЗначенияРеквизитов Цикл
		
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			
			СтруктураОперации[Элемент.Ключ] = XMLСтрока(Элемент.Значение);				
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Процедура Пауза(ДлительностьПаузы) Экспорт

	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
	Если Сеанс.ПолучитьФоновоеЗадание() = Неопределено Тогда		
		биг_ОбщегоНазначенияКлиентСервер.ПаузаВСекундах(ДлительностьПаузы);
	Иначе		
		ОбщегоНазначенияБТС.Пауза(ДлительностьПаузы);	
	КонецЕсли;
	
КонецПроцедуры

Функция ЗапуститьФоновоеЗадание(ВыполняемыйМетод, ПараметрыЗапуска) Экспорт
		
	ПараметрыВыполнения 	= ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = ВыполняемыйМетод;
	ПараметрыВыполнения.ЗапуститьВФоне 				= Истина; 
	
	СтруктураФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗапуска, ПараметрыВыполнения);
	Возврат СтруктураФоновогоЗадания;	
КонецФункции


Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбратьРазрешенные = Ложь) Экспорт
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбратьРазрешенные);
		
КонецФункции

Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты, ВыбратьРазрешенные = Ложь) Экспорт
	
