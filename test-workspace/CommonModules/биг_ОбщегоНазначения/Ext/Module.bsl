
 
 #Область РаботаСоСвечами
 
/////////////////////////////////////////////////////////////////////////////////
//// В большинстве объектов время хранится в нескольких видах, хотя формат у всех формально ts (time stamp)
//// При этом в логике конфигурации приоритетно используется ts в виде Число(10)

// Функция ПолучитьДанныеСвечейПоТочке
//
// Параметры:
// ПараметрыЗапроса - Структура - описание см. биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам()
// ЗадачиРасчета - Структура - описание см. биг_УправлениеИндикаторамиКлиентСервер.ОписаниеЗадачиРасчетаИндикатора()
//
// Возвращаемое значение: 
// ТаблицаЗначений - Колонки см. РегистрСведений.биг_ДанныеСвечей + колонки со значениями индикаторов, имена задаются в Задачах расчета
Функция ПолучитьДанныеСвечейПоТочкеСИндикаторами(ПараметрыЗапроса, ЗадачиРасчета = Неопределено, РазрешитьОбращениеКБирже = Ложь) Экспорт
	
    ДанныеСвечей 	= биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса);	
    Если ДанныеСвечей = Неопределено ИЛИ ДанныеСвечей.Количество() = 0 И РазрешитьОбращениеКБирже Тогда
    		
    	// этот метод уже возвращает массив структур
    	ОсновныеДанные = ПолучитьСвечиГрафикаНаБирже(ПараметрыЗапроса);
    Иначе
    	ОсновныеДанные = ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеСвечей);	
    КонецЕсли;
    
    Если ЗадачиРасчета <> Неопределено Тогда
    	// рассчитать дполнительные данные
    	МаксПериод = 0;
    	Для каждого Задача Из ЗадачиРасчета Цикл
    		МаксПериод = Макс(МаксПериод, Задача.Длина1, Задача.Длина2);
    	КонецЦикла;
    	
    	ПараметрыДопЗапроса = биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам();
    	ЗаполнитьЗначенияСвойств(ПараметрыДопЗапроса, ПараметрыЗапроса,, "СортировкаПоУбыванию");                                  
    	
    	РазмерБара												= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗапроса.Бар, "SecondsAmount");
    	ПараметрыДопЗапроса.ТочкаВремениТС_ЗавершениеПериода 	= ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода - РазмерБара;
    	ПараметрыДопЗапроса.ТочкаВремениТС_НачалоПериода 		= ПараметрыДопЗапроса.ТочкаВремениТС_ЗавершениеПериода - (РазмерБара * МаксПериод);
    	ПараметрыДопЗапроса.КоличествоСвечей					= МаксПериод;
		ПараметрыДопЗапроса.ОграничениеПериода					= ПараметрыДопЗапроса.ТочкаВремениТС_ЗавершениеПериода;
    	
    	ДополнительныеДанные = биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке(ПараметрыДопЗапроса);
    	Если ДополнительныеДанные = Неопределено ИЛИ ДополнительныеДанные.Количество() = 0 И РазрешитьОбращениеКБирже Тогда
    		
    		// этот метод уже возвращает массив структур
    		ДополнительныеДанные = ПолучитьСвечиГрафикаНаБирже(ПараметрыЗапроса);
    	Иначе
    		ДополнительныеДанные = ОбщегоНазначения.ТаблицаЗначенийВМассив(ДополнительныеДанные);	
    	КонецЕсли;
    			
    	// получим данные с расчитанными индикаторами 
    	Данные = биг_УправлениеИндикаторамиКлиентСервер.РассчитатьИндикаторы(ОсновныеДанные, ДополнительныеДанные, ЗадачиРасчета);
    Иначе
    	Данные = ОсновныеДанные;	
    КонецЕсли;
 
    Возврат Данные;
	
КонецФункции

Функция ПолучитьСвечиГрафикаНаБирже(ПараметрыЗапроса)
	
	ТС 						= ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода;
	ГрузитьДоТочкиТС 		= ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода;
		
	ТССтрока 				= биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ТС);
	ГрузитьДоТочкиТССтрока	= биг_ОбщегоНазначенияКлиентСервер.TimeStampЧислоВСтроку(ГрузитьДоТочкиТС);
	
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_ЗагрузитьИсториюСвечей();
	СтруктураОперации.Биржа            = ПараметрыЗапроса.Биржа;
	СтруктураОперации.ИнструментИД     = ПараметрыЗапроса.ИнструментИД;
	СтруктураОперации.Бар              = ПараметрыЗапроса.Бар;
	СтруктураОперации.ТочкаДо          = ТССтрока;
	СтруктураОперации.ТочкаПосле       = ГрузитьДоТочкиТССтрока;
	СтруктураОперации.КоличествоСвечей = 100;	

	МассивСвечей = биг_МаркетАпи.ПолучитьИсториюСвечей(СтруктураОперации);
	ОбратныйМассив = math.reverse(МассивСвечей);
	Возврат ОбратныйМассив;
	
КонецФункции

// Функция ПолучитьДанныеСвечейПоТочке
//
// Параметры:
// параметрыВыборки - Структура - описание см. биг_ОбщегоНазначения.ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам() 
//
// Возвращаемое значение: 
// ТаблицаЗначений - Колонки см. РегистрСведений.биг_ДанныеСвечей
Функция ПолучитьДанныеСвечейПоТочке(ПараметрыЗапроса) Экспорт
	
	// Пока что отключаю повторное использование.
	
	//Биржа 								= ПараметрыЗапроса.Биржа;
	//ИнструментИД 						= ПараметрыЗапроса.ИнструментИД;
	//Бар 								= ПараметрыЗапроса.Бар;
	//ТочкаВремениТС_НачалоПериода 		= ПараметрыЗапроса.ТочкаВремениТС_НачалоПериода;
	//ТочкаВремениТС_ЗавершениеПериода 	= ПараметрыЗапроса.ТочкаВремениТС_ЗавершениеПериода;
	//КоличествоСвечей 					= ПараметрыЗапроса.КоличествоСвечей;
	//ИсключаяПереданнуюТочку 			= ПараметрыЗапроса.ИсключаяПереданнуюТочку;
	//ТолькоЗавершенные 					= ПараметрыЗапроса.ТолькоЗавершенные;
	//ОграничениеПериода 					= ПараметрыЗапроса.ОграничениеПериода;
	//СортировкаПоУбыванию 				= ПараметрыЗапроса.СортировкаПоУбыванию;
	//ВыбратьПервые						= ПараметрыЗапроса.ВыбратьПервые;
	//
	//Возврат биг_ОбщегоНазначенияПовтИсп.ПолучитьДанныеСвечейПоТочке(Биржа, ИнструментИД, Бар, ТочкаВремениТС_НачалоПериода, ТочкаВремениТС_ЗавершениеПериода,
	//																КоличествоСвечей, ИсключаяПереданнуюТочку, ТолькоЗавершенные, ОграничениеПериода, СортировкаПоУбыванию, ВыбратьПервые);
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ %Условие_Первые%
	|	биг_ДанныеСвечей.Биржа КАК Биржа,
	|	биг_ДанныеСвечей.ИнструментИД КАК ИнструментИД,
	|	биг_ДанныеСвечей.Бар КАК Бар,
	|	биг_ДанныеСвечей.TimeStamp КАК TimeStamp,
	|	биг_ДанныеСвечей.TimeStamp13 КАК TimeStamp13,
	|	биг_ДанныеСвечей.TimeStamp10 КАК TimeStamp10,
	|	биг_ДанныеСвечей.ДатаОткрытия КАК ДатаОткрытия,
	|	биг_ДанныеСвечей.ЦенаОткрытия КАК ЦенаОткрытия,
	|	биг_ДанныеСвечей.ЦенаМаксимум КАК ЦенаМаксимум,
	|	биг_ДанныеСвечей.ЦенаМинимум КАК ЦенаМинимум,
	|	биг_ДанныеСвечей.ЦенаЗакрытия КАК ЦенаЗакрытия,
	|	биг_ДанныеСвечей.Объем КАК Объем,
	|	биг_ДанныеСвечей.volCcy КАК volCcy,
	|	биг_ДанныеСвечей.volCcyQuote КАК volCcyQuote,
	|	биг_ДанныеСвечей.confirm КАК confirm
	|ИЗ
	|	РегистрСведений.биг_ДанныеСвечей КАК биг_ДанныеСвечей
	|ГДЕ
	|	биг_ДанныеСвечей.Биржа = &Биржа
	|	И биг_ДанныеСвечей.ИнструментИД = &ИнструментИД
	|	И биг_ДанныеСвечей.Бар = &Бар
	|	И биг_ДанныеСвечей.TimeStamp МЕЖДУ &НачалоПериода И &ЗавершениеПериода
	|	%УсловиеТолькоЗавершенная%	
	|	И биг_ДанныеСвечей.TimeStamp <= &ОграничениеПериода
	|УПОРЯДОЧИТЬ ПО
	|	TimeStamp %УсловиеСортировки%";
		
	
	
	биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке_УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса);
	
	ДанныеСвечей = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеСвечей;
			
КонецФункции

Процедура ПолучитьДанныеСвечейПоТочке_УстановитьПараметрыЗапроса(Запрос, СтруктураПараметров) Экспорт

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеСортировки%", ?(СтруктураПараметров.СортировкаПоУбыванию, " УБЫВ", ""));		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеТолькоЗавершенная%", ?(СтруктураПараметров.ТолькоЗавершенные, "И биг_ДанныеСвечей.confirm", ""));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Условие_Первые%", ?(СтруктураПараметров.ВыбратьПервые > 0, " ПЕРВЫЕ " + СтруктураПараметров.ВыбратьПервые, ""));	
	
	Если СтруктураПараметров.ТочкаВремениТС_НачалоПериода = Неопределено И СтруктураПараметров.ТочкаВремениТС_ЗавершениеПериода = Неопределено Тогда
		
		// не передано ничего
		НачалоПериода 		= 0;
		ЗавершениеПериода 	= 9999999999; 
		
		Если СтруктураПараметров.ИсключаяПереданнуюТочку Тогда
			Сообщить("Передан флаг 'Исключая переданную точку', но точки не переданы. Флаг будет проигнорирован");
		КонецЕсли;
		
	ИначеЕсли СтруктураПараметров.ТочкаВремениТС_НачалоПериода = Неопределено И СтруктураПараметров.ТочкаВремениТС_ЗавершениеПериода <> Неопределено Тогда 
		
		// передана точка завершения --> вычислить начало периода
		ЗавершениеПериода		= СтруктураПараметров.ТочкаВремениТС_ЗавершениеПериода;
		НачалоПериода			= ЗавершениеПериода - (СтруктураПараметров.Бар.SecondsAmount * СтруктураПараметров.КоличествоСвечей);
		
		Если СтруктураПараметров.ИсключаяПереданнуюТочку Тогда
			ЗавершениеПериода	= ЗавершениеПериода - 1;	
		КонецЕсли;
		
	ИначеЕсли СтруктураПараметров.ТочкаВремениТС_НачалоПериода <> Неопределено И СтруктураПараметров.ТочкаВремениТС_ЗавершениеПериода = Неопределено Тогда
		
		// передана точка начала --> вычислить точку завершения    
		НачалоПериода			= СтруктураПараметров.ТочкаВремениТС_НачалоПериода;	
		ЗавершениеПериода		= НачалоПериода + (СтруктураПараметров.Бар.SecondsAmount * СтруктураПараметров.КоличествоСвечей);
		
		Если СтруктураПараметров.ИсключаяПереданнуюТочку Тогда
			НачалоПериода		= НачалоПериода + 1;	
		КонецЕсли;
		
	Иначе
		
		// передано всё, просто фиксируем значения
		НачалоПериода			= СтруктураПараметров.ТочкаВремениТС_НачалоПериода;
		ЗавершениеПериода		= СтруктураПараметров.ТочкаВремениТС_ЗавершениеПериода; 
		
		Если СтруктураПараметров.ИсключаяПереданнуюТочку Тогда
			НачалоПериода		= НачалоПериода + 1;
			ЗавершениеПериода	= ЗавершениеПериода - 1;	
		КонецЕсли;	
		
	КонецЕсли;
	      	
	
	Запрос.УстановитьПараметр("Биржа", 					СтруктураПараметров.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 			СтруктураПараметров.ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 					СтруктураПараметров.Бар);
	
	Запрос.УстановитьПараметр("НачалоПериода", 			НачалоПериода);
	Запрос.УстановитьПараметр("ЗавершениеПериода", 		ЗавершениеПериода);	
	Запрос.УстановитьПараметр("ОграничениеПериода", 	СтруктураПараметров.ОграничениеПериода);
	
КонецПроцедуры


// Функция Возвращает структуру параметров для функции биг_ОбщегоНазначения.ПолучитьДанныеСвечейПоТочке()
//
// Возвращаемое значение
// Структура, содержит ключи: 
// Биржа - СправочникСсылка.big_Markets - Биржа 
// ИнструментИД - СправочникСсылка.big_Instruments - Торговая пара
// Бар - СправочникСсылка.big_BarTypes - Фрейм свечи
// TimeStamp - ts - точка До которой или После которой отобрать свечи (сама точка в отбор не входит!!!)
// КоличествоСвечей - Число - число свечей, которые будут возвращены
// ТолькоЗавершенные - Булево - Признак, что незавершенные свечи не будут включены в выборку
// ОграничениеПериода - ts - точка, ограничивающая отбор "с права". Используется для "эмуляции", когда "текущая дата" должна быть в прошлом
Функция ПолучитьСтруктуруПараметровЗапросаДанныхПоСвечам() Экспорт
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Биржа");
	СтруктураПараметров.Вставить("ИнструментИД");
	СтруктураПараметров.Вставить("Бар");
	СтруктураПараметров.Вставить("ТочкаВремениТС_НачалоПериода", Неопределено);
	СтруктураПараметров.Вставить("ТочкаВремениТС_ЗавершениеПериода", Неопределено);
	
	СтруктураПараметров.Вставить("КоличествоСвечей", 72);
	СтруктураПараметров.Вставить("ИсключаяПереданнуюТочку", Ложь);
	СтруктураПараметров.Вставить("ТолькоЗавершенные", Истина);
	СтруктураПараметров.Вставить("ОграничениеПериода", 9999999999);
	СтруктураПараметров.Вставить("СортировкаПоУбыванию", Ложь);
	СтруктураПараметров.Вставить("ВыбратьПервые", 0);
	Возврат СтруктураПараметров;	
	
КонецФункции

Функция ПредыдущиеЗначенияRSI(ДанныеСвечи, Индикатор, ПараметрыИндикатора, КоличествоЗначений, TimeStamp) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ЗначенияИндикаторов.Биржа КАК Биржа,
	|	биг_ЗначенияИндикаторов.ИнструментИД КАК ИнструментИД,
	|	биг_ЗначенияИндикаторов.Бар КАК Бар,
	|	биг_ЗначенияИндикаторов.TimeStamp КАК TimeStamp,
	|	биг_ЗначенияИндикаторов.Индикатор КАК Индикатор,
	|	биг_ЗначенияИндикаторов.TimeStamp10 КАК TimeStamp10,
	|	биг_ЗначенияИндикаторов.Значение КАК Значение,
	|	биг_ЗначенияИндикаторов.ДатаВремя КАК ДатаВремя
	|ИЗ
	|	РегистрСведений.биг_ЗначенияИндикаторов КАК биг_ЗначенияИндикаторов
	|ГДЕ
	|	биг_ЗначенияИндикаторов.Биржа = &Биржа
	|	И биг_ЗначенияИндикаторов.ИнструментИД = &ИнструментИД
	|	И биг_ЗначенияИндикаторов.Бар = &Бар
	|	И биг_ЗначенияИндикаторов.TimeStamp МЕЖДУ &НачалоПериода И &ЗавершениеПериода
	|	И биг_ЗначенияИндикаторов.Индикатор = &Индикатор
	|	И биг_ЗначенияИндикаторов.ПараметрыИндикатора = &ПараметрыИндикатора";
	
	Запрос.УстановитьПараметр("Биржа", 				ДанныеСвечи.Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", 		ДанныеСвечи.ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 				ДанныеСвечи.Бар);
	Запрос.УстановитьПараметр("Индикатор", 			Индикатор);
	Запрос.УстановитьПараметр("ПараметрыИндикатора",ПараметрыИндикатора);
	Запрос.УстановитьПараметр("НачалоПериода", 		TimeStamp - (ДанныеСвечи.Бар.SecondsAmount * КоличествоЗначений));
	Запрос.УстановитьПараметр("ЗавершениеПериода", 	TimeStamp);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		МассивRSI = Новый Массив;
	Иначе
		МассивRSI = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");	
	КонецЕсли;
	           
	Возврат МассивRSI;
		
КонецФункции

Функция ДополнитьДанныеСвечейДаннымиИндикаторов(ДанныеСвечей, Источник, Индикатор1, Параметр1, Индикатор2 = Неопределено, Параметр2 = Неопределено, ПустоеЗначение) Экспорт
	
	// конструктор-извращение, но как сделать красивее не придумал. Вроде через построитель можно, но я им не пользовался :) Прастите	
	
	Текст = 
	"ВЫБРАТЬ";
	
	ВсегоКолонок = ДанныеСвечей.Колонки.Количество();
	Сч = 0;
	Для каждого Колонка Из ДанныеСвечей.Колонки Цикл
		
		Сч = Сч + 1;
		
		Шаблон 	= "
					|	ДанныеСвечей.%1 КАК %1";
		Строка 	= СтрШаблон(Шаблон, Колонка.Имя);
		Если Сч < ВсегоКолонок Тогда
			Строка = Строка + ",";	
		КонецЕсли;
		
		Текст 	= Текст + Строка;
	КонецЦикла;
	
	
	Текст = Текст + "
	|ПОМЕСТИТЬ ВТ_ДанныеСвечей
	|ИЗ
	|	&ДанныеСвечей КАК ДанныеСвечей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ";
	
	ВсегоКолонок = ДанныеСвечей.Колонки.Количество();
	Сч = 0;
	Для каждого Колонка Из ДанныеСвечей.Колонки Цикл
		
		Сч = Сч + 1;
		
		Шаблон 	= "
					|	ВТ_ДанныеСвечей.%1 КАК %1,";
		Строка 	= СтрШаблон(Шаблон, Колонка.Имя);		
		Текст 	= Текст + Строка;
	КонецЦикла;
	
	ИмяИндикатора = Строка(Источник) + Индикатор1 + Параметр1 + ?(Индикатор2 = Неопределено, "", "" + Индикатор2 + Параметр2);
	
	Текст = Текст + "
	|	ЕСТЬNULL(биг_ЗначенияИндикаторов.Значение, " + ПустоеЗначение + ") КАК " + ИмяИндикатора + "
	|ИЗ
	|	ВТ_ДанныеСвечей КАК ВТ_ДанныеСвечей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.биг_ЗначенияИндикаторов КАК биг_ЗначенияИндикаторов
	|		ПО ВТ_ДанныеСвечей.Биржа = биг_ЗначенияИндикаторов.Биржа
	|			И ВТ_ДанныеСвечей.ИнструментИД = биг_ЗначенияИндикаторов.ИнструментИД
	|			И ВТ_ДанныеСвечей.Бар = биг_ЗначенияИндикаторов.Бар
	|			И ВТ_ДанныеСвечей.TimeStamp = биг_ЗначенияИндикаторов.TimeStamp
	|			И (биг_ЗначенияИндикаторов.Источник = &Источник)
	|			И (биг_ЗначенияИндикаторов.Индикатор1 = &Индикатор1)
	|			И (биг_ЗначенияИндикаторов.Параметр1 = &Параметр1)
	|			И (биг_ЗначенияИндикаторов.Индикатор2 = &Индикатор2)
	|			И (биг_ЗначенияИндикаторов.Параметр2 = &Параметр2)";
	              
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	
	Запрос.УстановитьПараметр("ДанныеСвечей", 	ДанныеСвечей);
	Запрос.УстановитьПараметр("Источник", 		Источник);
	Запрос.УстановитьПараметр("Индикатор1", 	Индикатор1);
	Запрос.УстановитьПараметр("Параметр1", 		Параметр1);
	Запрос.УстановитьПараметр("Индикатор2", 	?(Индикатор2 = Неопределено, Перечисления.биг_ВидыИндикаторов.ПустаяСсылка(), Индикатор2));
	Запрос.УстановитьПараметр("Параметр2", 		Параметр2);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица;			
	
КонецФункции

// Описание:
//
//
// Параметры (название, тип, дифференцированное значение)
//
// Возвращаемое значение: 
//
Функция ДетальнаяИнформацияОСвече(Биржа, ИнструментИД, Бар, TimeStamp) Экспорт
	
	// Пока что отключаю повторное использование.
	//Возврат биг_ОбщегоНазначенияПовтИсп.ДетальнаяИнформацияОСвече(Биржа, ИнструментИД, Бар, TimeStamp);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	биг_ДанныеСвечей.Биржа КАК Биржа,
	|	биг_ДанныеСвечей.ИнструментИД КАК ИнструментИД,
	|	биг_ДанныеСвечей.Бар КАК Бар,
	|	биг_ДанныеСвечей.TimeStamp КАК TimeStamp,
	|	биг_ДанныеСвечей.TimeStamp13 КАК TimeStamp13,
	|	биг_ДанныеСвечей.TimeStamp10 КАК TimeStamp10,
	|	биг_ДанныеСвечей.ДатаОткрытия КАК ДатаОткрытия,
	|	биг_ДанныеСвечей.ЦенаОткрытия КАК ЦенаОткрытия,
	|	биг_ДанныеСвечей.ЦенаМаксимум КАК ЦенаМаксимум,
	|	биг_ДанныеСвечей.ЦенаМинимум КАК ЦенаМинимум,
	|	биг_ДанныеСвечей.ЦенаЗакрытия КАК ЦенаЗакрытия,
	|	биг_ДанныеСвечей.Объем КАК Объем,
	|	биг_ДанныеСвечей.volCcy КАК volCcy,
	|	биг_ДанныеСвечей.volCcyQuote КАК volCcyQuote,
	|	биг_ДанныеСвечей.confirm КАК confirm
	|ИЗ
	|	РегистрСведений.биг_ДанныеСвечей КАК биг_ДанныеСвечей
	|ГДЕ
	|	биг_ДанныеСвечей.Биржа = &Биржа
	|	И биг_ДанныеСвечей.ИнструментИД = &ИнструментИД
	|	И биг_ДанныеСвечей.Бар = &Бар
	|	И биг_ДанныеСвечей.TimeStamp = &TimeStamp";
	
	Запрос.УстановитьПараметр("Биржа", 		Биржа);
	Запрос.УстановитьПараметр("ИнструментИД", ИнструментИД);
	Запрос.УстановитьПараметр("Бар", 		Бар);
	Запрос.УстановитьПараметр("TimeStamp", 	TimeStamp);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Свеча = биг_ОбщегоНазначенияКлиентСервер.ОписаниеСвечи();
	ЗаполнитьЗначенияСвойств(Свеча, Выборка);
	
	Возврат Свеча;
	
КонецФункции

