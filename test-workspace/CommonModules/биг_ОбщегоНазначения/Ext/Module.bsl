Процедура ЗаполнитьОбъектПоСоответствию(Объект, Соответствие, ПоляИсключения = "") Экспорт
	
	ПоляИсключения 			= СтрЗаменить(ПоляИсключения, " ", "");
	МассивПолей 			= СтрРазделить(ПоляИсключения, ",");
	КоличествоИсключений 	= МассивПолей.Количество();
	
		Для каждого Элемент Из Соответствие Цикл
		
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			
			Если ПроверитьНаличиеТребуемыхПолейВОбъекте(Объект, Элемент) Тогда
				
				Если ЭтоПростойТипЗначения(Объект[Элемент.Ключ]) Тогда
					
					Если КоличествоИсключений > 0 И МассивПолей.Найти(Элемент.Ключ) = Неопределено Тогда
						Объект[Элемент.Ключ] = Элемент.Значение;
					ИначеЕсли КоличествоИсключений = 0 Тогда
						Объект[Элемент.Ключ] = Элемент.Значение;
					КонецЕсли;
					
				КонецЕсли;				
			КонецЕсли;				
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры 

