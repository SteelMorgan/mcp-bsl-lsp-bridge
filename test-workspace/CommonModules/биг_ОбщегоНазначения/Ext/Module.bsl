// Функция НачалоПериодаПоБару
//
// Описание: Определяет точку ts (time stamp), соответствующую началу фрейма по Бару
//
//
// Параметры (название, тип, дифференцированное значение)
//  ТаймСтамп - Число(10) - Точка времени в формате 'ts'
//	Бар - СправочникСсылка.big_BarTypes - Бар, описывающий текущий фрейм
//
// Возвращаемое значение: 
//	НачалоПериодаТС - Число(10) - Число, соответствующее точке начала фрейма
Функция НачалоПериодаПоБару(ТаймСтамп, Бар) Экспорт
	
	ВеличинаБара = Бар.SecondsAmount; 
	НачалоПериода = Цел(ТаймСтамп / ВеличинаБара) * ВеличинаБара;
	
	Возврат НачалоПериода;
		
КонецФункции

Функция НайтиСтаршийФрейм(Бар) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	big_BarTypes.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.big_BarTypes КАК big_BarTypes
	|ГДЕ
	|	big_BarTypes.SecondsAmount > &РазмерТекущегоФрейма
	|
	|УПОРЯДОЧИТЬ ПО
	|	big_BarTypes.SecondsAmount";
	Запрос.УстановитьПараметр("РазмерТекущегоФрейма", Бар.SecondsAmount);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = Результат.Выбрать();	
		Возврат Выборка.Ссылка;	
	КонецЕсли;	
	
КонецФункции

