Функция ЭтоСвечаДоджи(Свеча, КлючНастроек) Экспорт
		
    // Вычисляем диапазон свечи (разницу между максимумом и минимумом)
    ДиапазонСвечи = Свеча.ЦенаМаксимум - Свеча.ЦенаМинимум;
    Если ДиапазонСвечи = 0 Тогда
        Возврат Ложь; // Свеча без движения (нет диапазона)
    КонецЕсли;

    // Вычисляем размер тела свечи (абсолютную разницу между открытием и закрытием)
    РазмерТела = ?(Свеча.ЦенаЗакрытия - Свеча.ЦенаОткрытия < 0, (Свеча.ЦенаЗакрытия - Свеча.ЦенаОткрытия) *-1, Свеча.ЦенаЗакрытия - Свеча.ЦенаОткрытия);

    // Определяем, является ли тело свечи достаточно маленьким относительно диапазона
    ОтносительныйРазмерТела = РазмерТела / ДиапазонСвечи;
	
	Порог = 0.15;
	
    // Если относительный размер тела меньше порога, это доджи
    Если ОтносительныйРазмерТела <= Порог Тогда
        ЭтоДоджи = Истина;
    Иначе
        ЭтоДоджи = Ложь;
    КонецЕсли;
		
	//ЭтоДоджи 				= Истина;
	//
	//РазмерТела 				= Свеча.ЦенаЗакрытия - Свеча.ЦенаОткрытия;
	//РазмерХвоста 			= Свеча.ЦенаОткрытия - Свеча.ЦенаМинимум;
	//
	//КоэффициентЭлементов 	= РазмерХвоста / РазмерТела;
	//
	//Настройки 			= РегистрыСведений.биг_ЗначенияКонтрольныхУровней;
	//ЦелевойКоэффициент	= Настройки.ЗначениеУровняПоИмени("ДИ_4_ПоискТочкиВходаОдин_ЦелевойКоэффициентХвостаКТелу_Доджи", КлючНастроек);
	//
	//Если КоэффициентЭлементов < ЦелевойКоэффициент Тогда
	//	ЭтоДоджи = Ложь;
	//КонецЕсли;          
	
	Возврат ЭтоДоджи;
	
