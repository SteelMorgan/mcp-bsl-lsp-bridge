КонецФункции


#КонецОбласти //СлужебныеПроцедурыФункции



Функция ЭтоПростойТипЗначения(Значение) Экспорт

	Тип = ТипЗнч(Значение);
	
	ЭтопростойТип = Ложь;
	
	Если Тип = Тип("Строка") Тогда
		ЭтопростойТип = Истина;
	ИначеЕсли Тип = Тип("Число") Тогда
		ЭтопростойТип = Истина;
	КонецЕсли;
	
	Возврат ЭтопростойТип;
	
КонецФункции


Функция ПолучитьЗначениеПеречисления(ИмяПеречисления, ИмяЗначения) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ТипЗнч(ИмяПеречисления) <> Тип("Строка") Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяЗначения) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ВРЕГ(ИмяЗначения) = "NULL" Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	
КонецФункции

Функция ФоновоеЗаданиеАктивно_ПоКлючу(Ключ) Экспорт
	
	Отбор 	= Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно);
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	Если Задания.Количество() > 1 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции


Функция СтруктураРеквизитовПоМетаданным(Ссылка) Экспорт
	
	Структура = Новый Структура();
	МетаданныеСсылки = Ссылка.Метаданные();
	
	Для каждого Реквизит Из МетаданныеСсылки.Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя, "");	
	КонецЦикла;                                                        
	
	Возврат Структура;
	
КонецФункции 

Процедура ЗаполнитьСтруктуруПоОбъектуСУчетомТипов(Приемник, Источник, СписокИсключений = "") Экспорт

	МассивИсключений = СтрРазделить(СписокИсключений, ",");
	
	Для каждого Элемент Из Приемник Цикл
		
		Если МассивИсключений.Найти(Элемент.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НазваниеРеквизита 	= Элемент.Ключ;
		Реквизит 			= Источник[НазваниеРеквизита];
		ТипРеквизита 		= ТипЗнч(Реквизит);
		
		Если ТипРеквизита = Тип("Строка") Тогда
			
			Приемник[НазваниеРеквизита] = Реквизит; 
			
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда 
			
			Приемник[НазваниеРеквизита] = Формат(Реквизит, "ЧЦ=30; ЧДЦ=8; ЧРД=.; ЧГ=0");
			
		Иначе
			
			Приемник[НазваниеРеквизита] = Строка(Реквизит);	
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ОставитьВСтруктуреТолькоСтроки(СтруктураРеквизитов)
	
	МассивУдалить = Новый Массив;
	
	Для каждого Элемент Из СтруктураРеквизитов Цикл
		
		Если ТипЗнч(Элемент.Значение) <> Тип("Строка") Тогда
			МассивУдалить.Добавить(Элемент.Ключ);	
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Ключ Из МассивУдалить Цикл
		СтруктураРеквизитов.Удалить(Ключ);
	КонецЦикла;                           
	
КонецПроцедуры





