Процедура ТаблицаЗначений_СоздатьИндекс(Свойства, пПараметры)
	
	ТипПараметра = ТипЗнч(пПараметры);
	Если ТипПараметра = Тип("Строка") Тогда
		Индексы = Новый Массив;
		Индексы.Добавить(пПараметры);
	ИначеЕсли ТипПараметра = Тип("Массив") Тогда
		Индексы = пПараметры;
	Иначе
		ТекстОшибки = "Тип переданного индекса для таблицы значений отличается от ожидаемого. Передан тип: " + ТипПараметра;
		БроситьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Для Каждого ТекИндекс Из Индексы Цикл
		Свойства.Коллекция.Индексы.Добавить(ТекИндекс);
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаЗначений_СкопироватьКоллекцию(Свойства, пОбъект, пРекурсивно)
	
	Коллекция = ЭкземплярКлассаУниверсальнаяКоллекция(пОбъект);
	// TODO: 2024.09.23 Сейчас норм, но в будущем подклассе должен быть отдельный метод для копирования структуры без данных
	КопияТаблицы = Коллекция.Указатель().СкопироватьКолонки();
	КопияКоллекции = ЭкземплярКлассаУниверсальнаяКоллекция(КопияТаблицы);
	ПоляТаблицы = ТаблицаЗначений_ИменаПолей(Коллекция.Указатель()); 
	
	Пока Коллекция.Следующий() Цикл
		ДанныеСтроки = Коллекция.Значение();
		Если Не пРекурсивно Тогда
			КопияКоллекции.Добавить(ДанныеСтроки);
		Иначе // обходим каждое поле строки и обрабатываем рекурсивно
			НоваяСтрока = КопияКоллекции.ПолучитьЗначение(КопияКоллекции.Добавить());
			Для Каждого КлючПоля Из ПоляТаблицы Цикл
				Значение = СкопироватьЗначение(Свойства, ДанныеСтроки[КлючПоля], пРекурсивно); 
				НоваяСтрока[КлючПоля] = Значение; 
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КопияКоллекции.Указатель();
	
КонецФункции

#Область ДобавитьЗначение

Функция ДобавитьЗначениеВКоллекцию(Свойства, пЗначение, пКлюч)
	
	Если Свойства.Тип = Тип("Массив") Тогда
		Результат = Массив_ДобавитьЗначение(Свойства, пЗначение, пКлюч);
	ИначеЕсли Свойства.Тип = Тип("СписокЗначений") Тогда
		Результат = Массив_ДобавитьЗначение(Свойства, пЗначение, пКлюч);
	ИначеЕсли ТаблицаЗначенийПоддерживается() И Свойства.Тип = Тип("ТаблицаЗначений") Тогда
		Результат = ТаблицаЗначений_ДобавитьЗначение(Свойства, пЗначение, пКлюч);
	ИначеЕсли Свойства.Тип = Тип("Структура") Или Свойства.Тип = Тип("Соответствие") Тогда
		Результат = Структура_ДобавитьЗначение(Свойства, пЗначение, пКлюч);
	Иначе
		ОшибкаНеПоддерживаемыйТипКоллекции(Свойства);
	КонецЕсли;
	
	ПриИзмененииКоличества(Свойства);
	
	Возврат Результат;
	
КонецФункции

Функция Массив_ДобавитьЗначение(Свойства, пЗначение, пКлюч)
	
	Если пЗначение = Свойства.ПустоеЗначение Тогда
		ОшибкаЗначениеНеДолжноБытьПустым(Свойства);
	КонецЕсли;
	
	Если пКлюч = Свойства.ПустоеЗначение Тогда
		Свойства.Коллекция.Добавить(пЗначение);
		Результат = Свойства.ЧислоЗначений;
	Иначе
		Свойства.Коллекция.Вставить(пКлюч, пЗначение);
		Результат = пКлюч;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗначений_ДобавитьЗначение(Свойства, пЗначение, пКлюч)
	
	Если пКлюч = Свойства.ПустоеЗначение Тогда
		СтрокаТаблицы = Свойства.Коллекция.Добавить();
		Результат = Свойства.ЧислоЗначений;
	Иначе
		СтрокаТаблицы = Свойства.Коллекция.Вставить(пКлюч);
		Результат = пКлюч;
	КонецЕсли;
	
	Если Не пЗначение = Свойства.ПустоеЗначение Тогда
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, пЗначение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Структура_ДобавитьЗначение(Свойства, пЗначение, пКлюч)
	
	Если пКлюч = Свойства.ПустоеЗначение Тогда
		ОшибкаКлючНеДолженБытьПустым(Свойства);
	КонецЕсли;
	Если пЗначение = Свойства.ПустоеЗначение Тогда
		ЗначениеКДобавлению = Неопределено;
	Иначе
		ЗначениеКДобавлению = пЗначение;
	КонецЕсли;
	
	Свойства.Коллекция.Вставить(пКлюч, ЗначениеКДобавлению);
	Результат = пКлюч;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область НайтиПоЗначению

Функция НайтиПоЗначениюВКоллекции(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений = 0)
	
	ОбновитьИндексКлючейПриНеобходимости(Свойства);
	
	Если Свойства.ИндексПоискаДоступен И Не Свойства.ЕстьВстроенныйИндекс Тогда
		Результат = НайтиПоЗначениюВИндексе(Свойства, пЗначение, пЧислоЗначений);
	Иначе
		Если Свойства.Тип = Тип("Массив") Тогда
			Результат = Массив_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений);
		ИначеЕсли Свойства.Тип = Тип("СписокЗначений") Тогда
			Результат = СписокЗначений_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений);
		ИначеЕсли ТаблицаЗначенийПоддерживается() И Свойства.Тип = Тип("ТаблицаЗначений") Тогда
			Результат = ТаблицаЗначений_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений);
		ИначеЕсли Свойства.Тип = Тип("Структура") Или Свойства.Тип = Тип("Соответствие")
			Или Свойства.Тип = Тип("ФиксированнаяСтруктура") 
			Или Свойства.Тип = Тип("ФиксированноеСоответствие") Тогда
			Результат = Структура_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений);
		Иначе
			ОшибкаНеПоддерживаемыйТипКоллекции(Свойства);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Массив_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений = 0)
	
	ВернутьПервое = пЧислоЗначений = 1;
	
	Если ВернутьПервое Тогда
		Результат = Свойства.Коллекция.Найти(пЗначение);
	Иначе
		БезОграничений = пЧислоЗначений = 0;
		МаксИндекс = ?(БезОграничений, Свойства.МаксИндекс, пЧислоЗначений - 1);
		Результат = Новый Массив;
		Для Сч = 0 По МаксИндекс Цикл
			Если Свойства.Коллекция[Сч] = пЗначение Тогда
				Результат.Добавить(Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СписокЗначений_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений = 0)
	
	ВернутьПервое = пЧислоЗначений = 1;
	
	Если ВернутьПервое Тогда
		Элемент = Свойства.Коллекция.НайтиПоЗначению(пЗначение);
		Результат = ?(Элемент <> Неопределено, Свойства.Коллекция.Индекс(Элемент), Элемент);
	Иначе
		БезОграничений = пЧислоЗначений = 0;
		МаксИндекс = ?(БезОграничений, Свойства.МаксИндекс, пЧислоЗначений - 1);
		Результат = Новый Массив;
		Для Сч = 0 По МаксИндекс Цикл
			Если Свойства.Коллекция[Сч].Значение = пЗначение Тогда
				Результат.Добавить(Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ТаблицаЗначений_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений = 0)
	
	//!!! При нахождении приводим результат к ключу элемента для единой логики работы класса
	
	ИменаПолейСтрокой = ?(ЗначениеЗаполнено(пПараметрыПоиска), пПараметрыПоиска, "");
	ВернутьПервое = пЧислоЗначений = 1;
	// При поиске одиночного значения не заморачиваемся и пользуемся штатным методом
	Если ВернутьПервое Тогда
		Результат =  Свойства.Коллекция.Найти(пЗначение, ИменаПолейСтрокой);
		Возврат ТаблицаЗначений_КлючЭлемента(Свойства, Результат);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИменаПолейСтрокой) Тогда
		ИменаПолей = СтрРазделить(ИменаПолейСтрокой, ",", Ложь);
	Иначе
		ИменаПолей = ТаблицаЗначений_ИменаПолей(Свойства.Коллекция);
	КонецЕсли;
	
	// Сначала найдём все строки независимо от ожидаемого количества
	УникальныеКлючи = ЭкземплярКлассаУниверсальнаяКоллекция("Соответствие");
 	БезОграничений = пЧислоЗначений = 0;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Отбор = Новый Структура(ИмяПоля, пЗначение);
		НайденныеСтроки = Свойства.Коллекция.НайтиСтроки(Отбор);
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			УникальныеКлючи.Добавить(,ТаблицаЗначений_КлючЭлемента(Свойства, ТекСтрока));
		КонецЦикла;
	КонецЦикла;
	
	ВсеНайденныеКлючи = УникальныеКлючи.ВыгрузитьКлючи();
	МаксЧисло = ?(БезОграничений, Свойства.ЧислоЗначений, пЧислоЗначений);
	// Если ожидается меньшее число результатов, чем получено, то обрезаем результат
	Если Результат.Количество() <= МаксЧисло Тогда
		Результат = ВсеНайденныеКлючи;
	Иначе
		СортироватьМассив(ВсеНайденныеКлючи);
		Результат = Новый Массив;
		Для Сч = 0 По МаксЧисло - 1 Цикл
			Результат.Добавить(ВсеНайденныеКлючи[Сч]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Структура_НайтиПоЗначению(Свойства, пЗначение, пПараметрыПоиска, пЧислоЗначений = 0)
	
	ВернутьПервое = пЧислоЗначений = 1;
	БезОграничений = пЧислоЗначений = 0;
	МаксКоличество = ?(БезОграничений, Свойства.ЧислоЗначений, пЧислоЗначений);
	Результат = ?(ВернутьПервое, Неопределено, Новый Массив);
	
	Сч = 0;
	Для Каждого Элем Из Свойства.Коллекция Цикл
		Если Элем.Значение = пЗначение Тогда
			Если ВернутьПервое Тогда
				Результат = Элем.Ключ;
				Прервать;
			Иначе
				Результат.Добавить(Элем.Ключ);
				Сч = Сч + 1;
				Если Сч = МаксКоличество Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

