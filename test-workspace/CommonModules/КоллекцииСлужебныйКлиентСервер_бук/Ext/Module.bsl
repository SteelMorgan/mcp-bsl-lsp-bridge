Функция СписокКлючейКоллекции(Свойства)
	
	Результат = Новый Массив;
	
	Если Свойства.КлючЭтоИндекс Тогда
		Для Сч = 0 По Свойства.МаксИндекс Цикл
			Результат.Добавить(Сч);
		КонецЦикла;
	Иначе // На момент написания это структуры и соответствия
		Для Каждого Элемент Из Свойства.Коллекция Цикл
			Результат.Добавить(Элемент.Ключ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СписокЗначенийКоллекции(Свойства, пТолькоУникальные)

	Результат = Новый Массив;
	
	Если Свойства.ДоступнаВыгрузкаЗначений Тогда
		Результат = Свойства.Коллекция.ВыгрузитьЗначения();
	ИначеЕсли Свойства.ЕстьПолеЗначение Тогда
		Для Каждого Элемент Из Свойства.Коллекция Цикл
			Результат.Добавить(Элемент.Значение);
		КонецЦикла;
	ИначеЕсли Свойства.Тип = Тип("Массив") Тогда
		Результат = Свойства.Коллекция;
	ИначеЕсли ТаблицаЗначенийПоддерживается() И Свойства.Тип = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого ТекСтрока Из Свойства.Коллекция Цикл
			Результат.Добавить(ТекСтрока);
		КонецЦикла;
		
	Иначе
		ОшибкаНеПоддерживаемыйТипКоллекции(Свойства);
	КонецЕсли;
	
	Если пТолькоУникальные Тогда
		// Методы класса здесь ещё недоступны, так как это метод инициализации
		Результат = СкопироватьМассив(Результат, пТолькоУникальные);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеЭлементаПоКлючу(Свойства, пКлюч)
	
	Результат = Свойства.Коллекция[пКлюч];
	Если Свойства.Тип = Тип("СписокЗначений") Тогда
		Результат = Результат.Значение;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Процедура УдалитьПоСпискуКлючей(Свойства, пКлючи)
	
	// Числовые ключи отсортируем в убывании, чтобы удалять "с хвоста"
	Если ТипЗнч(пКлючи[0]) = Тип("Число") Тогда
		СортироватьМассив(пКлючи, "Убыв");
	КонецЕсли;
	
	Для Каждого Ключ Из пКлючи Цикл 
		Свойства.Коллекция.Удалить(Ключ);
	КонецЦикла;
	
	ПриИзмененииКоличества(Свойства);

