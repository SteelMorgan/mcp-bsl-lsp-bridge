// Инициализация класса для работы с коллекцией
// Тип коллекции определяется переданными данными
//
// Параметры:
//  
//  пИсточник - Строка,Тип,Массив,Структура,Соответствие,СписокЗначений,ТаблицаЗначений,ФиксированныйМассив,ФиксированнаяСтруктура,ФиксированноеСоответствие - описание коллекции для последующей инициализации
//                Если передана строка, то в ней ожидается наименование коллекции. В данном случае будет создана новая коллекция
//                Передача типа коллекции, также приведёт к созданию новой коллекции
//                Передача непосредственно универсальной коллекции просто инициализирует класс для дальнейшей работы с ней
//  пПараметрыКонструктора - Массив,Структура,Соответствие,Неопределено - Если задано, то передаст параметры для конструктора
//                Используется для инициализации фиксированных коллекций
//                Для списка значений допустима передача массива. В этом случае список будет инициализирован со значениями из массива
//
// Возвращаемое значение:
//   Булево - Истина, если инициализация выполнена успешно
//
Функция Инициализировать(пИсточник, пПараметрыКонструктора = Неопределено) Экспорт
	
	Свойства = Новый Структура;
	Свойства.Вставить("ТипыПоддерживаемыхКоллекций", ТипыПоддерживаемыхКоллекций()); 
	Свойства.Вставить("ПустоеЗначение", Новый УникальныйИдентификатор); 
	Свойства.Вставить("Коллекция", КонструкторКоллекции(пИсточник, пПараметрыКонструктора)); 
	Свойства.Вставить("Тип", ТипЗнч(Свойства.Коллекция)); 
	Свойства.Вставить("Фиксированная", ЭтоТипФиксированнойКоллекции(Свойства.Тип)); 
	Свойства.Вставить("ИзПарыФиксНеФикс", Свойства.Фиксированная Или ЕстьФиксАналог(Свойства.Тип)); 
	Свойства.Вставить("КлючЭтоИндекс", КлючЭтоИндекс(Свойства.Тип)); 
	Свойства.Вставить("ЕстьПолеЗначение", ЕстьПолеЗначение(Свойства.Тип)); 
	Свойства.Вставить("ДоступнаВыгрузкаЗначений", ДоступнаВыгрузкаЗначения(Свойства.Тип)); 
	Свойства.Вставить("ИндексКлючейАктуален", Ложь);
	Свойства.Вставить("КлючиКоллекции", Новый Массив);
	Свойства.Вставить("ЕстьВстроенныйИндекс", ЕстьВстроенныйИндекс(Свойства.Тип)); 
	Свойства.Вставить("ИндексПоиска", Новый Соответствие);
	Свойства.Вставить("ИндексПоискаДоступен", Ложь);
	Свойства.Вставить("ИндексПоискаПоОтбору", Новый Соответствие);
	Свойства.Вставить("ПозицияИтератора", -1);
	Свойства.Вставить("ТекущееЗначение", Свойства.ПустоеЗначение);
	Свойства.Вставить("ТекущийКлюч", Свойства.ПустоеЗначение);
	Свойства.Вставить("ЧислоЗначений", 0);
	Свойства.Вставить("МаксИндекс", 0);
	
	ПриИзмененииКоличества(Свойства, Истина);
	Сбросить(Свойства);
	
	Возврат Свойства;
	
КонецФункции

Процедура ПриИзмененииКоличества(Свойства, пОбновитьКлючи = Ложь)  Экспорт
	
	Сбросить(Свойства);
	
	Свойства.ЧислоЗначений = КоличествоЗначенийКоллекции(Свойства); 
	Свойства.МаксИндекс = Свойства.ЧислоЗначений - 1;
	Свойства.ИндексКлючейАктуален = Ложь;
	Свойства.ИндексПоискаДоступен = Ложь;
	Если пОбновитьКлючи Тогда
		ОбновитьИндексКлючейПриНеобходимости(Свойства);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Итератор_1_0

// Сбрасывает позицию курсора в начальное положение
// Действие необходимо, чтобы начать перебор элементов после того как он был начат,
// но по какой-либо причине прекращён
//
// Параметры:
//  нет передаваемых параметров
//
Процедура Сбросить(Свойства) Экспорт
	
	Свойства.ПозицияИтератора = -1;
	Свойства.ТекущееЗначение = Свойства.ПустоеЗначение;
	Свойства.ТекущийКлюч = Свойства.ПустоеЗначение;
	
КонецПроцедуры

// Метод итератора коллекции
// Сдвигает позицию итератора на заданный шаг итератора
// При первом вызове позиционирование производится на первый элемент коллекции при положительном шаге итератора
// При первом вызове позиционирование производится на последний элемент коллекции при отрицательном  шаге итератора
//
// Параметры:
//  
//  пШагИтератора - Число - Шаг итератора. Может быть отрицательным. По умолчанию = 1
//
// Возвращаемое значение:
//   Булево - Истина - итератор спозиционировался на следующий элемент. Ложь - следующий элемент отсутствует
//
Функция Следующий(Свойства, пШагИтератора = 1) Экспорт
	
	Если Не Свойства.ИндексКлючейАктуален Тогда
		ОбновитьИндексКлючейПриНеобходимости(Свойства);
	КонецЕсли;
	
	Если ИтераторАктивен(Свойства) Тогда
		Свойства.ПозицияИтератора = Свойства.ПозицияИтератора + пШагИтератора;
	ИначеЕсли пШагИтератора > 0 Тогда
		Свойства.ПозицияИтератора = 0;
	ИначеЕсли пШагИтератора < 0 Тогда
		Свойства.ПозицияИтератора = Свойства.МаксИндекс;
	Иначе
		ОшибкаШагИтератораНеМожетБытьРавенНулю(Свойства);
	КонецЕсли;
	
	
	Если ИтераторАктивен(Свойства) Тогда
		Результат = Истина;
		Свойства.ТекущийКлюч = Свойства.КлючиКоллекции[Свойства.ПозицияИтератора];
		Свойства.ТекущееЗначение = ПолучитьЗначение(Свойства, Свойства.ТекущийКлюч);
	Иначе
		Свойства.ТекущийКлюч = Свойства.ПустоеЗначение;
		Свойства.ТекущееЗначение = Свойства.ПустоеЗначение;
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получение ключа текущего элемента колллекции
// Для массивов, таблиц итд это будет индекс элемента
// Для структур и соответствий это будет Ключ из пары КлючИЗначение
//
// Параметры:
//  нет передаваемых параметров
//
// Возвращаемое значение:
//   Число,Строка,Произвольный - ключ текущего элемента коллекции
//
Функция Ключ(Свойства) Экспорт
	
	Если ИтераторАктивен(Свойства) Тогда
		Результат = Свойства.ТекущийКлюч;
	Иначе
		ОшибкаОбращениеКЭлементуПриНеактивномИтераторе(Свойства);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получение значение текущего элемента колллекции
// Для массивов это будет сам элемент, для таблиц строка таблицы,
// для структур, соответствий и списка значений содержимое поля Значение элемента коллекции
// Для структур и соответствий это будет Значение из пары КлючИЗначение
//
// Параметры:
//  нет передаваемых параметров
//
// Возвращаемое значение:
//   Произвольный - значение текущего элемента коллекции
//
Функция Значение(Свойства) Экспорт
	
	Если ИтераторАктивен(Свойства) Тогда
		Результат = Свойства.ТекущееЗначение;
	Иначе
		ОшибкаОбращениеКЭлементуПриНеактивномИтераторе(Свойства);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Изменение_1_0

// Добавляет элемент в коллекцию
//
// Параметры:
//  
//  пЗначение - Произвольный - Добавляемое значение
//                 Для таблицы либо не обязательно, либо данные заполнения для новой строки
//                 Если данные заполнения будут переданы, то добавляемая строка таблицы будет заполнена из них 
//  пКлюч - Число,Строка,Произвольный - Ключ элемента коллекции
//                 Массив,СписокЗначений,ТаблицаЗначений - не обязательно. Если ключ указан, то производится вставка в позицию ключа
//                 Структура,Соответствие - обязательно, должен быть уникальным.
//
// Возвращаемое значение:
//   Число,Строка,Произвольный - ключ добавленного элемента 
//
Функция Добавить(Свойства, пЗначение = "UFL_ШифрПараметрНеПередан", пКлюч = "UFL_ШифрПараметрНеПередан") Экспорт
	
	Если Свойства.Фиксированная Тогда
		ОшибкаПопыткаМодифицироватьФиксированнуюКоллекцию(Свойства);
	КонецЕсли;

	Ключ = ?(пКлюч = ШифрПараметрНеПередан(), Свойства.ПустоеЗначение, пКлюч);
	Значение = ?(пЗначение = ШифрПараметрНеПередан(), Свойства.ПустоеЗначение, пЗначение);
	
	Результат = ДобавитьЗначениеВКоллекцию(Свойства, пЗначение, Ключ);
	
	Возврат Результат;

КонецФункции

// Производит вставку значения в указанную позицию коллекции
// Реализовано как синтаксический сахар и для совместимости с
// существующим кодом, так как метод Добавить() реализует обе команды и Добавить() и Вставить()
//
// Параметры:
//  
//  пЗначение - Произвольный - вставляемое значение
//                 Для таблицы либо не обязательно, либо данные заполнения для новой строки
//                 Если данные заполнения будут переданы, то вставляемая строка таблицы будет заполнена из них 
//  пКлюч - Число,Строка,Произвольный - Ключ позиции коллекции, куда прпоизводится вставка
//
// Возвращаемое значение:
//   Число,Строка,Произвольный - ключ вставленного элемента 
//
Функция Вставить(Свойства, пКлюч, пЗначение) Экспорт
	
	Если Свойства.Фиксированная Тогда
		ОшибкаПопыткаМодифицироватьФиксированнуюКоллекцию(Свойства);
	КонецЕсли;
	
	Результат = ДобавитьЗначениеВКоллекцию(Свойства, пЗначение, пКлюч);
	
	Возврат Результат;

КонецФункции

// Удалить элемент(ы) с указанным ключом(ами)
//
// Параметры:
//  
//  пКлюч - Массив,Произвольный - ключ(и) удаляемого элемента
//                 Число - числовой ключ(индекс) элемента
//                 Массив - массив ключей
//                 Произвольный - ключ для соответствия
//                 Если будет передан хотя бы один несуществующий ключ, то будет вызвано исключение
//                 Наличие неуникальных ключей допускается
//                 
Процедура Удалить(Свойства, пКлюч) Экспорт
	
	Если Свойства.Фиксированная Тогда
		ОшибкаПопыткаМодифицироватьФиксированнуюКоллекцию(Свойства);
	КонецЕсли;
	
	Если ТипЗнч(пКлюч) = Тип("Массив") Тогда
		КлючиКУдалению = пКлюч;
	Иначе
		КлючиКУдалению = Новый Массив;
		КлючиКУдалению.Добавить(пКлюч);
	КонецЕсли;
	
	УдалитьПоСпискуКлючей(Свойства, КлючиКУдалению);
	
КонецПроцедуры

// Удалить элемент(ы) с указанным значением(ями)
//
// Параметры:
//  
//  пЗначение - Произвольный,Массив - значение или массив значений подлежащих удалению
//  пВсеНайденные - Булево - Истина - удалить все найденные элементы, иначе, только первое найденное
//                 
Процедура УдалитьЗначение(Свойства, пЗначение, пВсеНайденные = Истина) Экспорт
	
	Если Свойства.Фиксированная Тогда
		ОшибкаПопыткаМодифицироватьФиксированнуюКоллекцию(Свойства);
	КонецЕсли;

	Если пВсеНайденные Тогда
		КлючиКУдалению = НайтиВсеПоЗначению(Свойства, пЗначение);
	Иначе
		Ключ = НайтиПоЗначению(Свойства, пЗначение);
		КлючиКУдалению = Новый Массив;
