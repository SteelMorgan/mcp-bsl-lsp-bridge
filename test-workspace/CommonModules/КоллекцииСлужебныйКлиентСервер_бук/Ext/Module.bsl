Функция ЭкземплярКлассаУниверсальнаяКоллекция(пОбъект) Экспорт
	
	Если ЭтоЭкземплярКлассаУниверсальнаяКоллекция(пОбъект) Тогда
		Результат = пОбъект;
	Иначе
		#Если ТонкийКлиент Или ВебКлиент Или МобильныйКлиент Или МобильноеПриложениеКлиент Тогда
			Результат = ПолучитьФорму("Обработка.УниверсальнаяКоллекция_бук.Форма.УниверсальнаяКоллекцияКлиент");
		#Иначе
			Результат = Обработки.УниверсальнаяКоллекция_бук.Создать();
		#КонецЕсли
		Результат.Инициализировать(пОбъект);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭкземплярКлассаТаблицаЗначений(пОбъект) Экспорт
	
	Если ЭтоЭкземплярКлассаУниверсальнаяКоллекция(пОбъект) Тогда
		Результат = пОбъект;
	Иначе
		#Если ТонкийКлиент Или ВебКлиент Или МобильныйКлиент Или МобильноеПриложениеКлиент Тогда
			Контекст = Новый Структура("Тип", Тип("ТаблицаЗначений"));
			ОшибкаТипКоллекцииНеПоддерживаетКонтекст(Контекст);
		#Иначе
			Результат = Обработки.ТаблицаЗначений_бук.Создать();
		#КонецЕсли
		Результат.Инициализировать(пОбъект);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоЭкземплярКлассаУниверсальнаяКоллекция(пОбъект) Экспорт
	
	ТипВходящихДанных = ТипЗнч(пОбъект);
	#Если ТонкийКлиент Или ВебКлиент Или МобильныйКлиент Или МобильноеПриложениеКлиент Тогда
		Результат = ТипВходящихДанных = Тип("ФормаКлиентскогоПриложения") 
		И пОбъект.ИмяФормы = ИмяКлассаУниверсальнаяКоллекцияКлиент(); 
	#Иначе
		Результат = ТипВходящихДанных = Тип("ОбработкаОбъект.УниверсальнаяКоллекция_бук"); 
	#КонецЕсли
	
	Возврат Результат;

КонецФункции

Функция ЭтоЭкземплярКлассаТаблицаЗначений(пОбъект) Экспорт
	
	ТипВходящихДанных = ТипЗнч(пОбъект);
	#Если ТонкийКлиент Или ВебКлиент Или МобильныйКлиент Или МобильноеПриложениеКлиент Тогда
		Результат = Ложь;  // ТЗ не работает в данном контексте
	#Иначе
		Результат = ТипВходящихДанных = Тип("ОбработкаОбъект.ТаблицаЗначений_бук"); 
	#КонецЕсли
	
	Возврат Результат;

КонецФункции


Функция ИмяКласса() Экспорт
	
	Возврат "УниверсальнаяКоллекция";
	
КонецФункции

Функция ИмяКлассаУниверсальнаяКоллекцияКлиент() Экспорт
	
	ЧастиИмени = Новый Массив;
	ЧастиИмени.Добавить(ИмяКласса());
	ЧастиИмени.Добавить("Клиент");
	Разделитель = "";
	Результат = СтрСоединить(ЧастиИмени, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Функция ШифрПараметрНеПередан() Экспорт
	
	Возврат "UFL_ШифрПараметрНеПередан";

КонецФункции

