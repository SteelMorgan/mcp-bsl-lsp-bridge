Функция КлючЭтоИндекс(пТипКоллекции)
	
	КоллекцииСИндексом = Новый Соответствие;
	КоллекцииСИндексом.Вставить(Тип("Массив"), Истина);
	КоллекцииСИндексом.Вставить(Тип("СписокЗначений"), Истина); 
	Если ТаблицаЗначенийПоддерживается() Тогда
		КоллекцииСИндексом.Вставить(Тип("ТаблицаЗначений"), Истина);
	КонецЕсли;
	КоллекцииСИндексом.Вставить(Тип("ФиксированныйМассив"), Истина);
	
	Результат = КоллекцииСИндексом[пТипКоллекции] = Истина; 
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьПолеЗначение(пТипКоллекции)
	
	КоллекцияСПолем = Новый Соответствие;
	КоллекцияСПолем.Вставить(Тип("Структура"), Истина);
	КоллекцияСПолем.Вставить(Тип("Соответствие"), Истина);
	КоллекцияСПолем.Вставить(Тип("СписокЗначений"), Истина);
	КоллекцияСПолем.Вставить(Тип("ФиксированнаяСтруктура"), Истина);
	КоллекцияСПолем.Вставить(Тип("ФиксированноеСоответствие"), Истина);
	
	Результат = КоллекцияСПолем[пТипКоллекции] = Истина; 
	
	Возврат Результат;
	
КонецФункции

Функция ДоступнаВыгрузкаЗначения(пТипКоллекции)
	
	Результат = пТипКоллекции = Тип("СписокЗначений"); 
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоТипФиксированнойКоллекции(пТипКоллекции)
	
	ФиксКоллекции = Новый Соответствие;
	ФиксКоллекции.Вставить(Тип("ФиксированныйМассив"), Истина);
	ФиксКоллекции.Вставить(Тип("ФиксированнаяСтруктура"), Истина);
	ФиксКоллекции.Вставить(Тип("ФиксированноеСоответствие"), Истина);
	
	Результат = ФиксКоллекции[пТипКоллекции] = Истина; 
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьВстроенныйИндекс(пТипКоллекции)
	
	Если ТаблицаЗначенийПоддерживается() И пТипКоллекции = Тип("ТаблицаЗначений") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьФиксАналог(пТипКоллекции)
	
	Результат = ТипФиксАналогаКоллекции(пТипКоллекции) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьНеФиксАналогКоллекции(пТипКоллекции)
	
	Результат = ТипНеФиксАналогаКоллекции(пТипКоллекции) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ТипФиксАналогаКоллекции(пТипКоллекции)
	
	Если пТипКоллекции = Тип("Массив") Тогда
		Результат = Тип("ФиксированныйМассив");
	ИначеЕсли пТипКоллекции = Тип("Структура") Тогда
		Результат = Тип("ФиксированнаяСтруктура");
	ИначеЕсли пТипКоллекции = Тип("Соответствие") Тогда
		Результат = Тип("ФиксированноеСоответствие");
	Иначе
		Результат = Неопределено;
	КонецЕсли;
		
	Возврат Результат;

КонецФункции

Функция ТипНеФиксАналогаКоллекции(пТипКоллекции)
	
	Если пТипКоллекции = Тип("ФиксированныйМассив") Тогда
		Результат = Тип("Массив");
	ИначеЕсли пТипКоллекции = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Тип("Структура");
	ИначеЕсли пТипКоллекции = Тип("ФиксированноеСоответствие") Тогда
		Результат = Тип("Соответствие");
	Иначе
		Результат = Неопределено;
	КонецЕсли;
		
	Возврат Результат;

КонецФункции

Функция ЭтоТипПоддерживаемойКоллекции(Свойства, пТипКоллекции)
	
	Результат = Свойства.ТипыПоддерживаемыхКоллекций[пТипКоллекции] <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

