Функция ИменаПоддерживаемыхКоллекций()
	
	Результат = Новый Соответствие;
	Результат.Вставить("Массив", Истина);
	Результат.Вставить("Структура", Истина);
	Результат.Вставить("Соответствие", Истина);
	Результат.Вставить("СписокЗначений", Истина);
	Если ТаблицаЗначенийПоддерживается() Тогда
		Результат.Вставить("ТаблицаЗначений", Истина); 
	КонецЕсли;
	Результат.Вставить("ФиксированныйМассив", Истина);
	Результат.Вставить("ФиксированнаяСтруктура", Истина);
	Результат.Вставить("ФиксированноеСоответствие", Истина);
	
	Возврат Результат;
	
