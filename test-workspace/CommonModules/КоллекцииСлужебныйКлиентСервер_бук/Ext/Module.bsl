Функция СкопироватьКоллекцию(Свойства, пОбъект, пРекурсивно)
	
	Коллекция = ЭкземплярКлассаУниверсальнаяКоллекция(пОбъект);
	      
	Если Не Коллекция.ЭтоФиксированнаяКоллекция() Тогда 
		ТипКопии = Коллекция.ТипКоллекции();
	Иначе
		ТипКопии = ТипНеФиксАналогаКоллекции(Коллекция.ТипКоллекции());
	КонецЕсли;
	КопияКоллекции = ЭкземплярКлассаУниверсальнаяКоллекция(ТипКопии);
	
	Пока Коллекция.Следующий() Цикл
		Значение = СкопироватьЗначение(Свойства, Коллекция.Значение(), пРекурсивно);
		КопияКоллекции.Добавить(Значение, Коллекция.Ключ());
	КонецЦикла;
	
	Результат = КопияКоллекции.Указатель(); 
	Если Коллекция.ЭтоФиксированнаяКоллекция() Тогда
		// данные фикс коллекции копируются в обычной коллекции
		КопияКоллекции = ЭкземплярКлассаУниверсальнаяКоллекция(Результат);
		Результат = КопияКоллекции.СкопироватьКакЗафиксированныеДанные(пРекурсивно);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СкопироватьЗначение(Свойства, пЗначение, пРекурсивно)
	
	Результат = пЗначение;
	ТипЗначенияЭлемента = ТипЗнч(пЗначение);
	Если пРекурсивно Тогда
		Если ТаблицаЗначенийПоддерживается() И ТипЗначенияЭлемента = Тип("ТаблицаЗначений") Тогда
			Результат = ТаблицаЗначений_СкопироватьКоллекцию(Свойства, пЗначение, пРекурсивно);
		ИначеЕсли ЭтоТипПоддерживаемойКоллекции(Свойства, ТипЗначенияЭлемента) Тогда
			Результат = СкопироватьКоллекцию(Свойства, пЗначение, пРекурсивно); 
		КонецЕсли;
	ИначеЕсли ТаблицаЗначенийПоддерживается() И ТипЗначенияЭлемента = Тип("ТаблицаЗначений") Тогда
		Результат = пЗначение.Скопировать();
	ИначеЕсли ЭтоТипФиксированнойКоллекции(ТипЗначенияЭлемента) Тогда
		ФиксКоллекция = ЭкземплярКлассаУниверсальнаяКоллекция(пЗначение);
		Результат = ФиксКоллекция.СкопироватьКакДанныеБезФиксации(пРекурсивно);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЗафиксироватьКоллекциюРекурсивно(пОбъект)
	
	Коллекция = ЭкземплярКлассаУниверсальнаяКоллекция(пОбъект);
	ТипКоллекции = Коллекция.ТипКоллекции();
	КопияКоллекции = ЭкземплярКлассаУниверсальнаяКоллекция(ТипКоллекции);
	
	Пока Коллекция.Следующий() Цикл
		Значение = Коллекция.Значение();
		ТипЗначенияЭлемента = ТипЗнч(Значение);
		ТипФиксАналогаЭлемента = ТипФиксАналогаКоллекции(ТипЗначенияЭлемента);
		Если ТипФиксАналогаЭлемента <> Неопределено Тогда
			Значение = ЗафиксироватьКоллекциюРекурсивно(Значение);
		КонецЕсли;
		КопияКоллекции.Добавить(Значение, Коллекция.Ключ());
	КонецЦикла;

	ТипФиксАналога = ТипФиксАналогаКоллекции(ТипКоллекции);
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(КопияКоллекции.Указатель());
	Результат = Новый(ТипФиксАналога, ПараметрыКонструктора);
	
	Возврат Результат;
	
КонецФункции

Функция СнятьФиксациюКоллекцииРекурсивно(пОбъект)
	
	Коллекция = ЭкземплярКлассаУниверсальнаяКоллекция(пОбъект);
	ТипКоллекции = Коллекция.ТипКоллекции();
	ТипНеФиксАналога = ТипнеФиксАналогаКоллекции(ТипКоллекции);
	КопияКоллекции = ЭкземплярКлассаУниверсальнаяКоллекция(ТипНеФиксАналога);
	
	Пока Коллекция.Следующий() Цикл
		Значение = Коллекция.Значение();
		ТипЗначенияЭлемента = ТипЗнч(Значение);
		ТипНеФиксАналогаЭлемента = ТипНеФиксАналогаКоллекции(ТипЗначенияЭлемента);
		Если ТипНеФиксАналогаЭлемента <> Неопределено Тогда
			Значение = СнятьФиксациюКоллекцииРекурсивно(Значение);
		КонецЕсли;
		КопияКоллекции.Добавить(Значение, Коллекция.Ключ());
	КонецЦикла;
	
	Результат = КопияКоллекции.Указатель();
	
	Возврат Результат;
	
КонецФункции

Функция КонструкторКоллекции(пИсточник, пПараметрыКонструктора)
	
	ЕстьПараметрыКонструктора = Не пПараметрыКонструктора = Неопределено;
	ТипИсточника = ТипЗнч(пИсточник);
	
	Если ТипИсточника = Тип("Строка") Или ТипИсточника = Тип("Тип") Тогда
		Если ЕстьПараметрыКонструктора Тогда
			Параметры = Новый Массив;
			Параметры.Добавить(пПараметрыКонструктора);
			Результат = Новый(пИсточник, Параметры);
		Иначе
			Результат = Новый(пИсточник);
		КонецЕсли;
	Иначе
		Результат = пИсточник;
	КонецЕсли;
	
	Если ЕстьПараметрыКонструктора И ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		Результат.ЗагрузитьЗначения(пПараметрыКонструктора);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура ОбновитьИндексПоискаЗначений(Свойства, пПараметры)
	
	Если ТаблицаЗначенийПоддерживается() И Свойства.Тип = Тип("ТаблицаЗначений") Тогда
		ТаблицаЗначений_СоздатьИндекс(Свойства, пПараметры);
	Иначе
		Сбросить(Свойства);
		Пока Следующий(Свойства) Цикл
			ДобавитьЗначениеВПростойИндекс(Свойства, Значение(Свойства), Ключ(Свойства));
		КонецЦикла;
		Сбросить(Свойства);
	КонецЕсли;
	
	Свойства.ИндексПоискаДоступен = Истина;
	
КонецПроцедуры

Процедура ОчиститьИндексПоискаЗначений(Свойства)
	
	Если ТаблицаЗначенийПоддерживается() И Свойства.Тип = Тип("ТаблицаЗначений") Тогда
		Свойства.Коллекция.Индексы.Очистить();
	Иначе
		Свойства.ИндексПоиска.Очистить();
		Свойства.ИндексПоискаПоОтбору.Очистить();
	КонецЕсли;
	
	Свойства.ИндексПоискаДоступен = Ложь;
	
КонецПроцедуры

Процедура ДобавитьЗначениеВПростойИндекс(Свойства, пЗначение, пКлюч)
	
	ТекСодержимое = Свойства.ИндексПоиска[пЗначение];
	Если ТекСодержимое = Неопределено Тогда
		ТекСодержимое = Новый Массив;
		Свойства.ИндексПоиска[пЗначение] = ТекСодержимое;
	КонецЕсли;
	
	ТекСодержимое.Добавить(пКлюч);
	
КонецПроцедуры

Функция НайтиПоЗначениюВИндексе(Свойства, пЗначение, пЧислоЗначений = 0)
	
	ВернутьПервое = пЧислоЗначений = 1;
	БезОграничений = пЧислоЗначений = 0;
	
	Ключи = Свойства.ИндексПоиска[пЗначение];
	Если ЗначениеЗаполнено(Ключи) Тогда
		Если ВернутьПервое Тогда
			Результат = Ключи[0];
		ИначеЕсли БезОграничений Тогда
			Результат = Ключи; 
		Иначе
			Результат = Новый Массив;
			Для Сч = 0 По пЧислоЗначений - 1 Цикл
				Результат.Добавить(Ключи[Сч]);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

