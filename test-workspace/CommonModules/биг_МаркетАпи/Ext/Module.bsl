Функция ПолучитьАккаунт(ДокументОперации = Неопределено, ПараметрыОперации = Неопределено)
	
	Если ДокументОперации = Неопределено И ПараметрыОперации = Неопределено Тогда
		
		// todo: исключительная ситуация. фиксировать ошибку
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьАккаунт - Все входные параметры Неопределены";
		ВызватьИсключение ОписаниеОшибки;		
	КонецЕсли;
	
	Аккаунт = Неопределено;
	
	Если ДокументОперации <> Неопределено Тогда           		
		Аккаунт 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОперации, 	"Аккаунт");		
	ИначеЕсли ПараметрыОперации <> Неопределено Тогда		
		ПараметрыОперации.Свойство("Аккаунт", Аккаунт);		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		ВызватьИсключение "биг_МаркетАпи.ПолучитьАккаунт - не удалось определеить аккаунт";	
	КонецЕсли;
	
	Возврат Аккаунт;
	
КонецФункции

Функция ПолучитьИнтеграционныйМодуль_ПоАккаунту(Аккаунт = Неопределено, ПараметрыОперации = Неопределено)

	Если Аккаунт = Неопределено И ПараметрыОперации = Неопределено Тогда
		
		// todo: исключительная ситуация. фикс ошибку
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьИнтеграционныйМодуль_ПоАккаунту() - не определен модуль интеграции";
		ВызватьИсключение ОписаниеОшибки;		
	КонецЕсли;
	
	Если Аккаунт <> Неопределено Тогда               
		
		Биржа		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Аккаунт, "Владелец");		
	ИначеЕсли ПараметрыОперации <> Неопределено Тогда
		
		Биржа		= ПараметрыОперации.Биржа;		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Биржа) Тогда
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьИнтеграционныйМодуль_ПоАккаунту() - не удалось определить биржу";
		ВызватьИсключение ОписаниеОшибки;	
	КонецЕсли;
	
	Модуль = ПолучитьМодульПоБирже(Биржа);	
	Возврат Модуль;
		
КонецФункции 

Функция ПолучитьИнтеграционныйМодуль_ПоПараметрамОперации(ПараметрыОперации)
	
	Биржа 	= Неопределено;
	Аккаунт = Неопределено;
	
	ПараметрыОперации.Свойство("Аккаунт", Аккаунт);
	ПараметрыОперации.Свойство("Биржа", Биржа);
	
	Если НЕ ЗначениеЗаполнено(Биржа) И НЕ ЗначениеЗаполнено(Аккаунт) Тогда		
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьИнтеграционныйМодуль_ПоПараметрамОперации() - не заполнены все входные параметры";
		ВызватьИсключение ОписаниеОшибки;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Биржа) Тогда
		Биржа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Аккаунт, "Владелец");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Биржа) Тогда
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьИнтеграционныйМодуль_ПоПараметрамОперации() - не удалось определить Биржу";
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Модуль = ПолучитьМодульПоБирже(Биржа);	
	Возврат Модуль;
		
КонецФункции

Функция ПолучитьМодульПоБирже(Биржа) Экспорт

	ИмяМодуля	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Биржа, "ОбщийМодульИнтеграции");
	
	Если НЕ ЗначениеЗаполнено(ИмяМодуля) Тогда
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьМодульПоБирже() - в элементе Биржа не указано Имя модуля интеграции";
		ВызватьИсключение ОписаниеОшибки;	
	КонецЕсли;
	
	Модуль 		= ?(ЗначениеЗаполнено(ИмяМодуля), ОбщегоНазначения.ОбщийМодуль(ИмяМодуля), Неопределено); 
    Если Модуль = Неопределено Тогда
		ОписаниеОшибки = "биг_МаркетАпи.ПолучитьМодульПоБирже() - по имени Интеграционного модуля не удалось получить Общий модуль";
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Модуль;
	
КонецФункции



#КонецОбласти //СлужебныеПроцедурыФункции

