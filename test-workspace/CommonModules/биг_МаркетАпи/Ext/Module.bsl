Процедура МенеджерОбновленияИнформацииОбАккаунтах() Экспорт
	
	// проверка, что задание уже выполняется (в моменте только один менеджер очереди. Ключ = Модуль.ИмяМетода из задания)
	Если биг_ОбщегоНазначения.ФоновоеЗаданиеАктивно_ПоКлючу("биг_МаркетАпи.МенеджерОбновленияИнформацииОбАккаунтах") Тогда
		Возврат;	
	КонецЕсли;
	
	ВыборкаАккаунтов = ПолучитьВыборкуАккаунтов();	
	Пока ВыборкаАккаунтов.Следующий() Цикл
		
		ВыполняемыйМетод 			= "биг_МаркетАпи.ОбновитьИнформациюОбАккаунте";		
		ПараметрыЗапуска			= Новый Структура("Аккаунт", ВыборкаАккаунтов.Аккаунт);		
		СтруктураФоновогоЗадания 	= биг_ОбщегоНазначения.ЗапуститьФоновоеЗадание(ВыполняемыйМетод, ПараметрыЗапуска);
	КонецЦикла;		
		
