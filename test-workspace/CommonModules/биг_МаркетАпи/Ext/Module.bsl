Функция СоздатьОрдер(ДокументОперации = Неопределено, ПараметрыОперации = Неопределено, Бектест = Ложь, ТаймСтамп = Неопределено) Экспорт
	
	Аккаунт			= ПолучитьАккаунт(ДокументОперации, ПараметрыОперации);	
	Интеграция 		= ПолучитьИнтеграционныйМодуль_ПоАккаунту(Аккаунт);		
	
	Если ДокументОперации 	= Неопределено Тогда
		ДокументОперации 	= Интеграция.СоздатьДокумент_Ордер(ПараметрыОперации, Бектест, ТаймСтамп);	
	КонецЕсли;
	    
	ПараметрыОперацииБиржи 	= Интеграция.ПараметрыОперацииБиржи_СоздатьОрдер(ДокументОперации);		
	Результат = Интеграция.СоздатьОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест);
	
	Если Бектест И ПараметрыОперации.БектестВычислитьPnL = Истина Тогда
		Интеграция.Ордер_Бектест_ВычислитьPnL(ДокументОперации);
	КонецЕсли;
	
	Если Результат = Истина Тогда
		МассивОпераций = Интеграция.ПолучитьМассивСвязанныхОпераций(ДокументОперации);
		биг_СтратегииСервер.ЗафиксироватьОперацию(МассивОпераций);	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ИзменитьОрдер(ПараметрыОперации = Неопределено, Бектест = Ложь) Экспорт

	Аккаунт			= ПолучитьАккаунт(, ПараметрыОперации);	
	Интеграция 		= ПолучитьИнтеграционныйМодуль_ПоАккаунту(Аккаунт);	
	
	ПараметрыОперацииБиржи = Интеграция.ПараметрыОперацииБиржи_ИзменитьОрдер(ПараметрыОперации);		
	Возврат Интеграция.ИзменитьОрдер(ПараметрыОперацииБиржи, Аккаунт, Бектест);
	
КонецФункции 

