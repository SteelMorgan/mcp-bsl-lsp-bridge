	СтруктураОперации.Биржа 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Аккаунт, "Владелец");
	СтруктураОперации.Аккаунт	= Параметры.Аккаунт;
	
	Результат = ПолучитьИнформациюОбАккаунте(Параметры.Аккаунт, СтруктураОперации);
	
