
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
    Настройки 			= КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки 	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	// установка общей "группы" для всех кусков макета, что бы не разъезжалась ширина
	УстановитьОбщуюГруппуИШиринуКолонок(МакетКомпоновки);
	
	// костыль для параметра Стейблы
	//МассивСтейблов = биг_ОбщегоНазначенияКлиентСервер.ПолучитьМассивЗначенийПоИмени("Стейблкоин");
	//СписокСтейблов = Новый СписокЗначений;
	//Для каждого Монета Из МассивСтейблов Цикл
	//	СписокСтейблов.Добавить(Монета);	
	//КонецЦикла;
	//Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("МассивСтейблов", СписокСтейблов);
	//ПользовательскийПараметр 			= КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрСтейблы.ИдентификаторПользовательскойНастройки);
	//ПользовательскийПараметр.Значение 	= ПараметрСтейблы.Значение;	
	//ПользовательскийПараметр.Использование = Истина;
	
	// сформируем наборы данных
	ОтборПортфель 		= Настройки.ПараметрыДанных.Элементы.Найти("Портфель");
	ОтборАккаунт		= Настройки.ПараметрыДанных.Элементы.Найти("Аккаунт");
	ПериодОтчета		= Настройки.ПараметрыДанных.Элементы.Найти("ПериодОтчета");
	ДатаНачала			= ПериодОтчета.Значение.ДатаНачала;
	ДатаОкончания		= ПериодОтчета.Значение.ДатаОкончания;
		
	ЗаПериодУправления 	= СформироватьТаблицуОбщегоРезультата(ОтборПортфель, ОтборАккаунт, ДатаОкончания);
	ЗаПериодОтчета		= СформироватьТаблицуРезультатаЗаПериод(ОтборПортфель, ОтборАккаунт, ДатаНачала, ДатаОкончания);
	ВнешниеНаборы		= Новый Структура("ЗаПериодУправления, ЗаПериодОтчета", ЗаПериодУправления, ЗаПериодОтчета); 
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки);
    ПроцессорВывода 	= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	// шаблон вывод изображений для группировки монет 
	// https://infostart.ru/1c/articles/1125765/
	ВывестиИзображенияТикеровМонет(ДокументРезультат);
	
	ПереместитьДиаграммуВЦелевуюОбласть(ДокументРезультат);
		
КонецПроцедуры  

Процедура УстановитьОбщуюГруппуИШиринуКолонок(МакетКомпоновки)

	Для ИИ=0 По МакетКомпоновки.Макеты.Количество()-1 Цикл
		ТекМакет1 = МакетКомпоновки.Макеты[ИИ];
		
		Если ТипЗнч(ТекМакет1.Макет) = Тип("МакетОбластиКомпоновкиДанных") Тогда
			Для УУ=0 По ТекМакет1.Макет.Количество()-1 Цикл
				ТекМакет2 = ТекМакет1.Макет[УУ];
				ТекМакет2.ИдентификаторТаблицы = "";
				
				// установка фикс. ширины для отдельных колонок (иначе плывут)
				Для ЮЮ = 0 По Мин(ТекМакет2.Ячейки.Количество()-1, 3) Цикл
					ТекМакет2.ИдентификаторТаблицы = "";
					ТекМакет2.Ячейки[ЮЮ].Оформление.УстановитьЗначениеПараметра("МинимальнаяШирина", 9);
					ТекМакет2.Ячейки[ЮЮ].Оформление.УстановитьЗначениеПараметра("МаксимальнаяШирина", 9);
				КонецЦикла;			
			КонецЦикла;			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  

