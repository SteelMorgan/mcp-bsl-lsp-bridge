
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура СформироватьИнтеграционныйДокумент(Операция, Аккаунт) Экспорт
	
	ОбъектОперации = Операция.ПолучитьОбъект();
	
	// 1. Подготовка универсальной структуры параметров для вызова API
	СтруктураОперации = биг_МаркетАпиКлиентСервер.СтруктураОперации_СоздатьОрдер();
	СтруктураОперации.Биржа 		= ОбъектОперации.Биржа;
	СтруктураОперации.Аккаунт 		= Аккаунт;
	СтруктураОперации.ОрдерСторона 	= ОбъектОперации.СторонаОрдера;
	СтруктураОперации.ОрдерТип		= ОбъектОперации.ТипОрдера;
	СтруктураОперации.Сигнал		= ОбъектОперации.Сигнал;
	СтруктураОперации.Сделка		= ОбъектОперации.Сделка;
	СтруктураОперации.Операция		= Операция;
	СтруктураОперации.ИнструментТип	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "instType");
	СтруктураОперации.ИнструментИД	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "instId");
	СтруктураОперации.ЦенаОрдера	= ОбъектОперации.ЦенаОрдера; 
	СтруктураОперации.РежимТорговли	= ОбъектОперации.РежимТорговли;
	
	// 2. Определение цены для расчета (для рыночных ордеров)
	Если ОбъектОперации.ТипОрдера = Перечисления.big_OKX_OrderTypes.market Тогда
		
		ЗапросЦены = биг_МаркетАпиКлиентСервер.СтруктураОперации_ПолучитьЦену();
		ЗапросЦены.Биржа				= ОбъектОперации.Биржа;
		ЗапросЦены.ИнструментТип		= СтруктураОперации.ИнструментТип;
		ЗапросЦены.ИнструментИД			= СтруктураОперации.ИнструментИД;	
		ЦенаРасчетов					= биг_МаркетАпи.ПолучитьЦенуТикета(ЗапросЦены);
		
	ИначеЕсли ОбъектОперации.ТипОрдера = Перечисления.big_OKX_OrderTypes.limit Тогда		
		ЦенаРасчетов					= СтруктураОперации.ЦенаОрдера;	
	Иначе		
		Ошибка = "Для Типа ордера = " + ОбъектОперации.ТипОрдера + " Не реализован обработчик заполнения. Модуль менеджера док. биг_ОперацияПокупкаПродажа";
		ВызватьИсключение(Ошибка);
	КонецЕсли;
	
	РеквизитыИнструмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектОперации.Инструмент, "baseCcy, ctValCcy, quoteCcy, settleCcy");
	
	// 3. Получение информации о текущей позиции (если не SPOT)
	Если СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT Тогда
		Позиция = Новый Структура("РазмерПозиции", 0);
	Иначе 	
		Позиция = биг_ПортфельноеУправление.ПолучитьИнформациюОПозиции(ОбъектОперации.Сделка, Аккаунт);	
	КонецЕсли; 
	
	// 4. Расчет базового размера ордера (в базовой валюте или контрактах)
	// Инициализируем переменную для sz
	sz_Значение = 0;

	// Определяем "депозит" и рассчитываем номинал операции
	Если (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN) Тогда
		Если СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
			// SPOT/MARGIN buy: депозит - quote валюта (USDT)
			quoteCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "quoteCcy");
			Если НЕ ЗначениеЗаполнено(quoteCcy) Тогда
				ВызватьИсключение "Для инструмента " + ОбъектОперации.Инструмент.Наименование + " не определена quote валюта.";
			КонецЕсли;
			БалансДепозита = биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, quoteCcy);
		ИначеЕсли СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
			// SPOT/MARGIN sell: депозит - base валюта (BTC)
			baseCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "baseCcy");
			Если НЕ ЗначениеЗаполнено(baseCcy) Тогда
				ВызватьИсключение "Для инструмента " + ОбъектОперации.Инструмент.Наименование + " не определена base валюта.";
			КонецЕсли;
			БалансДепозита = биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, baseCcy);
		Иначе
			ВызватьИсключение "Неподдерживаемая сторона ордера: " + СтруктураОперации.ОрдерСторона;
		КонецЕсли;
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SWAP ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.FUTURES) Тогда
		Если СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
			// SWAP/FUTURES buy: депозит - settle/quote валюта (USDT) для расчета маржи
			settleCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "settleCcy");
			quoteCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "quoteCcy");
			МонетаДепозита = ?(ЗначениеЗаполнено(settleCcy), settleCcy, quoteCcy);
			Если НЕ ЗначениеЗаполнено(МонетаДепозита) Тогда
				ВызватьИсключение "Для инструмента " + ОбъектОперации.Инструмент.Наименование + " не определена валюта расчетов (settle/quote).";
			КонецЕсли;
			БалансДепозита = биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, МонетаДепозита);
		ИначеЕсли СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
			// SWAP/FUTURES sell: депозит - размер существующей позиции
			// Предполагается, что Позиция.РазмерПозиции уже в нужных единицах (контракты или базовая валюта)
			БалансДепозита = Позиция.РазмерПозиции;
		Иначе
			ВызватьИсключение "Неподдерживаемая сторона ордера: " + СтруктураОперации.ОрдерСторона;
		КонецЕсли;
	Иначе
		// Для других типов инструментов (например, OPTION) - логика может отличаться
		// Пока используем упрощенную логику SPOT
		Если СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
			quoteCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "quoteCcy");
			Если НЕ ЗначениеЗаполнено(quoteCcy) Тогда
				ВызватьИсключение "Для инструмента " + ОбъектОперации.Инструмент.Наименование + " не определена quote валюта.";
			КонецЕсли;
			БалансДепозита = биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, quoteCcy);
		ИначеЕсли СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
			baseCcy = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "baseCcy");
			Если НЕ ЗначениеЗаполнено(baseCcy) Тогда
				ВызватьИсключение "Для инструмента " + ОбъектОперации.Инструмент.Наименование + " не определена base валюта.";
			КонецЕсли;
			БалансДепозита = биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, baseCcy);
		Иначе
			ВызватьИсключение "Неподдерживаемая сторона ордера: " + СтруктураОперации.ОрдерСторона;
		КонецЕсли;
	КонецЕсли;

	// Рассчитываем номинал операции (сумма или количество в валюте депозита)
	НоминалОперации = (БалансДепозита / 100 * ОбъектОперации.ДоляОтДепозита) * ОбъектОперации.РазмерПлеча;

	// Определяем финальный sz в единицах, понятных OKX
	Если (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN) И СтруктураОперации.ОрдерТип = Перечисления.big_OKX_OrderTypes.market И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
		// SPOT/MARGIN market buy: sz = сумма quote валюты
		sz_Значение = НоминалОперации;
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN) И СтруктураОперации.ОрдерТип = Перечисления.big_OKX_OrderTypes.market И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
		// SPOT/MARGIN market sell: sz = количество base валюты
		sz_Значение = НоминалОперации;
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN) И СтруктураОперации.ОрдерТип = Перечисления.big_OKX_OrderTypes.limit И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
		// SPOT/MARGIN limit buy: sz = количество base валюты
		sz_Значение = НоминалОперации / ЦенаРасчетов;
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SPOT ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.MARGIN) И СтруктураОперации.ОрдерТип = Перечисления.big_OKX_OrderTypes.limit И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
		// SPOT/MARGIN limit sell: sz = количество base валюты
		sz_Значение = НоминалОперации;
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SWAP ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.FUTURES) И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.buy Тогда
		// SWAP/FUTURES buy: sz = количество контрактов
		// Сначала считаем "количество базовой валюты", потом пересчитываем в контракты
		sz_Значение_БазоваяВалюта = НоминалОперации / ЦенаРасчетов;
		sz_Значение = биг_ОКХ_Сервер.ПересчитатьВКонтракты(sz_Значение_БазоваяВалюта, ОбъектОперации.Инструмент);
	ИначеЕсли (СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.SWAP ИЛИ СтруктураОперации.ИнструментТип = Перечисления.big_OKX_InstrumentType.FUTURES) И СтруктураОперации.ОрдерСторона = Перечисления.big_OKX_OrderSides.sell Тогда
		// SWAP/FUTURES sell: sz = количество контрактов
		// Сначала считаем "количество базовой валюты", потом пересчитываем в контракты
		sz_Значение_БазоваяВалюта = НоминалОперации;
		sz_Значение = биг_ОКХ_Сервер.ПересчитатьВКонтракты(sz_Значение_БазоваяВалюта, ОбъектОперации.Инструмент);
	Иначе
		// Неожиданная комбинация, используем номинал как есть (например, для OPTION)
		sz_Значение = НоминалОперации;
	КонецЕсли;

	// Округляем sz до кратности lotSz
	Кратность = биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(ОбъектОперации.Инструмент, "lotSz");
	Если ЗначениеЗаполнено(Кратность) И Кратность > 0 Тогда
		sz_Значение = биг_ОбщегоНазначенияКлиентСервер.ОкруглитьКратно(sz_Значение, Кратность);
	КонецЕсли;

	// --- Проверка на минимальный размер ордера ---
	Если НЕ ПроверитьМинимальныйРазмерОрдера(sz_Значение, ОбъектОперации.Инструмент, СтруктураОперации.ИнструментТип, СтруктураОперации.ОрдерСторона, СтруктураОперации.ОрдерТип, ЦенаРасчетов) Тогда
		// Обработка ошибки - например, запись в лог и вызов исключения
		ВызватьИсключение("Размер ордера (" + sz_Значение + ") меньше минимально допустимого для инструмента " + ОбъектОперации.Инструмент.Наименование);
	КонецЕсли;

	// 5. Передача рассчитанных значений в структуру параметров
	СтруктураОперации.РазмерОрдера = sz_Значение;
	
	// Добавление связанных алго-ордеров (стоп-лосс, тейк-профит)
	Для каждого Строка Из ОбъектОперации.СтопТейк Цикл
		ОперацияТейкСтоп = Строка.ТейкСтоп.ПолучитьОбъект();
		СтруктураАлго = биг_МаркетАпиКлиентСервер.СтруктураОперации_СоздатьАлгоОрдер();
		СтруктураАлго.Биржа 			= ОбъектОперации.Биржа;
		СтруктураАлго.Аккаунт 			= Аккаунт;
		СтруктураАлго.Сигнал 			= ОперацияТейкСтоп.Сигнал;
		СтруктураАлго.Операция 			= Строка.ТейкСтоп;
		СтруктураАлго.Сделка 			= ОперацияТейкСтоп.Сделка;
		СтруктураАлго.ИнструментИД 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОперацияТейкСтоп.Инструмент, "instId");
		СтруктураАлго.ТриггерСтопЛос 	= ОперацияТейкСтоп.СтопЛосс_Триггер;
		СтруктураАлго.ЦенаСтопЛос 		= ОперацияТейкСтоп.СтопЛосс_Цена;
		СтруктураАлго.ТриггерТейкПрофит = ОперацияТейкСтоп.ТейкПрофит_Триггер;
		СтруктураАлго.ЦенаТейкПрофит 	= ОперацияТейкСтоп.ТейкПрофит_Цена;
		СтруктураАлго.СторонаПозиции	= СтруктураОперации.ОрдерСторона;
		
		Если ЗначениеЗаполнено(ОперацияТейкСтоп.ТейкПрофит_Триггер) Тогда
			//Если ЗначениеЗаполнено(ОперацияТейкСтоп.ТейкПрофит_Объем) Тогда
			//	СтруктураАлго.ОбъемТейкПрофит = ОперацияТейкСтоп.ТейкПрофит_Объем;
			//ИначеЕсли ЗначениеЗаполнено(ОперацияТейкСтоп.ТейкПрофит_Доля) Тогда
			//	СтруктураАлго.ОбъемТейкПрофит = РазмерОрдера / 100 * ОперацияТейкСтоп.ТейкПрофит_Доля;   
			//КонецЕсли;
			
			//СтруктураАлго.ОбъемТейкПрофит = РазмерОрдера;
		КонецЕсли;
		
		СтруктураОперации.МассивСвязанныхАлгоОрдеров.Добавить(СтруктураАлго);
	КонецЦикла;
	
	// Создание ордера через API
	Результат = биг_МаркетАпи.СоздатьОрдер(, СтруктураОперации);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция для расчета размера ордера по депозиту
Функция РассчитатьРазмерОрдераПоДепозиту(ОбъектОперации, ЦенаРасчетов, Аккаунт)
	
	РеквизитыИнструмента 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектОперации.Инструмент, "baseCcy, ctValCcy, quoteCcy, settleCcy");
	Монета 					= ?(ЗначениеЗаполнено(РеквизитыИнструмента.quoteCcy), РеквизитыИнструмента.quoteCcy, РеквизитыИнструмента.settleCcy);
	
	РазмерДепозита 			= биг_ПортфельноеУправление.ПолучитьБалланс(Аккаунт, Монета);
	РазмерОрдера 			= Окр((РазмерДепозита / 100 * ОбъектОперации.ДоляОтДепозита) * ОбъектОперации.РазмерПлеча / ЦенаРасчетов, 8);
	
	Возврат РазмерОрдера;
	
КонецФункции

// Функция для расчета размера ордера по позиции
Функция РассчитатьРазмерОрдераПоПозиции(ОбъектОперации, РазмерТекущейПозиции)
	
	РазмерОрдера = РазмерТекущейПозиции / 100 * ОбъектОперации.ДоляОтДепозита;
	Возврат РазмерОрдера;
	
КонецФункции

// Проверяет, соответствует ли размер ордера минимальным требованиям биржи
Функция ПроверитьМинимальныйРазмерОрдера(sz_Значение, Инструмент, ТипИнструмента, СторонаОрдера, ТипОрдера, ЦенаРасчетов) Экспорт
	// Получаем минимальный размер из справочника инструментов (должен быть загружен из API)
	minSz = биг_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта(Инструмент, "minSz");
	Если НЕ ЗначениеЗаполнено(minSz) Тогда
		// Если minSz не загружен, считаем проверку пройденной
		Возврат Истина;
	КонецЕсли;

	Если ТипИнструмента = Перечисления.big_OKX_InstrumentType.SPOT И ТипОрдера = Перечисления.big_OKX_OrderTypes.market И СторонаОрдера = Перечисления.big_OKX_OrderSides.buy Тогда
		// Для SPOT market buy sz - это сумма в quote валюте
		// Нужно проверить, что эта сумма >= минимальной номинальной стоимости (если есть)
		// OKX API не всегда явно указывает минимальную номинальную стоимость, но minSz может быть в базовой валюте
		// Простая проверка: sz (сумма в quote) >= minSz (в quote, если так интерпретируется)
		// Более точно: sz >= (minSz_базовая_валюта * Цена)
		// Но так как minSz в API для SPOT часто относится к базовой валюте, проверим напрямую sz (в quote) >= minSz_quote (если известно)
		// Пока проверим sz >= minSz, предполагая, что minSz для buy market - это в quote
		// TODO: Уточнить логику minSz для разных типов ордеров
		Если sz_Значение < Число(minSz) Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.SPOT И ТипОрдера = Перечисления.big_OKX_OrderTypes.market И СторонаОрдера = Перечисления.big_OKX_OrderSides.sell Тогда
		// Для SPOT market sell sz - это количество базовой валюты
		Если sz_Значение < Число(minSz) Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.SPOT И ТипОрдера = Перечисления.big_OKX_OrderTypes.limit Тогда
		// Для SPOT limit sz - это количество базовой валюты
		Если sz_Значение < Число(minSz) Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипИнструмента = Перечисления.big_OKX_InstrumentType.SWAP ИЛИ ТипИнструмента = Перечисления.big_OKX_InstrumentType.FUTURES Тогда
		// Для SWAP/FUTURES sz - это количество контрактов (целое число)
		// minSz для контрактов часто 1, но может быть другим
		Если sz_Значение < Число(minSz) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		// Для других случаев (MARGIN и т.д.) проверяем sz >= minSz
		Если sz_Значение < Число(minSz) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;
КонецФункции

#КонецОбласти

#КонецЕсли
